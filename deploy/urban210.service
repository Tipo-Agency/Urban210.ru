# /etc/systemd/system/urban210.service: приём заявок /api/lead/ (Node, порт 3210)
[Unit]
Description=Urban210 lead API
After=network.target

[Service]
WorkingDirectory=/opt/urban210/current
EnvironmentFile=/opt/urban210/.env
Environment=HOST=127.0.0.1 PORT=3210
ExecStart=/usr/bin/node server/entry.mjs
Restart=always
User=www-data

[Install]
WantedBy=multi-user.target
