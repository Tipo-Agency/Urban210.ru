[Unit]
Description=Urban210 website (приём заявок /api/lead)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/urban210/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3210
EnvironmentFile=/etc/urban210/urban210.env
ExecStart=/usr/bin/node server/entry.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
