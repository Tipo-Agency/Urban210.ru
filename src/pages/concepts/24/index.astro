---
// Концепция 24 «Вайнгарт»: швейцарский панк, типографский плакат в духе Вольфганга Вайнгарта.
// Набор разных кеглей и углов, растровые (halftone) фото, наложение плашек (multiply), повтор букв со сдвигом,
// модульная сетка, которую нарочно ломают. Чёрный, оранжевый и голубой как третья краска поверх бумаги.
// Golos Text (весь набор) и IBM Plex Mono (подписи и служебные пометки). Движение: повторы букв расходятся,
// плашки сдвигаются «с приводкой» при попадании в экран (CSS + IntersectionObserver).
import pmCyr4 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-cyrillic-400-normal.woff2?url';
import pmLat4 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import pmCyr5 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-cyrillic-500-normal.woff2?url';
import pmLat5 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, programs } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (w: number, url: string, range: string) => `@font-face{font-family:'Plex w';font-style:normal;font-display:swap;font-weight:${w};src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = [ff(400, pmCyr4, UR), ff(400, pmLat4, UL), ff(500, pmCyr5, UR), ff(500, pmLat5, UL)].join('');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const dayRate = perDay(plans[0].month, 30);
const sidePromos = promos.filter((p) => ['trade-in', '1-plus-1'].includes(p.slug));
const shownReasons = reasons.filter((r) => !r.title.startsWith('Нет вступ'));
const cascade = [...Array(4).fill(`${dayRate} ₽ в день`), `${plans[0].name}: ${rub(plans[0].month)} в месяц`];
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const steps = [0, 1, 2, 3, 4, 5];
const groupTags = programs.flatMap((p) => p.items);
---
<Layout title="Концепция 24 «Вайнгарт»" description="Концепция дизайна сайта Urban210: типографский плакат в духе швейцарского панка, растровые фото и наложение красок." noindex bare>
  <Fragment slot="head">
    <style set:html={fonts} />
  </Fragment>
  <div class="wg">
    <header class="wg-top">
      <div class="wg-w wg-top-in">
        <a class="wg-logo" href="/concepts/24/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="wg-nav" aria-label="Разделы">
          <a href="#zony"><i>01</i>Зоны</a><a href="#tarify"><i>02</i>Тарифы</a><a href="#trenery"><i>03</i>Тренеры</a><a href="#otzyvy"><i>04</i>Отзывы</a><a href="#zayavka"><i>05</i>Адрес</a>
        </nav>
        <a class="wg-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="wg-btn wg-btn-s" href="#zayavka" data-lead="Заявка с сайта" data-block="24_header">Оставить заявку<Icon name="chev" /></a>
      </div>
    </header>

    <!-- Первый экран: типографский плакат -->
    <section class="wg-first" aria-labelledby="wg-h1" data-m>
      <div class="wg-w wg-first-in">
        <span class="wg-cols" aria-hidden="true">{Array.from({ length: 12 }).map(() => <i></i>)}</span>
        <p class="wg-kick"><b>Urban210</b><span>фитнес-клуб</span><span>{site.city}</span><span>{site.address.short}</span></p>

        <h1 id="wg-h1" class="wg-h1">
          <span class="a">Сила</span>
          <span class="b"><i>в</i>наборе</span>
          <span class="wg-sr">: Urban210 от {dayRate} ₽ в день</span>
        </h1>

        <div class="wg-art" aria-hidden="true">
          <span class="wg-plate wg-plate-or" data-p style="--x:-40px;--y:24px"></span>
          <figure class="wg-dt wg-dt-cy wg-por" data-p style="--x:30px;--y:-20px;--d:80ms">
            <div class="wg-ht">
              <Image src={img('/images/community/2.jpg')} alt="" widths={[360, 480, 640]} sizes="(min-width: 1000px) 30vw, 62vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
            </div>
          </figure>
          <figure class="wg-dt wg-sub" data-p style="--x:-30px;--y:30px;--d:120ms">
            <div class="wg-ht">
              <Image src={img('/images/group-strength.jpg')} alt="" widths={[320, 480]} sizes="(min-width: 1000px) 22vw, 50vw" loading="eager" format="webp" quality={40} />
            </div>
          </figure>
          <span class="wg-plate wg-plate-k" data-p style="--x:50px;--d:160ms"></span>
          <div class="wg-step wg-step-hero">
            {steps.map((i) => <span style={`--i:${i}`}>{dayRate}₽</span>)}
          </div>
          <span class="wg-reg wg-reg-1"></span>
          <span class="wg-reg wg-reg-2"></span>
          <span class="wg-vert">Хабаровск · Железнодорожный район · пр. 60-летия Октября, 210</span>
          <ul class="wg-spec">
            <li><i>Пн–Пт</i>06:30–23:30</li>
            <li><i>Сб–Вс</i>07:30–22:30</li>
            <li><i>Яндекс</i>{rating} · {site.rating.count}</li>
            <li><i>День</i>от {dayRate} ₽</li>
          </ul>
        </div>

        <div class="wg-offer">
          <p class="wg-lead">Urban210 от&nbsp;{dayRate}&nbsp;₽ в&nbsp;день по дневной карте. Зал {site.facts.area}, {site.facts.machines} {site.facts.brands}, групповые и SPA.</p>
          <div class="wg-cta">
            <a class="wg-btn" href="#tarify" data-block="24_hero">Выбрать карту<Icon name="chev" /></a>
            <a class="wg-link" href="#zayavka" data-lead="Заявка с сайта" data-block="24_hero">Оставить заявку</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Повтор со сдвигом: цена дня -->
    <section class="wg-sec wg-why" aria-labelledby="wg-why-h" data-m>
      <div class="wg-w">
        <h2 id="wg-why-h" class="wg-sr">Почему Urban210</h2>
        <div class="wg-cascade" aria-hidden="true">
          {cascade.map((t, i) => <p style={`--i:${i}`}>{t}</p>)}
        </div>
        <ol class="wg-reasons">
          {shownReasons.map((r, i) => (
            <li data-p style={`--y:30px;--d:${i * 80}ms`}>
              <span class="wg-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{r.title}</h3>
              <p>{cap(r.text)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Зоны -->
    <section class="wg-sec wg-zones-s" id="zony" aria-labelledby="wg-zones-h">
      <div class="wg-w">
        <header class="wg-shead" data-m>
          <p class="wg-mono">01 / зоны клуба</p>
          <h2 id="wg-zones-h" class="wg-h2" data-p style="--x:-30px"><span>Четыре</span> <span class="o">зоны</span></h2>
        </header>
        <div class="wg-zones">
          <a class="wz wz-zal" href={z.zal.href} data-m>
            <figure class="wg-dt wg-dt-cy wz-img" data-p style="--x:-30px;--y:20px">
              <div class="wg-ht"><Image src={img('/images/free-weights.jpg')} alt="Свободные веса в зале Urban210" widths={[480, 720, 960]} sizes="(min-width: 1000px) 52vw, 92vw" loading="lazy" format="avif" quality={45} /></div>
            </figure>
            <span class="wz-plate" data-p style="--x:40px;--d:120ms"></span>
            <span class="wz-big" aria-hidden="true">ЗАЛ</span>
            <div class="wz-tx" data-p style="--y:20px;--d:200ms">
              <h3>{z.zal.title}</h3>
              <p>{cap(z.zal.text)}</p>
              <span class="wg-more">Подробнее о зале<Icon name="chev" /></span>
            </div>
          </a>
          <a class="wz wz-cardio" href={z.cardio.href} data-m>
            <figure class="wg-dt wg-dt-or wz-img" data-p style="--x:30px;--y:-20px">
              <div class="wg-ht"><Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[400, 600, 800]} sizes="(min-width: 1000px) 34vw, 92vw" loading="lazy" format="avif" quality={45} /></div>
            </figure>
            <span class="wz-vert" aria-hidden="true">Кардио</span>
            <div class="wz-tx" data-p style="--y:20px;--d:160ms">
              <h3>{z.cardio.title}</h3>
              <p>{z.cardio.text}</p>
              <span class="wg-more">Подробнее<Icon name="chev" /></span>
            </div>
          </a>
          <a class="wz wz-group" href={z.group.href} data-m>
            <figure class="wg-dt wg-dt-k wz-img" data-p style="--x:-20px;--y:-30px">
              <div class="wg-ht"><Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале 150 м²" widths={[400, 600, 800]} sizes="(min-width: 1000px) 40vw, 92vw" loading="lazy" format="avif" quality={45} /></div>
            </figure>
            <div class="wz-tx" data-p style="--y:20px;--d:160ms">
              <h3>{z.group.title}</h3>
              <p>{cap(z.group.text)}</p>
              <ul class="wz-tags">{groupTags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </a>
          <a class="wz wz-spa" href={z.spa.href} data-m>
            <div class="wz-deg" aria-hidden="true" data-p style="--x:-40px">
              <span>40</span><span>50</span><b>°C</b>
            </div>
            <div class="wz-tx" data-p style="--y:20px;--d:140ms">
              <h3>{z.spa.title}</h3>
              <p>{z.spa.text}</p>
              <p class="wz-note">В тарифе «{plans[2].name}»</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="wg-sec wg-price" id="tarify" aria-labelledby="wg-price-h">
      <div class="wg-w">
        <header class="wg-shead" data-m>
          <p class="wg-mono">02 / тарифы · от {dayRate} ₽ в день</p>
          <h2 id="wg-price-h" class="wg-h2" data-p style="--x:-30px"><span>Три</span> <span class="o">тарифа</span></h2>
        </header>
        <div class="wg-plans" data-m>
          {plans.map((p, i) => (
            <article class={`wp wp-${p.id}`} data-p style={`--y:${30 + i * 10}px;--d:${i * 90}ms`}>
              <header>
                <span class="wg-mono">{String(i + 1).padStart(2, '0')}{p.tag ? ` · ${p.tag}` : ''}</span>
                <h3>{p.name}</h3>
                <p class="wp-h">{cap(p.hours)}</p>
              </header>
              <p class="wp-price"><b>{num(p.month)}</b><span>₽ / месяц</span></p>
              <p class="wp-year">За год {rub(p.year)}, это {perDay(p.year, 365)}&nbsp;₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="wg-btn wg-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`24_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="wg-try" data-m>
          <div class="wg-step wg-step-try" aria-hidden="true">
            {steps.map((i) => <span style={`--i:${i}`}>{dayRate}₽</span>)}
          </div>
          <span class="wg-try-plate" data-p style="--x:-60px" aria-hidden="true"></span>
          <div class="wg-try-tx" data-p style="--y:30px;--d:180ms">
            <p class="wg-mono">{plans[0].name}</p>
            <h3>{dayRate}&nbsp;₽ в&nbsp;день</h3>
            <p>{rub(plans[0].month)} в месяц. Тренажёрный зал и кардиозона {plans[0].hours}.</p>
            <ul>{plans[0].features.slice(1).map((t) => <li>{t}</li>)}</ul>
            <a class="wg-btn" href="#zayavka" data-lead="Заявка с сайта" data-block="24_day">Оставить заявку<Icon name="chev" /></a>
          </div>
        </div>

        <div class="wg-side">
          {sidePromos.map((pr, i) => (
            <article class="wg-sp" data-rise>
              <span class="wg-mono">Акция {String(i + 1).padStart(2, '0')}</span>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
              <a class="wg-link" href="#zayavka" data-lead={pr.goal} data-block={`24_promo_${pr.slug}`}>{pr.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Тренеры -->
    <section class="wg-sec wg-team" id="trenery" aria-labelledby="wg-team-h">
      <div class="wg-w">
        <header class="wg-shead" data-m>
          <p class="wg-mono">03 / тренеры клуба</p>
          <h2 id="wg-team-h" class="wg-h2" data-p style="--x:-30px"><span>Ставят</span> <span class="o">технику</span></h2>
        </header>
        <div class="wg-coaches">
          {trainers.map((t, i) => (
            <figure class={`wc wc-${i}`} data-m>
              <div class={`wg-dt ${i === 1 ? 'wg-dt-cy' : 'wg-dt-or'} wc-img`} data-p style={`--y:40px;--d:${i * 90}ms`}>
                <div class="wg-ht"><Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 1000px) 28vw, 80vw" loading="lazy" format="avif" quality={50} /></div>
              </div>
              <figcaption>
                <b>{t.name.split(' ')[1]}</b>
                <span>{t.name.split(' ')[0]}</span>
                <small>{t.role}</small>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="wg-pers" data-rise>
          <p class="wg-mono">Персональные тренировки</p>
          <p class="wg-pers-p">{personalLine}</p>
          <p class="wg-pers-t">{personal.firstFree}. Тренер поставит технику, составит программу под вашу цель и будет следить за прогрессом.</p>
          <a class="wg-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="24_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="wg-sec wg-rev" id="otzyvy" aria-labelledby="wg-rev-h">
      <div class="wg-w">
        <header class="wg-rev-head" data-m>
          <div>
            <p class="wg-mono">04 / отзывы гостей</p>
            <h2 id="wg-rev-h" class="wg-h2" data-p style="--x:-30px"><span>Слово</span> <span class="o">гостям</span></h2>
          </div>
          <a class="wg-score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-p style="--x:40px;--d:120ms">
            <span class="wg-score-n" aria-hidden="true">{[0, 1, 2].map((i) => <i style={`--i:${i}`}>{rating}</i>)}</span>
            <span class="wg-score-t"><b>{rating} из 5</b> на Яндекс Картах, {site.rating.text}</span>
          </a>
        </header>
        <div class="wg-quotes">
          {reviews.map((r, i) => (
            <blockquote class={`wq wq-${i}`} data-rise>
              <span class="wq-mark" aria-hidden="true">«</span>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="wg-final" id="zayavka" aria-labelledby="wg-final-h" data-m>
      <div class="wg-step wg-step-fin" aria-hidden="true">
        {steps.map((i) => <span style={`--i:${i}`}>{dayRate}₽</span>)}
      </div>
      <div class="wg-w wg-final-in">
        <div class="wg-final-tx">
          <p class="wg-mono">05 / заявка</p>
          <h2 id="wg-final-h" class="wg-h2"><span>Начни</span> <span>набор</span> <span class="w">сегодня</span></h2>
          <dl class="wg-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест под видеонаблюдением</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="wg-form" data-p style="--y:50px;--d:200ms">
          <span class="wg-form-plate" aria-hidden="true"></span>
          <LeadForm id="wg" block="24_final" />
        </div>
      </div>
    </section>

    <footer class="wg-foot">
      <div class="wg-w">
        <p class="wg-foot-big" aria-hidden="true">
          <span class="c">URBAN210</span><span class="o">URBAN210</span><span class="k">URBAN210<Icon name="chev" /></span>
        </p>
        <div class="wg-foot-cols">
          <div>
            <h2>Клуб</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>Клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>Документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="wg-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Блоки «печатаются» один раз при попадании в экран: плашки съезжаются, повторы букв расходятся.
  const groups = document.querySelectorAll<HTMLElement>('.wg [data-m]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) groups.forEach((g) => g.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    groups.forEach((g) => io.observe(g));
  }
</script>

<style is:global>
  body:has(.wg) { background: #f2efe8; color: #141210; color-scheme: light; overflow-x: clip; }
  body:has(.wg) ::selection { background: #00a6d6; color: #141210; }
  body:has(.wg) :focus-visible { outline: 3px solid #00a6d6; outline-offset: 3px; }
  body:has(.wg) .form { background: #f2efe8; color: #141210; --ink: #141210; --muted: #4f4943; --card: #fff; --line: #141210; border-radius: 0; border: 2px solid #141210; gap: 14px; }
