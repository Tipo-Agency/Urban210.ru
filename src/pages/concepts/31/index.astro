---
// Концепция 31 «Шеврон»: одна графическая единица на всю страницу.
// Белый лист, чёрный Onest, и только оранжевый шеврон » из логотипа: он едет по полю вместе с прокруткой
// и показывает на следующий блок, вырезает фото, служит кнопкой и курсором на десктопе.
import onCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onExt from '@fontsource-variable/onest/files/onest-latin-ext-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, personalText } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (url: string, range: string) => `@font-face{font-family:'Onest 31';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = ff(onCyr, UR) + ff(onLat, UL) + ff(onExt, 'U+20BD');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const photoZones = [
  { ...z.zal, pic: '/images/zal.jpg', alt: 'Тренажёрный зал Urban210' },
  { ...z.cardio, pic: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне' },
  { ...z.group, pic: '/images/group.jpg', alt: 'Групповая тренировка в зале' },
];
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const weekday = site.hours[0];
const weekend = site.hours[1];
---
<Layout title="Концепция 31 «Шеврон»" description="Концепция дизайна сайта Urban210: белый лист, чёрный шрифт и один оранжевый шеврон, который ведёт по странице." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={onCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="sv">
    <!-- Маска «двойной шеврон» в долях блока: пропорции знака из логотипа 17 × 16 -->
    <svg class="sv-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <clipPath id="sv-mask2" clipPathUnits="objectBoundingBox">
        <polygon points="0 0, .2118 0, .5882 .5, .2118 1, 0 1, .3765 .5" />
        <polygon points=".4118 0, .6235 0, 1 .5, .6235 1, .4118 1, .7882 .5" />
      </clipPath>
    </svg>

    <!-- Единственная графика: шеврон на поле. Едет вместе с прокруткой и смотрит на следующий блок -->
    <div class="sv-rail" aria-hidden="true" data-rail>
      <span class="sv-rail-c"><Icon name="chev" /></span>
      <span class="sv-rail-t" data-rail-t>зоны</span>
    </div>
    <div class="sv-cur" aria-hidden="true" data-cur><Icon name="chev" /></div>

    <header class="sv-top">
      <div class="sv-w sv-top-in">
        <a class="sv-logo" href="/concepts/31/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="sv-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Контакты</a>
        </nav>
        <a class="sv-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="sv-go sv-go-s" href="#zayavka" data-lead={trial.title} data-block="31_header"><span>1 ₽ пробный<span class="sv-hide-s">&nbsp;день</span></span></a>
      </div>
    </header>

    <div class="sv-main">
      <!-- Первый экран -->
      <section class="sv-first" aria-labelledby="sv-h1" data-sec="первый экран">
        <div class="sv-w sv-first-in">
          <div class="sv-first-tx">
            <p class="sv-kick">Фитнес-клуб в Хабаровске</p>
            <h1 id="sv-h1" class="sv-h1"><span>Первый</span><span>день</span><span>за 1 ₽</span></h1>
            <p class="sv-intro">Тренажёрный зал, кардио, групповые и SPA на {site.address.short}. Вступительного взноса нет.</p>
            <div class="sv-acts">
              <a class="sv-go" href="#zayavka" data-lead={trial.title} data-block="31_hero"><span>Записаться за 1 ₽</span></a>
              <a class="sv-link" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
            </div>
          </div>
          <div class="sv-mark" aria-hidden="true">
            <div class="sv-mark-in">
              <Image src={img('/images/group-strength.jpg')} alt="" widths={[480, 720, 960, 1200]} sizes="(min-width: 900px) 40vw, 90vw" loading="eager" fetchpriority="high" format="webp" quality={55} />
            </div>
          </div>
        </div>
        <dl class="sv-w sv-facts">
          <div><dt>{weekday.days}</dt><dd>{weekday.time}</dd></div>
          <div><dt>{weekend.days}</dt><dd>{weekend.time}</dd></div>
          <div><dt>Парковка</dt><dd>50 мест</dd></div>
          <div><dt>Яндекс Карты</dt><dd>{rating} из 5</dd></div>
        </dl>
      </section>

      <!-- Зоны: три фото сцеплены в один длинный шеврон -->
      <section class="sv-blk" id="zony" aria-labelledby="sv-zh" data-sec="зоны">
        <div class="sv-w">
          <div class="sv-head">
            <h2 id="sv-zh" class="sv-h2">Четыре зоны</h2>
            <p class="sv-note">{cap(site.facts.area)}, {site.facts.machines} {site.facts.brands}.</p>
          </div>
          <div class="sv-chain">
            {photoZones.map((p, i) => (
              <a class="sv-zone" href={p.href} style={`--i:${i}`}>
                <div class="sv-cut">
                  <Image src={img(p.pic)} alt={p.alt} widths={[480, 720, 960]} sizes="(min-width: 900px) 36vw, 90vw" loading="lazy" format="avif" quality={45} />
                </div>
                <div class="sv-zone-tx">
                  <span class="sv-n">0{i + 1}</span>
                  <h3>{p.title}</h3>
                  <p>{cap(p.text)}</p>
                </div>
              </a>
            ))}
          </div>
          <a class="sv-spa" href={z.spa.href}>
            <span class="sv-n">04</span>
            <h3>{z.spa.title}</h3>
            <p>{z.spa.text} В тарифе «{plans[2].name}».</p>
          </a>
        </div>
      </section>

      <!-- Тарифы -->
      <section class="sv-blk sv-blk-line" id="tarify" aria-labelledby="sv-ph" data-sec="тарифы">
        <div class="sv-w">
          <div class="sv-head">
            <h2 id="sv-ph" class="sv-h2">Три абонемента</h2>
            <p class="sv-note">Помесячно или за год. Вступительного взноса нет ни в одном.</p>
          </div>
          <div class="sv-plans">
            {plans.map((p, i) => (
              <article class={`sv-plan${i === 1 ? ' is-main' : ''}`}>
                <div class="sv-plan-h">
                  <h3>{p.name}</h3>
                  {p.tag && <span>{p.tag}</span>}
                </div>
                <p class="sv-plan-hours">{cap(p.hours)}</p>
                <p class="sv-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
                <p class="sv-year">За год {rub(p.year)}, {perDay(p.year, 365)} ₽ в день</p>
                <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
                {p.excluded && <p class="sv-no">Не входит: {p.excluded.map((x) => x.toLowerCase()).join(', ')}</p>}
                <a class={`sv-go sv-go-w${i === 1 ? '' : ' sv-go-k'}`} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`31_plan_${p.id}`}><span>Выбрать</span></a>
              </article>
            ))}
          </div>

          <div class="sv-trial">
            <p class="sv-one" aria-hidden="true">1 ₽</p>
            <div class="sv-trial-tx">
              <h3>{trial.title}</h3>
              <p>{trial.text}</p>
              <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
              <a class="sv-go" href="#zayavka" data-lead={trial.title} data-block="31_trial"><span>{trialPromo.cta}</span></a>
            </div>
          </div>

          <div class="sv-offers">
            {[tradein, friend].map((pr) => (
              <div class="sv-offer">
                <h3>{pr.title}</h3>
                <p>{pr.text}</p>
                <a class="sv-link" href="#zayavka" data-lead={pr.goal} data-block={`31_promo_${pr.slug}`}>{pr.cta}</a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Тренеры -->
      <section class="sv-blk sv-blk-line" id="trenery" aria-labelledby="sv-th" data-sec="тренеры">
        <div class="sv-w">
          <div class="sv-head">
            <h2 id="sv-th" class="sv-h2">Тренеры</h2>
            <p class="sv-note">{personalText.lead}</p>
          </div>
          <div class="sv-team">
            {trainers.map((t) => (
              <figure class="sv-coach">
                <div class="sv-cut sv-cut-t">
                  <Image src={img(t.photo)} alt={t.name} widths={[360, 540, 720]} sizes="(min-width: 900px) 28vw, 80vw" loading="lazy" format="avif" quality={50} />
                </div>
                <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
              </figure>
            ))}
          </div>
          <div class="sv-pt">
            <p><b>{personalLine}</b>{personal.firstFree}.</p>
            <a class="sv-link" href="#zayavka" data-lead="Персональная тренировка" data-block="31_personal">Записаться к тренеру</a>
          </div>
        </div>
      </section>

      <!-- Отзывы -->
      <section class="sv-blk sv-blk-line" id="otzyvy" aria-labelledby="sv-rh" data-sec="отзывы">
        <div class="sv-w sv-rev">
          <div class="sv-rate">
            <h2 id="sv-rh" class="sv-h2">Отзывы</h2>
            <p class="sv-rate-n">{rating}</p>
            <p class="sv-note">{site.rating.text} на Яндекс Картах и в 2ГИС</p>
            <a class="sv-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать на Яндекс Картах</a>
          </div>
          <div class="sv-quotes">
            {reviews.map((r) => (
              <blockquote class="sv-q">
                <p>{r.text}</p>
                <footer>{r.name}, {r.source}</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>

      <!-- Заявка -->
      <section class="sv-blk sv-blk-line sv-end" id="zayavka" aria-labelledby="sv-eh" data-sec="заявка" data-aim>
        <div class="sv-w sv-end-in">
          <div class="sv-end-tx">
            <h2 id="sv-eh" class="sv-h2">Приходите на&nbsp;пробный день</h2>
            <dl class="sv-addr">
              <div><dt>Адрес</dt><dd>{site.address.short}<br />{site.district}</dd></div>
              <div><dt>Часы</dt><dd>{weekday.days} {weekday.time}<br />{weekend.days} {weekend.time}</dd></div>
              <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
              <div><dt>Парковка</dt><dd>{site.parking.replace('Бесплатная парковка', 'Бесплатно')}</dd></div>
            </dl>
            <p class="sv-msg">
              <a href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener">WhatsApp</a>
              <a href={telegramLink('site_31')} target="_blank" rel="noopener">Telegram</a>
              <a href={site.maps.yandex} target="_blank" rel="noopener">Яндекс Карты</a>
              <a href={site.maps.twoGis} target="_blank" rel="noopener">2ГИС</a>
            </p>
          </div>
          <div class="sv-form">
            <LeadForm id="sv" block="31_final" />
          </div>
        </div>
      </section>
    </div>

    <footer class="sv-foot">
      <div class="sv-w">
        <p class="sv-word" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="sv-foot-g">
          <p>{site.fullName}<br />{site.address.locality}, {site.address.street}</p>
          <nav aria-label="Страницы">
            <a href="/price/">Тарифы</a><a href="/zal/">Тренажёрный зал</a><a href="/group/">Групповые</a><a href="/spa/">SPA</a><a href="/trainers/">Тренеры</a><a href="/promo/">Акции</a>
          </nav>
          <nav aria-label="Документы">
            <a href="/rules/">Правила клуба</a><a href="/oferta/">Договор-оферта</a><a href="/policy/">Политика конфиденциальности</a><a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
          </nav>
          <p><a href={site.phone.href}>{site.phone.display}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <p class="sv-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Шеврон на поле: высота = доля прокрутки, поворот вниз на следующий блок, вправо на форму.
  // Курсор-шеврон только для мыши. Всё отключается при prefers-reduced-motion.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const label = document.querySelector<HTMLElement>('[data-rail-t]');
  const cur = document.querySelector<HTMLElement>('[data-cur]');
  const secs = [...document.querySelectorAll<HTMLElement>('.sv [data-sec]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rail && label) {
    let raf = 0;
    const paint = () => {
      raf = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const mid = innerHeight * 0.5;
      let i = secs.findIndex((s) => s.getBoundingClientRect().top > mid);
      const aim = secs.find((s) => s.hasAttribute('data-aim'));
      const r = aim?.getBoundingClientRect();
      const atForm = !!r && r.top < mid && r.bottom > mid * 0.6;
      if (i === -1) i = secs.length - 1;
      label.textContent = atForm ? 'заявка' : secs[i].dataset.sec || '';
      rail.style.setProperty('--p', p.toFixed(4));
      rail.classList.toggle('is-aim', atForm);
    };
    const on = () => { if (!raf) raf = requestAnimationFrame(paint); };
    addEventListener('scroll', on, { passive: true });
    addEventListener('resize', on);
    paint();
    requestAnimationFrame(() => rail.classList.add('is-on'));
  }

  if (cur && !reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.documentElement.classList.add('sv-has-cur');
    let x = -100, y = -100, raf = 0;
    const move = () => { raf = 0; cur.style.transform = `translate3d(${x}px, ${y}px, 0)`; };
    addEventListener('pointermove', (e) => {
      x = e.clientX; y = e.clientY;
      const t = e.target as HTMLElement;
      cur.classList.toggle('is-link', !!t.closest('a, button, label, summary'));
      cur.classList.toggle('is-text', !!t.closest('input, textarea'));
      cur.classList.add('is-on');
      if (!raf) raf = requestAnimationFrame(move);
    }, { passive: true });
    document.addEventListener('pointerleave', () => cur.classList.remove('is-on'));
  }
</script>

<style is:global>
  body:has(.sv) { padding-bottom: 0; background: #fff; color: #0b0b0b; color-scheme: light; font-family: 'Onest 31', 'Helvetica Neue', Arial, sans-serif; }
  body:has(.sv) ::selection { background: #ff5722; color: #0b0b0b; }
  body:has(.sv) :focus-visible { outline: 2px solid #0b0b0b; outline-offset: 4px; border-radius: 0; }
  html.sv-has-cur body:has(.sv) .sv, html.sv-has-cur body:has(.sv) .sv * { cursor: none; }
  html.sv-has-cur body:has(.sv) .sv input { cursor: text; }
  body:has(.sv dialog[open]) .sv-cur, body:has(dialog.lead[open]) .sv-cur { display: none; }

  body:has(.sv) .form { background: #fff; color: #0b0b0b; --ink: #0b0b0b; --muted: #5c5c5c; --card: #fff; --line: #0b0b0b; border-radius: 0; padding: 0; gap: 24px; font-family: 'Onest 31', Arial, sans-serif; }
  body:has(.sv) .form h3 { font-family: inherit; font-weight: 650; font-size: 1.75rem; line-height: 1.1; letter-spacing: -0.03em; }
  body:has(.sv) .form .muted { color: #5c5c5c; font-size: 1rem !important; margin-top: -16px; }
  body:has(.sv) .form .field { color: #0b0b0b; font-size: 0.875rem; font-weight: 500; gap: 4px; }
  body:has(.sv) .form .field input { border: 0; border-bottom: 1px solid #0b0b0b; border-radius: 0; padding: 0; min-height: 48px; background: transparent; font-size: 1.25rem; }
  body:has(.sv) .form .field input::placeholder { color: #9a9a9a; }
  body:has(.sv) .form .field input:focus { border-bottom-color: #ff5722; box-shadow: inset 0 -1px 0 #ff5722; }
  body:has(.sv) .form .field .err, body:has(.sv) .form .consent.bad { color: #c2300a; }
  body:has(.sv) .form .field.bad input { border-bottom-color: #c2300a; }
  body:has(.sv) .form .consent { color: #5c5c5c; font-size: 0.875rem; }
  body:has(.sv) .form .consent input { accent-color: #0b0b0b; }
  body:has(.sv) .form .btn {
    border-radius: 0; background: #ff5722; color: #0b0b0b; font-family: inherit; font-weight: 600; font-size: 1.125rem; min-height: 64px;
    clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 50%, calc(100% - 32px) 100%, 0 100%, 32px 50%); padding: 0 56px; justify-content: flex-start;
  }
  body:has(.sv) .form .btn .chev { display: none; }
  body:has(.sv) .form .btn:hover { background: #0b0b0b; color: #fff; }
  body:has(.sv) .form .form-note { text-align: left; color: #5c5c5c; margin-top: -8px; }
  body:has(.sv) .form .form-note a { color: #0b0b0b; }
  body:has(.sv) .form .form-msg.is-err { border-radius: 0; background: #fff0eb; color: #9c2607; }
  body:has(.sv) .form .form-done { text-align: left; padding: 0; }
  body:has(.sv) .form .form-done .ok { margin: 0; background: #ff5722; color: #0b0b0b; border-radius: 0; clip-path: polygon(0 0, 50% 0, 100% 50%, 50% 100%, 0 100%, 50% 50%); }
  body:has(.sv) dialog.lead::backdrop { background: rgb(255 255 255 / 0.9); backdrop-filter: none; }
  body:has(.sv) dialog.lead .form { border: 1px solid #0b0b0b; padding: 40px 32px 32px; box-shadow: none; }
  body:has(.sv) dialog.lead .x { color: #0b0b0b; top: 12px; right: 12px; }
  body:has(.sv) .mbar { background: #fff; border-top: 1px solid #0b0b0b; backdrop-filter: none; }
  body:has(.sv) .mbar a.ic { border-radius: 0; border: 1px solid #0b0b0b; color: #0b0b0b; }
  body:has(.sv) .mbar .btn {
    border-radius: 0; background: #ff5722; color: #0b0b0b; font-family: inherit; font-weight: 600; font-size: 1rem; justify-content: flex-start;
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 50%, calc(100% - 22px) 100%, 0 100%, 22px 50%); padding: 0 30px 0 34px; white-space: nowrap; font-size: 0.9375rem;
  }
  body:has(.sv) .mbar .btn .chev { display: none; }
</style>

<style>
  .sv {
    --ink: #0b0b0b; --mute: #5c5c5c; --line: #0b0b0b; --or: #ff5722; --bg: #fff;
    --f: 'Onest 31', 'Helvetica Neue', Arial, sans-serif;
    --ez: cubic-bezier(0.2, 0.8, 0.2, 1);
    /* шкала отступов 8 */
    --s1: 8px; --s2: 16px; --s3: 24px; --s4: 32px; --s5: 48px; --s6: 64px; --s7: 96px; --s8: 128px;
    --gut: clamp(24px, 5.56vw, 80px);
    --blk: clamp(96px, 8.9vw, 128px);
    /* шкала размеров */
    --t-xs: 0.875rem; --t-s: 1.0625rem; --t-m: clamp(1.1875rem, 1rem + 0.45vw, 1.5rem);
    --t-l: clamp(2rem, 1.4rem + 1.9vw, 3.5rem); --t-xl: clamp(3rem, 1.8rem + 4.6vw, 6.5rem); --t-xxl: clamp(4.75rem, 1.2rem + 12vw, 11.5rem);
    background: var(--bg); color: var(--ink); font-family: var(--f); font-size: var(--t-s); line-height: 1.5;
    position: relative; overflow-x: clip;
  }
