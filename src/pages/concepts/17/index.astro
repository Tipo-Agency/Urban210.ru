---
// Концепция 17 «Обложка»: сайт как глянцевый журнал. Первый экран сверстан как обложка
// (огромный мастхед URBAN210 в Cormorant, анонсы вокруг кадрированного портрета), дальше
// развороты с колонтитулами и номерами страниц. Цветные фото в тёплой обработке,
// медленное раскрытие кадров и лёгкий параллакс без библиотек.
import { Image } from 'astro:assets';
import corCyr from '@fontsource-variable/cormorant/files/cormorant-cyrillic-wght-normal.woff2?url';
import corLat from '@fontsource-variable/cormorant/files/cormorant-latin-wght-normal.woff2?url';
import corCyrI from '@fontsource-variable/cormorant/files/cormorant-cyrillic-wght-italic.woff2?url';
import corLatI from '@fontsource-variable/cormorant/files/cormorant-latin-wght-italic.woff2?url';
import jostCyr from '@fontsource-variable/jost/files/jost-cyrillic-wght-normal.woff2?url';
import jostLat from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos } from '../../../data/content';

const CYR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const LAT = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+20BD,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (fam: string, style: string, w: string, url: string, range: string) =>
  `@font-face{font-family:'${fam}';font-style:${style};font-display:swap;font-weight:${w};src:url(${url}) format('woff2');unicode-range:${range}}`;
// Запасной шрифт с метриками Cormorant: меньше прыжков вёрстки, пока грузится настоящий
const fonts = [
  face('Cormorant c', 'normal', '300 700', corCyr, CYR),
  face('Cormorant c', 'normal', '300 700', corLat, LAT),
  face('Cormorant c', 'italic', '300 700', corCyrI, CYR),
  face('Cormorant c', 'italic', '300 700', corLatI, LAT),
  face('Jost c', 'normal', '300 700', jostCyr, CYR),
  face('Jost c', 'normal', '300 700', jostLat, LAT),
  `@font-face{font-family:'Cormorant fb';src:local('Times New Roman'),local('TimesNewRomanPSMT'),local('Georgia');size-adjust:90%;ascent-override:103%;descent-override:32%;line-gap-override:0%}`,
  `@font-face{font-family:'Jost fb';src:local('Futura'),local('Century Gothic'),local('Arial');size-adjust:96%;ascent-override:110%;descent-override:37%;line-gap-override:0%}`,
].join('');

const rating = site.rating.value.toString().replace('.', ',');
const [day, full, all] = plans;
const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const roman = ['I', 'II', 'III', 'IV'];
const dayRate = perDay(plans[0].month, 30);
const personalLine = `${personal.pack} тренировок, ${rub(personal.price)}`;
const mast = 'URBAN210'.split('');
const year = new Date().getFullYear();

// Штрихкод на обложке: детерминированный, чисто декоративный
const bars: { x: number; w: number }[] = [];
{
  let x = 0, s = 210;
  while (x < 118) {
    s = (s * 9301 + 49297) % 233280;
    const w = 1 + (s % 3);
    bars.push({ x, w });
    x += w + 1 + ((s >> 3) % 3);
  }
}

const contents = [
  { n: '04', href: '#zony', t: 'Зоны клуба', s: 'Зал, кардио, групповые, SPA' },
  { n: '12', href: '#abonementy', t: 'Абонементы', s: `Три карты, от ${dayRate} ₽ в день` },
  { n: '18', href: '#komanda', t: 'Команда', s: 'Тренеры клуба' },
  { n: '22', href: '#golosa', t: 'Голоса', s: 'Отзывы гостей' },
  { n: '26', href: '#zapis', t: 'Запись', s: 'Заявка и адрес' },
];
const planMeta = [
  { p: day, tag: 'Утро и день' },
  { p: full, tag: full.tag! },
  { p: all, tag: all.tag! },
];
---
<Layout title="Концепция 17 «Обложка»" description="Концепция дизайна сайта Urban210: глянцевый журнал, первый экран как обложка." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={corCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="cv">
    <!-- Липкая шапка появляется, когда обложка уехала -->
    <header class="cv-bar" data-cv-bar>
      <div class="cv-w cv-bar-in">
        <a class="cv-logo" href="/concepts/17/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="cv-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#abonementy">Абонементы</a><a href="#komanda">Команда</a><a href="#golosa">Отзывы</a><a href="#zapis">Контакты</a>
        </nav>
        <a class="cv-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="cv-btn cv-btn-s" href="#zapis" data-lead="Заявка с сайта" data-block="17_bar">Оставить заявку</a>
      </div>
    </header>

    <main>
      <!-- Обложка -->
      <section class="cv-cover" aria-labelledby="cv-h1">
        <div class="cv-w">
          <div class="cv-top">
            <nav class="cv-top-nav" aria-label="Основное меню">
              <a href="#zony">Зоны</a><a href="#abonementy">Абонементы</a><a href="#komanda">Команда</a><a href="#golosa">Отзывы</a>
            </nav>
            <p class="cv-issue">Выпуск № 210 <span>Осень {year}</span></p>
            <div class="cv-top-r">
              <a class="cv-tel" href={site.phone.href}>{site.phone.display}</a>
              <a class="cv-btn cv-btn-s" href="#zapis" data-lead="Заявка с сайта" data-block="17_header">Оставить заявку</a>
            </div>
          </div>
          <p class="cv-dateline" aria-hidden="true">
            <span>Хабаровск</span><span class="d-only">Железнодорожный район</span><span class="d-only">Зал · Кардио · Групповые · SPA</span><span>Цена дня {dayRate} ₽</span>
          </p>
          <p class="cv-mast" aria-hidden="true">
            {mast.map((ch, i) => <span class="cv-mast-l"><span style={`--i:${i}`}>{ch}</span></span>)}<span class="cv-mast-l cv-mast-chev"><span style="--i:8"><Icon name="chev" /></span></span>
          </p>
        </div>

        <div class="cv-w cv-cover-grid">
          <div class="cv-hl">
            <p class="cv-kick">Главная тема номера</p>
            <h1 id="cv-h1" class="cv-h1"><span class="sr">Фитнес-клуб Urban210 в Хабаровске. </span>Каждый день <em>от&nbsp;{dayRate}&nbsp;₽</em></h1>
          </div>

          <figure class="cv-cover-ph">
            <div class="cv-cover-frame">
              <Image src={img('/images/community/13.jpg')} alt="Гостья клуба в функциональной зоне Urban210" widths={[420, 600]} sizes="(min-width: 1100px) 460px, calc(100vw - 32px)" loading="eager" fetchpriority="high" format="webp" quality={62} />
            </div>
            <figcaption><span>На обложке</span> функциональная зона клуба</figcaption>
          </figure>

          <div class="cv-hb">
            <p class="cv-dek">{day.name} за {rub(day.month)} в месяц: тренажёрный зал и кардиозона {day.hours}. Это около {dayRate}&nbsp;₽ в&nbsp;день.</p>
            <div class="cv-cta">
              <a class="cv-btn" href="#abonementy" data-block="17_hero">Выбрать карту <Icon name="chev" /></a>
              <a class="cv-link" href="#zapis" data-lead="Заявка с сайта" data-block="17_hero">Оставить заявку</a>
            </div>
            <p class="cv-line cv-line-l"><b>1300 м²</b><span>{site.facts.machines} {site.facts.brands}, {site.facts.freeWeights}</span></p>
          </div>

          <div class="cv-r">
            <a class="cv-rate" href={site.maps.yandexReviews} target="_blank" rel="noopener">
              <b>{rating}</b><span>{site.rating.text}<br />на Яндекс Картах</span>
            </a>
            <p class="cv-line"><b>Сауна и хаммам</b><span>после тренировки, в&nbsp;тарифе «Всё включено»</span></p>
            <p class="cv-line"><b>06:30</b><span>открываемся по будням, в&nbsp;выходные в&nbsp;07:30</span></p>
            <p class="cv-line"><b>50 мест</b><span>бесплатной парковки под видеонаблюдением</span></p>
            <div class="cv-code" aria-hidden="true">
              <svg viewBox="0 0 120 40" preserveAspectRatio="none">{bars.map((b) => <rect x={b.x} y="0" width={b.w} height="40" />)}</svg>
              <span>4 607210 210210</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Содержание и письмо редакции -->
      <section class="cv-sec cv-toc" aria-labelledby="cv-toc-h">
        <div class="cv-w">
          <div class="cv-folio"><span>URBAN210</span><span>Содержание</span><span>02</span></div>
          <div class="cv-toc-grid">
            <div class="cv-toc-list">
              <h2 id="cv-toc-h" class="cv-h2" data-rise>Содержание</h2>
              <ol>
                {contents.map((c) => (
                  <li data-rise><a href={c.href}><span class="cv-pg">{c.n}</span><span class="cv-toc-t">{c.t}<i>{c.s}</i></span></a></li>
                ))}
              </ol>
            </div>
            <div class="cv-letter" data-rise>
              <p class="cv-kick">Письмо редакции</p>
              <p class="cv-letter-lead">Клуб, в котором есть место. Тренажёрам, дорожкам, тишине после работы.</p>
              <div class="cv-letter-txt">
                <p class="cv-drop">Urban210 стоит на {site.address.short}, в Железнодорожном районе Хабаровска. Это {site.facts.area}: {site.facts.machines} {site.facts.brands}, {site.facts.freeWeights}, {site.facts.groupHall}, финская сауна и хаммам.</p>
                <p>По будням открываемся в 06:30 и работаем до 23:30, в выходные с 07:30 до 22:30. У входа бесплатная парковка на 50 мест.</p>
                <p>Начать проще всего с дневной карты: {rub(day.month)} в месяц, около {dayRate} ₽ в день.</p>
              </div>
              <p class="cv-sign">Редакция Urban210</p>
            </div>
            <figure class="cv-ph cv-toc-ph px" data-rise>
              <div class="pi"><Image src={img('/images/community/11.jpg')} alt="Гостья клуба у тренировочной шины в солнечном зале" widths={[360, 600]} sizes="(min-width: 1100px) 360px, 80vw" format="avif" quality={50} loading="lazy" /></div>
              <figcaption><span>с. 03</span> Утро в зале, свет с запада</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- Зоны -->
      <section class="cv-sec cv-zones" id="zony" aria-labelledby="cv-zones-h">
        <div class="cv-w">
          <div class="cv-folio"><span>URBAN210</span><span>Зоны клуба</span><span>04</span></div>
          <h2 id="cv-zones-h" class="cv-h2 cv-h2-xl" data-rise>Клуб <em>в&nbsp;четырёх частях</em></h2>

          <article class="cv-z cv-z1">
            <figure class="cv-ph px warm" data-rise>
              <div class="pi"><Image src={img(zal.image!)} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 800, 1100]} sizes="(min-width: 1100px) 760px, 100vw" format="avif" quality={48} loading="lazy" /></div>
            </figure>
            <div class="cv-z-txt" data-rise>
              <p class="cv-num">{roman[0]}</p>
              <h3>{zal.title}</h3>
              <p>{zal.text}</p>
              <a class="cv-link" href={zal.href}>Смотреть зал</a>
            </div>
          </article>

          <article class="cv-z cv-z2">
            <figure class="cv-ph cv-z2-detail px warm" data-rise>
              <div class="pi"><Image src={img('/images/free-weights.jpg')} alt="Гантели на стойке в зоне свободных весов" widths={[360, 600]} sizes="(min-width: 1100px) 300px, 50vw" format="avif" quality={48} loading="lazy" /></div>
              <figcaption><span>Деталь</span> свободные веса до 60 кг</figcaption>
            </figure>
            <figure class="cv-ph cv-z2-main px warm" data-rise>
              <div class="pi"><Image src={img(cardio.image!)} alt="Ряд беговых дорожек в кардиозоне" widths={[400, 700, 1000]} sizes="(min-width: 1100px) 440px, 100vw" format="avif" quality={48} loading="lazy" /></div>
            </figure>
            <div class="cv-z-txt" data-rise>
              <p class="cv-num">{roman[1]}</p>
              <h3>{cardio.title}</h3>
              <p>{cardio.text}</p>
              <a class="cv-link" href={cardio.href}>О кардиозоне</a>
            </div>
          </article>

          <article class="cv-z cv-z3">
            <figure class="cv-ph px warm" data-rise>
              <div class="pi"><Image src={img(group.image!)} alt="Групповая тренировка в зале 150 м²" widths={[600, 1000, 1400]} sizes="(min-width: 1100px) 1200px, 100vw" format="avif" quality={48} loading="lazy" /></div>
            </figure>
            <div class="cv-z-txt" data-rise>
              <p class="cv-num">{roman[2]}</p>
              <h3>{group.title}</h3>
              <p>{group.text}</p>
              <a class="cv-link" href={group.href}>Расписание и направления</a>
            </div>
          </article>

          <article class="cv-z cv-z4" data-rise>
            <p class="cv-num">{roman[3]}</p>
            <h3 class="cv-z4-h">{spa.title}</h3>
            <p class="cv-z4-q"><em>{spa.text}</em></p>
            <p class="cv-z4-note">Входит в тариф «{all.name}» · <a class="cv-link" href={spa.href}>Подробнее о SPA</a></p>
          </article>
        </div>
      </section>

      <!-- Цитата -->
      <section class="cv-sec cv-quote" aria-label="Цитата из отзыва">
        <div class="cv-w cv-quote-grid">
          <figure class="cv-ph cv-quote-ph px" data-rise>
            <div class="pi"><Image src={img('/images/community/9.jpg')} alt="Гость клуба на тренажёре для пресса" widths={[360, 600]} sizes="(min-width: 1100px) 380px, 70vw" format="avif" quality={50} loading="lazy" /></div>
            <figcaption><span>с. 10</span> Вечер буднего дня</figcaption>
          </figure>
          <blockquote class="cv-quote-txt" data-rise>
            <p>«Много пространства, нет очередей к&nbsp;тренажёрам.»</p>
            <footer>{reviews[0].name} · {reviews[0].source}</footer>
          </blockquote>
        </div>
      </section>

      <!-- Абонементы -->
      <section class="cv-sec cv-prices" id="abonementy" aria-labelledby="cv-pr-h">
        <div class="cv-w">
          <div class="cv-folio"><span>URBAN210</span><span>Абонементы</span><span>12</span></div>
          <div class="cv-pr-head">
            <h2 id="cv-pr-h" class="cv-h2 cv-h2-xl" data-rise>Абонементы <em>сезона</em></h2>
            <p class="cv-pr-note" data-rise>Цены за месяц и за год. Дневная карта выходит около {dayRate}&nbsp;₽ в&nbsp;день.</p>
          </div>
          <div class="cv-plans">
            {planMeta.map(({ p, tag }, i) => (
              <article class={`cv-plan${p.id === 'full' ? ' is-pop' : ''}`} data-rise style={`--d:${i * 120}ms`}>
                <p class="cv-plan-top"><span class="cv-num">{roman[i]}</span><span class="cv-plan-tag">{tag}</span></p>
                <h3>{p.name}</h3>
                <p class="cv-plan-hours"><em>{p.hours}</em></p>
                <p class="cv-plan-price"><b>{rub(p.month).replace(/\s₽$/, '')}</b><span>₽ в месяц</span></p>
                <p class="cv-plan-year">{rub(p.year)} за год, около {perDay(p.year, 365)} ₽ в день</p>
                <ul>
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
                {p.excluded && <p class="cv-plan-ex">Не входит: {p.excluded.join(', ').toLowerCase()}</p>}
                <a class={`cv-btn ${p.id === 'full' ? '' : 'cv-btn-o'} cv-btn-w`} href="#zapis" data-lead={`Абонемент «${p.name}»`} data-block={`17_plan_${p.id}`}>Выбрать <Icon name="chev" /></a>
              </article>
            ))}
          </div>
        </div>

        <div class="cv-gift" id="dnevnaya">
          <div class="cv-w cv-gift-grid">
            <p class="cv-gift-n" data-rise aria-hidden="true">{dayRate}<span>₽</span></p>
            <div class="cv-gift-txt" data-rise>
              <p class="cv-kick">Цена номера</p>
              <h3>{day.name}: {dayRate}&nbsp;₽ в&nbsp;день</h3>
              <p>{rub(day.month)} в месяц. Тренажёрный зал и кардиозона {day.hours}, без вечерних часов.</p>
              <ul>{day.features.map((t) => <li>{t}</li>)}</ul>
              <a class="cv-btn cv-btn-i" href="#zapis" data-lead="Заявка с сайта" data-block="17_day">Оставить заявку <Icon name="chev" /></a>
            </div>
          </div>
        </div>

        <div class="cv-w cv-also">
          <p class="cv-kick">Также в номере</p>
          <div class="cv-also-grid">
            {[tradein, friend].map((pr, i) => (
              <article class="cv-also-i" data-rise>
                <span class="cv-pg">{i === 0 ? '14' : '16'}</span>
                <div>
                  <h3>{pr.title}</h3>
                  <p>{pr.text}</p>
                  <a class="cv-link" href="#zapis" data-lead={pr.goal} data-block={`17_promo_${pr.slug}`}>{pr.cta}</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Команда -->
      <section class="cv-sec cv-team" id="komanda" aria-labelledby="cv-team-h">
        <div class="cv-w">
          <div class="cv-folio"><span>URBAN210</span><span>Команда</span><span>18</span></div>
          <div class="cv-team-head">
            <h2 id="cv-team-h" class="cv-h2 cv-h2-xl" data-rise>Лица <em>клуба</em></h2>
            <div class="cv-team-pt" data-rise>
              <p class="cv-kick">Персональные тренировки</p>
              <p>{personalLine}. {personal.firstFree}.</p>
              <a class="cv-link" href="#zapis" data-lead="Персональная тренировка" data-block="17_personal">Подобрать тренера</a>
            </div>
          </div>
          <div class="cv-team-grid">
            {trainers.map((t, i) => (
              <figure class="cv-tr" style={`--o:${[0, 1, 0.45][i]}`}>
                <div class="cv-ph px" data-rise>
                  <div class="pi"><Image src={img(t.photo)} alt={t.name} widths={[360, 600]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 33vw, 80vw" format="avif" quality={50} loading="lazy" /></div>
                </div>
                <figcaption data-rise>
                  <span class="cv-pg">{String(18 + i).padStart(2, '0')}</span>
                  <b>{t.name}</b>
                  <em>{t.role}</em>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- Отзывы -->
      <section class="cv-sec cv-voices" id="golosa" aria-labelledby="cv-v-h">
        <div class="cv-w">
          <div class="cv-folio"><span>URBAN210</span><span>Голоса</span><span>22</span></div>
          <div class="cv-v-grid">
            <div class="cv-v-side" data-rise>
              <h2 id="cv-v-h" class="cv-h2 cv-h2-xl">Голоса</h2>
              <p class="cv-v-rate"><b>{rating}</b><span>из 5 на Яндекс Картах,<br />{site.rating.text}</span></p>
              <a class="cv-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать все отзывы</a>
            </div>
            <div class="cv-v-list">
              {reviews.map((r) => (
                <blockquote class="cv-rv" data-rise>
                  <p>{r.text}</p>
                  <footer><b>{r.name}</b><span>{r.source}</span></footer>
                </blockquote>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Запись -->
      <section class="cv-sec cv-join" id="zapis" aria-labelledby="cv-j-h">
        <div class="cv-w">
          <div class="cv-folio"><span>URBAN210</span><span>Запись</span><span>26</span></div>
          <div class="cv-join-grid">
            <div class="cv-join-l">
              <h2 id="cv-j-h" class="cv-h2 cv-h2-xl" data-rise>Приходите <em>в&nbsp;клуб</em></h2>
              <p class="cv-join-lead" data-rise>Оставьте имя и телефон. Администратор перезвонит, поможет выбрать карту и встретит вас в клубе.</p>
