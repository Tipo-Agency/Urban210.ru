      linear-gradient(var(--c) 0 0) 0 100% / var(--l) 2px, linear-gradient(var(--c) 0 0) 0 100% / 2px var(--l),
      linear-gradient(var(--c) 0 0) 100% 100% / var(--l) 2px, linear-gradient(var(--c) 0 0) 100% 100% / 2px var(--l);
