---
// Концепция 16 «Игрок»: интерфейс игры. HUD-рамки с уголками, полосы характеристик, выбор класса вместо тарифов,
// тренеры как напарники, дневная карта как стартовый уровень, всплывающие достижения.
// Все цифры из src/data: часы, цены, зоны и перки тарифов. Движение: HUD «загружается», полосы заполняются. Без звука.
import '@fontsource-variable/tektur/standard.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos } from '../../../data/content';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, '\u00a0');
const dec = (n: number) => String(n).replace('.', ',');
const rating = dec(site.rating.value);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Часы в день: дневная карта из её интервала, остальные из будних часов клуба
const span = (s: string) => {
  const t = [...s.matchAll(/(\d{1,2}):(\d{2})/g)].map((m) => Number(m[1]) * 60 + Number(m[2]));
  return (t[1] - t[0]) / 60;
};
const clubDay = span(site.hours[0].time);
const hoursOf = (id: string) => (id === 'day' ? span(plans[0].hours) : clubDay);

// Перки собраны из features и excluded в pricing.ts
const perks: [string, number, number, number][] = [
  ['Тренажёрный зал и кардиозона', 1, 1, 1],
  ['Фитнес-тестирование', 1, 1, 1],
  ['Раздевалки, душевые, парковка', 1, 1, 1],
  ['Вечернее время', 0, 1, 1],
  ['Пробная тренировка с тренером', 0, 1, 1],
  ['Групповые программы', 0, 0, 1],
  ['SPA: сауна, хаммам, релакс-зона', 0, 0, 1],
  ['Приоритетное обслуживание', 0, 0, 1],
];
const zoneAccess: Record<string, number[]> = { zal: [1, 1, 1], cardio: [1, 1, 1], group: [0, 0, 1], spa: [0, 0, 1] };
const zonesIn = (i: number) => Object.values(zoneAccess).filter((a) => a[i]).length;
const archetype = ['Ранний старт', 'Универсал', 'Без ограничений'];
const short = ['Дневная', 'Полный', 'Всё вкл.'];
const classes = plans.map((p, i) => {
  const h = hoursOf(p.id);
  const pk = perks.filter((r) => r[i + 1]).length;
  const zn = zonesIn(i);
  return {
    ...p, i, arch: archetype[i],
    stats: [
      { k: 'Время', v: `${dec(h)} ч в день`, f: h / clubDay, seg: 0 },
      { k: 'Зоны', v: `${zn} из 4`, f: zn / 4, seg: 4, on: zn },
      { k: 'Перки', v: `${pk} из ${perks.length}`, f: pk / perks.length, seg: perks.length, on: pk },
    ],
  };
});
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const zoneCards = [
  { ...z.zal, photo: '/images/zal.jpg', alt: 'Тренажёрный зал Urban210' },
  { ...z.cardio, photo: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне' },
  { ...z.group, photo: '/images/group.jpg', alt: 'Групповая тренировка' },
  { ...z.spa, photo: null, alt: '' },
];
const dayRate = perDay(plans[0].month, 30);
const quests = promos.filter((p) => ['trade-in', '1-plus-1'].includes(p.slug));
const personalLine = `${personal.pack} тренировок · ${rub(personal.price)}`;
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
---
<Layout title="Концепция 16 «Игрок»" description={`Концепция дизайна сайта Urban210: интерфейс игры, выбор класса вместо тарифов, напарники и дневная карта от ${dayRate} ₽ в день.`} noindex bare>
  <div class="gm">
    <header class="gm-top">
      <div class="gm-w gm-top-in">
        <a class="gm-logo" href="/concepts/16/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="gm-nav" aria-label="Разделы">
          <a href="#lokacii"><kbd>1</kbd>Локации</a>
          <a href="#klassy"><kbd>2</kbd>Классы</a>
          <a href="#naparniki"><kbd>3</kbd>Напарники</a>
          <a href="#otzyvy"><kbd>4</kbd>Отзывы</a>
          <a href="#baza"><kbd>5</kbd>База</a>
        </nav>
        <p class="gm-status" data-status><i></i><span data-status-t>{site.hours[0].days} {site.hours[0].time}</span></p>
        <a class="gm-btn gm-btn-s" href="#baza" data-lead="Заявка с сайта" data-block="16_header">Оставить заявку</a>
      </div>
    </header>

    <!-- Титульный экран -->
    <section class="gm-hero" aria-labelledby="gm-h1">
      <div class="gm-hero-bg" aria-hidden="true">
        <Image src={img('/images/hero.jpg')} alt="" widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
        <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none"></video>
      </div>
      <div class="gm-w gm-hero-in">
        <div class="gm-hero-tx">
          <p class="gm-label boot" style="--b:0ms"><span>Фитнес-клуб</span>Хабаровск · {site.district}</p>
          <h1 id="gm-h1" class="gm-h1"><span class="boot" style="--b:80ms">Нажми</span> <span class="boot acc" style="--b:180ms">старт</span></h1>
          <p class="gm-lead boot" style="--b:260ms">Зал, кардио, групповые и SPA в одном клубе. Первый уровень от {dayRate}&nbsp;₽ в&nbsp;день: {plans[0].name.toLowerCase()} за {rub(plans[0].month)} в&nbsp;месяц.</p>
          <ul class="gm-menu" aria-label="Главное меню">
            <li class="boot" style="--b:340ms"><a class="is-sel" href="#baza" data-lead="Заявка с сайта" data-block="16_hero"><kbd>A</kbd><b>Новая игра</b><span>Оставить заявку</span><Icon name="chev1" /></a></li>
            <li class="boot" style="--b:400ms"><a href="#klassy"><kbd>B</kbd><b>Выбор класса</b><span>3 тарифа от {num(plans[0].month)} ₽</span><Icon name="chev1" /></a></li>
            <li class="boot" style="--b:460ms"><a href="#baza"><kbd>C</kbd><b>Карта</b><span>{site.address.short}</span><Icon name="chev1" /></a></li>
          </ul>
        </div>

        <div class="gm-char" aria-hidden="true">
          <span class="gm-pad"></span>
          <Image class="gm-man" src={cutout} alt="" widths={[360, 520, 760]} sizes="(min-width: 1000px) 34vw, 70vw" loading="eager" format="webp" quality={60} />
          <div class="gm-card hud boot" style="--b:520ms">
            <p class="gm-card-k">Напарник</p>
            <p class="gm-card-n">Александр Лазько</p>
            <p class="gm-card-r">Координатор тренажёрного зала</p>
          </div>
        </div>
      </div>

      <div class="gm-w">
        <dl class="gm-stats hud boot" style="--b:600ms" data-m>
          <div>
            <dt>Рейтинг</dt>
            <dd><b>{rating}</b> / 5</dd>
            <span class="gm-bar" style={`--f:${site.rating.value / 5}`}><i></i></span>
            <small>{site.rating.text} на Яндекс Картах</small>
          </div>
          <div><dt>Будни</dt><dd><b>{site.hours[0].time}</b></dd><small>{site.hours[1].days}: {site.hours[1].time}</small></div>
          <div><dt>Парковка</dt><dd><b>50</b> мест</dd><small>Бесплатная, под видеонаблюдением</small></div>
          <div><dt>{plans[0].name}</dt><dd><b>{dayRate}</b> ₽ в день</dd><small>{rub(plans[0].month)} в месяц</small></div>
        </dl>
      </div>
    </section>

    <!-- Локации -->
    <section class="gm-sec gm-w" id="lokacii" aria-labelledby="gm-loc-h">
      <div class="gm-head" data-m>
        <p class="gm-tag">Карта клуба</p>
        <h2 id="gm-loc-h" class="gm-h2">Четыре локации</h2>
        <p class="gm-head-p">{cap(site.facts.area)}, {site.facts.machines} {site.facts.brands}. Внизу карточки видно, какой класс открывает локацию.</p>
      </div>
      <div class="gm-locs">
        {zoneCards.map((c, i) => (
          <a class={`loc hud${c.photo ? '' : ' loc-spa'}`} href={c.href} data-m style={`--d:${i * 90}ms`}>
            <div class="loc-img">
              {c.photo ? (
                <Image src={img(c.photo)} alt={c.alt} widths={[360, 560, 760]} sizes="(min-width: 1100px) 22vw, (min-width: 700px) 45vw, 92vw" loading="lazy" format="avif" quality={45} />
              ) : (
                <div class="loc-gauge" aria-hidden="true">
                  <span class="loc-gauge-t">40–50 °C</span>
                  <span class="loc-gauge-b">{Array.from({ length: 10 }).map((_, k) => <i style={`--k:${k}`}></i>)}</span>
                  <span class="loc-gauge-l">хаммам</span>
                </div>
              )}
              <span class="loc-chip">Локация {i + 1}/4</span>
            </div>
            <h3>{c.title}</h3>
            <p>{cap(c.text)}</p>
            <p class="loc-acc"><span class="sr">Доступно в тарифах:</span>
              {short.map((s, k) => <span class={zoneAccess[c.id][k] ? 'y' : 'n'}>{zoneAccess[c.id][k] ? '' : <Icon name="minus" />}{s}</span>)}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Выбор класса -->
    <section class="gm-sec gm-classes" id="klassy" aria-labelledby="gm-cls-h">
      <div class="gm-w">
        <div class="gm-head" data-m>
          <p class="gm-tag">Абонементы</p>
          <h2 id="gm-cls-h" class="gm-h2">Выбери класс</h2>
          <p class="gm-head-p">Три класса, от {dayRate}&nbsp;₽ в&nbsp;день. Полосы посчитаны по часам доступа, зонам и перкам каждого тарифа.</p>
        </div>
        <div class="gm-cls">
          {classes.map((c) => (
            <article class={`cl hud${c.i === 1 ? ' cl-top' : ''}`} data-m style={`--d:${c.i * 110}ms`}>
              <header class="cl-h">
                <span class={`cl-ico i${c.i}`} aria-hidden="true">
                  {c.i === 0 && <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="20" cy="22" r="7" /><path d="M20 6v5M8 22H3m34 0h-5M10 12l3 3m17-3-3 3M4 32h32" stroke-linecap="square" /></svg>}
                  {c.i === 1 && <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="20" cy="20" r="14" /><path d="M20 11v10l6 4" stroke-linecap="square" /></svg>}
                  {c.i === 2 && <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="miter"><path d="M6 30 4 12l9 7 7-11 7 11 9-7-2 18z" /><path d="M8 35h24" /></svg>}
                </span>
                <div>
                  <p class="cl-arch">{c.tag ? `${c.arch} · ${c.tag}` : c.arch}</p>
                  <h3>{c.name}</h3>
                </div>
              </header>
              <dl class="cl-stats">
                {c.stats.map((s) => (
                  <div>
                    <dt>{s.k}</dt><dd>{s.v}</dd>
                    {s.seg ? (
                      <span class="gm-seg" style={`--n:${s.seg}`}>{Array.from({ length: s.seg }).map((_, k) => <i class={k < (s.on ?? 0) ? 'on' : ''} style={`--k:${k}`}></i>)}</span>
                    ) : (
                      <span class="gm-bar" style={`--f:${s.f.toFixed(3)}`}><i></i></span>
                    )}
                  </div>
                ))}
              </dl>
              <p class="cl-price"><b>{num(c.month)}</b> ₽ <span>в месяц</span></p>
              <p class="cl-sub">{perDay(c.month, 30)} ₽ в день · за год {rub(c.year)}</p>
              <ul class="cl-perks">
                {perks.map((r) => (
                  <li class={r[c.i + 1] ? 'y' : 'n'}>
                    {r[c.i + 1]
                      ? <Icon name="check" />
                      : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>}
                    <span>{r[0]}{!r[c.i + 1] && <span class="sr"> (недоступно)</span>}</span>
                  </li>
                ))}
              </ul>
              <a class={`gm-btn gm-btn-w${c.i === 1 ? '' : ' gm-btn-o'}`} href="#baza" data-lead={`Тариф «${c.name}»`} data-block={`16_class_${c.id}`}>Выбрать класс<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <!-- Стартовый уровень: дневная карта -->
        <div class="gm-demo hud" data-m>
          <div class="demo-l">
            <p class="gm-tag">Стартовый класс</p>
            <h3>{plans[0].name}: <span>{dayRate}&nbsp;₽</span> в день</h3>
            <p>{rub(plans[0].month)} в месяц: тренажёрный зал и кардиозона {plans[0].hours}.</p>
            <ul class="demo-terms">{plans[0].features.slice(1).map((t) => <li>{t}</li>)}</ul>
            <a class="gm-btn" href="#baza" data-lead="Заявка с сайта" data-block="16_day">Оставить заявку<Icon name="chev" /></a>
          </div>
          <div class="demo-r" aria-hidden="true">
            <span class="demo-ring"></span>
            <span class="demo-num" data-day-rate={dayRate}>{dayRate}<small>₽</small></span>
            <span class="demo-cap">Уровень 1 · один день</span>
          </div>
        </div>

        <div class="gm-quests">
          <p class="gm-tag">Побочные квесты</p>
          <div class="gm-quests-in">
            {quests.map((q, i) => (
              <article class="qs hud" data-m style={`--d:${i * 100}ms`}>
                <p class="qs-k">Квест · {q.short}</p>
                <h3>{q.title}</h3>
                <p>{q.text}</p>
                <p class="qs-r"><b>Условие:</b> {q.terms.join(', ').toLowerCase()}</p>
                <a class="gm-link" href="#baza" data-lead={q.goal} data-block={`16_quest_${q.slug}`}>{q.cta}<Icon name="chev1" /></a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Напарники -->
    <section class="gm-sec gm-w" id="naparniki" aria-labelledby="gm-team-h">
      <div class="gm-head" data-m>
        <p class="gm-tag">Команда</p>
        <h2 id="gm-team-h" class="gm-h2">Выбери напарника</h2>
        <p class="gm-head-p">{personal.firstFree}. Тренер поставит технику и составит программу под вашу цель.</p>
      </div>
      <div class="gm-team">
        {trainers.map((t, i) => (
          <figure class="mate hud" data-m style={`--d:${i * 100}ms`}>
            <div class="mate-img">
              <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 900px) 30vw, 92vw" loading="lazy" format="avif" quality={50} />
              <span class="mate-p">P{i + 1}</span>
            </div>
            <figcaption>
              <b>{t.name}</b>
              <span><em>Роль</em>{t.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="gm-pack hud" data-m>
        <p class="gm-tag">Персональные тренировки</p>
        <p class="gm-pack-p">{personalLine}</p>
        <a class="gm-btn gm-btn-o" href="#baza" data-lead="Персональные тренировки" data-block="16_personal">Позвать напарника<Icon name="chev" /></a>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="gm-sec gm-w" id="otzyvy" aria-labelledby="gm-rev-h">
      <div class="gm-head" data-m>
        <p class="gm-tag">Лог игроков</p>
        <h2 id="gm-rev-h" class="gm-h2">Отзывы игроков</h2>
      </div>
      <div class="gm-rev">
        <a class="gm-score hud" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-m>
          <span class="gm-score-k">Рейтинг клуба</span>
          <b>{rating}</b>
          <span class="gm-seg gm-seg-l" style="--n:5">{[0, 1, 2, 3, 4].map((k) => <i class="on" style={`--k:${k}`}></i>)}</span>
          <span class="gm-score-t">{site.rating.text} на Яндекс Картах</span>
          <span class="gm-link">Читать все<Icon name="chev1" /></span>
        </a>
        <ol class="gm-log">
          {reviews.map((r, i) => (
            <li class="hud" data-m style={`--d:${i * 80}ms`}>
              <span class="log-av" aria-hidden="true">{initials(r.name)}</span>
              <div>
                <p class="log-h"><b>{r.name}</b><span>{r.source}</span></p>
                <p>{r.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- База и заявка -->
    <section class="gm-sec gm-w gm-base" id="baza" aria-labelledby="gm-base-h">
      <div class="gm-final hud" data-m>
        <div class="fn-l">
          <p class="gm-tag">База</p>
          <h2 id="gm-base-h" class="gm-h2">Готов к первому уровню?</h2>
          <dl class="fn-facts">
            <div><dt>Координаты</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест</dd></div>
            <div><dt>Связь</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
          <p class="fn-links">
            <a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a>
            <a href={telegramLink('site_16')} target="_blank" rel="noopener"><Icon name="tg" />Telegram</a>
            <a href={site.maps.yandex} target="_blank" rel="noopener"><Icon name="pin" />Маршрут</a>
          </p>
        </div>
        <div class="fn-r">
          <LeadForm id="gm" block="16_final" />
        </div>
      </div>
    </section>

    <footer class="gm-foot">
      <div class="gm-w">
        <div class="gm-foot-top">
          <a class="gm-logo gm-logo-l" href="/concepts/16/">URBAN210<Icon name="chev" /></a>
          <p class="gm-foot-cta">Продолжение в зале. <a href="#baza" data-lead="Заявка с сайта" data-block="16_footer">Оставить заявку<Icon name="chev1" /></a></p>
        </div>
        <div class="gm-foot-cols">
          <div><p class="gm-tag">Клуб</p><p>{site.address.locality}, {site.address.street}<br />{site.district}</p><p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p></div>
          <div><p class="gm-tag">Связь</p><ul><li><a href={site.phone.href}>{site.phone.display}</a></li><li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li><li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li><li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li><li><a href={`mailto:${site.email}`}>{site.email}</a></li></ul></div>
          <div><p class="gm-tag">Разделы</p><ul><li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li></ul></div>
          <div><p class="gm-tag">Документы</p><ul><li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li></ul></div>
        </div>
        <p class="gm-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>

    <div class="gm-toasts" aria-live="polite" data-toasts></div>
    <template data-toast-tpl>
      <div class="toast" role="status">
        <span class="toast-ico" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 3 35 11.5v17L20 37 5 28.5v-17z" /><path d="m13 20 5 5 9-10" stroke-linecap="square" /></svg></span>
        <span class="toast-tx"><small>Достижение открыто</small><b data-t></b><span data-s></span></span>
        <button type="button" class="toast-x" aria-label="Закрыть"><Icon name="close" /></button>
      </div>
    </template>
  </div>
</Layout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector<HTMLElement>('.gm');

  // HUD загружается: первый экран сразу, остальные блоки при появлении
  requestAnimationFrame(() => root?.classList.add('is-boot'));
  const groups = document.querySelectorAll<HTMLElement>('.gm [data-m]');
  if (reduce || !('IntersectionObserver' in window)) groups.forEach((g) => g.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    groups.forEach((g) => io.observe(g));
  }

  // Статус клуба по времени Хабаровска
  const st = document.querySelector<HTMLElement>('[data-status]');
  const hm = (x: number) => `${String(Math.floor(x / 60) % 24).padStart(2, '0')}:${String(x % 60).padStart(2, '0')}`;
  const paint = () => {
    if (!st) return;
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Vladivostok', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value || '';
    const wd = get('weekday');
    const m = Number(get('hour')) * 60 + Number(get('minute'));
    const weekend = wd === 'Sat' || wd === 'Sun';
    const [o, c] = weekend ? [450, 1350] : [390, 1410];
    const open = m >= o && m < c;
    const nextWeekend = wd === 'Fri' || wd === 'Sat';
    st.classList.toggle('is-open', open);
    st.querySelector('[data-status-t]')!.textContent = open ? `Открыто до ${hm(c)}` : `Закрыто, откроемся в ${hm(m < o ? o : nextWeekend ? 450 : 390)}`;
  };
  paint();
  setInterval(paint, 60000);

  // Достижения: всплывают один раз, сами прячутся через 5 секунд
  const box = document.querySelector<HTMLElement>('[data-toasts]');
  const tpl = document.querySelector<HTMLTemplateElement>('[data-toast-tpl]');
  const shown = new Set<string>();
  const toast = (id: string, t: string, s: string) => {
    if (!box || !tpl || shown.has(id)) return;
    shown.add(id);
    const el = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    el.querySelector('[data-t]')!.textContent = t;
    el.querySelector('[data-s]')!.textContent = s;
    const close = () => { el.classList.remove('is-in'); setTimeout(() => el.remove(), 400); };
    el.querySelector('button')!.addEventListener('click', close);
    box.querySelectorAll('.toast').forEach((x) => (x as HTMLElement).classList.remove('is-in'));
    box.append(el);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-in')));
    setTimeout(close, 5200);
  };
  const ach: Record<string, [string, string]> = {
    lokacii: ['Исследователь', 'Зал, кардио, групповые и SPA в одном клубе'],
    klassy: ['Свободный выбор', 'Месяц или год, дневная карта или полный доступ'],
    otzyvy: ['Народное признание', `${document.querySelector('.gm-score b')?.textContent || ''} из 5, больше 2000 отзывов`],
  };
  const dayRate = document.querySelector<HTMLElement>('[data-day-rate]')?.dataset.dayRate;
  setTimeout(() => toast('start', 'Первый визит', `Дневная карта от ${dayRate} ₽ в день`), 1200);
  if ('IntersectionObserver' in window) {
    const so = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const a = ach[(e.target as HTMLElement).id];
      if (a) toast(e.target.id, a[0], a[1]);
      so.unobserve(e.target);
    }), { threshold: 0.25 });
    Object.keys(ach).forEach((id) => { const s = document.getElementById(id); if (s) so.observe(s); });
  }
</script>

