---
// Концепция 06 «Кампания»: как рекламная кампания спортивного бренда. Чёрный и белый, оранжевый как единственный
// цвет силы, огромный плотный капс Montserrat, тренер в вырезке перекрывает заголовок, плакаты на всю ширину.
// Движение: строки заголовков выезжают снизу, лозунг едет вбок вместе с прокруткой (CSS scroll-driven),
// плакаты зон наезжают друг на друга (position: sticky, без перехвата прокрутки).
import '@fontsource-variable/montserrat/wght.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink, nav } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs } from '../../../data/content';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const posters = [
  { z: zones.find((z) => z.id === 'zal')!, line: ['Железо', 'ждёт.'], alt: 'Тренажёрный зал Urban210 с панорамными окнами' },
  { z: zones.find((z) => z.id === 'cardio')!, line: ['Дыши', 'глубже.'], alt: 'Беговые дорожки в кардиозоне' },
  { z: zones.find((z) => z.id === 'group')!, line: ['Вместе', 'проще.'], alt: 'Групповая тренировка в зале 150 м²', extra: programs.flatMap((p) => p.items).join(' · ') },
];
const spa = zones.find((z) => z.id === 'spa')!;
const dayCard = plans[0];
const fromDay = perDay(dayCard.month, 30);
const stats = [
  [`${fromDay} ₽`, 'в день по дневной карте'],
  ['60+', 'тренажёров Technogym и Matrix'],
  ['1300+', 'м² на двух этажах'],
  ['50', 'мест бесплатной парковки'],
];
const year = new Date().getFullYear();
---
<Layout title="Концепция 06 «Кампания»" description="Концепция дизайна сайта Urban210: рекламная кампания спортивного бренда, чёрный, белый и оранжевый." noindex bare>
  <div class="c6">
    <header class="c6-top" data-c6-top>
      <a class="c6-logo" href="/concepts/06/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
      <nav class="c6-nav" aria-label="Меню">
        <a href="#zones">Клуб</a><a href="#price">Тарифы</a><a href="#team">Команда</a><a href="#lead">Контакты</a>
      </nav>
      <a class="c6-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="c6-btn c6-btn-sm" href="#price" data-block="06_header">Выбрать карту</a>
    </header>

    <!-- Первый экран: плакат -->
    <section class="c6-hero" aria-labelledby="c6-h">
      <div class="c6-hero-bg" aria-hidden="true">
        <video data-hero-video data-src="/video/hero-bw.mp4" poster="/video/hero-bw-poster.jpg" muted loop playsinline preload="none"></video>
      </div>
      <h1 id="c6-h" class="c6-hero-h">
        <span class="sr">Начни с {fromDay} ₽ в день: фитнес-клуб Urban210</span>
        <span class="c6-hl" aria-hidden="true"><span style="--d:0">Начни</span></span>
        <span class="c6-hl" aria-hidden="true"><span style="--d:1">с {fromDay}&nbsp;₽</span></span>
        <span class="c6-hl" aria-hidden="true"><span style="--d:2">в день<em>.</em></span></span>
      </h1>
      <Image class="c6-cut" src={cutout} alt="Александр Лазько, координатор тренажёрного зала Urban210" widths={[420, 640, 900]} sizes="(min-width: 980px) 46vw, 100vw" loading="eager" fetchpriority="high" format="webp" quality={55} />
      <div class="c6-hero-ghost" aria-hidden="true">
        <span class="c6-hl"><span style="--d:0">Начни</span></span>
        <span class="c6-hl"><span style="--d:1">с {fromDay}&nbsp;₽</span></span>
        <span class="c6-hl"><span style="--d:2">в день<em>.</em></span></span>
      </div>
      <div class="c6-hero-foot">
        <p class="c6-hero-sub"><b>{dayCard.name}: {rub(dayCard.month)} в месяц.</b> Безлимит в зал и кардиозону {dayCard.hours}. Фитнес-клуб Urban210, Хабаровск, {site.address.short}.</p>
        <div class="c6-hero-act">
          <a class="c6-btn" href="#price" data-block="06_hero">Выбрать карту<Icon name="chev" /></a>
          <a class="c6-rate" href={site.maps.yandexReviews} target="_blank" rel="noopener"><b>4,7</b><span><Icon name="star" />{site.rating.text}<br />на Яндекс Картах</span></a>
        </div>
      </div>
    </section>

    <!-- Манифест -->
    <section class="c6-man" aria-labelledby="c6-m">
      <h2 id="c6-m" class="c6-split" data-rise>
        <span class="c6-ln"><span>Без суеты.</span></span>
        <span class="c6-ln"><span>Без очередей.</span></span>
        <span class="c6-ln"><span>Без оправданий.</span></span>
      </h2>
      <ul class="c6-stats">
        {stats.map(([n, l]) => <li data-rise><b>{n}</b><span>{l}</span></li>)}
      </ul>
    </section>

    <!-- Лозунг едет с прокруткой -->
    <section class="c6-run" aria-label="Работай. Отдыхай. Возвращайся.">
      <div class="c6-run-row r1" aria-hidden="true">
        {[0, 1, 2].map(() => <span>Работай<Icon name="chev" />Отдыхай<Icon name="chev" />Возвращайся<Icon name="chev" /></span>)}
      </div>
      <div class="c6-run-row r2" aria-hidden="true">
        {[0, 1, 2].map(() => <span>С 6:30 утра<Icon name="chev" />До 23:30 вечера<Icon name="chev" /></span>)}
      </div>
    </section>

    <!-- Зоны: плакаты наезжают друг на друга -->
    <section class="c6-zones" id="zones" aria-labelledby="c6-z">
      <h2 id="c6-z" class="sr">Зоны клуба</h2>
      {posters.map((p) => (
        <article class="c6-poster">
          <Image src={img(p.z.image!)} alt={p.alt} widths={[600, 1000, 1600]} sizes="100vw" format="avif" quality={45} />
          <div class="c6-poster-in">
            <p class="c6-poster-line c6-split" data-rise>{p.line.map((w) => <span class="c6-ln"><span>{w}</span></span>)}</p>
            <div class="c6-poster-info">
              <h3>{p.z.title}</h3>
              <p>{p.z.text}</p>
              {p.extra && <p class="c6-poster-extra">{p.extra}</p>}
              <a class="c6-link" href={p.z.href}>Подробнее<Icon name="chev" /></a>
            </div>
          </div>
        </article>
      ))}
      <article class="c6-poster c6-poster-spa">
        <div class="c6-poster-in">
          <p class="c6-poster-line c6-split" data-rise><span class="c6-ln"><span>Отдых</span></span><span class="c6-ln"><span>тоже</span></span><span class="c6-ln"><span>работа.</span></span></p>
          <div class="c6-poster-info">
            <h3>{spa.title}</h3>
            <p>{spa.text} Входит в тариф «Всё включено».</p>
            <a class="c6-link" href={spa.href}>Подробнее<Icon name="chev" /></a>
          </div>
        </div>
        <span class="c6-spa-deg" aria-hidden="true">40–50°</span>
      </article>
    </section>

    <!-- Тарифы -->
    <section class="c6-price" id="price" aria-labelledby="c6-p">
      <div class="c6-wrap">
        <div class="c6-head">
          <h2 id="c6-p" class="c6-split" data-rise><span class="c6-ln"><span>Три тарифа.</span></span><span class="c6-ln"><span>От {fromDay} ₽ в день.</span></span></h2>
          <p>Безлимит в своё время, при оплате за год дешевле.</p>
        </div>
        <div class="c6-plans">
          {plans.map((p) => (
            <article class={`c6-plan ${p.id === 'full' ? 'is-hot' : ''}`}>
              <div class="c6-plan-top">
                <h3>{p.name}</h3>
                {p.tag && <span>{p.tag}</span>}
              </div>
              <p class="c6-plan-hours">{p.hours}</p>
              <p class="c6-plan-num">{rub(p.month)}<small>в месяц</small></p>
              <p class="c6-plan-alt">{rub(p.year)} за год · ≈ {perDay(p.month, 30)} ₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="chev1" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" />{f}</li>)}
              </ul>
              <a class={`c6-btn ${p.id === 'full' ? '' : 'c6-btn-k'} c6-btn-wide`} href="#lead" data-lead={`Тариф «${p.name}»`} data-block="06_price">Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c6-offer" aria-labelledby="c6-tr">
      <div class="c6-offer-num" aria-hidden="true">{fromDay}₽</div>
      <div class="c6-offer-txt">
        <h2 id="c6-tr">От {fromDay} ₽ в день</h2>
        <p>{dayCard.name}: {rub(dayCard.month)} в месяц. Зал и кардиозона {dayCard.hours}.</p>
        <a class="c6-btn c6-btn-k" href="#lead" data-lead="Заявка с сайта" data-block="06_offer">Оставить заявку<Icon name="chev" /></a>
      </div>
    </section>

    <!-- Команда -->
    <section class="c6-team" id="team" aria-labelledby="c6-t">
      <div class="c6-wrap">
        <div class="c6-head c6-head-dark">
          <h2 id="c6-t" class="c6-split" data-rise><span class="c6-ln"><span>Команда</span></span><span class="c6-ln"><span>в твоём углу.</span></span></h2>
          <p>Тренеры покажут тренажёры и поставят технику. {personal.firstFree}.</p>
        </div>
        <div class="c6-coaches">
          {trainers.map((t) => (
            <article class="c6-coach">
              <Image src={img(t.photo)} alt={t.name} widths={[360, 600]} sizes="(min-width: 980px) 30vw, 86vw" format="avif" quality={50} />
              <div><h3>{t.name}</h3><p>{t.role}</p></div>
            </article>
          ))}
        </div>
        <div class="c6-personal">
          <p><b>Персональные тренировки</b> {rub(personal.price)} за {personal.pack} занятий. Первая бесплатно при покупке подписки.</p>
          <a class="c6-btn" href="#lead" data-lead="Персональные тренировки" data-block="06_personal">Подобрать тренера<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="c6-rev" aria-labelledby="c6-r">
      <div class="c6-wrap c6-rev-grid">
        <div class="c6-rev-side">
          <a class="c6-rev-big" href={site.maps.yandexReviews} target="_blank" rel="noopener" aria-label={`Рейтинг 4,7 на Яндекс Картах, ${site.rating.text}`}>4,7</a>
          <h2 id="c6-r">Говорят те, кто ходит</h2>
          <p>{site.rating.text} на Яндекс Картах и в 2ГИС.</p>
        </div>
        <div class="c6-quotes">
          {reviews.map((r) => (
            <blockquote data-rise>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="c6-lead" id="lead" aria-labelledby="c6-l">
      <div class="c6-wrap c6-lead-grid">
        <div>
          <h2 id="c6-l" class="c6-split" data-rise><span class="c6-ln"><span>Твой</span></span><span class="c6-ln"><span>ход.</span></span></h2>
          <ol class="c6-steps">
            <li>Оставь имя и телефон</li>
            <li>Администратор перезвонит и подберёт время</li>
            <li>Приходи с паспортом, оформим карту и покажем зал</li>
          </ol>
          <p class="c6-lead-alt">Удобнее написать: <a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener">WhatsApp</a> или <a href={telegramLink('concept06')} target="_blank" rel="noopener">Telegram</a></p>
        </div>
        <div class="c6-form"><LeadForm block="06_final" id="c6" /></div>
      </div>
    </section>

    <footer class="c6-foot">
      <div class="c6-wrap">
        <div class="c6-foot-grid">
          <div>
            <h2>Адрес</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <a class="c6-foot-tel" href={site.phone.href}>{site.phone.display}</a>
          </div>
          <div>
            <h2>Часы</h2>
            <ul>{site.hours.map((h) => <li>{h.days} {h.time}</li>)}</ul>
            <p class="c6-foot-note">{site.parking}</p>
          </div>
          <div>
            <h2>Клуб</h2>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
        </div>
        <div class="c6-foot-mark" aria-hidden="true">URBAN210<Icon name="chev" /></div>
        <div class="c6-foot-bottom">
          <span>© {year} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</span>
          <span><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Оферта</a> · <a href="/rules/">Правила клуба</a></span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Шапка получает фон, когда первый экран уехал
  const top = document.querySelector<HTMLElement>('[data-c6-top]');
  if (top) {
    const on = () => top.classList.toggle('is-solid', scrollY > 60);
    on();
    addEventListener('scroll', on, { passive: true });
  }
</script>

<style is:global>
  body:has(.c6) { background: #0b0a09; color: #f4f2ee; }
  body:has(.c6) .mbar { background: rgb(11 10 9 / 0.94); border-top: 1px solid rgb(255 255 255 / 0.12); }
  body:has(.c6) .mbar a.ic { border-radius: 0; }
  body:has(.c6) .mbar .btn, body:has(.c6) dialog.lead .btn { border-radius: 0; font-family: 'Montserrat Variable', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; color: #0b0a09; }
  body:has(.c6) dialog.lead .form { border-radius: 0; background: #0b0a09; }
  body:has(.c6) dialog.lead .form h3 { font-family: 'Montserrat Variable', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; }
  body:has(.c6) dialog.lead .field input { border-radius: 0; }
</style>

<style>
  .c6 {
    --k: #0b0a09; --w: #f4f2ee; --o: #ff5722; --g: #8f8a84;
    --gut: clamp(16px, 3vw, 40px);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    font-family: 'Montserrat Variable', system-ui, sans-serif;
    font-size: 16.5px; line-height: 1.55; color: var(--w); background: var(--k);
    overflow-x: clip;
  }
  .c6 :global(h1), .c6 :global(h2), .c6 :global(h3) { font-family: 'Montserrat Variable', sans-serif; hyphens: manual; -webkit-hyphens: manual; }
  .c6 a { text-decoration: none; }
  .c6 :global(svg) { flex: none; }
  .c6-wrap { max-width: 1440px; margin-inline: auto; padding-inline: var(--gut); }

  /* ---------- Кнопки ---------- */
  .c6-btn { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 60px; padding: 0 26px; background: var(--o); color: var(--k); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; transition: background-color 0.25s ease, color 0.25s ease, transform 0.16s ease; }
  .c6-btn :global(svg) { width: 20px; height: 15px; transition: transform 0.35s var(--ease); }
  .c6-btn:hover { background: var(--w); }
  .c6-btn:hover :global(svg) { transform: translateX(6px); }
  .c6-btn:active { transform: scale(0.97); }
  .c6-btn-k { background: var(--k); color: var(--w); }
  .c6-btn-k:hover { background: var(--o); color: var(--k); }
  .c6-btn-sm { min-height: 44px; padding: 0 16px; font-size: 0.78rem; }
  .c6-btn-wide { width: 100%; }
  .c6-link { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; border-bottom: 2px solid var(--o); padding-bottom: 4px; width: fit-content; }
  .c6-link :global(svg) { width: 16px; height: 12px; color: var(--o); transition: transform 0.35s var(--ease); }
  .c6-link:hover :global(svg) { transform: translateX(5px); }

  /* ---------- Шапка ---------- */
  .c6-top { position: fixed; z-index: 30; inset: 0 0 auto; display: flex; align-items: center; gap: 28px; height: 72px; padding-inline: var(--gut); transition: background-color 0.3s ease; }
  .c6-top.is-solid { background: rgb(11 10 9 / 0.92); backdrop-filter: blur(10px); }
  .c6-logo { display: inline-flex; align-items: center; gap: 6px; font-weight: 900; font-size: 1.3rem; letter-spacing: -0.04em; }
  .c6-logo :global(svg) { width: 18px; height: 16px; color: var(--o); }
  .c6-nav { display: none; gap: 26px; margin-left: auto; }
  .c6-nav a { font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85; transition: opacity 0.2s ease, color 0.2s ease; }
  .c6-nav a:hover { opacity: 1; color: var(--o); }
  .c6-tel { display: none; font-weight: 700; font-size: 0.9rem; }
  .c6-top .c6-btn { margin-left: auto; }
  @media (min-width: 900px) { .c6-nav { display: flex; } .c6-top .c6-btn { margin-left: 0; } }
  @media (min-width: 1200px) { .c6-tel { display: inline; } }

  /* ---------- Первый экран ---------- */
  .c6-hero { position: relative; isolation: isolate; min-height: max(100svh, 640px); overflow: hidden; display: grid; grid-template-rows: 1fr auto; padding: 96px var(--gut) 28px; }
  .c6-hero-bg { position: absolute; inset: 0; z-index: -2; background: #141210 url('/video/hero-bw-poster.jpg') center / cover; }
  .c6-hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(11 10 9 / 0.55) 0%, rgb(11 10 9 / 0.75) 60%, var(--k) 100%); }
  .c6-hero-bg video { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s ease; filter: grayscale(1) contrast(1.15); }
  .c6-hero-bg video:global(.is-on) { opacity: 1; }

  .c6-hero-h, .c6-hero-ghost { position: absolute; z-index: 1; left: var(--gut); right: var(--gut); top: 104px; margin: 0; display: grid; font-weight: 900; text-transform: uppercase; font-size: clamp(3.6rem, 16.4vw, 15rem); line-height: 0.84; letter-spacing: -0.055em; color: var(--w); }
  .c6-hero-ghost { z-index: 3; color: transparent; -webkit-text-stroke: 2px var(--w); pointer-events: none; }
  .c6-hero-h em, .c6-hero-ghost em { font-style: normal; color: var(--o); }
  .c6-hero-ghost em { -webkit-text-stroke-color: var(--o); }
  .c6-hl { display: block; overflow: hidden; padding: 0.14em 0 0.12em; margin: -0.14em 0 -0.08em; }
  .c6-hl > span { display: block; animation: c6-up 1s var(--ease) both; animation-delay: calc(0.12s + var(--d) * 0.12s); }
  .c6-hero-h .c6-hl:nth-child(4) { color: var(--o); }
  .c6-hero-ghost .c6-hl:nth-child(3) { -webkit-text-stroke-color: var(--o); }
  @keyframes c6-up { from { transform: translateY(105%); } }

  .c6-cut { position: absolute; z-index: 2; bottom: 0; left: 50%; width: min(118vw, 620px); height: auto; translate: -50% 0; filter: grayscale(1) contrast(1.08);
    mask-image: linear-gradient(180deg, #000 70%, transparent 98%); -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 98%); animation: c6-in 1.4s var(--ease) 0.2s both; }
  @keyframes c6-in { from { opacity: 0; transform: translateY(40px) scale(1.03); } }

  .c6-hero-foot { position: relative; z-index: 4; grid-row: 2; display: grid; gap: 18px; }
  .c6-hero-sub { max-width: 34ch; font-size: 1rem; font-weight: 500; color: rgb(244 242 238 / 0.85); }
  .c6-hero-sub b { color: var(--w); font-weight: 800; }
  .c6-hero-act { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 26px; }
  .c6-rate { display: inline-flex; align-items: center; gap: 12px; }
  .c6-rate b { font-size: 2.6rem; font-weight: 900; letter-spacing: -0.05em; line-height: 1; }
  .c6-rate span { font-size: 0.78rem; font-weight: 600; line-height: 1.35; color: rgb(244 242 238 / 0.75); }
