---
// Концепция 35 «Ма»: японское «ма», пустота как часть формы.
// Одна идея: на каждом экране одна огромная цифра против мелкого точного текста, одно фото не по центру и много воздуха.
// Палитра: тёплая бумага, чёрная тушь и единственная оранжевая метка, шеврон » из логотипа.
// Одно движение: шеврон медленно спускается по тонкой линии слева вместе с прокруткой (CSS scroll-timeline, без JS).
import onCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onExt from '@fontsource-variable/onest/files/onest-latin-ext-wght-normal.woff2?url';
import pmCyr from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-cyrillic-400-normal.woff2?url';
import pmLat from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, nav, whatsappLink, telegramLink } from '../../../data/site';
import { plans, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, personalText } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Onest m';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Onest m';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onLat}) format('woff2');unicode-range:${UL}}
@font-face{font-family:'Onest m';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onExt}) format('woff2');unicode-range:U+20BD}
@font-face{font-family:'Onest fb';src:local('Arial');size-adjust:104%;ascent-override:96%;descent-override:24%}
@font-face{font-family:'Plex m';font-style:normal;font-display:swap;font-weight:400;src:url(${pmCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Plex m';font-style:normal;font-display:swap;font-weight:400;src:url(${pmLat}) format('woff2');unicode-range:${UL}}`;

const nb = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const low = (s: string) => (/^[A-ZА-ЯЁ][a-zа-яё]/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);
const rating = site.rating.value.toString().replace('.', ',');
const area = site.facts.area.match(/\d+/)?.[0] ?? '';
const areaPre = cap(site.facts.area.replace(/\s*\d+.*$/, ''));
const noFee = reasons.find((r) => r.title.includes('взнос'))!;
const noQueue = reasons.find((r) => r.title.includes('очеред'))!;
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const hours = site.hours.map((h) => `${h.days} ${h.time}`);
const quotes = [reviews[0], reviews[3]];
const lazko = trainers.find((t) => t.photo.includes('lazko'))!;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<Layout title="Концепция 35 «Ма»" description="Концепция дизайна сайта Urban210: японское «ма», много воздуха, одна большая цифра на экран и единственная оранжевая метка." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={onCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="ma">
    <div class="ma-rail" aria-hidden="true"><i></i><span><Icon name="chev" /></span></div>

    <header class="ma-top">
      <div class="ma-w ma-top-in">
        <a class="ma-logo" href="/concepts/35/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="ma-nav" aria-label="Разделы">
          <a href="#zony">Пространство</a><a href="#tarify">Тарифы</a><a href="#komanda">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Контакты</a>
        </nav>
        <a class="ma-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="ma-btn ma-btn-s" href="#zayavka" data-lead={trial.title} data-block="35_header"><span>1&nbsp;₽<span class="ma-hide-s"> пробный день</span></span><Icon name="chev" /></a>
      </div>
    </header>

    <!-- 01. Первый экран: одна цифра -->
    <section class="ma-first" aria-labelledby="ma-h1">
      <div class="ma-w ma-g ma-first-in">
        <p class="ma-mono ma-first-k"><span>01</span>Фитнес-клуб в Хабаровске, {site.district.toLowerCase()}</p>
        <h1 id="ma-h1" class="ma-h1">
          <span class="ma-h1-a">Первый день<br />в Urban210 за</span>
          <span class="ma-h1-n"><span class="d">1</span><span class="r">₽<Icon name="chev" /></span></span>
        </h1>
        <figure class="ma-first-ph">
          <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 38vw, 46vw" loading="eager" fetchpriority="high" format="webp" quality={60} />
        </figure>
        <div class="ma-first-tx">
          <p class="ma-p">{trial.text} {noFee.title}.</p>
          <div class="ma-acts">
            <a class="ma-btn" href="#zayavka" data-lead={trial.title} data-block="35_hero">Записаться за 1&nbsp;₽<Icon name="chev" /></a>
            <a class="ma-link" href="#tarify">Тарифы от {nb(plans[0].month)}&nbsp;₽</a>
          </div>
        </div>
        <ul class="ma-facts ma-mono">
          <li><span>Будни</span>{site.hours[0].time}</li>
          <li><span>Выходные</span>{site.hours[1].time}</li>
          <li><span>Адрес</span>{site.address.short}</li>
          <li><a href={site.maps.yandexReviews} target="_blank" rel="noopener"><span>Яндекс Карты</span>{rating} из 5, {site.rating.text}</a></li>
        </ul>
      </div>
    </section>

    <!-- 02. Пространство -->
    <section class="ma-sec" id="zony" aria-labelledby="ma-zones-h">
      <div class="ma-w ma-g">
        <p class="ma-mono ma-k" data-rise><span>02</span>Пространство</p>
        <div class="ma-area" data-rise>
          <p class="ma-mono ma-area-pre">{areaPre}</p>
          <p class="ma-giant">{area}<span>м²</span></p>
        </div>
        <figure class="ma-area-ph" data-rise>
          <Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[400, 600, 800]} sizes="(min-width: 1024px) 30vw, 70vw" loading="lazy" format="avif" quality={45} />
          <figcaption class="ma-mono">{zones[1].title}</figcaption>
        </figure>
        <div class="ma-area-tx" data-rise>
          <h2 id="ma-zones-h" class="ma-h3">{noQueue.title}</h2>
          <p class="ma-p">{cap(noQueue.text)}</p>
        </div>
      </div>

      <div class="ma-w">
        <ol class="ma-zones">
          {zones.map((z, i) => (
            <li data-rise>
              <a class="ma-g ma-zone" href={z.href}>
                <span class="ma-mono n">{pad(i)}</span>
                <span class="t">{z.title}</span>
                <span class="zx">{cap(z.text)}</span>
                <Icon name="chev" class="c" />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 03. Тарифы -->
    <section class="ma-sec" id="tarify" aria-labelledby="ma-price-h">
      <div class="ma-w ma-g">
        <p class="ma-mono ma-k" data-rise><span>03</span>Тарифы</p>
        <h2 id="ma-price-h" class="ma-h2" data-rise>Три абонемента.<br />Вступительного взноса нет.</h2>
        <p class="ma-p ma-price-note" data-rise>{noFee.text}</p>
      </div>
      <div class="ma-w ma-g ma-plans">
        {plans.map((p) => (
          <article class:list={['ma-plan', { 'is-pop': p.tag === 'Популярный' }]} data-rise>
            <p class="ma-mono ma-plan-k">{p.tag === 'Популярный' && <Icon name="chev" />}{p.name}{p.tag && <span>{p.tag}</span>}</p>
            <p class="ma-price"><b>{nb(p.month)}</b><span>₽ в&nbsp;месяц</span></p>
            <p class="ma-plan-y">{rub(p.year)} за год, {p.hours}</p>
            <ul class="ma-plan-f">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            {p.excluded && <p class="ma-plan-x">Не входит: {p.excluded.map(low).join(', ')}</p>}
            <a class="ma-link" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block="35_plans">Оформить «{p.name}»</a>
          </article>
        ))}
      </div>

      <div class="ma-w">
        <div class="ma-g ma-trial" data-rise>
          <p class="ma-mono ma-trial-k">{trial.title}</p>
          <p class="ma-trial-n"><b>{trial.price}</b><span>₽</span></p>
          <div class="ma-trial-tx">
            <p class="ma-p">{trialPromo.text}</p>
            <p class="ma-mono ma-trial-t">{trialPromo.terms.join(' · ')}</p>
          </div>
          <a class="ma-btn ma-trial-b" href="#zayavka" data-lead={trial.title} data-block="35_trial">Записаться<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- 04. Тренеры -->
    <section class="ma-sec" id="komanda" aria-labelledby="ma-team-h">
      <div class="ma-w ma-g">
        <p class="ma-mono ma-k" data-rise><span>04</span>Тренеры</p>
        <div class="ma-team-tx" data-rise>
          <h2 id="ma-team-h" class="ma-h3">Техника, программа и прогресс под присмотром тренера</h2>
          <p class="ma-p">{personalText.lead}</p>
          <p class="ma-team-price"><b>{personalLine}</b>{personalText.bonus}.</p>
          <a class="ma-link" href="#zayavka" data-lead="Персональная тренировка" data-block="35_trainers">Записаться к тренеру</a>
        </div>
        <ul class="ma-team-list" data-rise>
          {trainers.map((t, i) => (
            <li><span class="ma-mono">{pad(i)}</span><b>{t.name}</b><span class="role">{t.role}</span></li>
          ))}
        </ul>
        <figure class="ma-lz" data-rise>
          <Image src={img('/images/trainers/lazko-cutout.webp')} alt={lazko.name} widths={[360, 540, 720]} sizes="(min-width: 1024px) 34vw, 80vw" loading="lazy" format="avif" quality={50} />
          <figcaption class="ma-mono">{lazko.name}, {low(lazko.role)}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 05. Отзывы -->
    <section class="ma-sec" id="otzyvy" aria-labelledby="ma-rev-h">
      <div class="ma-w ma-g">
        <p class="ma-mono ma-k" data-rise><span>05</span>Отзывы</p>
        <div class="ma-score" data-rise>
          <h2 id="ma-rev-h" class="sr">Отзывы гостей клуба</h2>
          <p class="ma-giant">{rating}</p>
          <a class="ma-mono ma-score-l" href={site.maps.yandexReviews} target="_blank" rel="noopener">Яндекс Карты, {site.rating.text}<Icon name="chev" /></a>
        </div>
        <div class="ma-quotes">
          {quotes.map((r) => (
            <blockquote class="ma-q" data-rise>
              <p>{r.text}</p>
              <footer class="ma-mono">{r.name}, {r.source}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- 06. Заявка -->
    <section class="ma-sec ma-final" id="zayavka" aria-labelledby="ma-final-h">
      <div class="ma-w ma-g">
        <p class="ma-mono ma-k" data-rise><span>06</span>Заявка</p>
        <div class="ma-final-tx" data-rise>
          <h2 id="ma-final-h" class="ma-h2">Приходите.<br />Первый день за&nbsp;1&nbsp;₽</h2>
          <dl class="ma-dl">
            <div><dt class="ma-mono">Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt class="ma-mono">Часы</dt><dd>{hours.join(', ')}</dd></div>
            <div><dt class="ma-mono">Парковка</dt><dd>{site.parking}</dd></div>
            <div><dt class="ma-mono">Связь</dt><dd><a href={site.phone.href}>{site.phone.display}</a><br /><a href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener">WhatsApp</a>, <a href={telegramLink('site_35')} target="_blank" rel="noopener">Telegram</a></dd></div>
          </dl>
        </div>
        <div class="ma-form" data-rise>
          <LeadForm id="ma" block="35_final" />
        </div>
      </div>
    </section>

    <footer class="ma-foot">
      <div class="ma-w ma-g">
        <a class="ma-logo" href="/concepts/35/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="ma-foot-nav" aria-label="Страницы">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="ma-foot-c">
          <a href={site.phone.href}>{site.phone.display}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        </div>
        <p class="ma-mono ma-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}<span><a href="/policy/">Политика конфиденциальности</a><a href="/oferta/">Договор-оферта</a><a href="/rules/">Правила клуба</a></span></p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  body:has(.ma) { background: #f4f1ea; color: #141311; color-scheme: light; overflow-x: clip; font-family: 'Onest m', 'Onest fb', system-ui, sans-serif; }
  body:has(.ma) ::selection { background: #141311; color: #f4f1ea; }
  body:has(.ma) :focus-visible { outline: 2px solid #ff5722; outline-offset: 3px; border-radius: 0; }
  body:has(.ma) .form { background: transparent; color: #141311; --ink: #141311; --muted: #67625a; --card: #fbf9f4; --line: rgb(20 19 17 / 0.18); border-radius: 0; padding: 0; gap: 16px; font-family: 'Onest m', 'Onest fb', system-ui, sans-serif; }
  body:has(.ma) .form h3 { font-family: inherit; font-weight: 500; font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.02em; }
  body:has(.ma) .form .muted { color: #67625a; }
  body:has(.ma) .form .field { color: #67625a; font-weight: 400; font-size: 0.875rem; gap: 8px; }
  body:has(.ma) .form .field input { border-radius: 0; border: 0; border-bottom: 1px solid rgb(20 19 17 / 0.32); background: transparent; padding: 0; min-height: 48px; color: #141311; font-size: 1.0625rem; }
  body:has(.ma) .form .field input::placeholder { color: #9a948a; }
  body:has(.ma) .form .field input:focus { border-color: #141311; }
  body:has(.ma) .form .field .err, body:has(.ma) .form .consent.bad { color: #b4300a; }
  body:has(.ma) .form .field.bad input { border-color: #b4300a; }
  body:has(.ma) .form .consent { color: #67625a; font-size: 0.8125rem; }
  body:has(.ma) .form .consent input { accent-color: #141311; }
  body:has(.ma) .form .btn { margin-top: 8px; border-radius: 0; background: #141311; color: #f4f1ea; font-weight: 500; font-size: 1rem; min-height: 56px; justify-content: space-between; padding: 0 24px; }
  body:has(.ma) .form .btn .chev { color: #ff5722; }
  body:has(.ma) .form .btn:hover { background: #000; }
  body:has(.ma) .form .form-note { text-align: left; color: #67625a; }
  body:has(.ma) .form .form-msg.is-err { border-radius: 0; background: #f3ddd2; color: #8a2408; }
  body:has(.ma) .form .form-done { text-align: left; }
  body:has(.ma) .form .form-done .ok { margin: 0; width: 48px; height: 48px; border-radius: 0; background: #ff5722; color: #141311; }
  body:has(.ma) dialog.lead .form { background: #f4f1ea; padding: 40px 32px 32px; border: 0; }
  body:has(.ma) dialog.lead::backdrop { background: rgb(20 19 17 / 0.55); backdrop-filter: blur(4px); }
  body:has(.ma) dialog.lead .x { color: #141311; }
  body:has(.ma) .mbar { background: rgb(244 241 234 / 0.94); border-top: 1px solid rgb(20 19 17 / 0.14); }
  body:has(.ma) .mbar a.ic { border-radius: 0; border: 1px solid rgb(20 19 17 / 0.2); color: #141311; }
  body:has(.ma) .mbar .btn { border-radius: 0; background: #141311; color: #f4f1ea; font-weight: 500; justify-content: space-between; padding: 0 20px; }
  body:has(.ma) .mbar .btn .chev { color: #ff5722; }
</style>

<style>
  .ma {
    --paper: #f4f1ea; --ink: #141311; --mute: #67625a; --line: rgb(20 19 17 / 0.14); --or: #ff5722;
    --f: 'Onest m', 'Onest fb', system-ui, sans-serif;
    --mono: 'Plex m', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --ez: cubic-bezier(0.22, 1, 0.36, 1);
    /* шкала отступов 8 px */
    --s1: 8px; --s2: 16px; --s3: 24px; --s4: 32px; --s5: 48px; --s6: 64px; --s7: 96px; --s8: 128px; --s9: 192px;
    --gut: 16px; --gap: 16px; --sec: var(--s8);
    background: var(--paper); color: var(--ink); font-family: var(--f); font-size: 16px; line-height: 1.55;
  }
  @media (min-width: 700px) { .ma { --gut: 32px; --gap: 24px; } }
  @media (min-width: 1024px) { .ma { --gut: 64px; --sec: var(--s9); } }

  .ma a { color: inherit; }
  .ma-w { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: var(--gut); }
  .ma-g { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gap); }
  @media (min-width: 1024px) { .ma-g { grid-template-columns: repeat(12, minmax(0, 1fr)); } }

  .ma-mono { font-family: var(--mono); font-size: 12px; line-height: 16px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--mute); }
  .ma-k { grid-column: 1 / -1; display: flex; gap: var(--s2); margin-bottom: var(--s6); }
  .ma-k span, .ma-first-k span { color: var(--ink); }
  .ma-p { font-size: 16px; line-height: 1.6; color: var(--ink); max-width: 46ch; }
  .ma-h2 { font-family: var(--f); font-weight: 500; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.08; letter-spacing: -0.03em; }
  .ma-h3 { font-family: var(--f); font-weight: 500; font-size: 24px; line-height: 1.25; letter-spacing: -0.02em; text-wrap: balance; }
  .ma-giant { font-weight: 700; font-size: clamp(140px, 22vw, 320px); line-height: 0.74; letter-spacing: -0.07em; font-variant-numeric: lining-nums; margin-left: -0.012em; }
  .ma-giant span { font-weight: 500; font-size: 0.2em; letter-spacing: -0.02em; margin-left: 0.3em; vertical-align: top; }

  /* Кнопки: тушь, оранжевый только шеврон */
  .ma-btn { display: inline-flex; align-items: center; justify-content: space-between; gap: var(--s3); min-height: 56px; padding: 0 var(--s3); background: var(--ink); color: var(--paper) !important; text-decoration: none; font-weight: 500; font-size: 16px; line-height: 1; transition: background-color 0.3s var(--ez); }
  .ma-btn :global(svg) { width: 17px; height: 16px; flex: none; color: var(--or); transition: transform 0.5s var(--ez); }
  .ma-btn:hover { background: #000; }
  .ma-btn:hover :global(svg) { transform: translateX(4px); }
  .ma-btn-s { min-height: 40px; padding: 0 var(--s2); gap: var(--s1); font-size: 14px; }
  .ma-btn-s :global(svg) { width: 13px; height: 12px; }
  .ma-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 500; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; text-decoration-color: rgb(20 19 17 / 0.3); transition: text-decoration-color 0.3s; }
  .ma-link:hover { text-decoration-color: var(--or); }

  /* Линия с шевроном слева: единственное движение страницы */
  .ma-rail { display: none; }
  @media (min-width: 1200px) {
    .ma-rail { display: block; position: fixed; z-index: 30; left: 24px; top: 30vh; height: 40vh; width: 16px; pointer-events: none; }
    .ma-rail i { position: absolute; left: 7.5px; top: 0; bottom: 0; width: 1px; background: var(--line); }
    .ma-rail span { position: absolute; left: 0; top: 0; width: 16px; height: 16px; display: grid; place-items: center; background: var(--paper); color: var(--or); }
    .ma-rail span :global(svg) { width: 12px; height: 12px; transform: rotate(90deg); }
  }
  @supports (animation-timeline: scroll()) {
