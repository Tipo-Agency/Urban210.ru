---
// Концепция 34 «Рамс»: клуб как аккуратный прибор в духе Дитера Рамса и Braun.
// Тёплый светло-серый корпус, точные скруглённые панели, подписи как маркировка на устройстве.
// Единственный акцент: оранжевая точка (индикатор «открыто», метка на ручке тарифов, точка на кнопке).
// Управление как у прибора: тумблер месяц/год и поворотная ручка выбора тарифа работают на CSS (radio + :has),
// индикатор «открыто сейчас» считается по времени Хабаровска.
import geCyr from '@fontsource-variable/geologica/files/geologica-cyrillic-wght-normal.woff2?url';
import geLat from '@fontsource-variable/geologica/files/geologica-latin-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, personalText } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Geo r';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Geo r';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geLat}) format('woff2');unicode-range:${UL}}
@font-face{font-family:'Geo fb';src:local('Arial');size-adjust:104%;ascent-override:92%;descent-override:24%;line-gap-override:0%}`;

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const rating = site.rating.value.toString().replace('.', ',');
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const modules = [
  { ...z.zal, text: cap(z.zal.text), photo: '/images/zal.jpg', alt: 'Тренажёрный зал Urban210 с панорамными окнами' },
  { ...z.cardio, photo: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне' },
  { ...z.group, text: cap(z.group.text), photo: '/images/stretching.jpg', alt: 'Растяжка в зале групповых программ' },
  { ...z.spa, photo: null, alt: '' },
];
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const side = promos.filter((p) => p.slug !== '1-rubl');
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
// положения меток на шкале ручки, градусы
const angles = [-56, 0, 56];
const hoursData = JSON.stringify(site.hours.map((h) => h.time.split('–')));
const hoursLine = site.hours.map((h) => `${h.days} ${h.time}`).join(' · ');
---
<Layout title="Концепция 34 «Рамс»" description="Концепция дизайна сайта Urban210: клуб как точный прибор в духе Дитера Рамса. Тумблер месяц и год, ручка выбора тарифа, индикатор «открыто сейчас»." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={geCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="rm" data-hours={hoursData}>
    <header class="rm-top">
      <div class="rm-w rm-top-in">
        <a class="rm-logo" href="/concepts/34/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="rm-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a>
        </nav>
        <p class="rm-status" data-status><i class="rm-led" aria-hidden="true"></i><span data-status-text>{hoursLine}</span></p>
        <a class="rm-cta rm-cta-s" href="#zayavka" data-lead={trial.title} data-block="34_header"><i aria-hidden="true"></i><span>1 ₽<span class="rm-hide-s"> пробный день</span></span></a>
      </div>
    </header>

    <!-- Первый экран: прибор с экраном, решёткой динамика и индикатором -->
    <section class="rm-hero" aria-labelledby="rm-h1">
      <div class="rm-w rm-hero-in">
        <div class="rm-hero-tx">
          <p class="rm-label">Фитнес-клуб · {site.city} · {site.district}</p>
          <h1 id="rm-h1" class="rm-h1"><span>Клуб</span><span>без лишнего.</span></h1>
          <p class="rm-lead">{cap(site.facts.area)}, {site.facts.machines} {site.facts.brands}, групповые программы и&nbsp;SPA. Без вступительного взноса и&nbsp;очередей к&nbsp;тренажёрам.</p>
          <div class="rm-acts">
            <a class="rm-cta" href="#zayavka" data-lead={trial.title} data-block="34_hero"><i aria-hidden="true"></i>Пробный день за 1 ₽</a>
            <a class="rm-link" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>
        <div class="rm-dev rm-hero-dev">
          <div class="rm-screen">
            <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210" widths={[480, 720, 960, 1280]} sizes="(min-width: 1000px) 620px, calc(100vw - 72px)" loading="eager" fetchpriority="high" format="webp" quality={58} />
          </div>
          <div class="rm-dev-bar">
            <span class="rm-grille" aria-hidden="true"></span>
            <div class="rm-dev-st">
              <p class="rm-label">Сейчас в клубе</p>
              <p class="rm-dev-now" data-status><i class="rm-led" aria-hidden="true"></i><span data-status-text>{site.hours[0].days} {site.hours[0].time}</span></p>
            </div>
            <a class="rm-round" href="#zayavka" data-lead={trial.title} data-block="34_device" aria-label="Пробный день за 1 ₽"><i aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Зоны: четыре одинаковых модуля -->
    <section class="rm-sec" id="zony" aria-labelledby="rm-zones-h">
      <div class="rm-w">
        <div class="rm-head">
          <p class="rm-label">01 · Пространство</p>
          <h2 id="rm-zones-h" class="rm-h2">Четыре зоны, один абонемент</h2>
        </div>
        <ul class="rm-mods">
          {modules.map((m, i) => (
            <li class="rm-dev rm-mod">
              <span class="rm-screen rm-mod-scr">
                {m.photo
                  ? <Image src={img(m.photo)} alt={m.alt} widths={[360, 520, 720]} sizes="(min-width: 1000px) 300px, calc(100vw - 72px)" loading="lazy" format="avif" quality={45} />
                  : <span class="rm-grille rm-grille-fill" aria-hidden="true"></span>}
              </span>
              <p class="rm-label">{String(i + 1).padStart(2, '0')}{!m.photo && ` · В тарифе «${plans[2].name}»`}</p>
              <h3><a href={m.href}>{m.title}</a></h3>
              <p class="rm-mod-tx">{m.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Тарифы: тумблер и ручка -->
    <section class="rm-sec" id="tarify" aria-labelledby="rm-price-h">
      <div class="rm-w">
        <div class="rm-head">
          <p class="rm-label">02 · Тарифы</p>
          <h2 id="rm-price-h" class="rm-h2">Повернул ручку, выбрал тариф</h2>
        </div>
        <div class="rm-dev rm-price" data-price>
          <div class="rm-ctrl">
            <div class="rm-switch-row">
              <span class="rm-label" aria-hidden="true">Месяц</span>
              <label class="rm-switch">
                <input type="checkbox" id="rm-y" role="switch" />
                <span class="rm-sr">Оплата за год</span>
                <span class="rm-track" aria-hidden="true"><i></i></span>
              </label>
              <span class="rm-label" aria-hidden="true">Год</span>
            </div>
            <fieldset class="rm-dial">
              <legend class="rm-sr">Тариф</legend>
              {plans.map((p, i) => (
                <>
                  <input class="rm-sr" type="radio" name="rm-plan" id={`rm-p${i}`} value={p.id} checked={i === 1} />
                  <label for={`rm-p${i}`} class="rm-mark" style={`--ang:${angles[i]}deg`}><i aria-hidden="true"></i>{p.name}</label>
                </>
              ))}
              <span class="rm-ring" aria-hidden="true"></span>
              <button class="rm-knob" type="button" data-knob aria-label="Следующий тариф"><i></i></button>
            </fieldset>
          </div>
          <div class="rm-read">
            {plans.map((p, i) => (
              <div class="rm-ro" data-i={i}>
                <p class="rm-label rm-ro-top"><span>{p.name}</span>{p.tag && <span>{p.tag}</span>}</p>
                <p class="rm-ro-hours">{cap(p.hours)}</p>
                <p class="rm-ro-price">
                  <b class="m">{num(p.month)}</b><b class="y">{num(p.year)}</b>
                  <span class="m">₽ в месяц</span><span class="y">₽ за год</span>
                </p>
                <p class="rm-ro-note"><span class="m">За год {rub(p.year)}</span><span class="y">Это {rub(Math.round(p.year / 12))} в месяц</span></p>
                <ul class="rm-ro-list">
                  {p.features.map((f) => <li>{f}</li>)}
                  {p.excluded?.map((f) => <li class="no">{f}</li>)}
                </ul>
                <a class="rm-cta" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`34_plan_${p.id}`}><i aria-hidden="true"></i>Выбрать «{p.name}»</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Пробный день и акции -->
    <section class="rm-sec" aria-labelledby="rm-trial-h">
      <div class="rm-w rm-trial">
        <div class="rm-dev rm-trial-dev">
          <div class="rm-display" aria-hidden="true"><b>1</b><span>₽</span></div>
          <div class="rm-trial-tx">
            <p class="rm-label">03 · Первый визит</p>
            <h2 id="rm-trial-h" class="rm-h2">Пробный день</h2>
            <p class="rm-p">{trial.text}</p>
            <ul class="rm-terms">{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
            <a class="rm-cta" href="#zayavka" data-lead={trial.title} data-block="34_trial"><i aria-hidden="true"></i>{trialPromo.cta}</a>
          </div>
        </div>
        {side.map((pr) => (
          <article class="rm-dev rm-side">
            <p class="rm-label">Акция</p>
            <h3>{pr.title}</h3>
            <p class="rm-p">{pr.text}</p>
            <a class="rm-link" href="#zayavka" data-lead={pr.goal} data-block={`34_promo_${pr.slug}`}>{pr.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Тренеры -->
    <section class="rm-sec" id="trenery" aria-labelledby="rm-team-h">
      <div class="rm-w">
        <div class="rm-head">
          <p class="rm-label">04 · Команда</p>
          <h2 id="rm-team-h" class="rm-h2">Тренеры клуба</h2>
        </div>
        <ul class="rm-team">
          {trainers.map((t) => (
            <li class="rm-dev rm-mod">
              <span class="rm-screen rm-team-scr"><Image src={img(t.photo)} alt={t.name} widths={[360, 520, 760]} sizes="(min-width: 1000px) 420px, calc(100vw - 72px)" loading="lazy" format="avif" quality={45} /></span>
              <h3>{t.name}</h3>
              <p class="rm-mod-tx">{t.role}</p>
            </li>
          ))}
        </ul>
        <div class="rm-dev rm-personal">
          <div>
            <p class="rm-label">Персонально</p>
            <h3>Персональные тренировки</h3>
          </div>
          <p class="rm-p">{personalText.lead}</p>
          <div class="rm-personal-r">
            <p class="rm-personal-p">{personalLine}</p>
            <p class="rm-mod-tx">{personal.firstFree}</p>
            <a class="rm-link" href="#zayavka" data-lead="Персональные тренировки" data-block="34_personal">Записаться к тренеру</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Отзывы: дисплей с переключателями -->
    <section class="rm-sec" id="otzyvy" aria-labelledby="rm-rev-h">
      <div class="rm-w">
        <div class="rm-head">
          <p class="rm-label">05 · Отзывы</p>
          <h2 id="rm-rev-h" class="rm-h2">Что пишут гости</h2>
        </div>
        <div class="rm-dev rm-rev" data-rev>
          <div class="rm-rev-score">
            <p class="rm-label">Яндекс Карты</p>
            <p class="rm-rev-num">{rating}</p>
            <p class="rm-mod-tx">из 5, {site.rating.text}</p>
            <a class="rm-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Все отзывы</a>
          </div>
          <div class="rm-rev-main">
            <ul class="rm-rev-track" data-track tabindex="0" aria-label="Отзывы гостей">
              {reviews.map((r) => (
                <li class="rm-rev-item">
                  <blockquote><p>{r.text}</p></blockquote>
                  <p class="rm-rev-who"><b>{r.name}</b><span class="rm-label">{r.source}</span></p>
                </li>
              ))}
            </ul>
            <div class="rm-rev-ctrl">
              <p class="rm-label rm-count" aria-live="polite"><span data-cur>01</span> / {String(reviews.length).padStart(2, '0')}</p>
              <button class="rm-btn-r" type="button" data-prev aria-label="Предыдущий отзыв"><Icon name="chev1" /></button>
              <button class="rm-btn-r" type="button" data-next aria-label="Следующий отзыв"><Icon name="chev1" /></button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="rm-sec rm-final" id="zayavka" aria-labelledby="rm-final-h">
      <div class="rm-w">
        <div class="rm-dev rm-final-dev">
          <div class="rm-final-tx">
            <p class="rm-label">06 · Запись</p>
            <h2 id="rm-final-h" class="rm-h2">Приходите на&nbsp;пробный день за&nbsp;1&nbsp;₽</h2>
            <dl class="rm-spec">
              <div><dt class="rm-label">Адрес</dt><dd>{site.address.locality}, {site.address.street}, {site.district}</dd></div>
              <div><dt class="rm-label">Часы</dt><dd>{site.hours.map((h, i) => <>{i > 0 && <br />}{`${h.days} ${h.time}`}</>)}</dd></div>
              <div><dt class="rm-label">Парковка</dt><dd>{site.parking}</dd></div>
              <div><dt class="rm-label">Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
            </dl>
          </div>
          <div class="rm-form">
            <LeadForm id="rm" block="34_final" />
          </div>
        </div>
      </div>
    </section>

    <footer class="rm-foot">
      <div class="rm-w">
        <div class="rm-foot-cols">
          <div>
            <a class="rm-logo" href="/concepts/34/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
            <p class="rm-mod-tx">{site.address.locality}, {site.address.street}<br />{hoursLine}</p>
          </div>
          <ul>
            <li class="rm-label">Связь</li>
            <li><a href={site.phone.href}>{site.phone.display}</a></li>
            <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
            <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
            <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
          </ul>
          <ul>
            <li class="rm-label">Клуб</li>
            <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li>
          </ul>
          <ul>
            <li class="rm-label">Документы</li>
            <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li>
          </ul>
        </div>
        <p class="rm-legal rm-label">© {new Date().getFullYear()} {site.legal.name} · ИНН {site.legal.inn} · ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.rm');
  if (root) {
    // Индикатор «открыто сейчас» по времени Хабаровска (UTC+10, как Владивосток)
    const hours: [string, string][] = JSON.parse(root.dataset.hours || '[]');
    const toMin = (s: string) => { const [h, m] = s.split(':').map(Number); return h * 60 + m; };
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Vladivostok', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const status = () => {
      const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((p) => [p.type, p.value]));
      const day = parts.weekday as string;
      const weekend = day === 'Sat' || day === 'Sun';
      const now = Number(parts.hour) * 60 + Number(parts.minute);
      const [o, c] = hours[weekend ? 1 : 0] || ['00:00', '00:00'];
      const open = now >= toMin(o) && now < toMin(c);
      let text: string;
      if (open) text = `Открыто до ${c}`;
      else if (now < toMin(o)) text = `Закрыто, откроемся в ${o}`;
      else {
        const tomorrowWeekend = day === 'Fri' || day === 'Sat';
        text = `Закрыто, откроемся в ${(hours[tomorrowWeekend ? 1 : 0] || [o])[0]}`;
      }
      root.querySelectorAll('[data-status]').forEach((el) => {
        el.classList.toggle('is-open', open);
        const t = el.querySelector('[data-status-text]');
        if (t) t.textContent = text;
      });
    };
    status();
    setInterval(status, 30000);

    // Ручка: нажатие поворачивает на следующий тариф
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="rm-plan"]')];
    root.querySelector('[data-knob]')?.addEventListener('click', () => {
      const i = radios.findIndex((r) => r.checked);
      const next = radios[(i + 1) % radios.length];
      next.checked = true;
      next.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // Отзывы: кнопки листают дорожку, счётчик следит за прокруткой
    const track = root.querySelector<HTMLElement>('[data-track]');
    const cur = root.querySelector<HTMLElement>('[data-cur]');
    if (track && cur) {
      const step = () => track.clientWidth;
      root.querySelector('[data-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      root.querySelector('[data-next]')?.addEventListener('click', () => {
        const end = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        track.scrollTo({ left: end ? 0 : track.scrollLeft + step(), behavior: 'smooth' });
      });
      track.addEventListener('scroll', () => { cur.textContent = String(Math.round(track.scrollLeft / step()) + 1).padStart(2, '0'); }, { passive: true });
    }
  }
</script>

<style is:global>
  body:has(.rm) { background: #e7e5e0; color: #1d1d1b; color-scheme: light; }
  body:has(.rm) ::selection { background: #1d1d1b; color: #f4f3ef; }
  body:has(.rm) :focus-visible { outline: 2px solid #1d1d1b; outline-offset: 3px; }
  body:has(.rm) .form { --ink: #1d1d1b; --muted: #76746e; --line: rgb(29 29 27 / 0.12); --card: #ecebe7; gap: 16px; padding: 0; background: transparent; border-radius: 0; color: #1d1d1b; font-family: 'Geo r', 'Geo fb', system-ui, sans-serif; }
  body:has(.rm) .form h3 { font-family: 'Geo r', 'Geo fb', system-ui, sans-serif; font-weight: 500; font-size: 1.375rem; letter-spacing: -0.02em; line-height: 1.2; }
  body:has(.rm) .form .field { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #76746e; gap: 8px; }
  body:has(.rm) .form .field input { border-radius: 14px; border: 0; background: #e3e1dc; box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.1); min-height: 56px; padding: 0 20px; font-size: 1.0625rem; letter-spacing: 0; text-transform: none; font-weight: 400; color: #1d1d1b; }
  body:has(.rm) .form .field input::placeholder { color: #9a9892; }
  body:has(.rm) .form .field input:focus { box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.1), 0 0 0 2px #1d1d1b; }
  body:has(.rm) .form .field.bad input { box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.1), 0 0 0 2px #ff5722; }
  body:has(.rm) .form .field .err, body:has(.rm) .form .consent.bad { color: #c2410c; text-transform: none; letter-spacing: 0; font-weight: 500; }
  body:has(.rm) .form .consent { color: #76746e; }
  body:has(.rm) .form .consent input { accent-color: #1d1d1b; }
