---
// Концепция 30 «Манга»: страница свёрстана как разворот манги. Панели с толстыми чёрными
// гаттерами и косыми срезами, линии скорости и взрывы нарисованы в SVG (генерируются при сборке),
// звуки-ономатопеи крупной кириллицей, отзывы в облачках, скринтон через CSS-точки,
// фото в чёрно-белой «туши». Единственный цвет: оранжевый. Цены и форма читаются без усилий.
import dgCyr from '@fontsource/dela-gothic-one/files/dela-gothic-one-cyrillic-400-normal.woff2?url';
import dgLat from '@fontsource/dela-gothic-one/files/dela-gothic-one-latin-400-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, personalText } from '../../../data/content';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Dela m';font-style:normal;font-display:swap;font-weight:400;src:url(${dgCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Dela m';font-style:normal;font-display:swap;font-weight:400;src:url(${dgLat}) format('woff2');unicode-range:${UL}}`;

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const side = promos.filter((p) => p.slug !== '1-rubl');
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;

// ---------- SVG-графика манги, считается при сборке ----------
const rnd = (seed: number) => () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const f = (n: number) => n.toFixed(1);
// линии концентрации: клинья от края к центру, центр пустой
function focus(n: number, seed: number, inner = 0.3, cx = 500, cy = 500) {
  const r = rnd(seed); let d = '';
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2 + r() * 0.06;
    const w = 0.003 + r() * 0.011;
    const r0 = 1000 * (inner + r() * 0.22);
    const R = 1600;
    d += `M${f(cx + Math.cos(a - w) * R)} ${f(cy + Math.sin(a - w) * R)}L${f(cx + Math.cos(a + w) * R)} ${f(cy + Math.sin(a + w) * R)}L${f(cx + Math.cos(a) * r0)} ${f(cy + Math.sin(a) * r0)}Z`;
  }
  return d;
}
// взрыв: неровная звезда в рамке -100..100
function burst(n: number, seed: number, rIn = 58, rOut = 98) {
  const r = rnd(seed); const pts: string[] = [];
  for (let i = 0; i < n * 2; i++) {
    const a = (i / (n * 2)) * Math.PI * 2;
    const rad = i % 2 ? rIn + r() * 8 : rOut - r() * 16;
    pts.push(`${f(Math.cos(a) * rad)} ${f(Math.sin(a) * rad)}`);
  }
  return `M${pts.join('L')}Z`;
}
// горизонтальные линии скорости (движение)
function streaks(n: number, seed: number) {
  const r = rnd(seed); let d = '';
  for (let i = 0; i < n; i++) {
    const y = r() * 1000, h = 1 + r() * 7, x0 = r() * 500, len = 300 + r() * 700;
    d += `M${f(x0)} ${f(y)}L${f(x0 + len)} ${f(y - h / 2)}L${f(x0 + len)} ${f(y + h / 2)}Z`;
  }
  return d;
}
// пар: волнистые линии
function steam(n: number, seed: number) {
  const r = rnd(seed); const out: string[] = [];
  for (let i = 0; i < n; i++) {
    const x = 80 + r() * 840, amp = 18 + r() * 30, top = r() * 300;
    let d = `M${f(x)} 1000`;
    let k = 0;
    for (let y = 1000; y > top; y -= 120, k++) d += `Q${f(k % 2 ? x + amp : x - amp)} ${f(y - 60)} ${f(x)} ${f(y - 120)}`;
    out.push(d);
  }
  return out;
}
const fx = {
  heroA: focus(150, 7, 0.3, 560, 360), heroB: focus(150, 19, 0.32, 560, 360),
  trialA: focus(170, 3, 0.26), trialB: focus(170, 41, 0.28),
  finalA: focus(160, 11, 0.36, 320, 480),
  b1: burst(14, 5), b2: burst(18, 9, 64, 98), b3: burst(11, 13, 54, 98), b4: burst(22, 17, 70, 98),
  s1: streaks(70, 23), s2: streaks(60, 29),
  steam: steam(7, 31),
};
const sfx = { zal: 'ЛЯЗГ!', cardio: 'ТУК-ТУК', group: 'РАЗ! ДВА!', spa: 'ПШШШ' };
---
<Layout title="Концепция 30 «Манга»" description="Концепция дизайна сайта Urban210: страница как разворот манги, панели, линии скорости, звуки и облачка." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={dgCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="mg">
    <header class="mg-top">
      <div class="mg-top-in">
        <a class="mg-logo" href="/concepts/30/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="mg-nav" aria-label="Разделы">
          <a href="#zony">Локации</a><a href="#tarify">Цены</a><a href="#komanda">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="mg-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="mg-btn mg-btn-s" href="#zayavka" data-lead={trial.title} data-block="30_header">1 ₽<span class="mg-hide-s">&nbsp;пробный день</span></a>
      </div>
    </header>

    <!-- Глава 1: первый экран как разворот -->
    <section class="pg pg-hero" aria-labelledby="mg-h1">
      <div class="pn p-title kb-top">
        <span class="tone tone-tr" aria-hidden="true"></span>
        <div class="p-title-in">
          <p class="chap"><b>Глава 1</b><span>Хабаровск, {site.address.short}</span></p>
          <h1 id="mg-h1" class="mg-h1">Первый подход <em>за&nbsp;1&nbsp;₽</em></h1>
          <p class="mg-lead">Фитнес-клуб Urban210: тренажёрный зал, кардио, групповые программы и SPA в {site.district === 'Железнодорожный район' ? 'Железнодорожном районе' : site.district}. Пробный день за 1&nbsp;₽, вступительного взноса нет.</p>
          <div class="mg-acts">
            <a class="mg-btn" href="#zayavka" data-lead={trial.title} data-block="30_hero">Записаться за 1 ₽<Icon name="chev" /></a>
            <a class="mg-btn mg-btn-line" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>
      </div>

      <div class="pn p-man ka" data-mg>
        <svg class="lines flick" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path class="la" d={fx.heroA} /><path class="lb" d={fx.heroB} /></svg>
        <svg class="burst burst-man" viewBox="-100 -100 200 200" aria-hidden="true"><path d={fx.b2} /></svg>
        <Image class="man" src={cutout} alt="Александр Лазько, координатор тренажёрного зала Urban210" widths={[360, 520, 720]} sizes="(min-width: 900px) 40vw, 86vw" loading="eager" fetchpriority="high" format="webp" quality={60} />
        <span class="sfx sfx-zhmi" aria-hidden="true">ЖМИ!</span>
        <p class="box box-man"><b>Александр Лазько</b>координатор тренажёрного зала</p>
      </div>

      <div class="pn p-act kb-bot" data-mg>
        <div class="ink">
          <Image src={img('/images/free-weights.jpg')} alt="Гантели в зале свободных весов" widths={[420, 640, 860]} sizes="(min-width: 900px) 46vw, 96vw" loading="lazy" format="avif" quality={45} />
          <video class="ink-video" data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
        </div>
        <svg class="streaks" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true"><path d={fx.s1} /></svg>
        <span class="boom" aria-hidden="true"><svg viewBox="-100 -100 200 200"><path d={fx.b1} /></svg><b>БАХ!</b></span>
        <a class="bubble bubble-rate" href={site.maps.yandexReviews} target="_blank" rel="noopener"><b>{rating} на Яндекс Картах!</b><span>{site.rating.text}</span></a>
      </div>
    </section>

    <!-- Почему здесь: четыре маленькие панели -->
    <section class="pg pg-why" aria-label="Почему Urban210">
      {reasons.map((r, i) => (
        <article class={`pn why why-${i}`} data-mg style={`--d:${i * 80}ms`}>
          {i % 2 === 0 && <span class="tone tone-bl" aria-hidden="true"></span>}
          <h2>{r.title}</h2>
          <p>{r.text}</p>
        </article>
      ))}
    </section>

    <!-- Глава 2: локации -->
    <section class="pg pg-zones" id="zony" aria-labelledby="mg-zones-h">
      <div class="pn p-head">
        <p class="chap"><b>Глава 2</b><span>Локации</span></p>
        <h2 id="mg-zones-h" class="mg-h2">Четыре зоны на одной карте</h2>
      </div>
      <a class="pn zn zn-zal ka" href={z.zal.href} data-mg>
        <span class="ink"><Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 760, 1040]} sizes="(min-width: 900px) 62vw, 96vw" loading="lazy" format="avif" quality={42} /></span>
        <span class="sfx sfx-zone s-zal" aria-hidden="true">{sfx.zal}</span>
        <span class="box zn-box"><h3>{z.zal.title}<Icon name="chev" /></h3><span>{cap(z.zal.text)}</span></span>
      </a>
      <a class="pn zn zn-cardio kb" href={z.cardio.href} data-mg>
        <span class="ink"><Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[420, 640, 820]} sizes="(min-width: 900px) 40vw, 96vw" loading="lazy" format="avif" quality={42} /></span>
        <svg class="streaks streaks-l" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true"><path d={fx.s2} /></svg>
        <span class="sfx sfx-zone s-cardio" aria-hidden="true">{sfx.cardio}</span>
        <span class="box zn-box"><h3>{z.cardio.title}<Icon name="chev" /></h3><span>{z.cardio.text}</span></span>
      </a>
      <a class="pn zn zn-group kc" href={z.group.href} data-mg>
        <span class="ink"><Image src={img('/images/group-strength.jpg')} alt="Силовая групповая тренировка с гантелями" widths={[420, 640, 820]} sizes="(min-width: 900px) 46vw, 96vw" loading="lazy" format="avif" quality={42} /></span>
        <span class="sfx sfx-zone s-group" aria-hidden="true">{sfx.group}</span>
        <span class="box zn-box"><h3>{z.group.title}<Icon name="chev" /></h3><span>{cap(z.group.text)}</span></span>
      </a>
      <a class="pn zn zn-spa kd" href={z.spa.href} data-mg>
        <span class="tone tone-full" aria-hidden="true"></span>
        <svg class="steam" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">{fx.steam.map((d) => <path d={d} />)}</svg>
        <span class="sfx sfx-zone s-spa" aria-hidden="true">{sfx.spa}</span>
        <span class="box zn-box"><h3>{z.spa.title}<Icon name="chev" /></h3><span>{z.spa.text}</span><small>В тарифе «{plans[2].name}»</small></span>
      </a>
    </section>

    <!-- Глава 3: цены -->
    <section class="pg pg-price" id="tarify" aria-labelledby="mg-price-h">
      <div class="pn p-head">
        <p class="chap"><b>Глава 3</b><span>Цена вопроса</span></p>
        <h2 id="mg-price-h" class="mg-h2">Три тарифа. Вступительный взнос: 0&nbsp;₽</h2>
      </div>
      {plans.map((p, i) => (
        <article class={`pn pl ${i === 1 ? 'pl-hot' : ''}`} data-mg style={`--d:${i * 90}ms`}>
          {p.tag && <span class="pl-tag"><svg viewBox="-100 -100 200 200" aria-hidden="true"><path d={i === 1 ? fx.b3 : fx.b4} /></svg><b>{p.tag}</b></span>}
          <h3>{p.name}</h3>
          <p class="pl-hours">{cap(p.hours)}</p>
          <p class="pl-price"><b>{num(p.month)}</b><span>₽<br />в месяц</span></p>
          <p class="pl-year">За год {rub(p.year)}, это {perDay(p.year, 365)}&nbsp;₽ в день</p>
          <ul>
            {p.features.map((x) => <li><Icon name="check" />{x}</li>)}
            {p.excluded?.map((x) => <li class="no"><Icon name="minus" />{x}</li>)}
          </ul>
          <a class={`mg-btn mg-btn-w ${i === 1 ? 'mg-btn-ink' : ''}`} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`30_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
        </article>
      ))}

      <div class="pn p-trial" data-mg>
        <svg class="lines lines-w flick" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path class="la" d={fx.trialA} /><path class="lb" d={fx.trialB} /></svg>
        <div class="trial-burst" aria-hidden="true">
          <svg viewBox="-100 -100 200 200"><path d={fx.b4} /></svg>
          <b>1&nbsp;₽</b>
        </div>
        <div class="box trial-box">
          <h3>Пробный день</h3>
          <p>{trial.text}</p>
          <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
          <a class="mg-btn" href="#zayavka" data-lead={trial.title} data-block="30_trial">{trialPromo.cta}<Icon name="chev" /></a>
        </div>
      </div>
      {side.map((pr, i) => (
        <article class={`pn promo-${i}`} data-mg>
          <span class="tone tone-tr" aria-hidden="true"></span>
          <h3>{pr.title}</h3>
          <p>{pr.text}</p>
          <a class="mg-more" href="#zayavka" data-lead={pr.goal} data-block={`30_promo_${pr.slug}`}>{pr.cta}<Icon name="chev" /></a>
        </article>
      ))}
    </section>

    <!-- Глава 4: тренеры -->
    <section class="pg pg-team" id="komanda" aria-labelledby="mg-team-h">
      <div class="pn p-head">
        <p class="chap"><b>Глава 4</b><span>Наставники</span></p>
        <h2 id="mg-team-h" class="mg-h2">Тренеры клуба</h2>
      </div>
      {trainers.map((t, i) => (
        <figure class={`pn tm tm-${i}`} data-mg style={`--d:${i * 90}ms`}>
          <span class="ink ink-face"><Image src={img(t.photo)} alt={t.name} widths={[360, 520, 700]} sizes="(min-width: 900px) 32vw, 96vw" loading="lazy" format="avif" quality={48} /></span>
          <figcaption class="box"><b>{t.name}</b>{t.role}</figcaption>
        </figure>
      ))}
      <div class="pn p-personal" data-mg>
        <div>
          <h3>Персональные тренировки</h3>
          <p>{personalText.lead}</p>
        </div>
        <div class="pp">
          <p class="pp-price">{personalLine}</p>
          <p class="pp-bonus">{personal.firstFree}</p>
          <a class="mg-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="30_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Глава 5: отзывы в облачках -->
    <section class="pg pg-rev" id="otzyvy" aria-labelledby="mg-rev-h">
      <div class="pn p-rev">
        <span class="tone tone-full tone-soft" aria-hidden="true"></span>
        <div class="rev-head">
          <p class="chap"><b>Глава 5</b><span>Голоса</span></p>
          <h2 id="mg-rev-h" class="mg-h2">Что говорят гости</h2>
          <a class="rev-score" href={site.maps.yandexReviews} target="_blank" rel="noopener">
            <svg viewBox="-100 -100 200 200" aria-hidden="true"><path d={fx.b2} /></svg>
            <b>{rating}</b><span>из 5<br />Яндекс Карты</span>
          </a>
        </div>
        <div class="bubbles">
          {reviews.map((r, i) => (
            <figure class={`say say-${i}`} data-mg style={`--d:${i * 90}ms`}>
              <blockquote class="bubble"><p>{r.text}</p></blockquote>
              <figcaption><b>{r.name}</b><span>{r.source}</span></figcaption>
            </figure>
          ))}
        </div>
        <a class="mg-more rev-all" href={site.maps.yandexReviews} target="_blank" rel="noopener">Все {site.rating.text} на Яндекс Картах<Icon name="chev" /></a>
      </div>
    </section>

    <!-- Финал -->
    <section class="pg pg-final" id="zayavka" aria-labelledby="mg-final-h">
      <div class="pn p-final ka">
        <svg class="lines" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path class="la" d={fx.finalA} /></svg>
        <div class="final-tx">
          <p class="chap"><b>Финал</b><span>Твой ход</span></p>
          <h2 id="mg-final-h" class="mg-h1 mg-h1-final">Приходи <em>за&nbsp;1&nbsp;₽</em></h2>
          <dl class="facts">
            <div class="box"><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}, {site.district}</dd></div>
            <div class="box"><dt>Часы</dt><dd>{site.hours.map((h) => `${h.days} ${h.time}`).join(', ')}</dd></div>
            <div class="box"><dt>Парковка</dt><dd>{site.parking}</dd></div>
            <div class="box"><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
      </div>
      <div class="pn p-form kb" data-mg>
        <span class="sfx sfx-form" aria-hidden="true">ЖМИ!</span>
        <LeadForm id="mg" block="30_final" />
      </div>
    </section>

    <footer class="mg-foot">
      <p class="mg-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
      <div class="mg-foot-cols">
        <div>
          <h2>Клуб</h2>
          <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
          <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
        </div>
        <div>
          <h2>Связь</h2>
          <ul>
            <li><a href={site.phone.href}>{site.phone.display}</a></li>
            <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
            <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
            <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
        <div>
          <h2>Клуб и цены</h2>
          <ul>
            <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
          </ul>
        </div>
        <div>
          <h2>Документы</h2>
          <ul>
            <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
          </ul>
        </div>
      </div>
      <p class="mg-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
    </footer>
  </div>
</Layout>

<script>
  // Панели «влетают» один раз, звуки выскакивают следом. Без JS и при reduce всё на месте.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('.mg [data-mg]');
  if (reduce || !('IntersectionObserver' in window)) items.forEach((el) => el.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    items.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  body:has(.mg) { background: #0e0d0c; color: #0e0d0c; overflow-x: clip; }
  body:has(.mg) ::selection { background: #ff5722; color: #0e0d0c; }
  body:has(.mg) :focus-visible { outline: 3px solid #ff5722; outline-offset: 3px; }
  body:has(.mg) .form { background: #fbf9f4; color: #0e0d0c; --ink: #0e0d0c; --muted: #45413c; --line: #0e0d0c; border: 3px solid #0e0d0c; border-radius: 0; gap: 14px; padding: clamp(22px, 3vw, 34px); }
  body:has(.mg) .form h3 { font-family: 'Dela m', 'Arial Black', sans-serif; font-weight: 400; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.05; letter-spacing: -0.01em; }
  body:has(.mg) .form .muted, body:has(.mg) .form .consent, body:has(.mg) .form .form-note, body:has(.mg) .form .form-note a { color: #45413c; }
  body:has(.mg) .form .field { color: #0e0d0c; font-weight: 700; }
  body:has(.mg) .form .field input { border-radius: 0; border: 2.5px solid #0e0d0c; background: #fff; color: #0e0d0c; min-height: 56px; font-size: 1.05rem; }
  body:has(.mg) .form .field input::placeholder { color: #8b857d; }
  body:has(.mg) .form .field input:focus { border-color: #ff5722; box-shadow: 4px 4px 0 #0e0d0c; }
  body:has(.mg) .form .field .err, body:has(.mg) .form .consent.bad { color: #c2300c; }
  body:has(.mg) .form .field.bad input { border-color: #c2300c; }
  body:has(.mg) .form .consent input { accent-color: #0e0d0c; }
  body:has(.mg) .form .btn { border-radius: 0; min-height: 60px; background: #ff5722; color: #0e0d0c; border: 3px solid #0e0d0c; box-shadow: 5px 5px 0 #0e0d0c; font-family: 'Dela m', 'Arial Black', sans-serif; font-weight: 400; font-size: 1.15rem; transition: transform 0.15s ease, box-shadow 0.15s ease; }
  body:has(.mg) .form .btn:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 #0e0d0c; }
  body:has(.mg) .form .btn:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 #0e0d0c; }
  body:has(.mg) .form .form-msg.is-err { border-radius: 0; background: #ffe1d6; color: #8f1a0c; border: 2px solid #0e0d0c; }
  body:has(.mg) .form .form-done .ok { background: #ff5722; color: #0e0d0c; border: 3px solid #0e0d0c; }
  body:has(.mg) dialog.lead::backdrop { background: rgb(14 13 12 / 0.85); backdrop-filter: none; }
  body:has(.mg) dialog.lead .form { box-shadow: 10px 10px 0 #ff5722; }
  body:has(.mg) dialog.lead .x { color: #0e0d0c; }
  body:has(.mg) .mbar { background: #fbf9f4; border-top: 3px solid #0e0d0c; backdrop-filter: none; }
  body:has(.mg) .mbar a.ic { border-radius: 0; border: 2.5px solid #0e0d0c; color: #0e0d0c; }
  body:has(.mg) .mbar .btn { border-radius: 0; background: #ff5722; color: #0e0d0c; border: 2.5px solid #0e0d0c; font-family: 'Dela m', 'Arial Black', sans-serif; font-weight: 400; font-size: 0.86rem; padding: 0 12px; }
</style>

<style>
  .mg {
    --paper: #f6f3ec; --ink: #0e0d0c; --or: #ff5722; --grey: #45413c;
    --fd: 'Dela m', 'Arial Black', sans-serif;
    --fb: 'Golos Text Variable', system-ui, sans-serif;
    --G: 8px; --S: 0px;
    --ez: cubic-bezier(0.2, 0.9, 0.25, 1);
    background: var(--ink); color: var(--ink); font-family: var(--fb); font-size: 1.0625rem; line-height: 1.5;
  }
  @media (min-width: 900px) { .mg { --G: 12px; --S: 64px; } }
  .mg :global(h1), .mg :global(h2), .mg :global(h3) { font-family: var(--fd); font-weight: 400; hyphens: manual; -webkit-hyphens: manual; text-transform: none; letter-spacing: -0.01em; }
  .mg p { text-wrap: pretty; }
  .mg figure, .mg blockquote { margin: 0; }

  /* ---------- Кнопки ---------- */
  .mg-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 58px; padding: 0 24px;
    background: var(--or); color: var(--ink); border: 3px solid var(--ink); box-shadow: 5px 5px 0 var(--ink);
    font-family: var(--fd); font-size: 1.08rem; line-height: 1.1; text-decoration: none; white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .mg-btn :global(svg) { width: 18px; height: 15px; flex: none; }
  .mg-btn:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
  .mg-btn:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--ink); }
  .mg-btn-line { background: var(--paper); }
  .mg-btn-ink { background: var(--ink); color: var(--paper); box-shadow: 5px 5px 0 var(--paper); border-color: var(--ink); }
  .mg-btn-ink :global(svg) { color: var(--or); }
  .mg-btn-ink:hover { box-shadow: 7px 7px 0 var(--paper); }
  .mg-btn-s { min-height: 44px; padding: 0 14px; font-size: 0.92rem; box-shadow: 3px 3px 0 var(--paper); border-color: var(--paper); }
  .mg-btn-s:hover { box-shadow: 5px 5px 0 var(--paper); }
  .mg-btn-w { width: 100%; justify-content: space-between; }
  .mg-more { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; font-weight: 800; color: var(--ink); text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--or); text-underline-offset: 6px; }
  .mg-more :global(svg) { width: 15px; height: 13px; color: var(--or); }

  /* ---------- Шапка ---------- */
  .mg-top { position: sticky; top: 0; z-index: 30; background: var(--ink); color: var(--paper); border-bottom: 3px solid var(--ink); }
  .mg-top-in { display: flex; align-items: center; gap: 26px; min-height: 64px; padding-inline: clamp(16px, 2vw, 24px); }
  .mg-logo { display: inline-flex; align-items: center; gap: 6px; font-family: var(--fd); font-size: 1.3rem; color: var(--paper); text-decoration: none; letter-spacing: 0.01em; }
  .mg-logo :global(svg) { width: 18px; height: 17px; color: var(--or); }
  .mg-nav { display: none; gap: 24px; margin-left: auto; }
  .mg-nav a { color: var(--paper); text-decoration: none; font-weight: 800; font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .mg-nav a:hover { color: var(--or); }
  .mg-tel { display: none; color: var(--paper); text-decoration: none; font-weight: 700; white-space: nowrap; }
  .mg-top .mg-btn { margin-left: auto; }
  .mg-hide-s { display: none; }
  @media (min-width: 1100px) {
    .mg-nav, .mg-tel { display: flex; }
    .mg-top .mg-btn { margin-left: 0; }
    .mg-hide-s { display: inline; }
  }

  /* ---------- Страница и панели ---------- */
  .pg { display: grid; gap: var(--G); padding: 0 var(--G) var(--G); max-width: 1600px; margin: 0 auto; }
  .pn { position: relative; background: var(--paper); overflow: hidden; isolation: isolate; }
  .chap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-weight: 700; font-size: 0.9rem; }
  .chap b { background: var(--ink); color: var(--paper); padding: 4px 10px; font-family: var(--fd); font-weight: 400; font-size: 0.86rem; letter-spacing: 0.04em; }
  .mg-h2 { font-size: clamp(2rem, 4.4vw, 3.8rem); line-height: 1; margin-top: 14px; max-width: 18ch; text-wrap: balance; }
  .p-head { padding: clamp(24px, 3.4vw, 48px); }
  .box { background: #fff; border: 3px solid var(--ink); padding: 10px 14px; }

  /* Срезы гаттеров (только десктоп, где --S > 0) */
  @media (min-width: 900px) {
    .ka { clip-path: polygon(0 0, 100% 0, calc(100% - var(--S)) 100%, 0 100%); }
    .kb { margin-left: calc(var(--S) * -1); clip-path: polygon(calc(var(--S) + var(--G)) 0, 100% 0, 100% 100%, var(--G) 100%); }
    .kc { clip-path: polygon(0 0, calc(100% - var(--S)) 0, 100% 100%, 0 100%); }
    .kd { margin-left: calc(var(--S) * -1); clip-path: polygon(var(--G) 0, 100% 0, 100% 100%, calc(var(--S) + var(--G)) 100%); }
    .kb-top { margin-left: calc(var(--S) * -1); clip-path: polygon(calc(var(--S) + var(--G)) 0, 100% 0, 100% 100%, calc(var(--S) / 2 + var(--G)) 100%); }
    .kb-bot { margin-left: calc(var(--S) * -1); clip-path: polygon(calc(var(--S) / 2 + var(--G)) 0, 100% 0, 100% 100%, var(--G) 100%); }
  }

  /* Скринтон */
  .tone { position: absolute; z-index: -1; pointer-events: none; background-image: radial-gradient(circle, var(--ink) 34%, transparent 37%); background-size: 9px 9px; }
  .tone-tr { inset: 0 0 auto auto; width: 70%; height: 80%; -webkit-mask-image: radial-gradient(farthest-side at 100% 0, #000 10%, transparent 100%); mask-image: radial-gradient(farthest-side at 100% 0, #000 10%, transparent 100%); opacity: 0.5; }
  .tone-bl { inset: auto auto 0 0; width: 80%; height: 90%; -webkit-mask-image: radial-gradient(farthest-side at 0 100%, #000, transparent); mask-image: radial-gradient(farthest-side at 0 100%, #000, transparent); opacity: 0.35; }
  .tone-full { inset: 0; -webkit-mask-image: linear-gradient(160deg, #000, rgb(0 0 0 / 0.15) 70%); mask-image: linear-gradient(160deg, #000, rgb(0 0 0 / 0.15) 70%); opacity: 0.6; }
  .tone-soft { opacity: 0.16; background-size: 7px 7px; }

  /* Тушь: ч/б с высоким контрастом и растровой точкой */
  .ink { position: absolute; inset: 0; background: var(--paper); }
  .ink :global(img), .ink video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(2) brightness(1.12); }
  .ink::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, var(--ink) 30%, transparent 33%); background-size: 5px 5px; mix-blend-mode: multiply; opacity: 0.22; pointer-events: none; }
  .ink-video { opacity: 0; transition: opacity 0.6s ease; }
  .ink-video:global(.is-on) { opacity: 1; }

  /* SVG-линии */
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; fill: var(--ink); }
  .lines-w { fill: var(--paper); }
  .streaks { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--paper); opacity: 0.55; pointer-events: none; }
  .streaks-l { transform: scaleX(-1); }
  @media (prefers-reduced-motion: no-preference) {
    .flick .lb { animation: mg-flick 0.3s steps(1) infinite; }
    .flick .la { animation: mg-flick 0.3s steps(1) infinite reverse; }
  }
  .flick .lb { opacity: 0; }
  @keyframes mg-flick { 0% { opacity: 1; } 50% { opacity: 0; } }

  /* Звуки */
  .sfx {
    position: absolute; z-index: 3; font-family: var(--fd); line-height: 0.9; color: var(--or); white-space: nowrap; pointer-events: none;
    -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; text-shadow: 5px 5px 0 var(--ink);
  }

  /* Появление: панель встаёт, звук выскакивает */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mg [data-mg] { opacity: 0; transform: scale(0.96); transition: opacity 0.45s var(--ez) var(--d, 0ms), transform 0.6s var(--ez) var(--d, 0ms); }
    :global(.js) .mg [data-mg].on { opacity: 1; transform: none; }
    :global(.js) .mg [data-mg] .sfx { transform: scale(0.3) rotate(var(--r, -8deg)); opacity: 0; transition: transform 0.45s var(--ez) 0.25s, opacity 0.2s ease 0.25s; }
    :global(.js) .mg [data-mg].on .sfx { transform: rotate(var(--r, -8deg)); opacity: 1; }
  }
  .sfx { transform: rotate(var(--r, -8deg)); }

  /* ---------- Глава 1 ---------- */
  .pg-hero { padding-top: var(--G); }
  .p-title-in { position: relative; padding: clamp(26px, 3.4vw, 52px); padding-left: clamp(26px, 3.4vw, 52px); }
  .mg-h1 { margin-top: 18px; font-size: clamp(2.7rem, 11vw, 5.6rem); line-height: 0.98; letter-spacing: -0.02em; }
  .mg-h1 em { font-style: normal; display: inline-block; color: var(--or); -webkit-text-stroke: 2px var(--ink); paint-order: stroke fill; text-shadow: 4px 4px 0 var(--ink); }
  .mg-lead { margin-top: 20px; max-width: 46ch; font-size: 1.05rem; font-weight: 500; }
  .mg-acts { display: flex; flex-wrap: wrap; gap: 16px 18px; margin-top: 26px; }

  .p-man { min-height: 520px; }
  .p-man .lines { z-index: 0; }
  .burst-man { position: absolute; z-index: 0; width: 82%; left: 9%; top: 6%; fill: var(--or); stroke: var(--ink); stroke-width: 2.5; }
  .p-man :global(.man) { position: absolute; z-index: 1; bottom: 0; left: 50%; transform: translateX(-50%); height: 94%; width: auto; max-width: none; filter: grayscale(1) contrast(1.55) brightness(1.08); }
  .sfx-zhmi { left: 5%; top: 7%; font-size: clamp(4.2rem, 17vw, 9rem); --r: -10deg; }
  .box-man { position: absolute; z-index: 3; left: 4%; bottom: 5%; display: grid; font-size: 0.84rem; line-height: 1.3; max-width: 60%; }
  .box-man b { font-family: var(--fd); font-weight: 400; font-size: 1rem; }

  .p-act { min-height: 300px; }
  .boom { position: absolute; z-index: 3; left: 6%; top: 8%; width: clamp(150px, 15vw, 210px); aspect-ratio: 1; display: grid; place-items: center; }
  .boom svg { position: absolute; inset: 0; fill: var(--or); stroke: var(--ink); stroke-width: 3; }
  .boom b { position: relative; font-family: var(--fd); font-weight: 400; font-size: clamp(1.9rem, 2.6vw, 2.5rem); transform: rotate(-8deg); }
  .bubble {
    position: relative; display: block; background: #fff; color: var(--ink); border: 3px solid var(--ink); border-radius: 44px; padding: 18px 24px; text-decoration: none;
  }
  .bubble::after { content: ''; position: absolute; width: 26px; height: 26px; background: #fff; border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink); left: 38px; bottom: -15px; transform: skewX(30deg) rotate(45deg); }
  .bubble-rate { position: absolute; z-index: 3; right: 5%; bottom: 10%; display: grid; text-align: center; padding: 14px 24px; }
  .bubble-rate b { font-family: var(--fd); font-weight: 400; font-size: 1.15rem; }
  .bubble-rate span { font-size: 0.85rem; font-weight: 600; }
  .bubble-rate::after { left: auto; right: 40px; bottom: auto; top: -15px; transform: skewX(-30deg) rotate(45deg) scale(-1); }

  @media (min-width: 900px) {
    .pg-hero { grid-template-columns: repeat(12, 1fr); grid-template-rows: auto auto; column-gap: 0; min-height: calc(100svh - 67px); }
    .p-man { grid-column: 1 / 7; grid-row: 1 / 3; order: -1; min-height: 0; }
    .p-title { grid-column: 7 / 13; grid-row: 1; }
    .p-title-in { padding-left: calc(var(--S) + var(--G) + 36px); }
    .p-act { grid-column: 7 / 13; grid-row: 2; min-height: 280px; }
    .mg-h1 { font-size: clamp(3rem, 4.6vw, 5rem); }
    .sfx-zhmi { font-size: clamp(5rem, 8.4vw, 9rem); }
  }

  /* ---------- Причины ---------- */
  .why { padding: 26px 24px 28px; }
  .why h2 { font-size: 1.3rem; line-height: 1.1; }
  .why p { margin-top: 10px; font-size: 0.98rem; font-weight: 500; }
  .why-1 { background: var(--or); }
  .why-3 { background: var(--ink); color: var(--paper); }
  @media (min-width: 700px) { .pg-why { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .pg-why { grid-template-columns: repeat(4, 1fr); } }

  /* ---------- Глава 2: зоны ---------- */
  .zn { display: block; min-height: 380px; color: var(--ink); text-decoration: none; }
  .zn-box { position: absolute; z-index: 4; left: 16px; right: 16px; bottom: 16px; display: grid; gap: 6px; max-width: 460px; font-size: 0.95rem; font-weight: 500; line-height: 1.4; }
  .zn-box h3 { display: flex; align-items: center; gap: 10px; font-size: 1.35rem; line-height: 1.05; }
  .zn-box h3 :global(svg) { width: 17px; height: 15px; color: var(--or); flex: none; transition: transform 0.2s ease; }
  .zn:hover .zn-box h3 :global(svg) { transform: translateX(5px); }
  .zn-box small { justify-self: start; margin-top: 6px; background: var(--or); border: 2px solid var(--ink); padding: 3px 10px; font-weight: 800; font-size: 0.8rem; }
  .zn .ink :global(img) { transition: transform 0.6s var(--ez); }
  .zn:hover .ink :global(img) { transform: scale(1.04); }
  .sfx-zone { font-size: clamp(2.6rem, 6vw, 5.2rem); }
  .s-zal { right: 6%; top: 8%; --r: 7deg; }
  .s-cardio { left: 10%; top: 9%; --r: -6deg; font-size: clamp(2.2rem, 4.4vw, 3.8rem); }
  .s-group { right: 6%; top: 10%; --r: -9deg; }
  .s-spa { left: 12%; top: 12%; --r: -4deg; color: var(--paper); font-size: clamp(3rem, 8vw, 6.4rem); letter-spacing: 0.04em; }
  .zn-spa { background: var(--or); }
  .steam { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--ink); stroke-width: 5; stroke-linecap: round; opacity: 0.85; }
  .zn-spa .tone-full { opacity: 0.4; }
  @media (prefers-reduced-motion: no-preference) {
    .steam path { stroke-dasharray: 60 40; animation: mg-steam 3s linear infinite; }
  }
  @keyframes mg-steam { to { stroke-dashoffset: -200; } }
  @media (min-width: 900px) {
    .pg-zones { grid-template-columns: repeat(12, 1fr); column-gap: 0; }
    .pg-zones .p-head { grid-column: 1 / -1; }
    .zn-zal { grid-column: 1 / 9; min-height: 520px; }
    .zn-cardio { grid-column: 9 / 13; min-height: 520px; }
    .zn-group { grid-column: 1 / 6; min-height: 460px; }
    .zn-spa { grid-column: 6 / 13; min-height: 460px; }
    .zn-cardio .zn-box, .zn-spa .zn-box { left: calc(var(--S) + var(--G) + 16px); }
    .zn-cardio .zn-box { left: calc(var(--G) + 16px); }
  }

  /* ---------- Глава 3: цены ---------- */
  .pl { display: flex; flex-direction: column; padding: clamp(24px, 2.6vw, 36px); }
  .pl h3 { font-size: clamp(1.5rem, 2.2vw, 1.9rem); line-height: 1.05; padding-right: 108px; }
  .pl-hours { margin-top: 8px; font-weight: 600; color: var(--grey); }
  .pl-price { display: flex; align-items: flex-end; gap: 10px; margin-top: 22px; padding-top: 18px; border-top: 3px solid var(--ink); }
  .pl-price b { font-family: var(--fd); font-weight: 400; font-size: clamp(3.6rem, 6vw, 5.4rem); line-height: 0.85; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .pl-price span { font-weight: 800; font-size: 0.95rem; line-height: 1.15; padding-bottom: 4px; }
  .pl-year { margin-top: 14px; font-weight: 700; font-size: 0.95rem; }
  .pl ul { list-style: none; display: grid; gap: 10px; margin: 22px 0 28px; flex: 1; align-content: start; }
  .pl li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-weight: 500; font-size: 0.98rem; line-height: 1.4; }
  .pl li :global(svg) { width: 20px; height: 20px; margin-top: 1px; }
  .pl li.no { color: var(--grey); }
  .pl li.no :global(svg) { opacity: 0.6; }
  .pl-tag { position: absolute; top: 8px; right: 8px; width: 124px; aspect-ratio: 1; display: grid; place-items: center; }
  .pl-tag svg { position: absolute; inset: 0; fill: var(--ink); }
  .pl-tag b { position: relative; color: var(--paper); font-family: var(--fd); font-weight: 400; font-size: 0.68rem; transform: rotate(-10deg); }
  .pl-hot { background: var(--or); }
  .pl-hot .pl-hours, .pl-hot li.no { color: #3a1606; }
  .pl-hot .pl-tag svg { fill: var(--paper); stroke: var(--ink); stroke-width: 4; }
  .pl-hot .pl-tag b { color: var(--ink); }

  .p-trial { background: var(--ink); color: var(--ink); min-height: 460px; display: grid; align-content: center; gap: 28px; padding: 40px 18px 28px; }
  .trial-burst { position: relative; justify-self: center; width: min(78vw, 420px); aspect-ratio: 1; display: grid; place-items: center; }
  .trial-burst svg { position: absolute; inset: 0; fill: var(--or); stroke: var(--paper); stroke-width: 3; }
  .trial-burst b { position: relative; font-family: var(--fd); font-weight: 400; font-size: clamp(5rem, 22vw, 9.6rem); line-height: 1; transform: rotate(-8deg); letter-spacing: -0.03em; }
  .trial-box { position: relative; display: grid; gap: 14px; justify-items: start; padding: clamp(20px, 2.4vw, 32px); width: 100%; max-width: 540px; justify-self: center; }
  .trial-box .mg-btn { white-space: normal; text-align: left; }
  .trial-box h3 { font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1; }
  .trial-box p { font-weight: 500; }
  .trial-box ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .trial-box li { border: 2px solid var(--ink); padding: 3px 10px; font-weight: 700; font-size: 0.86rem; }
  .trial-box .mg-btn { margin-top: 6px; }
  .promo-0, .promo-1 { padding: 26px 24px 18px; }
  .promo-0 h3, .promo-1 h3 { font-size: 1.4rem; line-height: 1.05; }
  .promo-0 p, .promo-1 p { margin-top: 10px; font-weight: 500; font-size: 0.98rem; max-width: 52ch; }
  @media (min-width: 900px) {
    .pg-price { grid-template-columns: repeat(6, 1fr); }
