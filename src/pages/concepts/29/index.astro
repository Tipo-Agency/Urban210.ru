---
// Концепция 29 «Жидкий свет»: спокойный премиальный клуб, как дорогой wellness-бренд.
// Атмосфера бренда: медленно текущий градиент (оранжевый, бордо, почти чёрный, тёплый янтарь).
// На десктопе после load его рисует лёгкий WebGL-шейдер (полразрешения, 30 кадров, пауза вне экрана),
// на телефоне и без WebGL работает CSS-версия из мягких пятен (только transform).
// Тёмные секции «закрывают» свет, а первый экран, пробный день и заявка открывают его, как окна.
import mnCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import mnLat from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, personalText } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Manrope l';font-style:normal;font-display:swap;font-weight:200 800;src:url(${mnCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Manrope l';font-style:normal;font-display:swap;font-weight:200 800;src:url(${mnLat}) format('woff2');unicode-range:${UL}}`;

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const side = promos.filter((p) => p.slug !== '1-rubl');
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;

// Шкала суток: часы клуба и дневной карты из данных
const toH = (s: string) => { const [h, m] = s.split(':').map(Number); return h + (m || 0) / 60; };
const pct = (h: number) => `${((h / 24) * 100).toFixed(2)}%`;
const dayMatch = plans[0].hours.match(/(\d{1,2}:\d{2})\D+(\d{1,2}:\d{2})/);
const bands = [
  ...site.hours.map((h) => { const [a, b] = h.time.split('–'); return { label: h.days, time: h.time, from: toH(a), to: toH(b), kind: 'club' }; }),
  ...(dayMatch ? [{ label: plans[0].name, time: `${dayMatch[1]}–${dayMatch[2]}`, from: toH(dayMatch[1]), to: toH(dayMatch[2]), kind: 'day' }] : []),
];
const weekdayHours = Math.round(bands[0].to - bands[0].from);
const plural = (n: number, one: string, few: string, many: string) => { const a = n % 10, b = n % 100; return a === 1 && b !== 11 ? one : a >= 2 && a <= 4 && (b < 12 || b > 14) ? few : many; };
const ticks = [0, 6, 12, 18, 24];
---
<Layout title="Концепция 29 «Жидкий свет»" description="Концепция дизайна сайта Urban210: спокойный премиальный клуб, текущий тёплый свет, стеклянные рамки фото." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={mnCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="lq">
    <header class="lq-top" data-lq-top>
      <div class="lq-w lq-top-in">
        <a class="lq-logo" href="/concepts/29/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="lq-nav" aria-label="Разделы">
          <a href="#zony">Пространство</a><a href="#tarify">Тарифы</a><a href="#komanda">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Контакты</a>
        </nav>
        <a class="lq-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="lq-pill lq-pill-s" href="#zayavka" data-lead={trial.title} data-block="29_header">1 ₽<span class="lq-hide-s">&nbsp;пробный день</span><Icon name="chev" /></a>
      </div>
    </header>

    <!-- Первый экран: окно в свет -->
    <section class="lq-first" data-sky aria-labelledby="lq-h1">
      <!-- Свет: CSS-пятна всегда, шейдер поверх на десктопе -->
      <div class="lq-sky" aria-hidden="true">
        <i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i>
        <canvas class="lq-gl" data-lq-gl></canvas>
        <span class="lq-grain"></span>
      </div>
      <div class="lq-w lq-first-in">
        <div class="lq-first-tx">
          <p class="lq-where">Фитнес-клуб в Хабаровске<span aria-hidden="true"></span>{site.district}</p>
          <h1 id="lq-h1" class="lq-h1">
            <span class="ln"><span>Сила</span></span>
            <span class="ln"><span>в спокойном</span></span>
            <span class="ln"><span>ритме</span></span>
          </h1>
          <p class="lq-lead">{cap(site.facts.area)}, {site.facts.machines} {site.facts.brands}, групповые программы, финская сауна и хаммам. Первый день за 1&nbsp;₽, вступительного взноса нет.</p>
          <div class="lq-acts">
            <a class="lq-pill" href="#zayavka" data-lead={trial.title} data-block="29_hero">Пробный день за 1 ₽<Icon name="chev" /></a>
            <a class="lq-quiet" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>

        <div class="lq-lens-wrap">
          <figure class="lq-lens">
            <Image src={img('/images/community/13.jpg')} alt="Гостья клуба с эспандером в зале Urban210" widths={[420, 560, 720]} sizes="(min-width: 1000px) 30vw, 88vw" loading="eager" fetchpriority="high" format="webp" quality={58} />
          </figure>
          <a class="lq-orb" href={site.maps.yandexReviews} target="_blank" rel="noopener">
            <b>{rating}</b><span>Яндекс Карты<br />{site.rating.text}</span>
          </a>
          <p class="lq-chip"><Icon name="clock" />{site.hours[0].days} {site.hours[0].time}</p>
        </div>
      </div>
    </section>

    <!-- Шкала суток -->
    <section class="lq-dark lq-sec" aria-labelledby="lq-day-h">
      <div class="lq-w">
        <div class="lq-day-head" data-lq>
          <h2 id="lq-day-h" class="lq-h2">{weekdayHours} {plural(weekdayHours, 'час', 'часа', 'часов')} в сутки, <span class="soft">чтобы найти своё время</span></h2>
          <p class="lq-p">До работы, в обед или поздно вечером: клуб открыт с утра до ночи, а дневная карта дешевле, если удобно приходить до вечера.</p>
        </div>
        <div class="lq-day" data-lq>
          <div class="lq-day-ticks" aria-hidden="true">
            {ticks.map((t) => <span style={`left:${pct(t)}`}>{String(t).padStart(2, '0')}:00</span>)}
          </div>
          <ul class="lq-day-rows">
            {bands.map((b) => (
              <li class={`row-${b.kind}`}>
                <span class="lab"><b>{b.label}</b><span>{b.time}</span></span>
                <span class="track" aria-hidden="true"><span class="fill" style={`left:${pct(b.from)};width:${pct(b.to - b.from)}`}><i></i></span></span>
              </li>
            ))}
          </ul>
        </div>
        <ul class="lq-why">
          {reasons.map((r) => (
            <li data-lq>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Пространство -->
    <section class="lq-dark lq-sec" id="zony" aria-labelledby="lq-zones-h">
      <div class="lq-w">
        <h2 id="lq-zones-h" class="lq-h2 lq-h2-w" data-lq>Четыре пространства, <span class="soft">один абонемент</span></h2>
        <div class="lq-zones">
          <a class="zn zn-zal" href={z.zal.href} data-lq>
            <span class="lq-frame"><Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 760, 1040]} sizes="(min-width: 1000px) 56vw, 92vw" loading="lazy" format="avif" quality={42} /></span>
            <span class="zn-tx"><h3>{z.zal.title}<Icon name="chev" /></h3><p>{cap(z.zal.text)}</p></span>
          </a>
          <a class="zn zn-cardio" href={z.cardio.href} data-lq>
            <span class="lq-frame"><Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[420, 640, 820]} sizes="(min-width: 1000px) 36vw, 92vw" loading="lazy" format="avif" quality={42} /></span>
            <span class="zn-tx"><h3>{z.cardio.title}<Icon name="chev" /></h3><p>{z.cardio.text}</p></span>
          </a>
          <a class="zn zn-group" href={z.group.href} data-lq>
            <span class="lq-frame"><Image src={img('/images/stretching.jpg')} alt="Растяжка в зале групповых программ" widths={[420, 640, 820]} sizes="(min-width: 1000px) 36vw, 92vw" loading="lazy" format="avif" quality={42} /></span>
            <span class="zn-tx"><h3>{z.group.title}<Icon name="chev" /></h3><p>{cap(z.group.text)}</p></span>
          </a>
          <a class="zn zn-spa" href={z.spa.href} data-lq>
            <span class="zn-heat" aria-hidden="true"><i class="h1"></i><i class="h2"></i><i class="h3"></i></span>
            <span class="zn-spa-in">
              <span class="zn-big" aria-hidden="true">SPA</span>
              <span class="zn-tx"><h3>{z.spa.title}<Icon name="chev" /></h3><p>{z.spa.text}</p><small>В тарифе «{plans[2].name}»</small></span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="lq-dark lq-sec" id="tarify" aria-labelledby="lq-price-h">
      <div class="lq-w">
        <div class="lq-price-head" data-lq>
          <h2 id="lq-price-h" class="lq-h2">Три тарифа <span class="soft">без вступительного взноса</span></h2>
          <p class="lq-p">Цена за месяц. При оплате за год выходит дешевле, считаем в рублях за день.</p>
        </div>
        <div class="lq-plans">
          {plans.map((p, i) => (
            <article class={`pl ${i === 1 ? 'pl-hot' : ''}`} data-lq style={`--d:${i * 90}ms`}>
              <header>
                <h3>{p.name}</h3>
                {p.tag && <span class="pl-tag">{p.tag}</span>}
              </header>
              <p class="pl-hours">{cap(p.hours)}</p>
              <p class="pl-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="pl-year">За год {rub(p.year)}, это {perDay(p.year, 365)}&nbsp;₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" />{f}</li>)}
              </ul>
              <a class={i === 1 ? 'lq-pill lq-pill-w' : 'lq-ghost'} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`29_plan_${p.id}`}>Выбрать «{p.name}»<Icon name="chev" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Пробный день: снова окно в свет -->
    <section class="lq-trial" data-sky aria-labelledby="lq-trial-h">
      <div class="lq-sky lq-sky-mid" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i><span class="lq-grain"></span></div>
      <div class="lq-w lq-trial-in">
        <div class="lq-drop" data-lq aria-hidden="true"><b>1</b><span>₽</span></div>
        <div class="lq-trial-tx" data-lq>
          <h2 id="lq-trial-h" class="lq-h2">Пробный день</h2>
          <p class="lq-p lq-p-ink">{trial.text}</p>
          <ul class="lq-terms">{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
          <a class="lq-pill lq-pill-dark" href="#zayavka" data-lead={trial.title} data-block="29_trial">{trialPromo.cta}<Icon name="chev" /></a>
        </div>
      </div>
      <div class="lq-w lq-side">
        {side.map((pr) => (
          <article class="sd" data-lq>
            <h3>{pr.title}</h3>
            <p>{pr.text}</p>
            <a class="lq-quiet" href="#zayavka" data-lead={pr.goal} data-block={`29_promo_${pr.slug}`}>{pr.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Тренеры -->
    <section class="lq-dark lq-sec" id="komanda" aria-labelledby="lq-team-h">
      <div class="lq-w">
        <h2 id="lq-team-h" class="lq-h2 lq-h2-w" data-lq>Тренеры, <span class="soft">с которыми не страшно начать</span></h2>
        <div class="lq-team">
          {trainers.map((t, i) => (
            <figure class="tm" data-lq style={`--d:${i * 90}ms`}>
              <span class="lq-frame"><Image src={img(t.photo)} alt={t.name} widths={[360, 520, 700]} sizes="(min-width: 1000px) 28vw, 88vw" loading="lazy" format="avif" quality={48} /></span>
              <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="lq-personal" data-lq>
          <div>
            <h3>Персональные тренировки</h3>
            <p class="lq-p">{personalText.lead}</p>
          </div>
          <div class="lq-personal-r">
            <p class="pp-price">{personalLine}</p>
            <p class="pp-bonus">{personal.firstFree}</p>
            <a class="lq-ghost" href="#zayavka" data-lead="Персональные тренировки" data-block="29_personal">Записаться к тренеру<Icon name="chev" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="lq-dark lq-sec" id="otzyvy" aria-labelledby="lq-rev-h">
      <div class="lq-w lq-rev">
        <div class="lq-rev-head" data-lq>
          <h2 id="lq-rev-h" class="lq-h2">Так о нас пишут гости</h2>
          <a class="lq-score" href={site.maps.yandexReviews} target="_blank" rel="noopener">
            <b>{rating}</b>
            <span><span class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>из 5 на Яндекс Картах, {site.rating.text}</span>
          </a>
        </div>
        <div class="lq-quotes">
          {reviews.map((r, i) => (
            <blockquote class={`qt qt-${i}`} data-lq>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка: свет в конце -->
    <section class="lq-final" id="zayavka" data-sky aria-labelledby="lq-final-h">
      <div class="lq-sky lq-sky-end" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i><span class="lq-grain"></span></div>
      <div class="lq-w lq-final-in">
        <div class="lq-final-tx" data-lq>
          <h2 id="lq-final-h" class="lq-h1 lq-h1-final">Приходите <br />за&nbsp;1&nbsp;₽</h2>
          <dl class="lq-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>{site.parking}</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="lq-form" data-lq>
          <LeadForm id="lq" block="29_final" />
        </div>
      </div>
    </section>

    <footer class="lq-foot">
      <div class="lq-w">
        <div class="lq-foot-cols">
          <div>
            <a class="lq-logo" href="/concepts/29/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
            <p>{site.address.locality}, {site.address.street}<br />{site.hours.map((h) => `${h.days} ${h.time}`).join(', ')}</p>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>Клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>Документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="lq-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Шапка становится стеклянной после первого экрана
  const top = document.querySelector<HTMLElement>('[data-lq-top]');
  const onScroll = () => top?.classList.toggle('is-solid', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Блоки проявляются один раз
  const items = document.querySelectorAll<HTMLElement>('.lq [data-lq]');
  if (reduce || !('IntersectionObserver' in window)) items.forEach((el) => el.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    items.forEach((el) => io.observe(el));
  }

  // Шейдер: только десктоп, после load, без reduce. CSS-пятна остаются запасным вариантом.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-lq-gl]');
  const FRAG = `precision mediump float;
uniform vec2 r;uniform float t;uniform vec2 m;
vec3 c0=vec3(.045,.026,.022);vec3 c1=vec3(.33,.045,.085);vec3 c2=vec3(1.,.36,.12);vec3 c3=vec3(1.,.70,.38);
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
void main(){
  vec2 uv=gl_FragCoord.xy/r;vec2 p=uv;p.x*=r.x/r.y;p*=1.35;
  float T=t*.045;
  p+=(m-.5)*.12;
  for(int i=1;i<6;i++){float f=float(i);p+=.42/f*vec2(sin(f*p.y*1.3+T*f*.9+.6*f),cos(f*p.x*1.1-T*f*.7+.3*f));}
  float a=.5+.5*sin(p.x*.9+T*1.1);
  float b=.5+.5*cos(p.y*1.05-T*.8+a);
  vec3 col=mix(c0,c1,smoothstep(.12,.95,a)*.92);
  col=mix(col,c2,smoothstep(.56,1.02,a*b+.08)*.86);
  col=mix(col,c3,smoothstep(.84,1.08,a*b+.14*sin(p.x*1.7+p.y))*.6);
  col=mix(col,c0,smoothstep(.5,1.,1.-b)*.6);
  col*=mix(.3,1.,smoothstep(.05,.95,uv.x*.75+uv.y*.45));
  col+=(h(gl_FragCoord.xy+t)-.5)*.035;
  gl_FragColor=vec4(col,1.);
}`;
  const startGL = () => {
    if (!canvas || reduce || !matchMedia('(min-width: 900px)').matches) return;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!gl) return;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null; };
    const vs = sh(gl.VERTEX_SHADER, 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}');
    const fs = sh(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
