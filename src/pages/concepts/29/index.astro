  .lq-top-in { display: flex; align-items: center; gap: 28px; min-height: 68px; }
  .lq-logo { display: inline-flex; align-items: center; gap: 6px; font-weight: 800; font-size: 1.12rem; letter-spacing: 0.06em; text-decoration: none; color: var(--ink); }
  .lq-logo :global(svg) { width: 15px; height: 14px; color: var(--or); }
  .lq-nav { display: none; gap: 30px; margin-left: auto; }
