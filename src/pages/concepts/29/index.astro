  .lq-sky .b4 { width: 70vmax; height: 70vmax; left: 10%; top: 55%; background: radial-gradient(closest-side, rgb(10 6 5 / 0.95), transparent); animation: lq-b 46s ease-in-out infinite alternate-reverse; }
  @keyframes lq-a { to { transform: translate(-18%, 22%) scale(1.15); } }
