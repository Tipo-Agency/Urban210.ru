  .lq-day-rows .fill i { position: absolute; inset: 0 -100% 0 0; background: linear-gradient(90deg, #5a0f1c, #ff5722 25%, #ffb066 45%, #ff5722 65%, #5a0f1c 85%, #ff5722); }
