---
// Концепция 15 «Агитка»: советский конструктивизм (Родченко, Лисицкий, «Окна РОСТА»).
// Красный, чёрный и кремовый, диагональные композиции, клинья и круги, фотомонтаж из ч/б фото зала.
// Движение: клинья и круги въезжают по диагоналям, куски фотомонтажа собираются при прокрутке (CSS + IntersectionObserver).
import '@fontsource-variable/sofia-sans-extra-condensed/wght.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons } from '../../../data/content';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, '\u00a0');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const [trialPromo, tradein, friend] = [promos.find((p) => p.slug === '1-rubl')!, promos.find((p) => p.slug === 'trade-in')!, promos.find((p) => p.slug === '1-plus-1')!];
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const ticker = ['Вступительного взноса нет', `Пробный день ${trial.price} ₽`, 'Парковка на 50 мест', 'Пн–Пт 06:30–23:30', 'Сб–Вс 07:30–22:30', `${rating} на Яндекс Картах`, site.facts.machines];
const shapes = ['circle', 'tri', 'square', 'half'];
const planSkin = ['paper', 'ink', 'red'];
---
<Layout title="Концепция 15 «Агитка»" description="Концепция дизайна сайта Urban210: спортивный плакат в духе конструктивизма, красный, чёрный и кремовый." noindex bare>
  <div class="ag">
    <header class="ag-top">
      <div class="ag-w ag-top-in">
        <a class="ag-logo" href="/concepts/15/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="ag-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#komanda">Команда</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="ag-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="ag-btn ag-btn-s" href="#zayavka" data-lead={trial.title} data-block="15_header">1 ₽ пробный<span class="ag-hide-s">&nbsp;день</span></a>
      </div>
    </header>

    <!-- Первый экран: плакат -->
    <section class="ag-hero" aria-labelledby="ag-h1">
      <div class="ag-w ag-hero-in">
        <div class="ag-hero-tx">
          <p class="ag-kicker"><span>Хабаровск</span><span>пр. 60-летия Октября, 210</span></p>
          <h1 id="ag-h1" class="ag-h1">
            <span class="l l1">А ты</span>
            <span class="l l2">записался</span>
            <span class="l l3">в зал<i>?</i></span>
          </h1>
          <p class="ag-lead">Первый день в Urban210 за 1&nbsp;₽. Тренажёрный зал, кардио, групповые и SPA в Железнодорожном районе. Вступительного взноса нет.</p>
          <div class="ag-cta">
            <a class="ag-btn" href="#zayavka" data-lead={trial.title} data-block="15_hero">Записаться за 1 ₽<Icon name="chev" /></a>
            <a class="ag-link" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>

        <div class="ag-comp" aria-hidden="true">
          <span class="ag-sun"></span>
          <span class="ag-wedge"></span>
          <span class="ag-rule"></span>
          <div class="ag-photo">
            <Image src={img('/images/zal.jpg')} alt="" widths={[420, 640, 900]} sizes="(min-width: 1000px) 40vw, 80vw" loading="eager" format="webp" quality={50} />
          </div>
          <Image class="ag-man" src={cutout} alt="" widths={[360, 520, 760]} sizes="(min-width: 1000px) 36vw, 74vw" loading="eager" fetchpriority="high" format="webp" quality={60} />
          <span class="ag-stamp"><b>{rating}</b><small>Яндекс Карты<br />{site.rating.text}</small></span>
          <span class="ag-vert">Фитнес-клуб · Железнодорожный район</span>
          <span class="ag-tag">Александр Лазько<br /><small>координатор зала</small></span>
        </div>
      </div>
    </section>

    <!-- Перекрёстные ленты -->
    <div class="ag-bands" aria-hidden="true">
      <div class="ag-band ag-band-k"><div class="ag-run">{[0, 1].map(() => <span>{ticker.map((t) => <>{t}<Icon name="chev" /></>)}</span>)}</div></div>
      <div class="ag-band ag-band-r"><div class="ag-run ag-run-rev">{[0, 1].map(() => <span>{ticker.slice().reverse().map((t) => <>{t}<Icon name="chev" /></>)}</span>)}</div></div>
    </div>

    <!-- Лозунги клуба -->
    <section class="ag-sec ag-w ag-slog" aria-labelledby="ag-slog-h" data-m>
      <h2 id="ag-slog-h" class="ag-h2"><span class="l">Четыре причины</span> <span class="l r">прийти сегодня</span></h2>
      <ol class="ag-reasons">
        {reasons.map((r, i) => (
          <li data-p style={`--d:${i * 90}ms;--x:${-40 + i * 6}px;--y:40px`}>
            <span class={`ag-shape ${shapes[i]}`} aria-hidden="true"></span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Зоны: фотомонтаж -->
    <section class="ag-sec ag-w" id="zony" aria-labelledby="ag-zones-h">
      <h2 id="ag-zones-h" class="ag-h2" data-m><span class="l" data-p style="--x:-60px;--y:30px">Четыре зоны.</span> <span class="l r" data-p style="--x:60px;--y:-30px;--d:120ms">Один клуб.</span></h2>
      <div class="ag-zones">
        <a class="zt zt-zal" href={z.zal.href} data-m>
          <span class="zt-sun" data-p style="--x:120px;--y:-120px;--s:.6"></span>
          <div class="zt-img" data-p style="--x:-120px;--y:80px;--r:-6deg;--d:80ms">
            <Image src={img('/images/free-weights.jpg')} alt="Свободные веса в зале Urban210" widths={[480, 720, 960]} sizes="(min-width: 1000px) 56vw, 92vw" loading="lazy" format="avif" quality={45} />
          </div>
          <span class="zt-wedge" data-p style="--x:-200px;--y:120px;--d:200ms"></span>
          <span class="zt-n" aria-hidden="true">1</span>
          <div class="zt-tx" data-p style="--y:30px;--d:260ms">
            <h3>{z.zal.title}</h3>
            <p>{cap(z.zal.text)}</p>
          </div>
        </a>
        <a class="zt zt-cardio" href={z.cardio.href} data-m>
          <div class="zt-img" data-p style="--x:90px;--y:-60px;--s:.7">
            <Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[360, 560, 760]} sizes="(min-width: 1000px) 24vw, 70vw" loading="lazy" format="avif" quality={45} />
          </div>
          <span class="zt-wedge" data-p style="--x:-140px;--y:-80px;--d:150ms"></span>
          <span class="zt-n" aria-hidden="true">2</span>
          <div class="zt-tx" data-p style="--y:24px;--d:220ms">
            <h3>{z.cardio.title}</h3>
            <p>{z.cardio.text}</p>
          </div>
        </a>
        <a class="zt zt-group" href={z.group.href} data-m>
          <div class="zt-img" data-p style="--x:-80px;--y:-80px;--r:5deg">
            <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале 150 м²" widths={[360, 560, 760]} sizes="(min-width: 1000px) 40vw, 92vw" loading="lazy" format="avif" quality={45} />
          </div>
          <span class="zt-n" aria-hidden="true">3</span>
          <div class="zt-tx" data-p style="--y:24px;--d:160ms">
            <h3>{z.group.title}</h3>
            <p>{cap(z.group.text)}</p>
          </div>
        </a>
        <a class="zt zt-spa" href={z.spa.href} data-m>
          <span class="zt-n" aria-hidden="true">4</span>
          <div class="zt-tx" data-p style="--x:-40px;--y:20px">
            <h3>{z.spa.title}</h3>
            <p>{z.spa.text}</p>
            <p class="zt-note">В тарифе «{plans[2].name}»</p>
          </div>
          <div class="zt-heat" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((i) => <span data-p style={`--i:${i};--x:${80 + i * 30}px;--y:${-40 - i * 10}px;--d:${i * 70}ms`}></span>)}
          </div>
        </a>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="ag-sec ag-prices" id="tarify" aria-labelledby="ag-price-h">
      <div class="ag-w">
        <h2 id="ag-price-h" class="ag-h2" data-m><span class="l" data-p style="--x:-60px;--y:30px">Три тарифа.</span> <span class="l r" data-p style="--x:60px;--y:-30px;--d:120ms">Ноль взносов.</span></h2>
        <div class="ag-plans" data-m>
          {plans.map((p, i) => (
            <article class={`pl pl-${planSkin[i]}`} data-p style={`--x:${(i - 1) * 60}px;--y:${80 - i * 20}px;--d:${i * 110}ms`}>
              {p.tag && <span class="pl-tag">{p.tag}</span>}
              <h3>{p.name}</h3>
              <p class="pl-h">{cap(p.hours)}</p>
              <p class="pl-price"><b>{num(p.month)}</b><span>₽<br />в месяц</span></p>
              <p class="pl-year">За год {rub(p.year)}, это {perDay(p.year, 365)} ₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="ag-btn ag-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`15_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="ag-trial" data-m>
          <span class="tr-wedge" data-p style="--x:-260px;--y:90px" aria-hidden="true"></span>
          <div class="tr-sun" data-p style="--x:140px;--y:-100px;--s:.5;--d:120ms" aria-hidden="true"><b>1</b><span>₽</span></div>
          <div class="tr-tx" data-p style="--y:30px;--d:220ms">
            <h3>Пробный день</h3>
            <p>{trial.text}</p>
            <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
            <a class="ag-btn" href="#zayavka" data-lead={trial.title} data-block="15_trial">{trialPromo.cta}<Icon name="chev" /></a>
          </div>
        </div>

        <div class="ag-flyers">
          {[tradein, friend].map((pr, i) => (
            <article class={`fl fl-${i}`} data-rise>
              <span class={`fl-mark ${i ? 'tri' : 'circle'}`} aria-hidden="true"></span>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
              <a class="ag-link" href="#zayavka" data-lead={pr.goal} data-block={`15_promo_${pr.slug}`}>{pr.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Команда -->
    <section class="ag-sec ag-team" id="komanda" aria-labelledby="ag-team-h">
      <div class="ag-w">
        <h2 id="ag-team-h" class="ag-h2" data-m><span class="l" data-p style="--x:-60px;--y:30px">Тренеры</span> <span class="l r" data-p style="--x:60px;--y:-30px;--d:120ms">на посту</span></h2>
        <div class="ag-coaches">
          {trainers.map((t, i) => (
            <figure class={`co co-${i}`} data-m>
              <span class="co-bg" data-p style={`--x:${i % 2 ? 90 : -90}px;--y:${i % 2 ? -70 : 70}px;--s:.7`} aria-hidden="true"></span>
              <div class="co-img" data-p style="--y:50px;--d:120ms">
                <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 1000px) 28vw, 80vw" loading="lazy" format="avif" quality={50} />
              </div>
              <figcaption data-p style="--x:-30px;--d:220ms"><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="ag-personal" data-rise>
          <p class="ag-personal-k">Персональные тренировки</p>
          <p class="ag-personal-p">{personalLine}</p>
          <p class="ag-personal-t">{personal.firstFree}. Тренер поставит технику, составит программу под вашу цель и будет следить за прогрессом.</p>
          <a class="ag-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="15_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы: окна -->
    <section class="ag-sec ag-w ag-rev" id="otzyvy" aria-labelledby="ag-rev-h">
      <div class="ag-rev-head" data-m>
        <h2 id="ag-rev-h" class="ag-h2"><span class="l" data-p style="--x:-60px;--y:30px">Говорят</span> <span class="l r" data-p style="--x:60px;--y:-30px;--d:120ms">гости</span></h2>
        <a class="ag-score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-p style="--x:80px;--y:-80px;--s:.6;--d:200ms">
          <b>{rating}</b><span>из 5 на Яндекс Картах<br />{site.rating.text}</span>
        </a>
      </div>
      <div class="ag-windows" data-m>
        {reviews.map((r, i) => (
          <blockquote class="win" data-p style={`--y:40px;--d:${i * 90}ms`}>
            <span class="win-n" aria-hidden="true">{i + 1}</span>
            <p>{r.text}</p>
            <footer><b>{r.name}</b><span>{r.source}</span></footer>
          </blockquote>
        ))}
      </div>
    </section>

    <!-- Заявка -->
    <section class="ag-final" id="zayavka" aria-labelledby="ag-final-h" data-m>
      <span class="fi-wedge" data-p style="--x:-320px;--y:160px" aria-hidden="true"></span>
      <span class="fi-sun" data-p style="--x:200px;--y:-160px;--s:.6;--d:100ms" aria-hidden="true"></span>
      <div class="ag-w fi-in">
        <div class="fi-tx">
          <h2 id="ag-final-h" class="ag-h2"><span class="l" data-p style="--x:-60px;--y:30px;--d:150ms">Первый шаг</span> <span class="l" data-p style="--x:60px;--y:-30px;--d:250ms">за 1 ₽</span></h2>
          <dl class="fi-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест под видеонаблюдением</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="fi-form" data-p style="--y:60px;--d:300ms">
          <span class="fi-plate" aria-hidden="true"></span>
          <LeadForm id="ag" block="15_final" />
        </div>
      </div>
    </section>

    <footer class="ag-foot">
      <div class="ag-w">
        <p class="ag-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="ag-foot-cols">
          <div>
            <h2>Клуб</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>Клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>Документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="ag-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Куски фотомонтажа собираются, когда блок попадает в экран. Один раз, без привязки к скроллу.
  const root = document.querySelector('.ag');
  const groups = document.querySelectorAll<HTMLElement>('.ag [data-m]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root) requestAnimationFrame(() => root.classList.add('is-ready'));
  if (reduce || !('IntersectionObserver' in window)) groups.forEach((g) => g.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -12% 0px', threshold: 0.05 });
    groups.forEach((g) => io.observe(g));
  }
</script>

<style is:global>
  body:has(.ag) { background: #efe6d3; color: #161210; color-scheme: light; overflow-x: clip; }
  body:has(.ag) ::selection { background: #ff5722; color: #161210; }
  body:has(.ag) :focus-visible { outline: 3px solid #161210; outline-offset: 3px; }
  body:has(.ag) .form { background: #efe6d3; color: #161210; --ink: #161210; --muted: #52473f; --card: #e5d9c3; --line: #161210; border-radius: 0; border: 3px solid #161210; gap: 14px; font-family: 'Golos Text Variable', system-ui, sans-serif; }
  body:has(.ag) .form h3 { font-family: 'Sofia Sans Extra Condensed Variable', 'Arial Narrow', sans-serif; font-weight: 900; text-transform: uppercase; font-size: 2.6rem; line-height: 0.9; letter-spacing: 0; }
  body:has(.ag) .form .muted { color: #52473f; }
  body:has(.ag) .form .field { color: #161210; font-weight: 600; font-size: 0.9rem; }
  body:has(.ag) .form .field input { border-radius: 0; border: 2px solid #161210; background: #fbf6ec; color: #161210; }
  body:has(.ag) .form .field input::placeholder { color: #8a7d70; }
  body:has(.ag) .form .field input:focus { border-color: #ff5722; box-shadow: 0 0 0 3px rgb(255 87 34 / 0.25); }
  body:has(.ag) .form .field .err, body:has(.ag) .form .consent.bad { color: #b3200f; }
  body:has(.ag) .form .field.bad input { border-color: #b3200f; }
  body:has(.ag) .form .consent { color: #52473f; }
  body:has(.ag) .form .consent input { accent-color: #161210; }
  body:has(.ag) .form .btn { border-radius: 0; background: #ff5722; color: #161210; font-family: 'Sofia Sans Extra Condensed Variable', 'Arial Narrow', sans-serif; font-weight: 850; font-size: 1.45rem; text-transform: uppercase; letter-spacing: 0.02em; min-height: 58px; clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%); }
  body:has(.ag) .form .btn:hover { background: #161210; color: #efe6d3; }
  body:has(.ag) .form .form-note, body:has(.ag) .form .form-note a { color: #52473f; }
  body:has(.ag) .form .form-msg.is-err { border-radius: 0; background: #f6d4c6; color: #8f1a0c; }
  body:has(.ag) .form .form-done .ok { background: #ff5722; color: #161210; border-radius: 0; }
  body:has(.ag) dialog.lead::backdrop { background: rgb(22 18 16 / 0.82); backdrop-filter: none; }
  body:has(.ag) dialog.lead .form { box-shadow: 14px 14px 0 #ff5722; }
  body:has(.ag) dialog.lead .x { color: #161210; }
  body:has(.ag) .mbar { background: #efe6d3; border-top: 3px solid #161210; backdrop-filter: none; }
  body:has(.ag) .mbar a.ic { border-radius: 0; border: 2px solid #161210; color: #161210; }
