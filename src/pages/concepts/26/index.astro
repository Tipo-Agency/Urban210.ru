---
// Концепция 26 «Спорт-журнал»: японский спортивный журнал (Number, Tarzan).
// Плотная редакционная вёрстка: вертикальные колонки текста, большие красные круги, темы с номерами,
// плашки с цифрами, вырезки с толстой белой обводкой, разнокалиберный шрифт. Красный, оранжевый, чёрный на белом.
// Движение: круги и вырезки «впечатываются» при появлении (CSS + IntersectionObserver), без библиотек.
import delaCyr from '@fontsource/dela-gothic-one/files/dela-gothic-one-cyrillic-400-normal.woff2?url';
import delaLat from '@fontsource/dela-gothic-one/files/dela-gothic-one-latin-400-normal.woff2?url';
import ssCyr from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-cyrillic-wght-normal.woff2?url';
import ssLat from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-latin-wght-normal.woff2?url';
import rubUrl from '@fontsource-variable/golos-text/files/golos-text-latin-ext-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, programs } from '../../../data/content';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (fam: string, w: string, url: string, range: string) => `@font-face{font-family:'${fam}';font-style:normal;font-display:swap;font-weight:${w};src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = [
  ff('Dela 26', '100 900', delaCyr, UR), ff('Dela 26', '100 900', delaLat, UL),
  ff('Sofia 26', '100 900', ssCyr, UR), ff('Sofia 26', '100 900', ssLat, UL),
  // в Dela Gothic и Sofia нет знака рубля: берём его из Golos (тот же файл, что уже грузит основной текст)
  ff('Dela 26', '100 900', rubUrl, 'U+20BD'), ff('Sofia 26', '100 900', rubUrl, 'U+20BD'),
].join('');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const dayPrice = perDay(plans[0].month, 30);
const points = reasons.filter((r) => !/взнос/i.test(r.title));
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const toc = [
  { p: '04', t: 'Клуб изнутри', h: '#zony' },
  { p: '12', t: 'Сколько стоит', h: '#tarify' },
  { p: '20', t: 'Тренеры', h: '#trenery' },
  { p: '26', t: 'Голос гостей', h: '#otzyvy' },
];
const planSkin = ['w', 'k', 'r'];
---
<Layout title="Концепция 26 «Спорт-журнал»" description="Концепция дизайна сайта Urban210: японский спортивный журнал, красные круги, вертикальные колонки и вырезки с белой обводкой." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={delaCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="nm">
    <!-- Шапка журнала -->
    <div class="nm-mast" aria-hidden="true">
      <div class="nm-w nm-mast-in">
        <span>No.210</span><span>Спорт · Тело · Город</span><span class="nm-hide-s">Хабаровск, {site.district}</span><span class="nm-hide-s">{site.hours[0].days} {site.hours[0].time}</span>
      </div>
    </div>
    <header class="nm-top">
      <div class="nm-w nm-top-in">
        <a class="nm-logo" href="/concepts/26/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="nm-nav" aria-label="Разделы">
          {toc.map((t) => <a href={t.h}><small>P.{t.p}</small>{t.t}</a>)}
        </nav>
        <a class="nm-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="nm-btn nm-btn-s" href="#tarify" data-block="26_header">Выбрать карту<Icon name="chev" /></a>
      </div>
    </header>

    <!-- Обложка -->
    <section class="nm-cover" aria-labelledby="nm-h1">
      <div class="nm-w nm-cover-in">
        <p class="nm-vert-word" aria-hidden="true">СТАРТ</p>

        <div class="nm-cover-main">
          <p class="nm-special"><b>Спецвыпуск</b><span>Фитнес-клуб в Хабаровске</span></p>
          <h1 id="nm-h1" class="nm-h1">
            <span class="a">Каждый</span>
            <span class="b">день</span>
            <span class="c">в зале <em>от {dayPrice} ₽</em></span>
          </h1>

          <div class="nm-comp" aria-hidden="true">
            <span class="nm-sun"></span>
            <span class="nm-dots"></span>
            <span class="nm-comp-vert">СТАРТ</span>
            <div class="nm-strip">
              <Image src={img('/images/zal.jpg')} alt="" widths={[360, 560, 800]} sizes="(min-width: 1100px) 30vw, 62vw" loading="eager" format="webp" quality={40} />
            </div>
            <Image class="nm-man" src={cutout} alt="" widths={[400, 560, 760]} sizes="(min-width: 1100px) 34vw, 78vw" loading="eager" fetchpriority="high" format="webp" quality={60} />
            <span class="nm-name"><b>Александр Лазько</b><small>координатор тренажёрного зала</small></span>
            <span class="nm-stamp"><b>{rating}</b><small>Яндекс<br />Карты</small></span>
          </div>
        </div>

        <aside class="nm-cover-side">
          <p class="nm-lead">Тренажёрный зал, кардио, групповые и SPA в одном клубе на проспекте 60-летия Октября. Безлимит от {dayPrice}&nbsp;₽ в день: {plans[0].name.toLowerCase()} за {rub(plans[0].month)} в месяц.</p>
          <ol class="nm-points">
            <li><span>1</span><p><b>{site.facts.machines}</b> {site.facts.brands}</p></li>
            <li><span>2</span><p><b>Парковка на 50 мест</b> бесплатно, под видеонаблюдением</p></li>
            <li><span>3</span><p><b>С 6:30 утра</b> по будням, до 23:30 вечера</p></li>
          </ol>
          <div class="nm-stats">
            <div class="k"><b>1300+</b><span>м² на двух этажах</span></div>
            <div class="r"><b>{dayPrice} ₽</b><span>в день, безлимит</span></div>
            <div><b>{num(plans[0].month)}</b><span>₽ в месяц, от</span></div>
            <div><b>{site.rating.count}</b><span>отзывов</span></div>
          </div>
          <div class="nm-cta">
            <a class="nm-btn" href="#tarify" data-block="26_hero">Выбрать карту<Icon name="chev" /></a>
            <a class="nm-link" href="#zayavka" data-lead="Заявка с сайта" data-block="26_hero">Оставить заявку</a>
          </div>
        </aside>

        <p class="nm-vert-lat" aria-hidden="true">URBAN210 FITNESS CLUB · KHABAROVSK · OPEN 06:30</p>
      </div>
    </section>

    <!-- Содержание номера -->
    <nav class="nm-toc" aria-label="Содержание">
      <div class="nm-w nm-toc-in">
        <p class="nm-toc-h">Содержание<small>в этом номере</small></p>
        <ol>
          {toc.map((t, i) => <li><a href={t.h}><span class="p">P.{t.p}</span><span class="n">Тема {i + 1}</span><span class="t">{t.t}</span><Icon name="chev" /></a></li>)}
        </ol>
      </div>
    </nav>

    <!-- Колонка: четыре причины -->
    <section class="nm-col" aria-labelledby="nm-col-h">
      <div class="nm-w nm-col-in">
        <h2 id="nm-col-h" class="nm-col-h"><span>Колонка</span>Почему сюда</h2>
        <ol class="nm-col-list">
          {points.map((r, i) => (
            <li data-pop style={`--d:${i * 80}ms`}>
              <span class="n">{i + 1}</span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Тема 1: зоны -->
    <section class="nm-sec" id="zony" aria-labelledby="nm-z-h">
      <div class="nm-w">
        <header class="nm-head">
          <span class="nm-theme"><small>Тема</small>1</span>
          <h2 id="nm-z-h" class="nm-h2">Клуб <em>изнутри</em></h2>
          <p class="nm-head-t">Четыре зоны, два этажа и {site.facts.area}. Разбираем по порядку, что где стоит.</p>
          <p class="nm-head-v" aria-hidden="true">INSIDE THE CLUB</p>
        </header>

        <div class="nm-zones">
          <a class="zn zn-zal" href={z.zal.href} data-pop>
            <figure class="zn-ph nm-cut">
              <Image src={img('/images/free-weights.jpg')} alt="Свободные веса в зале Urban210" widths={[480, 720, 960]} sizes="(min-width: 1100px) 52vw, 92vw" loading="lazy" format="avif" quality={45} />
            </figure>
            <span class="zn-n">1</span>
            <span class="zn-vert" aria-hidden="true">ЗАЛ</span>
            <div class="zn-tx">
              <h3>{z.zal.title}</h3>
              <p>{cap(z.zal.text)}</p>
            </div>
            <dl class="zn-box">
              <div><dt>60+</dt><dd>тренажёров</dd></div>
              <div><dt>60</dt><dd>кг, гантели до</dd></div>
            </dl>
          </a>

          <a class="zn zn-cardio" href={z.cardio.href} data-pop style="--d:80ms">
            <figure class="zn-ph zn-round">
              <Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[360, 520, 720]} sizes="(min-width: 1100px) 26vw, 70vw" loading="lazy" format="avif" quality={45} />
            </figure>
            <span class="zn-n">2</span>
            <div class="zn-tx">
              <h3>{z.cardio.title}</h3>
              <p>{z.cardio.text}</p>
            </div>
          </a>

          <a class="zn zn-group" href={z.group.href} data-pop>
            <figure class="zn-ph nm-cut">
              <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале 150 м²" widths={[480, 720, 960]} sizes="(min-width: 1100px) 40vw, 92vw" loading="lazy" format="avif" quality={45} />
            </figure>
            <span class="zn-n">3</span>
            <div class="zn-tx">
              <h3>{z.group.title}</h3>
              <p>{cap(z.group.text)}</p>
              <ul class="zn-tags">
                {programs.map((g) => <li><b>{g.group}</b>{g.items.join(', ')}</li>)}
              </ul>
            </div>
          </a>

          <a class="zn zn-spa" href={z.spa.href} data-pop style="--d:80ms">
            <span class="zn-sun" aria-hidden="true">SPA</span>
            <span class="zn-n">4</span>
            <div class="zn-tx">
              <h3>{z.spa.title}</h3>
              <p>{z.spa.text}</p>
              <p class="zn-note">В тарифе «{plans[2].name}»</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Тема 2: тарифы -->
    <section class="nm-sec nm-prices" id="tarify" aria-labelledby="nm-p-h">
      <div class="nm-w">
        <header class="nm-head">
          <span class="nm-theme"><small>Тема</small>2</span>
          <h2 id="nm-p-h" class="nm-h2">Сколько <em>стоит</em></h2>
          <p class="nm-head-t">Три тарифа, безлимит от {dayPrice}&nbsp;₽ в день. Годовая карта выходит дешевле, считаем цену дня.</p>
          <p class="nm-head-v" aria-hidden="true">PRICE DATA</p>
        </header>

        <div class="nm-plans">
          {plans.map((p, i) => (
            <article class={`pl pl-${planSkin[i]}`} data-pop style={`--d:${i * 90}ms`}>
              <header class="pl-head">
                <span class="pl-no">No.{i + 1}</span>
                <h3>{p.name}</h3>
              </header>
              {p.tag && <span class="pl-burst" aria-hidden="true">{p.tag}</span>}
              <p class="pl-h">{cap(p.hours)}</p>
              <p class="pl-price"><b>{num(p.month)}</b><span>₽<br />в месяц</span></p>
              <p class="pl-day"><span class="pl-dot">{perDay(p.year, 365)}<small>₽</small></span>в день при оплате за год: {rub(p.year)}</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="nm-btn nm-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`26_plan_${p.id}`}>Выбрать тариф<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="nm-coupon" data-pop>
          <div class="cp-sun" aria-hidden="true"><b>{dayPrice}</b><span>₽</span></div>
          <div class="cp-tx">
            <p class="cp-k">Цифра номера</p>
            <h3>Безлимит от {dayPrice} ₽ в день</h3>
            <p>{plans[0].name}: {rub(plans[0].month)} в месяц, {plans[0].hours}. Зал, кардиозона, раздевалки и парковка.</p>
            <ul>{plans[0].features.slice(1).map((t) => <li>{t}</li>)}</ul>
            <a class="nm-btn" href="#zayavka" data-lead="Заявка с сайта" data-block="26_offer">Оставить заявку<Icon name="chev" /></a>
          </div>
          <p class="cp-vert" aria-hidden="true">DAY CARD · {dayPrice} RUB A DAY</p>
        </div>

        <div class="nm-ads">
          {[tradein, friend].map((pr, i) => (
            <article class={`ad ad-${i}`} data-pop style={`--d:${i * 90}ms`}>
              <p class="ad-k">Акция</p>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
              <a class="nm-link" href="#zayavka" data-lead={pr.goal} data-block={`26_promo_${pr.slug}`}>{pr.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Тема 3: тренеры -->
    <section class="nm-sec nm-team" id="trenery" aria-labelledby="nm-t-h">
      <div class="nm-w">
        <header class="nm-head">
          <span class="nm-theme"><small>Тема</small>3</span>
          <h2 id="nm-t-h" class="nm-h2">Кто <em>ведёт</em></h2>
          <p class="nm-head-t">Тренеры клуба покажут тренажёры, поставят технику и соберут программу под вашу цель.</p>
          <p class="nm-head-v" aria-hidden="true">COACH PROFILE</p>
        </header>
        <div class="nm-coaches">
          {trainers.map((t, i) => (
            <figure class={`co co-${i}`} data-pop style={`--d:${i * 90}ms`}>
              <span class="co-sun" aria-hidden="true"></span>
              <div class="co-ph">
                <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 1100px) 26vw, 80vw" loading="lazy" format="avif" quality={50} />
              </div>
              <span class="co-vert" aria-hidden="true">{t.name}</span>
              <figcaption>
                <span class="co-no">Профиль {i + 1}</span>
                <b>{t.name}</b>
                <span>{t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="nm-pt" data-pop>
          <p class="pt-k">Персональные тренировки</p>
          <p class="pt-big">{personalLine}</p>
          <p class="pt-t">{personal.firstFree}.</p>
          <a class="nm-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="26_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Тема 4: отзывы -->
    <section class="nm-sec" id="otzyvy" aria-labelledby="nm-r-h">
      <div class="nm-w">
        <header class="nm-head">
          <span class="nm-theme"><small>Тема</small>4</span>
          <h2 id="nm-r-h" class="nm-h2">Голос <em>гостей</em></h2>
          <p class="nm-head-t">Отзывы с Яндекс Карт и 2ГИС. Сокращены, смысл сохранён, минусы тоже оставили.</p>
          <p class="nm-head-v" aria-hidden="true">READERS' VOICE</p>
        </header>
        <div class="nm-voices">
          <a class="nm-score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-pop>
            <b>{rating}</b>
            <span>из 5 на Яндекс Картах<br />{site.rating.text}</span>
          </a>
          {reviews.map((r, i) => (
            <blockquote class={`vo vo-${i}`} data-pop style={`--d:${i * 70}ms`}>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="nm-final" id="zayavka" aria-labelledby="nm-f-h">
      <span class="fi-sun" aria-hidden="true"></span>
      <div class="nm-w fi-in">
        <div class="fi-tx">
          <p class="nm-special"><b>Анкета</b><span>ответим в часы работы клуба</span></p>
          <h2 id="nm-f-h" class="fi-h"><span>Твой</span><span>первый</span><span class="r">день</span></h2>
          <dl class="fi-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="fi-form">
          <LeadForm id="nm" block="26_final" />
        </div>
        <p class="fi-vert" aria-hidden="true">ENTRY FORM · URBAN210</p>
      </div>
    </section>

    <footer class="nm-foot">
      <div class="nm-w">
        <p class="nm-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="nm-foot-cols">
          <div>
            <h2>Клуб</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>Клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>Документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="nm-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Круги и вырезки «впечатываются», когда блок попадает в экран. Один раз.
  const items = document.querySelectorAll<HTMLElement>('.nm [data-pop]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) items.forEach((el) => el.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
