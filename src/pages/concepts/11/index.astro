<style>
  .cr {
    --ink: #121318; --muted: #4b4e58; --pearl: #e4e5ea; --night: #0c0d11;
    --acc: #ff5722;
    --disp: 'Exo c', 'Arial Black', system-ui, sans-serif;
    --g: clamp(16px, 4vw, 56px);
    --chrome: linear-gradient(180deg, #a9aeb8 0%, #f7f8fa 16%, #8a8f9a 34%, #24262d 48%, #0e0f13 54%, #4d515b 66%, #c3c7cf 84%, #6c717c 100%);
    --chrome-d: linear-gradient(180deg, #ffffff 0%, #e7e9ee 30%, #8b909b 48%, #2a2d34 52%, #9ba0aa 64%, #f2f3f6 86%, #b9bdc5 100%);
    --holo: linear-gradient(110deg, #ffc2e6, #b8efff 22%, #dccbff 42%, #fff1b5 62%, #bfffe2 80%, #ffc2e6);
    --steel: linear-gradient(180deg, #ffffff 0%, #e3e5ea 45%, #c2c6ce 55%, #eef0f3 100%);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    color: var(--ink);
    overflow-x: clip;
  }
  .cr :global(h1), .cr :global(h2), .cr :global(h3) { font-family: var(--disp); font-style: italic; letter-spacing: -0.02em; hyphens: manual; -webkit-hyphens: manual; }
  .chr, .chr-d { background: var(--chrome); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .chr { filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.9)) drop-shadow(0 6px 14px rgb(30 32 44 / 0.22)); }
  .chr-d { background-image: var(--chrome-d); }

  /* ---------- Шапка ---------- */
  .top { position: sticky; top: 10px; z-index: 30; padding-inline: var(--g); margin-top: 10px; }
  .top-in {
    display: flex; align-items: center; gap: 20px; max-width: 1440px; margin-inline: auto;
    padding: 8px 8px 8px 22px; border-radius: 999px; background: rgb(240 241 245 / 0.94);
    box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 rgb(18 19 24 / 0.1), 0 10px 30px -14px rgb(20 22 34 / 0.35);
  }
  .x-logo { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font: italic 900 1.2rem/1 var(--disp); letter-spacing: 0.01em; }
  .x-logo .chr { filter: none; background-image: linear-gradient(180deg, #5d626d 0%, #111216 52%, #50545e 100%); }
  .x-logo :global(svg) { width: 18px; height: 17px; color: var(--acc); }
  .top-nav { display: none; gap: 4px; margin-inline: auto; }
  .top-nav a { padding: 10px 14px; border-radius: 999px; font-size: 0.95rem; font-weight: 550; text-decoration: none; color: #2a2c33; transition: background-color 0.2s var(--ease); }
  .top-nav a:hover { background: rgb(18 19 24 / 0.07); }
  .top-tel { display: none; font-weight: 650; text-decoration: none; font-size: 0.95rem; white-space: nowrap; }
  .top .gel-s { margin-left: auto; }
  @media (min-width: 1000px) { .top-nav { display: flex; } .top-tel { display: block; } .top .gel-s { margin-left: 0; } }

  /* ---------- Кнопки ---------- */
  .gel, .steel {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    min-height: 56px; padding: 0 26px; border-radius: 999px; text-decoration: none; white-space: nowrap;
    font: italic 800 1.02rem/1 var(--disp); letter-spacing: 0.005em; isolation: isolate;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .gel { color: #fff; background: linear-gradient(180deg, #ff9466 0%, #ff5722 46%, #e8400c 54%, #ff6c36 100%); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), inset 0 -3px 8px rgb(130 24 0 / 0.35), 0 14px 30px -10px rgb(255 87 34 / 0.7); }
  .gel::before { content: ''; position: absolute; inset: 3px 14px auto; height: 42%; border-radius: 999px; background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0)); z-index: -1; pointer-events: none; }
  .steel { color: var(--ink); background: var(--steel); box-shadow: inset 0 1px 0 #fff, inset 0 -2px 4px rgb(18 19 24 / 0.16), 0 0 0 1px rgb(18 19 24 / 0.12), 0 10px 24px -12px rgb(20 22 34 / 0.4); }
  .steel-dark { background: linear-gradient(180deg, #3b3e47 0%, #16181d 50%, #0b0c0f 52%, #2a2d34 100%); color: #fff; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 0 0 1px rgb(0 0 0 / 0.4), 0 14px 26px -12px rgb(0 0 0 / 0.6); }
  .gel :global(svg), .steel :global(svg) { width: 18px; height: 16px; flex: none; transition: transform 0.25s var(--ease); }
  .steel :global(svg[viewBox="0 0 24 24"]) { width: 20px; height: 20px; }
  .gel:hover, .steel:hover { transform: translateY(-2px); }
  .gel:hover :global(svg), .steel:hover :global(svg) { transform: translateX(4px); }
  .gel:active, .steel:active { transform: scale(0.97); }
  .gel-s { min-height: 46px; padding: 0 20px; font-size: 0.95rem; }
  .gel-w, .steel-w { width: 100%; }

  /* ---------- Первый экран ---------- */
  .x-hero { position: relative; display: grid; padding: clamp(28px, 4vw, 48px) var(--g) clamp(40px, 5vw, 64px); max-width: 1540px; margin-inline: auto; min-height: calc(100svh - 76px); align-content: space-between; gap: 18px; }
  .hero-bg { position: absolute; inset: -120px 0 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.7; }
  .b1 { width: 46vw; height: 46vw; right: 2vw; top: 4vh; background: radial-gradient(circle, #ffd0ea, transparent 68%); }
  .b2 { width: 38vw; height: 38vw; right: 24vw; top: 26vh; background: radial-gradient(circle, #c4f1ff, transparent 66%); }
  .b3 { width: 30vw; height: 30vw; left: -6vw; bottom: 0; background: radial-gradient(circle, #e2d6ff, transparent 66%); }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 0.95rem; font-weight: 550; color: #33353d; }
  .x-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 0 4px rgb(255 87 34 / 0.18); }
  .h1 { position: relative; z-index: 2; display: grid; font-weight: 900; font-size: clamp(3.6rem, 16.2vw, 15.5rem); line-height: 0.86; letter-spacing: -0.035em; padding-block: 0.06em; }
  .h1 span { display: block; padding-right: 0.08em; }
  .l2 { justify-self: end; }
  :global(.js:not(.reduce)) .h1 span { animation: rise 1.1s var(--ease) both; }
  :global(.js:not(.reduce)) .h1 .l2 { animation-delay: 0.12s; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.35em) skewX(-6deg); } }

  .obj { position: absolute; z-index: 1; pointer-events: none; aspect-ratio: 1; width: min(44vw, 660px); right: clamp(0px, 3vw, 80px); top: clamp(20px, 3vw, 60px); }
  .obj-img, .obj canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .obj canvas { opacity: 0; transition: opacity 0.8s var(--ease); }
  .obj.is-3d canvas { opacity: 1; }
  .obj.is-3d .obj-img { opacity: 0; transition: opacity 0.5s var(--ease); }
  :global(.js:not(.reduce)) .obj-img { animation: bob 6s ease-in-out infinite alternate; }
  @keyframes bob { from { transform: translateY(-2%) rotate(-3deg); } to { transform: translateY(3%) rotate(2deg); } }
  .orbit { position: absolute; inset: -6%; width: 112%; height: 112%; fill: none; stroke: rgb(18 19 24 / 0.16); stroke-width: 1; }
  .orbit ellipse:first-child { transform: rotate(-14deg); transform-origin: center; }
  .spark { position: absolute; width: 26px; fill: #fff; filter: drop-shadow(0 0 10px rgb(255 255 255 / 0.9)) drop-shadow(0 0 2px rgb(120 140 200 / 0.6)); }
  .s1 { top: 14%; left: 14%; width: 30px; }
  .s2 { bottom: 18%; right: 8%; width: 20px; }
  .s3 { top: 6%; right: 26%; width: 14px; }
  :global(.js:not(.reduce)) .spark { animation: twinkle 2.6s ease-in-out infinite; }
  :global(.js:not(.reduce)) .s2 { animation-delay: 0.9s; }
  :global(.js:not(.reduce)) .s3 { animation-delay: 1.6s; }
  @keyframes twinkle { 50% { transform: scale(0.45) rotate(45deg); opacity: 0.5; } }

  .hero-foot { position: relative; z-index: 4; display: grid; gap: 22px; align-items: end; }
  .hero-lead { max-width: 34rem; font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.2rem); line-height: 1.5; color: #24262d; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .x-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .x-chips li { display: flex; align-items: center; gap: 12px; padding: 10px 18px 10px 14px; }
  .x-chips b { font: italic 900 1.9rem/1 var(--disp); letter-spacing: -0.03em; }
  .x-chips span { font-size: 0.8rem; line-height: 1.25; color: #33353d; }
  .holo-edge { position: relative; border-radius: 22px; background: rgb(246 246 249 / 0.92); box-shadow: 0 10px 24px -14px rgb(20 22 34 / 0.4); }
  .holo-edge::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; background: var(--holo); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  @media (min-width: 900px) {
    .x-hero { min-height: min(calc(100svh - 76px), 980px); }
    .hero-foot { grid-template-columns: 1fr auto; column-gap: 40px; }
    .hero-foot .x-chips { grid-column: 2; grid-row: 1 / span 2; flex-direction: column; align-self: end; }
  }
  @media (max-width: 899px) {
    .x-hero { min-height: 0; padding-top: 18px; }
    .obj { position: relative; right: auto; top: auto; width: min(78vw, 420px); justify-self: center; margin: -6px 0 -24px; order: -1; grid-row: 2; }
    .eyebrow { grid-row: 1; font-size: 0.85rem; }
    .eb-addr { display: none; }
    .h1 { grid-row: 3; font-size: clamp(3rem, 16.4vw, 6rem); }
    .hero-foot { grid-row: 4; }
    .b1 { width: 90vw; height: 90vw; } .b2 { width: 70vw; height: 70vw; right: 0; top: 20vh; } .b3 { width: 70vw; height: 70vw; }
  }

  /* ---------- Лента ---------- */
  .tape { overflow: hidden; background: linear-gradient(180deg, #2a2d35 0%, #0d0e12 50%, #000 52%, #24272e 100%); color: #fff; transform: rotate(-1.6deg); margin: 10px -20px; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 18px 36px -18px rgb(0 0 0 / 0.5); }
  .tape-in { display: flex; width: max-content; }
  .tape span { display: inline-flex; align-items: center; gap: 26px; padding: 16px 13px; font: italic 800 clamp(1.1rem, 0.9rem + 1vw, 1.7rem)/1 var(--disp); white-space: nowrap; text-transform: uppercase; letter-spacing: 0.01em; }
  .tape span :global(svg) { width: 22px; height: 20px; color: var(--acc); }
  :global(.js:not(.reduce)) .tape-in { animation: tape 34s linear infinite; }
  @keyframes tape { to { transform: translateX(-50%); } }

  /* ---------- Секции ---------- */
  .x-sec { padding: clamp(80px, 10vw, 150px) var(--g); max-width: 1540px; margin-inline: auto; }
  .dark { max-width: none; background: radial-gradient(120% 70% at 80% 0%, #1d2030 0%, var(--night) 55%); color: #f2f3f6; --muted: #a9adb8; }
  .dark > * { max-width: 1428px; margin-inline: auto; }
  .x-head { display: grid; gap: 18px; margin-bottom: clamp(36px, 5vw, 64px); }
  .x-head h2, .cta h2, .rev-head h2 { font-weight: 850; font-size: clamp(1.9rem, 0.9rem + 4.4vw, 5.2rem); line-height: 0.95; letter-spacing: -0.03em; }
  .x-head .muted { max-width: 34rem; font-size: 1.05rem; }
  .muted { color: var(--muted); }
  @media (min-width: 900px) { .x-head { grid-template-columns: 1.3fr 1fr; align-items: end; gap: 48px; } }

  /* Хромированная рамка с фаской */
  .bevel { position: relative; border-radius: 30px; padding: 6px; background: linear-gradient(160deg, #ffffff 0%, #c3c7cf 22%, #7c818c 46%, #f6f7f9 58%, #9ea3ad 80%, #e9ebef 100%); box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 24px 50px -26px rgb(20 22 34 / 0.55); }

  /* ---------- Зоны ---------- */
  .zgrid { display: grid; gap: 16px; }
  .zc { display: grid; grid-template-rows: auto 1fr; text-decoration: none; color: var(--ink); transition: transform 0.35s var(--ease); }
  .zc-ph { position: relative; overflow: hidden; border-radius: 24px; aspect-ratio: 4 / 3; background: #888; }
  .zc-ph :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); transition: transform 0.8s var(--ease); }
  .foil { position: absolute; inset: 0; background: var(--holo); background-size: 220% 100%; mix-blend-mode: color; opacity: 0; transition: opacity 0.5s var(--ease), background-position 1.2s var(--ease); }
  .zc-txt { display: grid; gap: 8px; align-content: start; padding: 18px 18px 22px; background: #f4f5f8; border-radius: 0 0 24px 24px; margin-top: -1px; }
  .zc-ph + .zc-txt { border-radius: 0 0 24px 24px; }
  .zc :global(h3) { font-weight: 850; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem); }
  .zc-txt p { color: var(--muted); font-size: 0.98rem; line-height: 1.5; }
  .zc-ph { border-radius: 24px 24px 0 0; }
  .zc-go { position: absolute; right: 20px; top: 20px; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--steel); box-shadow: inset 0 1px 0 #fff, 0 6px 16px -6px rgb(0 0 0 / 0.5); color: var(--acc); transition: transform 0.35s var(--ease); }
  .zc-go :global(svg) { width: 18px; height: 16px; }
  .zc:hover { transform: translateY(-4px); }
  .zc:hover .zc-ph :global(img) { transform: scale(1.05); }
  .zc:hover .foil { opacity: 0.85; background-position: 100% 0; }
  .zc:hover .zc-go { transform: rotate(-20deg) scale(1.06); }
  .zc-spa .spa-face { position: relative; aspect-ratio: 4 / 3; border-radius: 24px 24px 0 0; overflow: hidden; display: grid; place-items: center; background: radial-gradient(80% 60% at 30% 20%, #fff 0%, transparent 60%), var(--holo); background-size: 100%, 200% 100%; transition: background-position 1.2s var(--ease); }
  .zc-spa:hover .spa-face { background-position: 0 0, 100% 0; }
  .spa-face span { font: italic 900 clamp(5rem, 14vw, 9rem)/1 var(--disp); letter-spacing: -0.04em; filter: drop-shadow(0 10px 18px rgb(40 30 80 / 0.3)); }
  @media (min-width: 700px) { .zgrid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) {
    .zgrid { grid-template-columns: 1.35fr 1fr 1fr; grid-template-rows: auto auto; }
    .zc-big { grid-row: span 2; grid-template-rows: 1fr auto; }
    .zc-spa { grid-column: 2 / span 2; grid-template-rows: none; grid-template-columns: 1fr 1fr; }
    .zc-spa .spa-face { aspect-ratio: auto; min-height: 240px; border-radius: 24px 0 0 24px; }
    .zc-spa .zc-txt { border-radius: 0 24px 24px 0; margin-top: 0; align-content: end; }
    .zc-big .zc-ph { aspect-ratio: auto; height: 100%; min-height: 420px; }
    .zc-big .zc-txt p { max-width: 30rem; }
  }
  .facts { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 16px; margin-top: clamp(40px, 6vw, 72px); padding-top: 32px; border-top: 1px solid rgb(18 19 24 / 0.14); }
  .facts li { display: grid; gap: 6px; }
  .facts b { font: italic 900 clamp(2.8rem, 2rem + 3.4vw, 5.4rem)/0.9 var(--disp); letter-spacing: -0.04em; }
  .facts span { font-size: 0.95rem; color: var(--muted); max-width: 14rem; }
  @media (min-width: 900px) { .facts { grid-template-columns: repeat(4, 1fr); } }

  /* ---------- Цена дня ---------- */
  .offer-wrap { padding: 0 var(--g) clamp(80px, 10vw, 140px); max-width: 1540px; margin-inline: auto; }
  .x-offer {
    position: relative; overflow: hidden; display: grid; gap: 24px; align-items: center; border-radius: 40px; padding: clamp(28px, 5vw, 72px);
    color: #1b0a03; background: radial-gradient(90% 120% at 15% 0%, #ffb08c 0%, transparent 55%), linear-gradient(160deg, #ff6a33 0%, #ff5722 50%, #e2400f 100%);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.45), inset 0 -6px 24px rgb(120 20 0 / 0.3), 0 40px 80px -40px rgb(255 87 34 / 0.75);
