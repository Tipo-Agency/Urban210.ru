---
// Концепция 11 «Хром»: Y2K и хромированный 3D. На первом экране хромированный двойной шеврон »
// на three.js с картой отражений и иридисценцией, поворачивается за курсором (только десктоп, после load).
// На телефоне и без WebGL тот же шеврон картинкой, отрендеренной из сцены, с мягким покачиванием на CSS.
// Металлический текст, перламутровый фон, голографические кромки, оранжевые «гелевые» кнопки.
import exoCyr from '@fontsource-variable/exo-2/files/exo-2-cyrillic-wght-italic.woff2?url';
import exoLat from '@fontsource-variable/exo-2/files/exo-2-latin-wght-italic.woff2?url';
import exoCyrN from '@fontsource-variable/exo-2/files/exo-2-cyrillic-wght-normal.woff2?url';
import exoLatN from '@fontsource-variable/exo-2/files/exo-2-latin-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos } from '../../../data/content';
import chevImg from '../../../assets/images/concepts/chrome-chev.png';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Exo c';font-style:italic;font-display:swap;font-weight:100 900;src:url(${exoCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Exo c';font-style:italic;font-display:swap;font-weight:100 900;src:url(${exoLat}) format('woff2');unicode-range:${UL}}
@font-face{font-family:'Exo c';font-style:normal;font-display:swap;font-weight:100 900;src:url(${exoCyrN}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Exo c';font-style:normal;font-display:swap;font-weight:100 900;src:url(${exoLatN}) format('woff2');unicode-range:${UL}}`;

const rating = site.rating.value.toString().replace('.', ',');
const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const dayCard = plans[0];
const fromDay = perDay(dayCard.month, 30);
const personalLine = `${personal.pack} тренировок за ${rub(personal.price)}`;
const perMonth = (y: number) => rub(Math.round(y / 12));
const hours = site.hours.map((h) => `${h.days} ${h.time}`);
---
<Layout title="Концепция 11 «Хром»" description="Концепция дизайна сайта Urban210: Y2K и хром, трёхмерный шеврон на первом экране." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={exoCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="cr">
    <header class="top">
      <div class="top-in">
        <a class="x-logo" href="/concepts/11/" aria-label="Urban210, на главную"><span class="chr">URBAN210</span><Icon name="chev" /></a>
        <nav class="top-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#komanda">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Контакты</a>
        </nav>
        <a class="top-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="gel gel-s" href="#tarify" data-block="11_header"><span>Выбрать карту</span></a>
      </div>
    </header>

    <main>
      <!-- Первый экран -->
      <section class="x-hero" aria-labelledby="h1">
        <div class="hero-bg" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
        <p class="eyebrow"><span class="x-dot"></span>Фитнес-клуб в Хабаровске<span class="eb-addr"> · {site.address.short}</span></p>
        <h1 id="h1" class="h1">
          <span class="l1 chr">Форма</span>
          <span class="l2 chr">с&nbsp;блеском</span>
        </h1>
        <div class="obj" aria-hidden="true" data-obj>
          <svg class="orbit" viewBox="0 0 600 600"><ellipse cx="300" cy="300" rx="290" ry="96" /><ellipse cx="300" cy="300" rx="240" ry="250" /></svg>
          <Image class="obj-img" src={chevImg} alt="" widths={[360, 560, 820]} sizes="(min-width: 900px) 560px, 72vw" loading="eager" fetchpriority="high" format="webp" quality={70} />
          <canvas data-chrome></canvas>
          <svg class="spark s1" viewBox="0 0 24 24"><path d="M12 0c.9 6.6 4.8 10.6 12 12-7.2 1.4-11.1 5.4-12 12-.9-6.6-4.8-10.6-12-12 7.2-1.4 11.1-5.4 12-12z" /></svg>
          <svg class="spark s2" viewBox="0 0 24 24"><path d="M12 0c.9 6.6 4.8 10.6 12 12-7.2 1.4-11.1 5.4-12 12-.9-6.6-4.8-10.6-12-12 7.2-1.4 11.1-5.4 12-12z" /></svg>
          <svg class="spark s3" viewBox="0 0 24 24"><path d="M12 0c.9 6.6 4.8 10.6 12 12-7.2 1.4-11.1 5.4-12 12-.9-6.6-4.8-10.6-12-12 7.2-1.4 11.1-5.4 12-12z" /></svg>
        </div>
        <div class="hero-foot">
          <p class="hero-lead">Больше 1300 м², 60+ тренажёров {site.facts.brands}, групповые программы и SPA с хаммамом. Дневная карта от {fromDay}&nbsp;₽ в&nbsp;день.</p>
          <div class="ctas">
            <a class="gel" href="#tarify" data-block="11_hero"><span>Выбрать карту</span><Icon name="chev" /></a>
            <a class="steel" href="#zayavka" data-lead="Заявка с сайта" data-block="11_hero_lead"><span>Оставить заявку</span></a>
          </div>
          <ul class="x-chips">
            <li class="holo-edge"><b class="chr">{rating}</b><span>Яндекс Карты<br />{site.rating.text}</span></li>
            <li class="holo-edge"><b class="chr">06:30</b><span>открываемся<br />по будням</span></li>
            <li class="holo-edge"><b class="chr">50</b><span>мест на бесплатной<br />парковке</span></li>
          </ul>
        </div>
      </section>

      <!-- Бегущая хромированная лента -->
      <div class="tape" aria-hidden="true">
        <div class="tape-in">
          {[0, 1].map(() => (
            <span>Тренажёрный зал<Icon name="chev" />Кардиозона<Icon name="chev" />Групповые<Icon name="chev" />SPA и хаммам<Icon name="chev" />От {fromDay} ₽ в день<Icon name="chev" />Парковка на 50 мест<Icon name="chev" /></span>
          ))}
        </div>
      </div>

      <!-- Зоны -->
      <section class="x-sec x-zones" id="zony" aria-labelledby="zones-h">
        <div class="x-head">
          <h2 id="zones-h"><span class="chr">Четыре зоны</span><br />в одном клубе</h2>
          <p class="muted">Два этажа: внизу силовая и свободные веса, наверху кардио. Зал групповых программ 150 м² и SPA для восстановления.</p>
        </div>
        <div class="zgrid">
          <a class="zc zc-big bevel" href={zal.href} data-rise>
            <div class="zc-ph">
              <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210" widths={[480, 800, 1200]} sizes="(min-width: 900px) 56vw, 100vw" format="avif" quality={50} />
              <i class="foil" aria-hidden="true"></i>
            </div>
            <div class="zc-txt"><h3>{zal.title}</h3><p>{zal.text}</p></div>
            <span class="zc-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="zc bevel" href={cardio.href} data-rise>
            <div class="zc-ph">
              <Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[400, 700]} sizes="(min-width: 900px) 30vw, 100vw" format="avif" quality={50} />
              <i class="foil" aria-hidden="true"></i>
            </div>
            <div class="zc-txt"><h3>{cardio.title}</h3><p>{cardio.text}</p></div>
            <span class="zc-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="zc bevel" href={group.href} data-rise>
            <div class="zc-ph">
              <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале групповых программ" widths={[400, 700]} sizes="(min-width: 900px) 30vw, 100vw" format="avif" quality={50} />
              <i class="foil" aria-hidden="true"></i>
            </div>
            <div class="zc-txt"><h3>{group.title}</h3><p>{group.text}</p></div>
            <span class="zc-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="zc zc-spa bevel" href={spa.href} data-rise>
            <div class="spa-face" aria-hidden="true"><span class="chr-d">SPA</span></div>
            <div class="zc-txt"><h3>{spa.title}</h3><p>{spa.text}</p></div>
            <span class="zc-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
        </div>
        <ul class="facts">
          <li><b class="chr">1300+</b><span>м² площади зала</span></li>
          <li><b class="chr">60+</b><span>тренажёров {site.facts.brands}</span></li>
          <li><b class="chr">60</b><span>кг максимальный вес гантелей</span></li>
          <li><b class="chr">150</b><span>м² зал групповых программ</span></li>
        </ul>
      </section>

      <!-- Цена дня -->
      <section class="offer-wrap" aria-labelledby="offer-h">
        <div class="x-offer" data-rise>
          <div class="coin-stage" aria-hidden="true">
            <div class="coin"><i class="cf"><span>{fromDay} ₽</span></i><i class="cb"><span>210</span></i></div>
          </div>
          <div class="offer-txt">
            <p class="offer-k">{dayCard.name}</p>
            <h2 id="offer-h">От {fromDay}&nbsp;₽ в&nbsp;день</h2>
            <p>{rub(dayCard.month)} в месяц: зал и кардиозона {dayCard.hours}. Администратор перезвонит и поможет выбрать тариф.</p>
            <ul class="terms">{dayCard.features.map((t) => <li><Icon name="check" />{t}</li>)}</ul>
            <a class="steel steel-dark" href="#zayavka" data-lead="Заявка с сайта" data-block="11_offer"><span>Оставить заявку</span><Icon name="chev" /></a>
          </div>
        </div>
      </section>

      <!-- Тарифы -->
      <section class="x-sec dark prices" id="tarify" aria-labelledby="price-h">
        <div class="x-head">
          <h2 id="price-h"><span class="chr-d">Три тарифа.</span><br />От {fromDay}&nbsp;₽ в&nbsp;день</h2>
          <p class="muted">Безлимит в своё время, при оплате за год дешевле.</p>
        </div>
        <div class="x-plans">
          {plans.map((p) => (
            <article class={`x-plan ${p.id === 'full' ? 'plan-hot' : ''}`} data-rise>
              <div class="plan-in">
                <div class="plan-top">
                  <h3>{p.name}</h3>
                  {p.tag && <span class="tag">{p.tag}</span>}
                </div>
                <p class="plan-h">{p.hours.charAt(0).toUpperCase() + p.hours.slice(1)}</p>
                <p class="price"><b class="chr-d">{p.month.toLocaleString('ru-RU').replace(/\s/g, ' ')}</b><span>₽<br />в месяц</span></p>
                <p class="year">{rub(p.year)} за год, выходит {perMonth(p.year)} в месяц</p>
                <ul class="feat">
                  {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                  {p.excluded?.map((f) => <li class="no"><Icon name="minus" />{f}</li>)}
                </ul>
                <a class={p.id === 'full' ? 'gel gel-w' : 'steel steel-w'} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`11_plan_${p.id}`}><span>Выбрать тариф</span><Icon name="chev" /></a>
              </div>
            </article>
          ))}
        </div>
        <div class="promo-row">
          <div class="x-promo holo-edge-d"><b>{tradein.title}</b><span>{tradein.short}. {tradein.terms[0]}.</span><a href="#zayavka" data-lead={tradein.goal} data-block="11_tradein">{tradein.cta}<Icon name="chev1" /></a></div>
          <div class="x-promo holo-edge-d"><b>{friend.title}</b><span>{friend.short}.</span><a href="#zayavka" data-lead={friend.goal} data-block="11_friend">{friend.cta}<Icon name="chev1" /></a></div>
        </div>
      </section>

      <!-- Тренеры -->
      <section class="x-sec team" id="komanda" aria-labelledby="team-h">
        <div class="x-head">
          <h2 id="team-h"><span class="chr">Команда</span><br />на твоей стороне</h2>
          <p class="muted">Тренер поставит технику, составит программу под цель и будет следить за прогрессом. {personal.firstFree}.</p>
        </div>
        <div class="tgrid">
          {trainers.map((t, i) => (
            <figure class="tc bevel" data-rise style={`--d:${i * 90}ms`}>
              <div class="tc-ph">
                <Image src={img(t.photo)} alt={t.name} widths={[360, 600]} sizes="(min-width: 900px) 28vw, 80vw" format="avif" quality={50} />
                <i class="foil" aria-hidden="true"></i>
              </div>
              <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
          <div class="tc tc-pt bevel" data-rise>
            <p class="pt-k">Персональные тренировки</p>
            <p class="pt-n"><b class="chr">{personal.pack}</b><span>тренировок</span></p>
            <p class="pt-p">{personalLine}</p>
            <a class="steel" href="#zayavka" data-lead="Персональные тренировки" data-block="11_personal"><span>Подобрать тренера</span><Icon name="chev" /></a>
          </div>
        </div>
      </section>

      <!-- Отзывы -->
      <section class="x-sec x-reviews" id="otzyvy" aria-labelledby="rev-h">
        <div class="rev-head">
          <p class="big-rate"><b class="chr">{rating}</b></p>
          <div>
            <h2 id="rev-h">Средняя оценка на Яндекс Картах</h2>
            <p class="muted">{site.rating.text}. Вот что пишут чаще всего: нет очередей, много места, чисто.</p>
            <a class="steel" href={site.maps.yandexReviews} target="_blank" rel="noopener"><span>Все отзывы</span><Icon name="chev" /></a>
          </div>
        </div>
        <div class="rgrid">
          {reviews.map((r, i) => (
            <blockquote class="rc" data-rise style={`--d:${i * 70}ms`}>
              <div class="x-stars" aria-label="5 звёзд">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</div>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </section>

      <!-- Заявка -->
      <section class="x-sec dark cta" id="zayavka" aria-labelledby="cta-h">
        <div class="cta-in">
          <div class="cta-txt">
            <h2 id="cta-h"><span class="chr-d">Приходи сиять.</span><br />От {fromDay}&nbsp;₽ в&nbsp;день</h2>
            <p class="muted">Оставьте имя и телефон. Администратор перезвонит в часы работы клуба и подберёт удобное время.</p>
            <dl class="info">
              <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
              <div><dt>Часы</dt><dd>{hours.map((h) => <>{h}<br /></>)}</dd></div>
              <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
              <div><dt>Парковка</dt><dd>{site.parking}</dd></div>
            </dl>
            <div class="msg">
              <a class="steel steel-w" href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener"><Icon name="wa" /><span>WhatsApp</span></a>
              <a class="steel steel-w" href={telegramLink('concept11')} target="_blank" rel="noopener"><Icon name="tg" /><span>Telegram</span></a>
            </div>
          </div>
          <div class="form-shell"><LeadForm id="c11" block="11_final" /></div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot-big" aria-hidden="true"><span class="chr-d">URBAN210</span><Icon name="chev" /></div>
      <div class="foot-grid">
        <div><b>Клуб</b><p>{site.address.locality}, {site.address.street}</p><p>{hours.join(' · ')}</p></div>
        <div><b>Разделы</b><p><a href="/price/">Тарифы</a> · <a href="/zal/">Зал</a> · <a href="/group/">Групповые</a> · <a href="/spa/">SPA</a> · <a href="/trainers/">Тренеры</a> · <a href="/promo/">Акции</a></p></div>
        <div><b>Связь</b><p><a href={site.phone.href}>{site.phone.display}</a></p><p><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p></div>
        <div><b>Документы</b><p><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Договор-оферта</a> · <a href="/rules/">Правила клуба</a></p></div>
      </div>
      <p class="x-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
    </footer>
  </div>
</Layout>

<script>
  // Хромированный шеврон: three.js грузится только на десктопе с мышью, после load и в простое.
  const host = document.querySelector<HTMLElement>('[data-obj]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-chrome]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const snap = location.search.includes('snap');
  const wants = snap || (!reduce && matchMedia('(min-width: 900px) and (pointer: fine)').matches);

  async function start() {
    if (!host || !canvas) return;
    const THREE = await import('three');
    let renderer: import('three').WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, preserveDrawingBuffer: snap, powerPreference: 'high-performance' });
    } catch {
      return; // нет WebGL: остаётся картинка
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, snap ? 2 : 1.75));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
    camera.position.set(0, 0, 9.5);

    // Студия для отражений: светлое небо с софтбоксами, тёмный горизонт, оранжевая и радужная полосы
    const c = document.createElement('canvas');
    c.width = 1024; c.height = 512;
    const g = c.getContext('2d')!;
    const sky = g.createLinearGradient(0, 0, 0, 512);
    [[0, '#ffffff'], [0.16, '#dde0e8'], [0.26, '#767b88'], [0.33, '#f3f4f8'], [0.42, '#3a3d47'], [0.49, '#050608'],
     [0.55, '#24272e'], [0.64, '#c6c9d1'], [0.75, '#555964'], [0.88, '#d9d6d2'], [1, '#f4f2ef']].forEach(([o, col]) => sky.addColorStop(o as number, col as string));
    g.fillStyle = sky; g.fillRect(0, 0, 1024, 512);
    // вертикальные тёмные стойки и софтбоксы дают полосы на плоских гранях
    g.fillStyle = 'rgba(8,9,12,0.85)';
    [[150, 46], [470, 30], [640, 64], [900, 38]].forEach(([x, w]) => g.fillRect(x, 0, w, 512));
    g.fillStyle = '#ffffff';
    [[60, 60, 70, 150], [300, 40, 120, 70], [560, 90, 60, 120], [760, 50, 110, 80], [380, 300, 90, 40], [820, 340, 120, 30]].forEach(([x, y, w, h]) => g.fillRect(x, y, w, h));
    g.fillStyle = '#ff5722'; g.fillRect(0, 300, 1024, 12); g.fillRect(700, 120, 26, 200);
    const rb = g.createLinearGradient(0, 0, 1024, 0);
    ['#ff9fd6', '#8fe9ff', '#c9a6ff', '#fff0a0', '#8dffd0', '#ff9fd6'].forEach((col, i, a) => rb.addColorStop(i / (a.length - 1), col));
    g.fillStyle = rb; g.fillRect(0, 206, 1024, 12); g.fillRect(0, 430, 1024, 8);
    const tex = new THREE.CanvasTexture(c);
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.colorSpace = THREE.SRGBColorSpace;
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromEquirectangular(tex).texture;
    tex.dispose();

    // Двойной шеврон из логотипа, выдавленный с фаской
    const part = (x: number) => {
      const s = new THREE.Shape();
      s.moveTo(x, 0); s.lineTo(x + 3.6, 0); s.lineTo(x + 10, -8); s.lineTo(x + 3.6, -16); s.lineTo(x, -16); s.lineTo(x + 6.4, -8); s.closePath();
      return s;
    };
    const geo = new THREE.ExtrudeGeometry([part(0), part(7)], { depth: 1.4, bevelEnabled: true, bevelThickness: 1.7, bevelSize: 1.05, bevelSegments: 16, curveSegments: 4 });
    geo.center();
    geo.computeVertexNormals();
    const mat = new THREE.MeshPhysicalMaterial({
      color: 0xffffff, metalness: 1, roughness: 0.07, clearcoat: 1, clearcoatRoughness: 0.06,
      iridescence: 0.7, iridescenceIOR: 1.7, iridescenceThicknessRange: [180, 620], envMapIntensity: 1.25,
    });
    const mesh = new THREE.Mesh(geo, mat);
    mesh.scale.setScalar(0.19);
    const pivot = new THREE.Group();
    pivot.add(mesh);
    scene.add(pivot);

    const size = () => {
      const r = host.getBoundingClientRect();
      renderer.setSize(r.width, r.height, false);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
    };
    size();
    addEventListener('resize', size);

    let tx = 0, ty = 0, rx = 0, ry = 0;
    addEventListener('pointermove', (e) => {
      tx = (e.clientY / innerHeight - 0.5) * 0.9;
      ty = (e.clientX / innerWidth - 0.5) * 1.3;
    }, { passive: true });

    let visible = true;
    new IntersectionObserver(([en]) => { visible = en.isIntersecting; }).observe(host);
    const t0 = performance.now();
    let shown = false;
    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      const t = (now - t0) / 1000;
      const intro = Math.min(1, t / 1.6);
      const e = 1 - Math.pow(1 - intro, 4);
      rx += (tx - rx) * 0.06;
      ry += (ty - ry) * 0.06;
      pivot.rotation.x = snap ? 0.34 : rx + Math.sin(t * 0.7) * 0.06 + 0.3;
      pivot.rotation.y = snap ? -0.62 : ry + Math.sin(t * 0.45) * 0.18 + (1 - e) * -Math.PI * 1.2 - 0.55;
      pivot.rotation.z = snap ? -0.06 : Math.sin(t * 0.5) * 0.04;
      pivot.position.y = snap ? 0 : Math.sin(t * 1.1) * 0.08;
      pivot.scale.setScalar(snap ? 1 : 0.75 + e * 0.25);
      renderer.render(scene, camera);
      if (!shown) { shown = true; host.classList.add('is-3d'); if (snap) (window as unknown as { __snap: string }).__snap = canvas.toDataURL('image/png'); }
    };
    requestAnimationFrame(frame);
  }

  if (wants) {
    const go = () => ('requestIdleCallback' in window ? requestIdleCallback(() => start(), { timeout: 1500 }) : setTimeout(start, 300));
    if (document.readyState === 'complete') go();
    else addEventListener('load', go, { once: true });
  }
</script>

