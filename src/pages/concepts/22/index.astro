<style>
  .bh {
    --paper: #f2ede2; --paper-2: #e8e1d2; --ink: #171512; --muted: #4f4a42;
    --or: #ff5722; --ye: #f6c21a; --bl: #1d3e9e;
    --f: 'Jost Variable', 'Futura', system-ui, sans-serif;
    --ez: cubic-bezier(0.2, 0.8, 0.2, 1);
    --gut: clamp(16px, 4vw, 56px);
    --rule: 3px solid var(--ink);
    background: var(--paper); color: var(--ink); font-family: var(--f); overflow-x: clip;
    font-size: 1.06rem;
  }
  .bh :global(h1), .bh :global(h2), .bh :global(h3), .bh :global(h4) { font-family: var(--f); hyphens: manual; -webkit-hyphens: manual; }
  .bh-w { width: 100%; max-width: 1440px; margin: 0 auto; padding-inline: var(--gut); }

  /* Кнопки: чёрный прямоугольник и оранжевый квадрат со стрелкой */
  .bh-btn {
    display: inline-flex; align-items: stretch; min-height: 60px; background: var(--ink); color: var(--paper); text-decoration: none;
    font-weight: 600; font-size: 1.12rem; letter-spacing: 0; line-height: 1;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }
  .bh-btn > span { display: flex; align-items: center; padding: 10px 22px 10px 24px; line-height: 1.15; }
  .bh-top .bh-btn > span { white-space: nowrap; padding-block: 0; }
  .bh-btn > b { width: 60px; flex: none; display: grid; place-items: center; background: var(--or); color: var(--ink); transition: background-color 0.25s ease; }
  .bh-btn :global(svg) { width: 20px; height: 18px; transition: transform 0.35s var(--ez); }
  .bh-btn:hover { background: var(--bl); }
  .bh-btn:hover > b { background: var(--ye); }
  .bh-btn:hover :global(svg) { transform: translateX(4px); }
  .bh-btn:active { transform: scale(0.98); }
  .bh-btn-s { min-height: 46px; font-size: 1rem; }
  .bh-btn-s > span { padding: 0 14px 0 16px; }
  .bh-btn-s > b { width: 46px; }
  .bh-btn-w { width: 100%; justify-content: space-between; }
  .bh-link { font-weight: 600; font-size: 1.12rem; text-decoration: none; background: linear-gradient(var(--ink), var(--ink)) 0 100% / 100% 3px no-repeat; padding-bottom: 4px; transition: background-size 0.3s var(--ez); }
  .bh-link:hover { background-image: linear-gradient(var(--or), var(--or)); }

  /* Шапка */
  .bh-top { position: sticky; top: 0; z-index: 30; background: var(--paper); border-bottom: var(--rule); }
  .bh-top-in { display: flex; align-items: center; gap: 22px; min-height: 66px; }
  .bh-logo { font-weight: 700; font-size: 1.6rem; letter-spacing: -0.01em; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; line-height: 1; }
  .bh-logo :global(svg) { width: 18px; height: 17px; color: var(--or); }
  .bh-mark { display: none; gap: 6px; align-items: center; }
  .bh-mark i { width: 16px; height: 16px; display: block; }
  .bh-mark .ci { border-radius: 50%; background: var(--or); }
  .bh-mark .sq { background: var(--bl); }
  .bh-mark .tr { background: var(--ye); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .bh-nav { display: none; gap: 30px; margin-left: auto; }
  .bh-nav a { font-weight: 500; font-size: 1.08rem; text-decoration: none; position: relative; padding: 6px 0; }
  .bh-nav a::before { content: ''; position: absolute; left: 50%; top: -8px; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: var(--or); transform: scale(0); transition: transform 0.3s var(--ez); }
  .bh-nav a:hover::before { transform: none; }
  .bh-tel { display: none; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .bh-top .bh-btn { margin-left: auto; }
  .bh-hide-s { display: none; }
  @media (min-width: 1100px) {
    .bh-mark { display: flex; }
    .bh-nav, .bh-tel { display: flex; }
    .bh-top .bh-btn { margin-left: 0; }
    .bh-hide-s { display: inline; }
  }

  /* Первый экран */
  .bh-hero { border-bottom: var(--rule); overflow: clip; }
  .bh-hero-g { display: grid; gap: 30px; padding-top: 30px; padding-bottom: 40px; }
  .bh-kick { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.95rem; font-weight: 500; }
  .bh-kick span { border: 2px solid var(--ink); padding: 5px 10px 4px; line-height: 1.1; }
  .bh-kick span:first-child { background: var(--ink); color: var(--paper); }
  .bh-h1 { margin: 34px 0 0; font-family: var(--f); font-weight: 700; font-size: clamp(3.6rem, 24vw, 10rem); line-height: 0.84; letter-spacing: -0.045em; text-wrap: nowrap; }
  .bh-h1 .l { display: block; }
  .bh-h1 .l2 { color: var(--bl); padding-left: 0.62em; }
  .bh-h1 .l3 i { display: inline-block; width: 0.17em; height: 0.17em; margin-left: 0.05em; background: var(--or); vertical-align: baseline; }
  .bh-lead { margin-top: 28px; max-width: 38ch; font-size: 1.12rem; line-height: 1.5; }
  .bh-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; margin-top: 26px; }

  .bh-comp { position: relative; width: 100%; aspect-ratio: 1; isolation: isolate; }
  .hc { position: absolute; display: block; }
  .hc-grid { inset: 0; background-image: linear-gradient(var(--paper-2) 1.5px, transparent 1.5px), linear-gradient(90deg, var(--paper-2) 1.5px, transparent 1.5px); background-size: 12.5% 12.5%; z-index: 0; }
  .hc-sq { left: 0; bottom: 0; width: 56%; aspect-ratio: 1; background: var(--bl); z-index: 1; }
  .hc-ci { right: 0; top: 0; width: 72%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--or); z-index: 2; }
  .hc-ci :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 40% 50%; filter: grayscale(1) contrast(1.2) brightness(1.08); mix-blend-mode: multiply; }
  .hc-tr { right: 0; bottom: 0; width: 38%; aspect-ratio: 1; background: var(--ye); clip-path: polygon(100% 0, 100% 100%, 0 100%); z-index: 3; }
  .hc-bar { left: 0; top: 46%; width: 64%; height: 4.2%; background: var(--ink); z-index: 3; transform-origin: 0 50%; }
  .hc-half { left: 6%; top: 4%; width: 22%; aspect-ratio: 2 / 1; border-radius: 0 0 999px 999px; background: var(--ink); z-index: 3; }
  .hc-line { left: -10%; top: 50%; width: 120%; height: 2px; background: var(--ink); transform: rotate(-45deg); z-index: 4; }
  .hc-stamp { left: 34%; bottom: 7%; width: 27%; aspect-ratio: 1; border-radius: 50%; background: var(--paper); color: var(--ink); z-index: 5; display: grid; place-content: center; text-align: center; border: 3px solid var(--ink); }
  .hc-stamp b { font-weight: 700; font-size: clamp(1.6rem, 7vw, 3rem); letter-spacing: -0.04em; line-height: 0.9; }
  .hc-stamp small { font-size: clamp(0.62rem, 2.6vw, 0.82rem); font-weight: 600; line-height: 1.1; margin-top: 4px; }
  .hc-vert { left: -30px; bottom: 0; writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; z-index: 4; display: none; }

  .bh-facts { list-style: none; margin: 0 auto; padding-top: 0; padding-bottom: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: var(--rule); }
  .bh-facts li { position: relative; display: grid; gap: 6px; align-content: start; padding: 22px 14px 24px; border-bottom: var(--rule); }
  .bh-facts li:nth-child(odd) { padding-left: 0; border-right: var(--rule); }
  .bh-facts li:nth-child(even) { padding-left: 16px; }
  .bh-facts li:nth-child(n + 3) { border-bottom: 0; }
  .bh-facts b { font-weight: 600; font-size: clamp(2.4rem, 11vw, 4.4rem); line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: lining-nums; }
  .bh-facts span:last-child { font-size: 0.95rem; line-height: 1.3; color: var(--muted); max-width: 18ch; }
  .fx { width: 22px; height: 22px; display: block; margin-bottom: 8px; }
  .fx.sq { background: var(--bl); }
  .fx.ci { background: var(--or); border-radius: 50%; }
  .fx.tr { background: var(--ye); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .fx.hf { background: var(--ink); border-radius: 22px 22px 0 0; height: 11px; margin-top: 11px; }

  @media (min-width: 1000px) {
    .bh-hero-g { grid-template-columns: repeat(12, 1fr); gap: 0 24px; padding-top: 0; padding-bottom: 0; min-height: min(calc(100svh - 69px - 150px), 760px); }
    .bh-hero-tx { grid-column: 1 / span 6; padding: clamp(36px, 6vh, 64px) 0; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 6; }
    .bh-h1 { font-size: clamp(6.4rem, 10.4vw, 10.8rem); margin-top: clamp(28px, 4vh, 44px); }
    .bh-lead { font-size: 1.22rem; }
    .bh-comp { grid-column: 7 / span 6; align-self: center; width: min(100%, 64vh, 640px); justify-self: end; margin: 40px 0; }
    .hc-vert { display: block; }
    .bh-facts { grid-template-columns: repeat(4, 1fr); }
    .bh-facts li { padding: 24px 24px 26px; border-bottom: 0; border-right: var(--rule); }
    .bh-facts li:nth-child(odd), .bh-facts li:nth-child(even) { padding-left: 24px; }
    .bh-facts li:first-child { padding-left: 0; }
    .bh-facts li:last-child { border-right: 0; }
    .bh-facts b { font-size: clamp(3rem, 4.6vw, 4.6rem); }
    .bh-facts li { grid-template-columns: auto 1fr; column-gap: 18px; align-items: end; }
    .bh-facts .fx { grid-row: 1; grid-column: 1 / -1; }
  }

  /* Заголовки секций */
  .bh-sec { padding-block: clamp(72px, 10vw, 140px); }
  .bh-h2 { font-family: var(--f); font-weight: 700; font-size: clamp(2.8rem, 12.4vw, 7.4rem); line-height: 0.88; letter-spacing: -0.045em; margin: 0; max-width: 12ch; text-wrap: balance; }
  .bh-h2 .o { color: var(--or); }
  .bh-h2 .b { color: var(--bl); }
  .bh-h2 .y { box-shadow: inset 0 -0.34em 0 var(--ye); }
  .bh-sec-head { display: grid; gap: 22px; margin-bottom: clamp(36px, 5vw, 64px); padding-bottom: clamp(24px, 3vw, 36px); border-bottom: var(--rule); }
  .bh-sec-note { font-size: 1.08rem; line-height: 1.5; max-width: 40ch; color: var(--muted); }
  @media (min-width: 900px) {
    .bh-sec-head { grid-template-columns: 1fr 360px; align-items: end; }
  }

  /* Правила */
  .bh-why { padding-top: clamp(64px, 8vw, 110px); }
  .bh-why-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: clamp(32px, 4vw, 56px); }
  .bh-why-pie { flex: none; width: clamp(80px, 14vw, 180px); aspect-ratio: 1; border-radius: 50%; background: conic-gradient(var(--or) 0 25%, var(--bl) 0 50%, var(--ye) 0 75%, var(--ink) 0); }
  .bh-rules { list-style: none; margin: 0; padding: 0; display: grid; border-top: var(--rule); }
  .bh-rules li { display: grid; grid-template-columns: 54px 1fr; gap: 6px 18px; padding: 24px 0; border-bottom: var(--rule); }
  .bh-rules h3 { font-weight: 600; font-size: 1.6rem; line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
  .bh-rules p { grid-column: 2; font-size: 1.02rem; line-height: 1.5; color: var(--muted); max-width: 42ch; }
  .rl { grid-row: span 2; width: 46px; height: 46px; display: block; }
  .rl-0 { background: var(--or); border-radius: 50%; }
  .rl-1 { background: var(--bl); }
  .rl-2 { background: var(--ye); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .rl-3 { background: var(--ink); border-radius: 46px 46px 0 0; height: 23px; margin-top: 12px; }
  @media (min-width: 900px) {
    .bh-rules { grid-template-columns: repeat(4, 1fr); border-bottom: var(--rule); }
    .bh-rules li { grid-template-columns: 1fr; padding: 28px 26px 36px; border-bottom: 0; border-left: var(--rule); align-content: start; gap: 16px; }
    .bh-rules li:first-child { border-left: 0; padding-left: 0; }
    .bh-rules p { grid-column: auto; }
    .rl { grid-row: auto; width: 64px; height: 64px; margin-bottom: 18px; }
    .rl-3 { height: 32px; margin-top: 32px; }
    .bh-rules h3 { font-size: 1.85rem; }
  }

  /* Зоны */
  .bh-zones { display: grid; gap: 0; border: var(--rule); }
  .zn { position: relative; display: grid; align-content: end; min-height: 460px; overflow: hidden; text-decoration: none; isolation: isolate; padding: 24px; }
  .zn + .zn { border-top: var(--rule); }
  .zn-img { position: absolute; z-index: 1; overflow: hidden; }
  .zn-img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2); transition: transform 0.9s var(--ez); }
  .zn:hover .zn-img :global(img) { transform: scale(1.06); }
  .zn-tx { position: relative; z-index: 3; max-width: 520px; }
  .zn h3 { font-weight: 700; font-size: clamp(2.3rem, 9vw, 3.6rem); line-height: 0.9; letter-spacing: -0.04em; margin: 0 0 12px; }
  .zn p { font-size: 1rem; line-height: 1.5; max-width: 40ch; }
  .zn-go { position: absolute; z-index: 4; right: 0; top: 0; width: 64px; height: 64px; display: grid; place-items: center; background: var(--ink); color: var(--paper); transition: background-color 0.25s ease, color 0.25s ease; }
  .zn-go :global(svg) { width: 20px; height: 19px; transition: transform 0.35s var(--ez); }
  .zn:hover .zn-go { background: var(--or); color: var(--ink); }
  .zn:hover .zn-go :global(svg) { transform: translateX(4px); }

  .zn-zal { background: var(--ye); color: var(--ink); min-height: 520px; }
  .zn-zal .zn-img { left: 0; top: 0; width: 78%; aspect-ratio: 1; }
  .zn-zal .zn-img :global(img) { mix-blend-mode: multiply; }
  .zn-zal .zn-ci { position: absolute; z-index: 2; width: 46%; aspect-ratio: 1; border-radius: 50%; background: var(--or); right: -8%; top: 28%; mix-blend-mode: multiply; }
  .zn-zal .zn-tx { background: var(--ye); padding-top: 16px; margin-top: 0; }

  .zn-cardio { background: var(--bl); color: var(--paper); }
  .zn-cardio .zn-img { width: 230px; aspect-ratio: 1; border-radius: 50%; top: 28px; left: 24px; background: var(--paper); }
  .zn-cardio .zn-bar { position: absolute; z-index: 2; left: 0; top: 150px; width: 100%; height: 14px; background: var(--ye); }

  .zn-group { background: var(--or); color: var(--ink); }
  .zn-group .zn-img { top: 0; left: 50%; translate: -50% 0; width: 92%; aspect-ratio: 2 / 1; border-radius: 0 0 999px 999px; }
  .zn-group .zn-img :global(img) { mix-blend-mode: multiply; }
  .zn-tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 14px 0 0; padding: 0; }
  .zn-tags li { border: 2px solid var(--ink); padding: 3px 9px 2px; font-size: 0.88rem; font-weight: 600; }

  .zn-spa { background: var(--ink); color: var(--paper); }
  .zn-spa .zn-go { background: var(--ye); color: var(--ink); }
  .zn-heat { position: absolute; z-index: 1; right: -30%; top: -30%; width: 100%; aspect-ratio: 1; }
  .zn-heat span { position: absolute; inset: calc(var(--i) * 12%); border-radius: 50%; }
  .zn-heat span:nth-child(1) { background: var(--or); }
  .zn-heat span:nth-child(2) { background: var(--ye); }
  .zn-heat span:nth-child(3) { background: var(--bl); }
  .zn-heat span:nth-child(4) { background: var(--ink); }
  .zn-note { margin-top: 14px; display: inline-block; background: var(--or); color: var(--ink); font-weight: 600; font-size: 0.95rem; padding: 5px 10px 4px; }

  @media (min-width: 900px) {
    .bh-zones { grid-template-columns: repeat(12, 1fr); }
    .zn + .zn { border-top: 0; }
    .zn { min-height: 520px; padding: 32px; }
    .zn-zal { grid-column: span 7; border-right: var(--rule); border-bottom: var(--rule); }
    .zn-cardio { grid-column: span 5; border-bottom: var(--rule); }
    .zn-group { grid-column: span 5; border-right: var(--rule); }
    .zn-spa { grid-column: span 7; }
    .zn-zal { min-height: 600px; }
    .zn-zal .zn-img { width: 62%; }
    .zn-zal .zn-ci { right: 6%; top: 10%; width: 40%; }
    .zn-zal .zn-tx { margin-left: 0; max-width: 64%; }
    .zn-cardio .zn-img { width: 250px; left: auto; right: 40px; top: 90px; }
    .zn-cardio .zn-bar { top: 200px; width: 100%; }
    .zn-cardio .zn-tx { max-width: 80%; }
    .zn-group .zn-img { width: 86%; }
    .zn-spa .zn-tx { max-width: 52%; }
    .zn-heat { right: -12%; top: -24%; width: 66%; }
  }

  /* Тарифы */
  .bh-prices { background: var(--paper-2); border-block: var(--rule); }
  .bh-plans { display: grid; gap: 0; border: var(--rule); }
  .pl { position: relative; display: flex; flex-direction: column; gap: 14px; padding: 28px 22px 26px; background: var(--paper); }
  .pl + .pl { border-top: var(--rule); }
  .pl-yellow { background: var(--ye); }
  .pl-blue { background: var(--bl); color: var(--paper); }
  .pl-fig { position: relative; height: 120px; margin-bottom: 8px; }
  .pl-fig span { position: absolute; display: block; }
  .f-half { left: 0; bottom: 0; width: 200px; height: 100px; border-radius: 200px 200px 0 0; background: var(--or); }
  .f-ci { left: 0; top: 0; width: 120px; height: 120px; border-radius: 50%; background: var(--or); }
  .pl-fig-1 .f-ci { background: var(--ink); }
  .pl-fig-2 .f-ci { background: var(--or); }
  .f-sq { left: 96px; top: 20px; width: 100px; height: 100px; background: var(--ye); }
  .f-tr { left: 172px; top: 0; width: 120px; height: 120px; background: var(--paper); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  @media (max-width: 899px) { .pl-fig-2 { transform: scale(0.72); transform-origin: 0 100%; } }
  .pl-tag { position: absolute; top: 28px; right: 22px; font-weight: 600; font-size: 0.92rem; border: 2px solid currentColor; padding: 4px 10px 3px; }
  .pl h3 { font-weight: 700; font-size: 2.3rem; line-height: 0.95; letter-spacing: -0.035em; margin: 0; }
  .pl-h { font-size: 0.98rem; }
  .pl-price { display: flex; align-items: baseline; gap: 10px; margin-top: 6px; }
