---
// Концепция 22 «Баухаус»: плакаты выставок Баухауса (Шмидт, Байер, Мохой-Надь).
// Круг, квадрат, треугольник; оранжевый Urban210 вместо красного, жёлтый, синий и чёрный на тёплой бумаге.
// Строгая сетка, строчный гротеск Jost, фото в кругах и квадратах дуотоном.
// Движение: фигуры въезжают и доворачиваются на место при прокрутке (CSS + IntersectionObserver), полукруги вращаются вместе со скроллом.
import jostCyr from '@fontsource-variable/jost/files/jost-cyrillic-wght-normal.woff2?url';
import jostLat from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, programs } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (url: string, range: string) => `@font-face{font-family:'Jost Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = ff(jostCyr, UR) + ff(jostLat, UL);

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const [trialPromo, tradein, friend] = [promos.find((p) => p.slug === '1-rubl')!, promos.find((p) => p.slug === 'trade-in')!, promos.find((p) => p.slug === '1-plus-1')!];
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const facts = [
  { shape: 'sq', big: '0 ₽', text: 'вступительный взнос' },
  { shape: 'ci', big: '06:30', text: 'открываемся по будням' },
  { shape: 'tr', big: '50', text: 'мест бесплатной парковки' },
  { shape: 'hf', big: rating, text: `Яндекс Карты, ${site.rating.text}` },
];
const planSkin = ['paper', 'yellow', 'blue'];
const coachSkin = ['ci', 'sq', 'ar'];
const tags = programs.flatMap((p) => p.items);
---
<Layout title="Концепция 22 «Баухаус»" description="Концепция дизайна сайта Urban210: плакат в духе Баухауса, круг, квадрат и треугольник, оранжевый, жёлтый и синий на бумаге." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={jostCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>
  <div class="bh">
    <header class="bh-top">
      <div class="bh-w bh-top-in">
        <a class="bh-logo" href="/concepts/22/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <span class="bh-mark" aria-hidden="true"><i class="ci"></i><i class="sq"></i><i class="tr"></i></span>
        <nav class="bh-nav" aria-label="Разделы">
          <a href="#zony">зоны</a><a href="#tarify">тарифы</a><a href="#trenery">тренеры</a><a href="#otzyvy">отзывы</a><a href="#zayavka">адрес</a>
        </nav>
        <a class="bh-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="bh-btn bh-btn-s" href="#zayavka" data-lead={trial.title} data-block="22_header"><span>пробный<span class="bh-hide-s">&nbsp;день за</span>&nbsp;1&nbsp;₽</span><b><Icon name="chev" /></b></a>
      </div>
    </header>

    <!-- Первый экран: плакат выставки -->
    <section class="bh-hero" aria-labelledby="bh-h1">
      <div class="bh-w bh-hero-g">
        <div class="bh-hero-tx">
          <p class="bh-kick"><span>фитнес-клуб</span><span>Хабаровск, {site.address.short}</span></p>
          <h1 id="bh-h1" class="bh-h1">
            <span class="l l1">собери</span>
            <span class="l l2">свою</span>
            <span class="l l3">форму<i aria-hidden="true"></i></span>
          </h1>
          <p class="bh-lead">Зал, кардио, групповые и SPA в одном клубе. Первый день в Urban210 за&nbsp;1&nbsp;₽, вступительного взноса нет.</p>
          <div class="bh-cta">
            <a class="bh-btn" href="#zayavka" data-lead={trial.title} data-block="22_hero"><span>Записаться за 1 ₽</span><b><Icon name="chev" /></b></a>
            <a class="bh-link" href="#tarify">тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>

        <div class="bh-comp" aria-hidden="true">
          <span class="hc hc-grid"></span>
          <span class="hc hc-sq"></span>
          <div class="hc hc-ci">
            <Image src={img('/images/functional.jpg')} alt="" widths={[480, 640, 900]} sizes="(min-width: 1000px) 34vw, 70vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
          </div>
          <span class="hc hc-tr"></span>
          <span class="hc hc-bar"></span>
          <span class="hc hc-half"></span>
          <span class="hc hc-line"></span>
          <span class="hc hc-stamp"><b>1 ₽</b><small>пробный<br />день</small></span>
          <span class="hc hc-vert">urban210 · железнодорожный район · с 6:30</span>
        </div>
      </div>

      <ul class="bh-w bh-facts">
        {facts.map((f, i) => (
          <li style={`--d:${i * 80}ms`}>
            <span class={`fx ${f.shape}`}></span>
            <b>{f.big}</b>
            <span>{f.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Принципы клуба -->
    <section class="bh-sec bh-w bh-why" aria-labelledby="bh-why-h" data-m>
      <div class="bh-why-head">
        <h2 id="bh-why-h" class="bh-h2" data-s style="--x:-40px">четыре <span class="o">правила</span> клуба</h2>
        <span class="bh-why-pie bh-spin" aria-hidden="true"></span>
      </div>
      <ol class="bh-rules">
        {reasons.map((r, i) => (
          <li data-s style={`--y:40px;--d:${i * 90}ms`}>
            <span class={`rl rl-${i}`} aria-hidden="true"></span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Зоны -->
    <section class="bh-sec bh-zones-s" id="zony" aria-labelledby="bh-zones-h">
      <div class="bh-w">
        <div class="bh-sec-head" data-m>
          <h2 id="bh-zones-h" class="bh-h2" data-s style="--x:-40px">зал, кардио, <span class="b">группы</span> и пар</h2>
          <p class="bh-sec-note" data-s style="--x:40px;--d:120ms">{cap(site.facts.area)} на двух этажах, {site.facts.machines} {site.facts.brands}.</p>
        </div>
        <div class="bh-zones">
          <a class="zn zn-zal" href={z.zal.href} data-m>
            <span class="zn-ci" data-s style="--x:160px;--y:-120px;--r:-90deg;--s:.5"></span>
            <div class="zn-img" data-s style="--x:-120px;--d:80ms">
              <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 720, 960]} sizes="(min-width: 900px) 40vw, 86vw" loading="lazy" format="avif" quality={45} />
            </div>
            <div class="zn-tx" data-s style="--y:30px;--d:200ms">
              <h3>{z.zal.title.toLowerCase()}</h3>
              <p>{cap(z.zal.text)}</p>
            </div>
            <span class="zn-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="zn zn-cardio" href={z.cardio.href} data-m>
            <div class="zn-img" data-s style="--r:120deg;--s:.6">
              <Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[360, 560, 720]} sizes="(min-width: 900px) 24vw, 70vw" loading="lazy" format="avif" quality={45} />
            </div>
            <span class="zn-bar" data-s style="--x:-200px;--d:120ms"></span>
            <div class="zn-tx" data-s style="--y:30px;--d:200ms">
              <h3>{z.cardio.title.toLowerCase()}</h3>
              <p>{z.cardio.text}</p>
            </div>
            <span class="zn-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="zn zn-group" href={z.group.href} data-m>
            <div class="zn-img" data-s style="--y:-140px;--r:-45deg">
              <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале 150 м²" widths={[360, 560, 720]} sizes="(min-width: 900px) 30vw, 86vw" loading="lazy" format="avif" quality={45} />
            </div>
            <div class="zn-tx" data-s style="--y:30px;--d:160ms">
              <h3>{z.group.title.toLowerCase()}</h3>
              <p>{cap(z.group.text)}</p>
              <ul class="zn-tags">{tags.map((t) => <li>{t}</li>)}</ul>
            </div>
            <span class="zn-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="zn zn-spa" href={z.spa.href} data-m>
            <div class="zn-heat" aria-hidden="true">
              {[0, 1, 2, 3].map((i) => <span data-s style={`--i:${i};--r:${-180 + i * 30}deg;--s:.4;--d:${i * 90}ms`}></span>)}
            </div>
            <div class="zn-tx" data-s style="--x:-40px;--d:160ms">
              <h3>{z.spa.title.toLowerCase()}</h3>
              <p>{z.spa.text}</p>
              <p class="zn-note">в тарифе «{plans[2].name}»</p>
            </div>
            <span class="zn-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
        </div>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="bh-sec bh-prices" id="tarify" aria-labelledby="bh-price-h">
      <div class="bh-w">
        <div class="bh-sec-head" data-m>
          <h2 id="bh-price-h" class="bh-h2" data-s style="--x:-40px">три формы <span class="o">абонемента</span></h2>
          <p class="bh-sec-note" data-s style="--x:40px;--d:120ms">Половина дня, полный день или всё сразу. Вступительного взноса нет ни в одном.</p>
        </div>
        <div class="bh-plans" data-m>
          {plans.map((p, i) => (
            <article class={`pl pl-${planSkin[i]}`} data-s style={`--y:60px;--d:${i * 110}ms`}>
              <div class={`pl-fig pl-fig-${i}`} aria-hidden="true">
                {i === 0 && <span class="f-half" data-s style="--r:-180deg;--d:200ms"></span>}
                {i === 1 && <span class="f-ci" data-s style="--s:.2;--d:260ms"></span>}
                {i === 2 && <><span class="f-ci" data-s style="--x:-60px;--d:300ms"></span><span class="f-sq" data-s style="--y:-60px;--r:45deg;--d:380ms"></span><span class="f-tr" data-s style="--x:60px;--r:-90deg;--d:460ms"></span></>}
              </div>
              {p.tag && <span class="pl-tag">{p.tag.toLowerCase()}</span>}
              <h3>{p.name.toLowerCase()}</h3>
              <p class="pl-h">{cap(p.hours)}</p>
              <p class="pl-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="pl-year">За год {rub(p.year)}, это {perDay(p.year, 365)} ₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="bh-btn bh-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`22_plan_${p.id}`}><span>Выбрать</span><b><Icon name="chev" /></b></a>
            </article>
          ))}
        </div>

        <div class="bh-trial" data-m>
          <div class="tr-art" aria-hidden="true">
            <span class="tr-ci" data-s style="--x:120px;--y:-80px;--r:-90deg;--s:.5"></span>
            <span class="tr-bar" data-s style="--y:-200px;--d:120ms"></span>
            <span class="tr-sq" data-s style="--x:-120px;--r:90deg;--d:200ms"></span>
            <span class="tr-one" data-s style="--y:40px;--d:280ms">1</span>
            <span class="tr-rub" data-s style="--x:40px;--d:340ms">₽</span>
          </div>
          <div class="tr-tx" data-s style="--y:40px;--d:200ms">
            <h3>пробный день</h3>
            <p>{trial.text}</p>
            <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
            <a class="bh-btn" href="#zayavka" data-lead={trial.title} data-block="22_trial"><span>{trialPromo.cta}</span><b><Icon name="chev" /></b></a>
          </div>
        </div>

        <div class="bh-offers">
          {[tradein, friend].map((pr, i) => (
            <article class={`of of-${i}`} data-m>
              <span class="of-fig" aria-hidden="true">
                {i === 0 ? <><i class="sq a" data-s style="--x:30px;--r:90deg"></i><i class="sq b" data-s style="--x:-30px;--r:-90deg;--d:100ms"></i></> : <><i class="ci a" data-s style="--x:40px"></i><i class="ci b" data-s style="--x:-40px;--d:100ms"></i></>}
              </span>
              <div data-s style="--y:24px;--d:160ms">
                <h3>{pr.title}</h3>
                <p>{pr.text}</p>
                <a class="bh-link" href="#zayavka" data-lead={pr.goal} data-block={`22_promo_${pr.slug}`}>{pr.cta.toLowerCase()}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Тренеры -->
    <section class="bh-sec bh-team" id="trenery" aria-labelledby="bh-team-h">
      <div class="bh-w">
        <div class="bh-sec-head" data-m>
          <h2 id="bh-team-h" class="bh-h2" data-s style="--x:-40px">люди, которые <span class="y">ставят технику</span></h2>
        </div>
        <div class="bh-coaches">
          {trainers.map((t, i) => (
            <figure class={`co co-${coachSkin[i]}`} data-m>
              <div class="co-stage">
                <span class="co-bg" data-s style={`--x:${i === 1 ? 80 : -80}px;--y:${i === 1 ? -60 : 60}px;--r:${i === 2 ? -90 : 45}deg;--s:.6`} aria-hidden="true"></span>
                <div class="co-img" data-s style="--y:40px;--d:140ms">
                  <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 900px) 26vw, 76vw" loading="lazy" format="avif" quality={50} />
                </div>
              </div>
              <figcaption data-s style="--y:20px;--d:240ms"><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="bh-personal" data-m>
          <span class="ps-fig bh-spin" aria-hidden="true"></span>
          <div data-s style="--x:-40px">
            <p class="ps-k">персональные тренировки</p>
            <p class="ps-p">{personalLine}</p>
            <p class="ps-t">{personal.firstFree}. Тренер поставит технику, составит программу под вашу цель и будет следить за прогрессом.</p>
          </div>
          <a class="bh-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="22_personal" data-s style="--x:40px;--d:120ms"><span>Записаться к тренеру</span><b><Icon name="chev" /></b></a>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="bh-sec bh-rev" id="otzyvy" aria-labelledby="bh-rev-h">
      <div class="bh-w">
        <div class="bh-rev-head" data-m>
          <h2 id="bh-rev-h" class="bh-h2" data-s style="--x:-40px">слово <span class="o">гостям</span></h2>
          <a class="bh-score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-s style="--r:-120deg;--s:.4;--d:120ms">
            <b>{rating}</b><span>из 5 на Яндекс Картах<br />{site.rating.text}</span>
          </a>
        </div>
        <div class="bh-quotes" data-m>
          {reviews.map((r, i) => (
            <blockquote class="q" data-s style={`--y:40px;--d:${i * 90}ms`}>
              <span class={`q-m q-m-${i}`} aria-hidden="true"></span>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="bh-final" id="zayavka" aria-labelledby="bh-final-h" data-m>
      <span class="fi-ci" data-s style="--x:200px;--y:-160px;--r:-90deg;--s:.6" aria-hidden="true"></span>
      <span class="fi-tr" data-s style="--x:-160px;--r:90deg;--d:120ms" aria-hidden="true"></span>
      <span class="fi-sq" data-s style="--y:160px;--r:45deg;--d:200ms" aria-hidden="true"></span>
      <div class="bh-w fi-in">
        <div class="fi-tx" data-s style="--x:-40px;--d:120ms">
          <h2 id="bh-final-h" class="bh-h2">форма начинается <span class="y">здесь</span></h2>
          <dl class="fi-facts">
            <div><dt>адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>парковка</dt><dd>Бесплатная, 50 мест под видеонаблюдением</dd></div>
            <div><dt>телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="fi-form" data-s style="--y:60px;--d:260ms">
          <LeadForm id="bh" block="22_final" />
        </div>
      </div>
    </section>

    <footer class="bh-foot">
      <div class="bh-w">
        <div class="bh-foot-big" aria-hidden="true">
          <span>URBAN210<Icon name="chev" /></span>
          <span class="bh-foot-fig"><i class="ci"></i><i class="sq"></i><i class="tr"></i></span>
        </div>
        <div class="bh-foot-cols">
          <div>
            <h2>клуб</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
          </div>
          <div>
            <h2>связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="bh-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Фигуры встают на место, когда группа попадает в экран. Один раз.
  const root = document.querySelector('.bh');
  const groups = document.querySelectorAll<HTMLElement>('.bh [data-m]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root) requestAnimationFrame(() => root.classList.add('is-ready'));
  if (reduce || !('IntersectionObserver' in window)) groups.forEach((g) => g.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    groups.forEach((g) => io.observe(g));
  }
</script>

<style is:global>
