---
// Концепция 09 «Забота»: светлый wellness для женщин. Крем, песок и мягкий персик,
// тёплые цветные фото в арках, Yeseva One + Jost. Медленное движение: солнце встаёт за аркой,
// бейдж пробного дня вращается, фото в арках мягко отдаляются при прокрутке.
import '@fontsource/yeseva-one/cyrillic-400.css';
import '@fontsource/yeseva-one/latin-400.css';
import '@fontsource-variable/jost/wght.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial } from '../../../data/pricing';
import { reviews, trainers, zones, programs, promos, faqGeneral } from '../../../data/content';

const rating = site.rating.value.toString().replace('.', ',');
const soft = programs.find((p) => p.group === 'Мягкий фитнес')!;
const rest = programs.filter((p) => p !== soft);
const space = [
  { title: zones[0].title, text: zones[0].text, image: '/images/zal.jpg', href: zones[0].href },
  { title: zones[1].title, text: zones[1].text, image: '/images/cardio.jpg', href: zones[1].href },
  { title: 'Свободные веса', text: `Гантели, грифы и блины, ${site.facts.freeWeights}. Тренер покажет технику на первом занятии.`, image: '/images/free-weights.jpg', href: '/zal/' },
];
const team = [trainers[0], trainers[1], trainers[2]];
const [lead, ...more] = [reviews[3], reviews[0], reviews[1]];
const start = faqGeneral[0];
const ring = 'пробный день · 1 рубль · пробный день · 1 рубль · ';
const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/ | /g, ' ');
---
<Layout title="Концепция 09 «Забота»" description="Концепция дизайна сайта Urban210: светлый клуб с заботой, групповые программы, SPA и утренние часы." noindex bare>
  <div class="zb">
    <header class="zb-top">
      <a class="zb-logo" href="/concepts/09/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
      <nav class="zb-nav" aria-label="Меню">
        <a href="#groups">Группы</a>
        <a href="#spa">SPA</a>
        <a href="#space">Зал</a>
        <a href="#price">Абонементы</a>
        <a href="#visit">Контакты</a>
      </nav>
      <a class="zb-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="zb-pill sm" href="#visit" data-lead={trial.title} data-block="09_header">Пробный день<span class="zb-rub">за 1 ₽</span></a>
    </header>

    <section class="zb-hero" aria-labelledby="zb-h">
      <div class="zb-hero-tx">
        <p class="zb-kicker"><i></i>Фитнес-клуб в Железнодорожном районе</p>
        <h1 id="zb-h">Время для&nbsp;себя <span>с 6:30 утра</span></h1>
        <p class="zb-lead">Пилатес и растяжка, сауна и хаммам, просторный зал без очередей. Утром спокойно, а у входа бесплатная парковка на 50 мест под видеонаблюдением.</p>
        <div class="zb-cta">
          <a class="zb-pill" href="#visit" data-lead={trial.title} data-block="09_hero">Пробный день за 1 ₽<span class="zb-pill-i"><Icon name="chev" /></span></a>
          <a class="zb-link" href="#price">Абонементы от {fmt(plans[0].month)} ₽</a>
        </div>
        <p class="zb-rate"><span class="zb-stars" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span><b>{rating}</b> на Яндекс Картах, {site.rating.text}</p>
      </div>

      <div class="zb-hero-art">
        <span class="zb-sun" aria-hidden="true"></span>
        <div class="zb-arch zb-arch-hero">
          <Image src={img('/images/stretching.jpg')} alt="Растяжка в зале групповых программ Urban210" widths={[420, 640, 900]} sizes="(min-width: 1000px) 34vw, 82vw" loading="eager" fetchpriority="high" format="webp" quality={55} />
        </div>
        <div class="zb-dot-photo">
          <Image src={img('/images/community/13.jpg')} alt="" widths={[240, 360]} sizes="180px" format="avif" quality={50} />
        </div>
        <a class="zb-badge" href="#visit" data-lead={trial.title} data-block="09_badge" aria-label="Пробный день за 1 рубль">
          <svg viewBox="0 0 200 200" aria-hidden="true"><defs><path id="zb-ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs><text><textPath href="#zb-ring" textLength="484" lengthAdjust="spacing">{ring}</textPath></text></svg>
          <b>1<span class="zb-rub">₽</span></b>
        </a>
      </div>
    </section>

    <ul class="zb-facts" aria-label="Коротко о клубе">
      <li><b>6:30</b><span>открываемся по будням, в выходные в {site.hours[1].time.slice(0, 5)}</span></li>
      <li><b>50</b><span>мест бесплатной парковки у входа под видеонаблюдением</span></li>
      <li><b>0<span class="zb-rub">₽</span></b><span>вступительный взнос, платите только за абонемент</span></li>
      <li><b>150 м²</b><span>отдельный зал для групповых программ</span></li>
    </ul>

    <section class="zb-sec zb-groups" id="groups" aria-labelledby="zb-g">
      <div class="zb-groups-art" data-rise>
        <div class="zb-arch tall"><Image src={img('/images/group.jpg')} alt="Групповое занятие в зале 150 м²" widths={[420, 640, 900]} sizes="(min-width: 1000px) 36vw, 90vw" format="avif" quality={50} /></div>
        <p class="zb-note">Запись на группы в&nbsp;приложении клуба</p>
      </div>
      <div class="zb-groups-tx">
        <h2 id="zb-g">Группы, в которые хочется возвращаться</h2>
        <article class="zb-soft" data-rise>
          <div class="zb-tags">{soft.items.map((t) => <span>{t}</span>)}</div>
          <h3>{soft.group}</h3>
          <p>{soft.text} Хорошее начало, если вы давно не тренировались.</p>
        </article>
        <ul class="zb-prog">
          {rest.map((p) => (
            <li data-rise>
              <h3>{p.group}</h3>
              <p>{p.text}</p>
              <span class="zb-prog-items">{p.items.join(' · ')}</span>
            </li>
          ))}
        </ul>
        <p class="zb-small">Групповые программы входят в абонемент «{plans[2].name}» без доплат.</p>
      </div>
    </section>

    <section class="zb-spa" id="spa" aria-labelledby="zb-s">
      <div class="zb-spa-in">
        <div class="zb-spa-art" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <svg class="zb-steam" viewBox="0 0 120 160" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M30 150c-14-22 14-34 0-58s14-36 0-60" /><path d="M60 150c-14-22 14-34 0-58s14-36 0-60" /><path d="M90 150c-14-22 14-34 0-58s14-36 0-60" /></svg>
        </div>
        <div class="zb-spa-tx">
          <h2 id="zb-s">Тепло после тренировки</h2>
          <p class="zb-lead">Финская сауна, хаммам <span class="zb-nw">40–50 °C</span> и релакс-зона с массажными креслами. Полчаса тишины, и день становится мягче.</p>
          <dl class="zb-spa-list">
            <div><dt>Финская сауна</dt><dd>сухой жар, чтобы прогреться после зала</dd></div>
            <div><dt>Хаммам <span>40–50 °C</span></dt><dd>мягкий влажный пар вместо сухого жара</dd></div>
            <div><dt>Релакс-зона</dt><dd>массажные кресла и время только для вас</dd></div>
          </dl>
          <a class="zb-link" href="#price">SPA входит в «{plans[2].name}»</a>
        </div>
      </div>
    </section>

    <section class="zb-sec" id="space" aria-labelledby="zb-z">
      <div class="zb-head">
        <h2 id="zb-z">Просторно, светло и&nbsp;без очередей</h2>
        <p>{site.facts.area} и {site.facts.machines} {site.facts.brands}. Свободно даже вечером.</p>
      </div>
      <ul class="zb-space">
        {space.map((z, i) => (
          <li class:list={['zb-space-i', `n${i}`]} data-rise>
            <a href={z.href}>
              <div class="zb-arch"><Image src={img(z.image)} alt={z.title} widths={[360, 520, 760]} sizes="(min-width: 1000px) 30vw, 90vw" format="avif" quality={48} /></div>
              <h3>{z.title}</h3>
              <p>{z.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="zb-sec zb-care" aria-labelledby="zb-c">
      <div class="zb-care-art" data-rise>
        <div class="zb-pillph"><Image src={img('/images/community/12.jpg')} alt="Гостья клуба в раздевалке Urban210" widths={[320, 480, 600]} sizes="(min-width: 1000px) 26vw, 60vw" format="avif" quality={50} /></div>
        <div class="zb-pillph sm"><Image src={img('/images/reception.jpg')} alt="Ресепшен клуба" widths={[240, 360]} sizes="200px" format="avif" quality={45} /></div>
      </div>
      <div class="zb-care-tx">
        <h2 id="zb-c">Спокойно с первого дня</h2>
        <ul class="zb-care-list">
          <li data-rise><span class="zb-ic"><Icon name="pin" /></span><div><h3>Парковка у входа</h3><p>{site.parking}. Не нужно кружить по району вечером.</p></div></li>
          <li data-rise><span class="zb-ic"><Icon name="clock" /></span><div><h3>Утро до работы</h3><p>По будням {site.hours[0].time}, в выходные {site.hours[1].time}. Успеть до работы, в обед или после.</p></div></li>
          <li data-rise><span class="zb-ic"><Icon name="check" /></span><div><h3>Тренер рядом</h3><p>{start.a.split('. ').slice(1, 2).join('. ')}.</p></div></li>
          <li data-rise><span class="zb-ic"><Icon name="minus" /></span><div><h3>Без вступительного взноса</h3><p>Регистрация и браслет входят в стоимость абонемента. Заморозка на 30 дней раз в год бесплатно.</p></div></li>
        </ul>
      </div>
    </section>

    <section class="zb-sec zb-price" id="price" aria-labelledby="zb-p">
      <div class="zb-head">
        <h2 id="zb-p">Абонементы</h2>
        <p>Цена за месяц и за год, без скрытых платежей. За год выходит дешевле.</p>
      </div>
      <div class="zb-plans">
        {plans.map((p) => (
          <article class:list={['zb-plan', p.id === 'all' && 'hot']} data-rise>
            <div class="zb-plan-top">
              <h3>{p.name}</h3>
              {p.id === 'all' ? <span class="zb-tag">Группы и SPA</span> : p.tag && <span class="zb-tag ghost">{p.tag}</span>}
            </div>
            <p class="zb-hrs">{p.hours}</p>
            <p class="zb-sum"><b>{fmt(p.month)}</b><span class="zb-rub">₽</span><small>в месяц</small></p>
            <p class="zb-year">{rub(p.year)} за год, это {perDay(p.year, 365)} ₽ в день</p>
            <ul>
              {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
              {p.excluded?.map((f) => <li class="no"><Icon name="minus" />{f}</li>)}
            </ul>
            <a class:list={['zb-pill', 'wide', p.id !== 'all' && 'ghost']} href="#visit" data-lead={`Абонемент «${p.name}»`} data-block={`09_${p.id}`}>Выбрать<span class="zb-pill-i"><Icon name="chev" /></span></a>
          </article>
        ))}
      </div>

      <div class="zb-trial" data-rise>
        <div class="zb-trial-num" aria-hidden="true">1<span class="zb-rub">₽</span></div>
        <div class="zb-trial-tx">
          <h3>{trial.title}</h3>
          <p>{trial.text} Посмотрите раздевалки, SPA-зону и группы, а потом решите.</p>
        </div>
        <a class="zb-pill" href="#visit" data-lead={trial.title} data-block="09_trial">Записаться<span class="zb-pill-i"><Icon name="chev" /></span></a>
      </div>

      <ul class="zb-promos">
        {promos.slice(1).map((p) => (
          <li><a href={`/promo/${p.slug}/`}><b>{p.title}</b><span>{p.short}</span><Icon name="chev" /></a></li>
        ))}
      </ul>
    </section>

    <section class="zb-sec zb-team" aria-labelledby="zb-t">
      <div class="zb-head">
        <h2 id="zb-t">Тренеры, которым можно доверить начало</h2>
        <p>Покажут тренажёры и технику, составят первую программу и подстроят нагрузку под самочувствие.</p>
      </div>
      <ul class="zb-coaches">
        {team.map((t) => (
          <li data-rise>
            <div class="zb-arch"><Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 1000px) 26vw, 80vw" format="avif" quality={48} /></div>
            <h3>{t.name}</h3>
            <p>{t.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="zb-sec zb-rev" aria-labelledby="zb-r">
      <div class="zb-rev-score">
        <h2 id="zb-r">Что пишут гости</h2>
        <p class="zb-big">{rating}</p>
        <p>средняя оценка на Яндекс Картах, {site.rating.text}</p>
        <a class="zb-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать все отзывы</a>
      </div>
      <figure class="zb-quote" data-rise>
        <blockquote>«{lead.text}»</blockquote>
        <figcaption><b>{lead.name}</b>{lead.source}</figcaption>
      </figure>
      <ul class="zb-more">
        {more.map((r) => (
          <li data-rise><p>«{r.text}»</p><span><b>{r.name}</b>{r.source}</span></li>
        ))}
      </ul>
    </section>

    <section class="zb-visit" id="visit" aria-labelledby="zb-v">
      <div class="zb-visit-in">
        <div class="zb-visit-tx">
          <h2 id="zb-v">Приходите познакомиться</h2>
          <p class="zb-lead">Оставьте телефон, администратор перезвонит и подберёт удобное время для пробного дня. Возьмите форму, сменную обувь и паспорт.</p>
          <dl class="zb-contacts">
            <div class="wide"><dt>Адрес</dt><dd>{site.address.locality}, {site.address.short}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <span class="nw">{`${h.days} ${h.time}`}</span>)}</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
            <div><dt>Парковка</dt><dd>50 мест у входа, бесплатно</dd></div>
          </dl>
          <p class="zb-msg"><a href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a><a href={telegramLink('concept_09')} target="_blank" rel="noopener"><Icon name="tg" />Telegram</a></p>
        </div>
        <div class="zb-visit-form">
          <LeadForm id="zb" block="09_final" />
        </div>
      </div>
    </section>

    <footer class="zb-foot">
      <div class="zb-foot-in">
        <p class="zb-foot-logo" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="zb-foot-cols">
          <div><h2>Клуб</h2><p>{site.address.locality}, {site.address.street}<br />{site.district}</p></div>
          <div><h2>Часы</h2><p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p></div>
          <div><h2>Связь</h2><p><a href={site.phone.href}>{site.phone.display}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p></div>
          <div><h2>Документы</h2><p><a href="/rules/">Правила клуба</a><br /><a href="/oferta/">Договор-оферта</a><br /><a href="/policy/">Политика конфиденциальности</a></p></div>
        </div>
        <p class="zb-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  body:has(.zb) {
    --bg: #f7f0e7;
    --card: #fffaf4;
    --raise: #f1e6d8;
    --ink: #2f221c;
    --muted: #6e5a4e;
    --line: rgb(47 34 28 / 0.14);
    --accent: #2f221c;
    --accent-ink: #fbf5ee;
    --font-display: 'Yeseva One', Georgia, serif;
    --font-body: 'Jost Variable', 'Jost', system-ui, sans-serif;
    background: #f7f0e7;
    color: #2f221c;
    color-scheme: light;
    font-size: 17px;
  }
  body:has(.zb) .btn { border-radius: 999px; font-weight: 500; letter-spacing: 0.01em; }
  body:has(.zb) .btn:hover { --b: #4a362c; }
  body:has(.zb) .form { --muted: #6e5a4e; --line: rgb(47 34 28 / 0.16); }
  body:has(.zb) .form h3 { font-weight: 400; letter-spacing: 0; }
  body:has(.zb) .field input { border-radius: 16px; background: #fffaf4; }
  body:has(.zb) .form-msg.is-err { background: #f9dccd; color: #8a3a1c; }
  body:has(.zb) .field .err, body:has(.zb) .consent.bad { color: #b4471f; }
  body:has(.zb) .field.bad input { border-color: #b4471f; }
  body:has(.zb) .form-done .ok { background: #f4b393; color: #2f221c; }
  body:has(.zb) dialog.lead .form { border-radius: 28px; }
  body:has(.zb) dialog.lead::backdrop { background: rgb(47 34 28 / 0.45); }
  body:has(.zb) .mbar { background: rgb(247 240 231 / 0.94); border-top-color: rgb(47 34 28 / 0.12); }
  body:has(.zb) .mbar a.ic { border-radius: 999px; }
</style>

<style>
  .zb {
    --cream: #f7f0e7;
    --white: #fffaf4;
    --sand: #ecdccb;
    --sand-2: #e2ccb5;
    --peach: #f4b393;
    --peach-2: #f9d9c6;
    --clay: #b9532d;
    --ink: #2f221c;
    --ink-2: #6e5a4e;
    --line: rgb(47 34 28 / 0.14);
    --serif: 'Yeseva One', Georgia, serif;
    --sans: 'Jost Variable', 'Jost', system-ui, sans-serif;
    --g: clamp(20px, 5vw, 72px);
    --slow: cubic-bezier(0.25, 0.6, 0.2, 1);
    font-family: var(--sans);
    color: var(--ink);
    overflow-x: clip;
  }
  .zb :global(h1), .zb :global(h2), .zb :global(h3) { font-family: var(--serif); font-weight: 400; letter-spacing: -0.005em; line-height: 1.08; }
  .zb h2 { font-size: clamp(2.1rem, 1.3rem + 3.2vw, 4.1rem); line-height: 1.04; max-width: 16ch; }
  .zb-rub { font-family: var(--sans); font-weight: 400; }
  .zb-nw { white-space: nowrap; }
  .zb h3 { hyphens: manual; }

  /* Шапка */
  .zb-top { position: relative; z-index: 5; display: flex; align-items: center; gap: 28px; padding: 22px var(--g); max-width: 1480px; margin: 0 auto; }
  .zb-logo { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 1.05rem; letter-spacing: 0.16em; text-decoration: none; }
  .zb-logo :global(svg) { width: 17px; height: 13px; color: var(--clay); }
  .zb-nav { display: none; gap: 30px; margin-left: auto; font-size: 0.98rem; }
  .zb-nav a { text-decoration: none; color: var(--ink-2); transition: color 0.3s; }
  .zb-nav a:hover { color: var(--ink); }
  .zb-tel { display: none; text-decoration: none; font-weight: 500; }
  .zb-top .zb-pill { margin-left: auto; }
  @media (min-width: 1100px) {
    .zb-nav { display: flex; }
    .zb-tel { display: inline; }
    .zb-top .zb-pill { margin-left: 0; }
  }

  /* Кнопки */
  .zb-pill { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 58px; padding: 0 8px 0 28px; border-radius: 999px; background: var(--ink); color: var(--white); text-decoration: none; font-weight: 500; font-size: 1.02rem; letter-spacing: 0.01em; transition: background-color 0.4s var(--slow); }
  .zb-pill:hover { background: #4a362c; }
  .zb-pill-i { width: 44px; height: 44px; border-radius: 50%; background: var(--peach); color: var(--ink); display: grid; place-items: center; transition: transform 0.5s var(--slow); }
  .zb-pill-i :global(svg) { width: 15px; height: 12px; }
  .zb-pill:hover .zb-pill-i { transform: translateX(4px); }
  .zb-pill.sm { min-height: 46px; padding: 0 20px; gap: 6px; font-size: 0.95rem; }
  .zb-pill.sm .zb-rub { color: var(--peach); }
  .zb-pill.wide { width: 100%; justify-content: space-between; }
  .zb-pill.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .zb-pill.ghost:hover { background: var(--ink); color: var(--white); }
  .zb-link { font-weight: 500; text-decoration: underline; text-decoration-color: var(--peach); text-decoration-thickness: 2px; text-underline-offset: 7px; transition: text-decoration-color 0.3s; }
  .zb-link:hover { text-decoration-color: var(--clay); }
  @media (max-width: 400px) { .zb-pill.sm { padding: 0 16px; font-size: 0.9rem; } }

  /* Первый экран */
  .zb-hero { display: grid; gap: 48px; padding: clamp(20px, 4vw, 48px) var(--g) clamp(40px, 6vw, 80px); max-width: 1480px; margin: 0 auto; }
  .zb-kicker { display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color: var(--ink-2); margin-bottom: 22px; }
  .zb-kicker i { width: 9px; height: 9px; border-radius: 50%; background: var(--peach); box-shadow: 0 0 0 5px var(--peach-2); }
  .zb-hero h1 { font-size: clamp(3.3rem, 1.2rem + 6.4vw, 7rem); line-height: 0.98; letter-spacing: -0.015em; max-width: 9ch; }
  .zb-hero h1 span { display: block; color: var(--clay); }
  .zb-lead { font-size: clamp(1.08rem, 1rem + 0.35vw, 1.3rem); line-height: 1.55; color: var(--ink-2); max-width: 40ch; }
  .zb-hero .zb-lead { margin-top: 26px; }
  .zb-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 34px; }
  .zb-rate { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 34px; font-size: 0.95rem; color: var(--ink-2); }
  .zb-rate b { color: var(--ink); font-weight: 600; }
  .zb-stars { display: inline-flex; gap: 2px; color: var(--clay); }
  .zb-stars :global(svg) { width: 15px; height: 15px; }

  .zb-hero-art { position: relative; justify-self: center; width: min(100%, 520px); aspect-ratio: 520 / 620; }
  .zb-sun { position: absolute; left: -8%; top: 4%; width: 64%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 40%, #f9c9ad, var(--peach) 70%); }
  .zb-arch { position: relative; overflow: hidden; border-radius: 999px 999px 28px 28px; background: var(--sand); isolation: isolate; }
  .zb-arch :global(img) { width: 100%; height: 100%; object-fit: cover; filter: sepia(0.22) saturate(1.15) brightness(1.03) contrast(0.96); }
  .zb-arch::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(244 179 147 / 0.14), rgb(185 83 45 / 0.12)); mix-blend-mode: multiply; pointer-events: none; }
  .zb-arch-hero { position: absolute; right: 0; bottom: 0; width: 80%; height: 92%; border-radius: 999px 999px 36px 36px; }
  .zb-arch-hero :global(img) { object-position: 62% 50%; }
  .zb-dot-photo { position: absolute; left: 0; bottom: 6%; width: 34%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 7px solid var(--cream); z-index: 2; }
  .zb-dot-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; filter: sepia(0.2) saturate(1.1); }
  .zb-badge { position: absolute; right: -4%; top: 0; z-index: 3; width: 30%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: var(--cream); color: var(--ink); text-decoration: none; box-shadow: 0 14px 40px -18px rgb(47 34 28 / 0.35); }
  .zb-badge svg { position: absolute; inset: 6%; width: 88%; height: 88%; overflow: visible; }
  .zb-badge text { font: 500 16px var(--sans); letter-spacing: 0; text-transform: uppercase; fill: currentColor; }
  .zb-badge b { font: 400 clamp(1.8rem, 1rem + 2.4vw, 2.6rem)/1 var(--serif); color: var(--clay); }
  .zb-badge b .zb-rub { font-size: 0.6em; margin-left: 2px; }

  @media (min-width: 1000px) {
    .zb-hero { grid-template-columns: 1.05fr 0.95fr; align-items: center; min-height: min(calc(100svh - 92px), 820px); gap: 40px; }
    .zb-hero-art { justify-self: end; width: min(100%, 560px); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .zb-sun { animation: zb-rise 2.8s var(--slow) both 0.15s; }
    .zb-badge svg { animation: zb-spin 48s linear infinite; }
    .zb-hero-tx > * { animation: zb-in 1.2s var(--slow) both; }
    .zb-hero-tx > :nth-child(2) { animation-delay: 0.1s; }
    .zb-hero-tx > :nth-child(3) { animation-delay: 0.2s; }
    .zb-hero-tx > :nth-child(4) { animation-delay: 0.3s; }
    .zb-hero-tx > :nth-child(5) { animation-delay: 0.4s; }
    .zb-arch-hero :global(img) { animation: zb-breathe 18s ease-in-out infinite alternate; }
  }
  @keyframes zb-rise { from { transform: translateY(46%) scale(0.92); opacity: 0; } }
  @keyframes zb-spin { to { transform: rotate(360deg); } }
  @keyframes zb-in { from { opacity: 0; transform: translateY(18px); } }
  @keyframes zb-breathe { from { transform: scale(1.02); } to { transform: scale(1.09); } }

  /* Факты */
  .zb-facts { list-style: none; display: grid; grid-template-columns: 1fr 1fr; max-width: 1480px; margin: 0 auto; padding: 0 var(--g); }
  .zb-facts li { display: grid; gap: 6px; align-content: start; padding: 26px 18px 26px 0; border-top: 1px solid var(--line); }
  .zb-facts li:nth-child(even) { padding-left: 18px; border-left: 1px solid var(--line); }
  .zb-facts b { font: 400 clamp(2rem, 1.4rem + 2vw, 3rem)/1 var(--serif); }
  .zb-facts b .zb-rub { font-size: 0.6em; margin-left: 3px; }
  .zb-facts span { font-size: 0.93rem; line-height: 1.4; color: var(--ink-2); max-width: 24ch; }
  @media (min-width: 900px) {
    .zb-facts { grid-template-columns: repeat(4, 1fr); }
    .zb-facts li { padding: 30px 28px; border-left: 1px solid var(--line); }
    .zb-facts li:first-child { border-left: 0; padding-left: 0; }
  }

  /* Секции */
  .zb-sec { max-width: 1480px; margin: 0 auto; padding: clamp(88px, 11vw, 160px) var(--g) 0; }
  .zb-head { display: grid; gap: 20px; margin-bottom: clamp(40px, 5vw, 72px); }
  .zb-head p { color: var(--ink-2); font-size: 1.08rem; max-width: 46ch; }
  @media (min-width: 1000px) { .zb-head { grid-template-columns: 1.2fr 0.8fr; align-items: end; } .zb-head p { justify-self: end; } }

  /* Группы */
  .zb-groups { display: grid; gap: 48px; }
  .zb-groups-art { position: relative; }
  .zb-arch.tall { aspect-ratio: 4 / 5; }
  .zb-arch.tall :global(img) { object-position: 46% 50%; }
  .zb-note { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); width: max-content; max-width: 86%; padding: 12px 20px; border-radius: 999px; background: var(--cream); font-size: 0.92rem; text-align: center; box-shadow: 0 10px 30px -16px rgb(47 34 28 / 0.4); }
  .zb-groups-tx h2 { margin-bottom: 36px; }
  .zb-soft { padding: clamp(26px, 3vw, 40px); border-radius: 32px; background: var(--peach-2); }
  .zb-soft h3 { font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem); margin: 18px 0 12px; }
  .zb-soft p { color: #5c4639; max-width: 44ch; }
  .zb-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .zb-tags span { padding: 7px 16px; border-radius: 999px; background: var(--white); font-size: 0.92rem; font-weight: 500; }
  .zb-prog { list-style: none; margin-top: 10px; }
  .zb-prog li { display: grid; gap: 6px; padding: 24px 4px; border-bottom: 1px solid var(--line); }
  .zb-prog h3 { font-size: 1.6rem; }
  .zb-prog p { color: var(--ink-2); max-width: 48ch; }
  .zb-prog-items { font-size: 0.9rem; font-weight: 500; letter-spacing: 0.04em; color: var(--clay); }
  .zb-small { margin-top: 22px; font-size: 0.95rem; color: var(--ink-2); }
  @media (min-width: 1000px) {
    .zb-groups { grid-template-columns: 0.9fr 1.1fr; gap: clamp(48px, 6vw, 110px); align-items: start; }
    .zb-groups-art { position: sticky; top: 32px; }
    .zb-prog li { grid-template-columns: 0.9fr 1.4fr; column-gap: 28px; align-items: baseline; }
    .zb-prog-items { grid-column: 2; }
  }

  /* SPA */
  .zb-spa { margin-top: clamp(88px, 11vw, 160px); padding: 0 clamp(10px, 2vw, 28px); }
  .zb-spa-in { position: relative; overflow: hidden; display: grid; gap: 44px; max-width: 1440px; margin: 0 auto; padding: clamp(48px, 7vw, 110px) clamp(22px, 5vw, 80px); border-radius: clamp(32px, 5vw, 64px); background: var(--sand); }
  .zb-spa-art { position: relative; width: min(100%, 420px); aspect-ratio: 1 / 1.05; justify-self: center; display: grid; place-items: end center; }
  .zb-spa-art span { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); border-radius: 999px 999px 0 0; }
  .zb-spa-art span:nth-child(1) { width: 100%; height: 100%; background: var(--sand-2); }
  .zb-spa-art span:nth-child(2) { width: 76%; height: 76%; background: var(--peach); }
  .zb-spa-art span:nth-child(3) { width: 52%; height: 52%; background: #f6c4a8; }
  .zb-spa-art span:nth-child(4) { width: 28%; height: 28%; background: var(--cream); }
  .zb-steam { position: relative; z-index: 1; width: 30%; color: var(--cream); margin-bottom: 30%; opacity: 0.9; }
  .zb-spa-tx { display: grid; gap: 26px; align-content: center; }
  .zb-spa-list { display: grid; margin: 6px 0; }
  .zb-spa-list div { padding: 18px 0; border-top: 1px solid rgb(47 34 28 / 0.16); display: grid; gap: 4px; }
  .zb-spa-list dt { font: 400 1.5rem/1.2 var(--serif); }
  .zb-spa-list dt span { color: var(--clay); }
  .zb-spa-list dd { margin: 0; color: #5c4639; }
  @media (min-width: 1000px) {
    .zb-spa-in { grid-template-columns: 0.9fr 1.1fr; gap: clamp(48px, 6vw, 110px); }
    .zb-spa-list div { grid-template-columns: 1fr 1fr; align-items: baseline; gap: 20px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .zb-steam path { animation: zb-steam 6s ease-in-out infinite; }
    .zb-steam path:nth-child(2) { animation-delay: -2s; }
    .zb-steam path:nth-child(3) { animation-delay: -4s; }
  }
  @keyframes zb-steam { 0%, 100% { transform: translateY(6px); opacity: 0.35; } 50% { transform: translateY(-8px); opacity: 1; } }

  /* Пространство */
  .zb-space { list-style: none; display: grid; gap: 44px; }
  .zb-space a { display: grid; gap: 12px; text-decoration: none; }
  .zb-space .zb-arch { aspect-ratio: 3 / 4; margin-bottom: 10px; }
  .zb-space h3 { font-size: 1.75rem; }
  .zb-space p { color: var(--ink-2); max-width: 36ch; }
  .zb-space a:hover h3 { color: var(--clay); }
  @media (min-width: 900px) {
    .zb-space { grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 48px); align-items: start; }
    .zb-space .n1 { margin-top: 90px; }
    .zb-space .n2 { margin-top: 30px; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .zb-space .zb-arch :global(img), .zb-coaches .zb-arch :global(img), .zb-groups-art .zb-arch :global(img) { animation: zb-open linear both; animation-timeline: view(); animation-range: entry 0% cover 55%; }
    }
  }
  @keyframes zb-open { from { transform: scale(1.18); } to { transform: scale(1); } }

  /* Забота */
  .zb-care { display: grid; gap: 52px; }
  .zb-care-art { position: relative; width: min(100%, 460px); justify-self: center; }
  .zb-pillph { overflow: hidden; border-radius: 999px; aspect-ratio: 9 / 15; width: 72%; background: var(--sand); }
  .zb-pillph :global(img) { width: 100%; height: 100%; object-fit: cover; filter: sepia(0.18) saturate(1.1); }
  .zb-pillph.sm { position: absolute; right: 0; bottom: 8%; width: 44%; aspect-ratio: 1; border-radius: 50%; border: 7px solid var(--cream); }
  .zb-care-tx h2 { margin-bottom: 30px; }
  .zb-care-list { list-style: none; display: grid; }
  .zb-care-list li { display: grid; grid-template-columns: 52px 1fr; gap: 20px; padding: 24px 0; border-top: 1px solid var(--line); }
  .zb-ic { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--peach-2); color: var(--clay); }
  .zb-ic :global(svg) { width: 22px; height: 22px; }
  .zb-care-list h3 { font-size: 1.45rem; margin-bottom: 6px; }
  .zb-care-list p { color: var(--ink-2); max-width: 50ch; }
  @media (min-width: 1000px) { .zb-care { grid-template-columns: 0.8fr 1.2fr; gap: clamp(48px, 7vw, 120px); align-items: center; } }

  /* Цены */
  .zb-plans { display: grid; gap: 18px; }
  .zb-plan { display: flex; flex-direction: column; padding: clamp(26px, 2.6vw, 38px); border-radius: 32px; background: var(--white); box-shadow: 0 1px 0 var(--line), 0 30px 60px -48px rgb(47 34 28 / 0.4); }
  .zb-plan.hot { background: var(--peach); }
  .zb-plan-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .zb-plan h3 { font-size: 1.75rem; }
  .zb-tag { flex: none; padding: 6px 14px; border-radius: 999px; background: var(--ink); color: var(--white); font-size: 0.82rem; font-weight: 500; }
  .zb-tag.ghost { background: var(--peach-2); color: var(--ink); }
  .zb-hrs { margin-top: 6px; color: var(--ink-2); font-size: 0.95rem; }
  .zb-plan.hot .zb-hrs, .zb-plan.hot .zb-year, .zb-plan.hot li.no { color: #5a3a2a; }
  .zb-sum { display: flex; align-items: baseline; gap: 6px; margin-top: 28px; }
  .zb-sum b { font: 400 clamp(3rem, 2.2rem + 2vw, 4rem)/1 var(--serif); letter-spacing: -0.01em; }
  .zb-sum .zb-rub { font-size: 1.7rem; }
  .zb-sum small { font-size: 1rem; color: var(--ink-2); margin-left: 4px; }
  .zb-plan.hot .zb-sum small { color: #5a3a2a; }
  .zb-year { margin-top: 8px; font-size: 0.95rem; color: var(--ink-2); }
  .zb-plan ul { list-style: none; display: grid; gap: 10px; margin: 26px 0 30px; padding-top: 24px; border-top: 1px solid var(--line); flex: 1; align-content: start; }
  .zb-plan li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; font-size: 0.98rem; line-height: 1.4; }
  .zb-plan li :global(svg) { width: 18px; height: 18px; margin-top: 1px; color: var(--clay); }
  .zb-plan.hot li :global(svg) { color: var(--ink); }
  .zb-plan li.no { color: #8a776b; }
  .zb-plan li.no :global(svg) { color: #a8968a; }
  @media (min-width: 960px) { .zb-plans { grid-template-columns: repeat(3, 1fr); } .zb-plan.hot { transform: translateY(-14px); } }

  .zb-trial { margin-top: 28px; display: grid; gap: 18px; align-items: center; padding: clamp(28px, 3.4vw, 48px); border-radius: 32px; background: var(--ink); color: var(--white); }
  .zb-trial-num { font: 400 clamp(5rem, 4rem + 4vw, 8rem)/0.9 var(--serif); color: var(--peach); }
  .zb-trial-num .zb-rub { font-size: 0.45em; margin-left: 6px; }
  .zb-trial h3 { font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.4rem); margin-bottom: 10px; }
  .zb-trial p { color: #dacbbf; max-width: 52ch; }
  .zb-trial .zb-pill { background: var(--peach); color: var(--ink); justify-self: start; }
  .zb-trial .zb-pill-i { background: var(--ink); color: var(--peach); }
  .zb-trial .zb-pill:hover { background: #f7c4a8; }
  @media (min-width: 960px) { .zb-trial { grid-template-columns: auto 1fr auto; gap: clamp(28px, 4vw, 64px); } }

  .zb-promos { list-style: none; display: grid; gap: 12px; margin-top: 12px; }
  .zb-promos a { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; align-items: center; padding: 22px 26px; border-radius: 24px; border: 1px solid var(--line); text-decoration: none; transition: background-color 0.4s var(--slow); }
  .zb-promos a:hover { background: var(--white); }
  .zb-promos b { font: 400 1.25rem/1.25 var(--serif); }
  .zb-promos span { grid-column: 1; color: var(--ink-2); font-size: 0.95rem; }
  .zb-promos :global(svg) { grid-row: 1 / 3; grid-column: 2; width: 17px; height: 13px; color: var(--clay); }
  @media (min-width: 960px) { .zb-promos { grid-template-columns: 1fr 1fr; } }

  /* Тренеры */
  .zb-coaches { list-style: none; display: grid; gap: 40px; grid-template-columns: 1fr; }
  .zb-coaches .zb-arch { aspect-ratio: 4 / 4.6; margin-bottom: 18px; background: #3a2c25; }
  .zb-coaches .zb-arch :global(img) { object-position: 50% 30%; }
  .zb-coaches h3 { font-size: 1.6rem; }
  .zb-coaches p { color: var(--ink-2); margin-top: 4px; }
  @media (min-width: 700px) { .zb-coaches { grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 44px); } .zb-coaches li:nth-child(2) { margin-top: 60px; } }

  /* Отзывы */
  .zb-rev { display: grid; gap: 40px; }
  .zb-rev-score { display: grid; gap: 10px; align-content: start; }
  .zb-rev-score h2 { margin-bottom: 18px; }
  .zb-big { font: 400 clamp(5rem, 4rem + 4vw, 8.5rem)/0.9 var(--serif); color: var(--clay); }
  .zb-rev-score p:not(.zb-big) { color: var(--ink-2); max-width: 26ch; margin-bottom: 10px; }
  .zb-quote { margin: 0; padding: clamp(28px, 4vw, 56px); border-radius: 36px; background: var(--white); }
  .zb-quote blockquote { margin: 0; font: 400 clamp(1.35rem, 1.1rem + 1vw, 2rem)/1.35 var(--serif); }
  .zb-quote figcaption, .zb-more span { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; color: var(--ink-2); font-size: 0.95rem; }
  .zb-quote figcaption b, .zb-more b { color: var(--ink); font-weight: 600; }
  .zb-more { list-style: none; display: grid; gap: 16px; }
  .zb-more li { padding: 28px; border-radius: 28px; border: 1px solid var(--line); }
  .zb-more p { color: #4b3a31; }
  @media (min-width: 1000px) {
    .zb-rev { grid-template-columns: 0.75fr 1.25fr; column-gap: clamp(40px, 6vw, 100px); }
    .zb-rev-score { grid-row: span 2; position: sticky; top: 40px; }
    .zb-more { grid-template-columns: 1fr 1fr; }
  }

  /* Заявка */
  .zb-visit { margin-top: clamp(88px, 11vw, 160px); padding: 0 clamp(10px, 2vw, 28px); }
  .zb-visit-in { display: grid; gap: 40px; max-width: 1440px; margin: 0 auto; padding: clamp(44px, 7vw, 110px) clamp(22px, 5vw, 80px); border-radius: clamp(32px, 5vw, 64px); background: var(--peach-2); }
  .zb-visit-tx h2 { margin-bottom: 22px; }
  .zb-visit .zb-lead { color: #5c4639; }
  .zb-contacts { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 24px; margin-top: 36px; }
  .zb-contacts dt { font-size: 0.85rem; color: #7a6253; margin-bottom: 4px; }
  .zb-contacts dd { margin: 0; font-weight: 500; line-height: 1.45; }
  .zb-contacts a { text-decoration: none; }
  .zb-contacts .nw { display: block; white-space: nowrap; }
  @media (max-width: 599px) { .zb-contacts .wide { grid-column: 1 / -1; } }
  .zb-msg { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .zb-msg a { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 18px; border-radius: 999px; background: var(--white); text-decoration: none; font-weight: 500; }
  .zb-msg :global(svg) { width: 18px; height: 18px; }
  .zb-visit-form :global(.form) { border-radius: 32px; background: var(--white); padding: clamp(24px, 3vw, 40px); box-shadow: 0 40px 80px -50px rgb(47 34 28 / 0.5); }
  .zb-visit-form :global(.form h3) { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); }
  .zb-visit-form :global(.field input) { background: var(--cream); border-color: transparent; }
  .zb-visit-form :global(.field input:focus) { border-color: var(--ink); }
  @media (min-width: 1000px) { .zb-visit-in { grid-template-columns: 1.05fr 0.95fr; gap: clamp(48px, 6vw, 110px); align-items: center; } }

  /* Подвал */
  .zb-foot { margin-top: clamp(20px, 2vw, 28px); background: var(--ink); color: #eadccf; }
  .zb-foot-in { max-width: 1480px; margin: 0 auto; padding: clamp(56px, 7vw, 100px) var(--g) calc(28px + 84px); }
  .zb-foot .zb-foot-logo { display: flex; align-items: center; gap: 0.12em; font: 400 clamp(2.6rem, 0.6rem + 9.4vw, 9.4rem)/0.9 var(--serif); color: var(--white); letter-spacing: -0.02em; }
  .zb-foot-logo :global(svg) { width: 0.42em; height: 0.36em; color: var(--peach); }
  .zb-foot-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 24px; margin-top: clamp(40px, 5vw, 64px); padding-top: 32px; border-top: 1px solid rgb(234 220 207 / 0.16); }
  .zb-foot h2 { font: 500 0.85rem/1.3 var(--sans); letter-spacing: 0.08em; color: var(--peach); margin-bottom: 10px; max-width: none; }
  .zb-foot p { line-height: 1.7; font-size: 0.97rem; }
  .zb-foot a { text-decoration: none; }
