---
// Концепция 32 «Цифры крупно»: страницу держат только цифры клуба.
// Чёрный лист, светлые табличные цифры Manrope и одна оранжевая цифра на экран.
// Движение: цифры прокручиваются, как барабан счётчика, и встают на своё значение, когда попадают в экран.
import mnCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import mnLat from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import mnExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, zones, promos } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (url: string, range: string) => `@font-face{font-family:'Manrope 32';font-style:normal;font-display:swap;font-weight:200 800;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = ff(mnCyr, UR) + ff(mnLat, UL) + ff(mnExt, 'U+20BD');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const [weekday, weekend] = site.hours;
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const dayPrice = perDay(plans[0].month, 30);
const stats = [
  { n: '60+', t: `тренажёров ${site.facts.brands}` },
  { n: '150 м²', t: 'зал групповых программ' },
  { n: '60 кг', t: 'предел свободных весов' },
  { n: '40–50 °C', t: 'хаммам в SPA-зоне' },
  { n: '50', t: 'мест бесплатной парковки' },
  { n: `${dayPrice} ₽`, t: 'в день по дневной карте' },
];
const zoneRows = [z.zal, z.cardio, z.group, z.spa];
---
<Layout title="Концепция 32 «Цифры крупно»" description="Концепция дизайна сайта Urban210: страницу держат крупные цифры клуба, одна оранжевая на экран." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={mnLat} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mnExt} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="cf">
    <header class="cf-top">
      <div class="cf-w cf-top-in">
        <a class="cf-logo" href="/concepts/32/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="cf-nav" aria-label="Разделы">
          <a href="#chasy">Часы</a><a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="cf-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="cf-btn cf-btn-s" href="#tarify" data-block="32_header">Выбрать карту</a>
      </div>
    </header>

    <!-- 43 ₽ в день -->
    <section class="cf-scr cf-first" aria-labelledby="cf-h1">
      <div class="cf-w cf-first-in">
        <div class="cf-first-tx">
          <p class="cf-lbl">Фитнес-клуб в Хабаровске</p>
          <h1 id="cf-h1" class="cf-h1">День безлимита в&nbsp;Urban210 стоит от <span class="cf-sr">{dayPrice} ₽</span></h1>
        </div>
        <p class="cf-giant cf-or" aria-hidden="true" data-roll>{dayPrice} ₽</p>
        <div class="cf-first-side">
          <p class="cf-p">{plans[0].name}: {rub(plans[0].month)} в месяц, {plans[0].hours}. Зал, кардиозона, раздевалки и парковка.</p>
          <div class="cf-acts">
            <a class="cf-btn" href="#tarify" data-block="32_hero">Выбрать карту</a>
            <a class="cf-link" href="#zayavka" data-lead="Заявка с сайта" data-block="32_hero">Оставить заявку</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Часы -->
    <section class="cf-scr" id="chasy" aria-labelledby="cf-hh">
      <div class="cf-w">
        <div class="cf-row-h">
          <h2 id="cf-hh" class="cf-h2">Открыто по будням</h2>
          <span class="cf-lbl">{weekday.days}</span>
        </div>
        <p class="cf-wide cf-or cf-hours" aria-label={weekday.time}><span data-roll aria-hidden="true">{weekday.time.split('–')[0]}</span><span class="cf-dash" aria-hidden="true">–</span><br class="cf-br" /><span data-roll aria-hidden="true">{weekday.time.split('–')[1]}</span></p>
        <div class="cf-sub">
          <div>
            <span class="cf-lbl">{weekend.days}</span>
            <p class="cf-mid" data-roll>{weekend.time}</p>
          </div>
          <p class="cf-p">До работы, в обед или после. Дневная карта действует {plans[0].hours}, полный день и «Всё включено» на всё время работы клуба.</p>
        </div>
      </div>
    </section>

    <!-- Площадь и зоны -->
    <section class="cf-scr" id="zony" aria-labelledby="cf-zh">
      <div class="cf-w">
        <div class="cf-row-h">
          <h2 id="cf-zh" class="cf-h2">Площадь клуба</h2>
          <span class="cf-lbl">более</span>
        </div>
        <p class="cf-wide cf-or cf-area" data-roll>1300 м²</p>
        <div class="cf-photo">
          <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1440px) 1312px, 92vw" loading="lazy" format="avif" quality={45} />
        </div>
        <ul class="cf-stats">
          {stats.map((s) => (
            <li><p class="cf-mid" data-roll>{s.n}</p><span>{s.t}</span></li>
          ))}
        </ul>
        <ol class="cf-zones">
          {zoneRows.map((x, i) => (
            <li>
              <a href={x.href}>
                <span class="cf-ix">0{i + 1}</span>
                <h3>{x.title}</h3>
                <p>{cap(x.text)}</p>
                <Icon name="chev" class="cf-go" />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="cf-scr" id="tarify" aria-labelledby="cf-ph">
      <div class="cf-w">
        <div class="cf-row-h">
          <h2 id="cf-ph" class="cf-h2">Абонемент в месяц</h2>
          <span class="cf-lbl">от {dayPrice} ₽ в день</span>
        </div>
        <div class="cf-plans">
          {plans.map((p, i) => (
            <article class="cf-plan">
              <p class={`cf-price${i === 1 ? ' cf-or' : ''}`}><span data-roll>{num(p.month)}</span><small>₽</small></p>
              <div class="cf-plan-h">
                <h3>{p.name}</h3>
                {p.tag && <span class="cf-lbl">{p.tag}</span>}
              </div>
              <p class="cf-plan-hr">{cap(p.hours)}</p>
              <dl class="cf-year">
                <div><dt>за год</dt><dd>{rub(p.year)}</dd></div>
                <div><dt>в день</dt><dd>{perDay(p.year, 365)} ₽</dd></div>
              </dl>
              <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
              {p.excluded && <p class="cf-no">Не входит: {p.excluded.map((x) => x.toLowerCase()).join(', ')}</p>}
              <a class={`cf-btn cf-btn-w${i === 1 ? '' : ' cf-btn-o'}`} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`32_plan_${p.id}`}>Выбрать «{p.name}»</a>
            </article>
          ))}
        </div>

        <div class="cf-extra">
          <div class="cf-ex">
            <p class="cf-mid" data-roll>{dayPrice} ₽</p>
            <h3>В день по дневной карте</h3>
            <p>{plans[0].name}: {rub(plans[0].month)} в месяц, {plans[0].hours}.</p>
            <a class="cf-link" href="#zayavka" data-lead="Заявка с сайта" data-block="32_offer">Оставить заявку</a>
          </div>
          <div class="cf-ex">
            <p class="cf-mid" data-roll>999 ₽</p>
            <h3>{tradein.title}</h3>
            <p>{tradein.text}</p>
            <a class="cf-link" href="#zayavka" data-lead={tradein.goal} data-block="32_promo_trade-in">{tradein.cta}</a>
          </div>
          <div class="cf-ex">
            <p class="cf-mid" data-roll>1+1</p>
            <h3>{friend.short}</h3>
            <p>{friend.text}</p>
            <a class="cf-link" href="#zayavka" data-lead={friend.goal} data-block="32_promo_1-plus-1">{friend.cta}</a>
          </div>
          <div class="cf-ex">
            <p class="cf-mid" data-roll>{num(personal.price)} ₽</p>
            <h3>{personal.pack} персональных тренировок</h3>
            <p>{personal.firstFree}.</p>
            <a class="cf-link" href="#zayavka" data-lead="Персональная тренировка" data-block="32_personal">Записаться к тренеру</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="cf-scr" id="otzyvy" aria-labelledby="cf-rh">
      <div class="cf-w">
        <div class="cf-row-h">
          <h2 id="cf-rh" class="cf-h2">Оценка на Яндекс Картах</h2>
          <span class="cf-lbl">из 5</span>
        </div>
        <div class="cf-rate">
          <p class="cf-wide cf-or" data-roll>{rating}</p>
          <div class="cf-rate-side">
            <p class="cf-mid" data-roll>{site.rating.count}</p>
            <span class="cf-lbl">отзывов на Яндекс Картах и в 2ГИС</span>
            <a class="cf-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать все отзывы</a>
          </div>
        </div>
        <div class="cf-quotes">
          {reviews.map((r, i) => (
            <blockquote class="cf-q">
              <span class="cf-ix">0{i + 1}</span>
              <p>{r.text}</p>
              <footer>{r.name}, {r.source}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Адрес и заявка -->
    <section class="cf-scr cf-end" id="zayavka" aria-labelledby="cf-eh">
      <div class="cf-w">
        <div class="cf-row-h">
          <h2 id="cf-eh" class="cf-h2">Проспект <span class="cf-nw">60-летия</span> Октября</h2>
          <span class="cf-lbl">{site.district}</span>
        </div>
        <div class="cf-end-g">
          <div>
            <p class="cf-wide cf-or cf-house" data-roll>210</p>
            <dl class="cf-addr">
              <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
              <div><dt>{weekday.days}</dt><dd>{weekday.time}</dd></div>
              <div><dt>{weekend.days}</dt><dd>{weekend.time}</dd></div>
              <div><dt>Индекс</dt><dd>{site.address.postalCode}, {site.address.locality}</dd></div>
            </dl>
            <p class="cf-msg">
              <a href={whatsappLink('Здравствуйте! Хочу выбрать карту в Urban210')} target="_blank" rel="noopener">WhatsApp</a>
              <a href={telegramLink('site_32')} target="_blank" rel="noopener">Telegram</a>
              <a href={site.maps.yandex} target="_blank" rel="noopener">Яндекс Карты</a>
              <a href={site.maps.twoGis} target="_blank" rel="noopener">2ГИС</a>
            </p>
          </div>
          <div class="cf-form">
            <LeadForm id="cf" block="32_final" />
          </div>
        </div>
      </div>
    </section>

    <footer class="cf-foot">
      <div class="cf-w cf-foot-g">
        <a class="cf-logo" href="/concepts/32/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav aria-label="Страницы">
          <a href="/price/">Тарифы</a><a href="/zal/">Тренажёрный зал</a><a href="/group/">Групповые</a><a href="/spa/">SPA</a><a href="/trainers/">Тренеры</a><a href="/promo/">Акции</a>
        </nav>
        <nav aria-label="Документы">
          <a href="/rules/">Правила клуба</a><a href="/oferta/">Договор-оферта</a><a href="/policy/">Политика конфиденциальности</a><a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        </nav>
        <p class="cf-foot-c"><a href={site.phone.href}>{site.phone.display}</a><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <p class="cf-w cf-legal">© {new Date().getFullYear()} {site.legal.name} · ИНН {site.legal.inn} · ОГРН {site.legal.ogrn}</p>
    </footer>
  </div>
</Layout>

<script>
  // Барабан счётчика: каждая цифра становится лентой 0–9 и прокручивается до своего значения,
  // когда число попадает в экран. Цифры табличные, поэтому ширина числа не меняется.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = [...document.querySelectorAll<HTMLElement>('.cf [data-roll]')];
  if (!reduce && 'IntersectionObserver' in window) {
    const strip = Array.from({ length: 20 }, (_, i) => `<i>${i % 10}</i>`).join('');
    els.forEach((el) => {
      const text = el.textContent || '';
      if (!el.hasAttribute('aria-hidden')) el.setAttribute('aria-label', text);
      let k = 0;
      el.innerHTML = [...text].map((ch) => {
        if (!/\d/.test(ch)) return `<span class="cf-c" aria-hidden="true">${ch === ' ' ? '&nbsp;' : ch}</span>`;
        const d = `<span class="cf-d" aria-hidden="true" style="--v:${10 + Number(ch)};--k:${k}"><span class="cf-s">${strip}</span></span>`;
        k++;
        return d;
      }).join('');
      el.classList.add('cf-roll');
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-in');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -12% 0px' });
    els.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  body:has(.cf) { padding-bottom: 0; background: #0c0c0c; color: #f2efe9; color-scheme: dark; font-family: 'Manrope 32', 'Helvetica Neue', Arial, sans-serif; }
  body:has(.cf) ::selection { background: #ff5722; color: #0c0c0c; }
  body:has(.cf) :focus-visible { outline: 2px solid #f2efe9; outline-offset: 4px; border-radius: 0; }
  body:has(.cf) .form { background: #0c0c0c; color: #f2efe9; --ink: #f2efe9; --muted: #8f8a83; --card: #0c0c0c; --line: rgb(242 239 233 / 0.32); border-radius: 0; padding: 0; gap: 24px; font-family: 'Manrope 32', Arial, sans-serif; }
  body:has(.cf) .form h3 { font-family: inherit; font-weight: 700; font-size: 1.75rem; line-height: 1.1; letter-spacing: -0.03em; }
  body:has(.cf) .form .muted { color: #8f8a83; font-size: 1rem !important; margin-top: -16px; }
  body:has(.cf) .form .field { color: #f2efe9; font-size: 0.875rem; gap: 4px; }
  body:has(.cf) .form .field input { border: 0; border-bottom: 1px solid rgb(242 239 233 / 0.5); border-radius: 0; padding: 0; min-height: 52px; background: transparent; font-size: 1.375rem; font-variant-numeric: tabular-nums; }
  body:has(.cf) .form .field input::placeholder { color: #6d6964; }
  body:has(.cf) .form .field input:focus { border-bottom-color: #ff5722; box-shadow: inset 0 -1px 0 #ff5722; }
  body:has(.cf) .form .field .err, body:has(.cf) .form .consent.bad { color: #ff8a65; }
  body:has(.cf) .form .consent { color: #8f8a83; font-size: 0.875rem; }
  body:has(.cf) .form .consent input { accent-color: #f2efe9; }
  body:has(.cf) .form .btn { border-radius: 0; background: #f2efe9; color: #0c0c0c; font-family: inherit; font-weight: 700; font-size: 1.0625rem; min-height: 64px; justify-content: space-between; padding: 0 24px; }
  body:has(.cf) .form .btn:hover { background: #ff5722; }
  body:has(.cf) .form .form-note { text-align: left; margin-top: -8px; }
  body:has(.cf) .form .form-note, body:has(.cf) .form .form-note a { color: #8f8a83; font-variant-numeric: tabular-nums; }
  body:has(.cf) .form .form-msg.is-err { border-radius: 0; }
  body:has(.cf) .form .form-done { text-align: left; padding: 0; }
  body:has(.cf) .form .form-done .ok { margin: 0; border-radius: 0; background: #f2efe9; color: #0c0c0c; }
  body:has(.cf) dialog.lead::backdrop { background: rgb(12 12 12 / 0.92); backdrop-filter: none; }
  body:has(.cf) dialog.lead .form { border: 1px solid rgb(242 239 233 / 0.32); padding: 40px 32px 32px; }
  body:has(.cf) dialog.lead .x { color: #f2efe9; }
  body:has(.cf) .mbar { background: #0c0c0c; border-top: 1px solid rgb(242 239 233 / 0.2); backdrop-filter: none; }
  body:has(.cf) .mbar a.ic { border-radius: 0; border-color: rgb(242 239 233 / 0.32); }
  body:has(.cf) .mbar .btn { border-radius: 0; background: #f2efe9; color: #0c0c0c; font-family: inherit; font-weight: 700; font-size: 1rem; }
</style>

<style>
  .cf {
    --bg: #0c0c0c; --ink: #f2efe9; --mute: #8f8a83; --line: rgb(242 239 233 / 0.2); --or: #ff5722;
    --f: 'Manrope 32', 'Helvetica Neue', Arial, sans-serif;
    --ez: cubic-bezier(0.16, 1, 0.3, 1);
    --s1: 8px; --s2: 16px; --s3: 24px; --s4: 32px; --s5: 48px; --s6: 64px; --s7: 96px; --s8: 128px;
    --gut: clamp(20px, 4.44vw, 64px);
    --scr: clamp(96px, 11vw, 160px);
    /* шкала: подписи, текст, крупный текст, заголовок; цифры: средние, широкие, гигантские */
    --t-xs: 0.875rem; --t-s: 1.0625rem; --t-m: clamp(1.1875rem, 1.05rem + 0.4vw, 1.4375rem); --t-l: clamp(1.75rem, 1.2rem + 1.6vw, 3rem);
    --n-m: clamp(3rem, 1.6rem + 3.6vw, 5rem); --n-l: clamp(3.25rem, 0.25rem + 14.4vw, 13.25rem); --n-xl: clamp(10rem, 2.5rem + 24vw, 26rem);
    background: var(--bg); color: var(--ink); font-family: var(--f); font-size: var(--t-s); line-height: 1.5;
    font-variant-numeric: tabular-nums; overflow-x: clip;
  }
  .cf :global(h1), .cf :global(h2), .cf :global(h3) { font-family: var(--f); hyphens: manual; -webkit-hyphens: manual; overflow-wrap: normal; }
  .cf-w { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: var(--gut); }
  .cf a { text-decoration: none; }
  .cf-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cf-or { color: var(--or); }
  .cf-nw { white-space: nowrap; }
  .cf-br { display: none; }
  .cf-hours > span { display: inline-block; vertical-align: top; height: calc(var(--lh) * 1em); }
  .cf-lbl { font-size: var(--t-xs); font-weight: 500; color: var(--mute); line-height: 1.4; letter-spacing: 0.01em; }
  .cf-p { font-size: var(--t-m); line-height: 1.45; max-width: 28em; }

  /* Кнопки: прямоугольник без декора */
  .cf-btn { display: inline-flex; align-items: center; min-height: 64px; padding: 0 var(--s4); background: var(--ink); color: var(--bg); font-weight: 700; font-size: 1.0625rem; line-height: 1; white-space: nowrap; transition: background-color 0.25s ease, color 0.25s ease; }
  .cf-btn:hover { background: var(--or); color: var(--bg); }
  .cf-btn-s { min-height: 44px; padding: 0 var(--s3); font-size: 0.9375rem; }
  .cf-btn-w { width: 100%; justify-content: center; }
  .cf-btn-o { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px rgb(242 239 233 / 0.5); }
  .cf-btn-o:hover { background: var(--ink); color: var(--bg); }
  .cf-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; box-shadow: inset 0 -1px 0 var(--ink); line-height: 1.2; transition: color 0.2s ease, box-shadow 0.2s ease; }
  .cf-link:hover { color: var(--or); box-shadow: inset 0 -1px 0 var(--or); }

