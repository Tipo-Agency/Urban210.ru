---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

// Превью первых экранов: src/assets/concepts/NN.jpg (снимки 1440×900 из docs/concepts)
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/concepts/*.jpg', { eager: true });
const shot = (n: string) => shots[`../../assets/concepts/${n}.jpg`].default;

const list = [
  ['01', 'Монохром', 'Чёрно-белый премиум как у Equinox: тонкий шрифт, много воздуха, фото на всю ширину раскрывается шторкой.'],
  ['02', 'Красный свет', 'Клубная ночь как у Barry\'s: зал в красном свете, узкий капс, пульсирующий свет и бегущие ленты.'],
  ['03', 'Ночь', 'Тёмная роскошь как у Third Space: неоновые шевроны под потолком, тонкая антиква, холодный свет.'],
  ['04', 'Спринт', 'Спорт как у F45: огромный узкий шрифт, синий и оранжевый, живой таймер до закрытия клуба.'],
  ['05', 'Дружелюбный', 'Как DDX, только аккуратнее: яркие скруглённые карточки, стикеры, фото гостей веером.'],
  ['06', 'Кампания', 'Реклама в духе Nike: огромные слова, тренер в вырезке, плакаты зон наезжают друг на друга.'],
  ['07', 'Сетка', 'Швейцарский журнал: видимая сетка колонок, моноширинные подписи, цифры как счётчик.'],
  ['08', 'Бенто', 'Плитки как у Apple: видео, «открыто сейчас» с часами Хабаровска, рейтинг, карта, переключатели.'],
  ['09', 'Забота', 'Мягкий велнес для девушек: песочные тона, фото в арках, акцент на растяжке, SPA и утре.'],
  ['10', 'Район', 'Уличный журнал про свой район: коллаж, скотч, стикеры, «Наш район. Наш зал.»'],
  ['11', 'Хром', 'Стиль нулевых: металлический 3D-шеврон поворачивается за курсором, хромированные цифры и рамки.'],
  ['12', 'Слова', 'Только огромные слова: фото зала видно сквозь буквы и двигается внутри них при прокрутке.'],
  ['13', 'Плёнка', 'Киноплёнка: на компьютере страница едет вбок кадрами с перфорацией, «Первый дубль за 1 ₽».'],
  ['14', 'Эфир', 'Спортивная трансляция: табло с часами, плашки «прямой эфир», мультикамера по зонам.'],
  ['15', 'Агитка', 'Конструктивизм в духе Родченко: диагонали, красный круг, фотомонтаж, «А ты записался в зал?»'],
  ['16', 'Игрок', 'Интерфейс игры: «Нажми старт», тарифы как классы персонажей, тренеры как напарники.'],
  ['17', 'Обложка', 'Модный журнал как Vogue: обложка с портретом, крупная антиква, развороты с номерами страниц.'],
  ['18', 'Блоки', 'Необрутализм: толстые чёрные рамки, яркие плоские цвета, жёсткие тени, кнопки нажимаются.'],
  ['19', 'Цифры', 'Клуб в инфографике: график часов работы на неделю, цена дня по тарифам, всё из реальных данных.'],
  ['20', 'Первый день', 'История первого дня сценами при прокрутке: 6:30 парковка, ресепшен, зал, кардио, сауна.'],
];
---
<Layout title="Двадцать концепций" description="Двадцать концепций главной страницы Urban210." noindex>
  <section class="page-hero">
    <div class="wrap">
      <h1>Двадцать концепций</h1>
      <p class="lead">Живые главные страницы на фото, видео и ценах Urban210. Откройте каждую на телефоне и компьютере и назовите номер, который ближе. Можно смешать: шрифт из одной, цвет из другой.</p>
      <ul class="cl">
        {list.map(([n, t, d]) => (
          <li>
            <a href={`/concepts/${n}/`}>
              <div class="cl-ph"><Image src={shot(n)} alt={`Первый экран концепции ${n}`} widths={[480, 720]} sizes="(min-width: 900px) 45vw, 100vw" format="webp" quality={60} loading={Number(n) < 3 ? 'eager' : 'lazy'} /></div>
              <h2><span>{n}</span> {t}</h2>
              <p>{d}</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted" style="margin-top:48px">Ранние варианты: <a href="/concepts/a/">A</a>, <a href="/concepts/b/">B</a>, <a href="/concepts/c/">C</a>. Текущий сайт: <a href="/">главная</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .cl { list-style: none; margin-top: 48px; display: grid; gap: 40px 24px; }
  @media (min-width: 900px) { .cl { grid-template-columns: repeat(2, 1fr); } }
  .cl a { text-decoration: none; display: grid; gap: 12px; }
  .cl-ph { aspect-ratio: 16 / 10; overflow: hidden; background: var(--card); border-radius: 6px; }
  .cl-ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.8s var(--ease); }
  .cl a:hover .cl-ph :global(img) { transform: scale(1.03); }
  .cl h2 { font-size: 1.6rem; margin-top: 6px; }
  .cl h2 span { color: var(--accent); }
  .cl p { color: var(--muted); max-width: 56ch; }
</style>
