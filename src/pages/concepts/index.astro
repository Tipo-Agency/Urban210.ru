---
import Layout from '../../layouts/Layout.astro';
const list = [
  ['a', 'Табло', 'Светлый спортивный плакат: бумага, чёрный Dela Gothic, табло с часами и статусом «открыто сейчас», зоны строками с фото у курсора, ценники.'],
  ['b', 'Кино', 'Тёмная и полноэкранная: ч/б видео, зал главами на весь экран, фото раскрывается из щели при прокрутке, Manrope, оранжевый только в кнопках.'],
  ['c', 'Импульс', 'Оранжевый бренд во весь экран: тренер в вырезке, шевроны как графика, Russo One, фото в рамке-шевроне, полоса шевронов едет при прокрутке.'],
];
---
<Layout title="Концепции дизайна" description="Три направления дизайна сайта Urban210." noindex>
  <section class="page-hero"><div class="wrap">
    <h1>Три концепции</h1>
    <p class="lead">Живые страницы с настоящими фото, видео и данными клуба. Выберите направление, дальше доведём его на всём сайте.</p>
    <ul class="grid-3" style="list-style:none;margin-top:48px">
      {list.map(([k, t, d]) => <li class="tile"><span class="k">Концепция {k.toUpperCase()}</span><h2 style="font-size:2rem">{t}</h2><p>{d}</p><a class="btn" href={`/concepts/${k}/`}>Открыть</a></li>)}
    </ul>
  </div></section>
</Layout>
