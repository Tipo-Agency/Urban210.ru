<style>
  .ap {
    --ink: #0e0c0b; --ink-2: #1a1716; --wh: #f4f1ec; --muted: #b3aba2; --line: rgb(244 241 236 / 0.18);
    --red: #e8261b; --or: #ff5722;
    --fd: 'Dela w', system-ui, 'Helvetica Neue', sans-serif;
    --fb: 'Golos Text Variable', system-ui, sans-serif;
    --ez: cubic-bezier(0.2, 0.8, 0.2, 1);
    --gut: clamp(16px, 4vw, 56px);
    background: var(--ink); color: var(--wh); font-family: var(--fb); overflow-x: clip;
  }
  .ap :global(h2), .ap :global(h3) { hyphens: manual; -webkit-hyphens: manual; text-wrap: balance; }
  .ap-w { position: relative; width: 100%; max-width: 1440px; margin: 0 auto; padding-inline: var(--gut); }

  /* Кнопки */
  .ap-btn {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; padding: 0 22px 0 24px;
    background: var(--red); color: #fff; text-decoration: none; font-weight: 800; font-size: 1.1rem; letter-spacing: -0.01em; line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .ap-btn :global(svg) { width: 20px; height: 18px; transition: transform 0.3s var(--ez); }
  .ap-btn:hover { background: var(--wh); color: var(--ink); }
  .ap-btn:hover :global(svg) { transform: translateX(5px); }
  .ap-btn:active { transform: scale(0.97); }
  .ap-btn-s { white-space: nowrap; min-height: 44px; font-size: 0.96rem; padding: 0 14px 0 16px; gap: 10px; }
  .ap-btn-s :global(svg) { width: 15px; height: 14px; }
  .ap-btn-w { width: 100%; }
  .ap-btn-k { background: var(--ink); color: var(--wh); }
  .ap-link { font-weight: 700; font-size: 1rem; text-decoration: none; border-bottom: 2px solid var(--or); padding-bottom: 3px; transition: color 0.2s ease; }
  .ap-link:hover { color: var(--or); }

  /* Элементы интерфейса */
  .h { position: absolute; z-index: 3; width: 9px; height: 9px; background: var(--wh); border: 1.5px solid var(--or); pointer-events: none; }
  .h1 { left: -5px; top: -5px; } .h2 { left: calc(50% - 5px); top: -5px; } .h3 { right: -5px; top: -5px; }
  .h4 { left: -5px; top: calc(50% - 5px); } .h5 { right: -5px; top: calc(50% - 5px); }
  .h6 { left: -5px; bottom: -5px; } .h7 { left: calc(50% - 5px); bottom: -5px; } .h8 { right: -5px; bottom: -5px; }
  .ap-sel-lab { position: absolute; z-index: 3; left: -1px; top: -30px; background: var(--or); color: var(--ink); font-size: 0.78rem; font-weight: 700; padding: 4px 8px; white-space: nowrap; }
  .ap-cursor { position: absolute; z-index: 6; display: inline-flex; align-items: flex-start; gap: 0; pointer-events: none; }
  .ap-cursor svg { width: 18px; height: 22px; flex: none; fill: var(--c); }
  .ap-cursor b { margin: 16px 0 0 -2px; background: var(--c); color: var(--t, #fff); font-size: 0.8rem; font-weight: 700; padding: 4px 9px 5px; border-radius: 0 10px 10px 10px; white-space: nowrap; }
  .ap-cursor-red { --c: var(--red); }
  .ap-cursor-or { --c: var(--or); --t: var(--ink); }
  .ap-cursor-wh { --c: var(--wh); --t: var(--ink); }
  .ap-crop { position: absolute; z-index: 4; width: 22px; height: 22px; pointer-events: none; border-color: var(--wh); border-style: solid; border-width: 0; }
  .ap-crop-tl { left: 10px; top: 10px; border-left-width: 1px; border-top-width: 1px; }
  .ap-crop-tr { right: 10px; top: 10px; border-right-width: 1px; border-top-width: 1px; }
  .ap-crop-bl { left: 10px; bottom: 10px; border-left-width: 1px; border-bottom-width: 1px; }
  .ap-crop-br { right: 10px; bottom: 10px; border-right-width: 1px; border-bottom-width: 1px; }

  /* Сдвиг каналов: красная копия фото поверх ч/б, чуть смещена, со «сбоем» в одной полосе */
  .ap-rgb { position: relative; overflow: hidden; background: var(--ink); width: 100%; height: 100%; }
  .ap-rgb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2); }
  .ap-rgb-r { position: absolute; inset: 0; background: var(--red); mix-blend-mode: screen; opacity: 0.75; transform: translateX(7px); clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
  .ap-rgb-r :global(img) { mix-blend-mode: multiply; filter: grayscale(1) contrast(1.5) brightness(0.8); }
  .ap-rgb::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgb(14 12 11 / 0.35) 0 1px, transparent 1px 4px); pointer-events: none; }

  /* Шапка */
  .ap-top { position: sticky; top: 0; z-index: 30; background: rgb(14 12 11 / 0.92); border-bottom: 1px solid var(--line); }
  .ap-top-in { display: flex; align-items: center; gap: 28px; min-height: 62px; }
  .ap-logo { font-family: var(--fd); font-size: 1.3rem; letter-spacing: -0.02em; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; line-height: 1; }
  .ap-logo :global(svg) { width: 16px; height: 15px; color: var(--red); }
  .ap-nav { display: none; gap: 26px; margin-left: auto; }
  .ap-nav a { font-weight: 600; font-size: 0.98rem; text-decoration: none; }
  .ap-nav a:hover { color: var(--or); }
  .ap-tel { display: none; font-weight: 600; text-decoration: none; font-size: 0.96rem; white-space: nowrap; }
  .ap-top .ap-btn { margin-left: auto; }
  @media (min-width: 1100px) { .ap-nav, .ap-tel { display: flex; } .ap-top .ap-btn { margin-left: 0; } }

  /* Первый экран */
  .ap-first { position: relative; overflow: clip; isolation: isolate; }
  .ap-bg { position: absolute; inset: 0; z-index: -1; background: var(--ink); }
  .ap-bg :global(img), .ap-bg video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15); opacity: 0.34; }
  .ap-bg video { opacity: 0; transition: opacity 1.2s ease; }
  .ap-bg video:global(.is-on) { opacity: 0.34; }
  .ap-bg::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgb(14 12 11 / 0.2), rgb(14 12 11 / 0.1) 50%, var(--ink)), repeating-linear-gradient(0deg, rgb(14 12 11 / 0.5) 0 1px, transparent 1px 3px); }
  .ap-scan { position: absolute; z-index: 2; left: 0; right: 0; top: 0; height: 22%; background: linear-gradient(180deg, transparent, rgb(255 87 34 / 0.05) 80%, rgb(255 87 34 / 0.1)); transform: translateY(-100%); }
  .ap-first .ap-crop { z-index: 2; }
  .ap-first-in { position: relative; z-index: 3; padding-top: 30px; padding-bottom: 40px; }
  .ap-kick { display: inline-flex; align-items: center; gap: 10px; font-size: 0.82rem; font-weight: 600; border: 1px solid var(--line); padding: 7px 12px; background: rgb(14 12 11 / 0.6); }
  .ap-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 4px rgb(232 38 27 / 0.25); }

  .ap-h1 { margin: 40px 0 0; font-family: var(--fd); font-weight: 400; text-transform: uppercase; line-height: 0.92; letter-spacing: -0.02em; transform: rotate(-7deg); transform-origin: 0 100%; }
  .ap-h1 .l1 { display: block; white-space: nowrap; font-size: clamp(2.2rem, 10.2vw, 9.4rem); }
  .ap-h1 .l2 { display: block; white-space: nowrap; margin-top: 0.1em; font-size: clamp(2.7rem, 14.6vw, 9.4rem); }
  .ap-h1 .l2 span { display: inline-block; background: var(--red); color: var(--wh); padding: 0.04em 0.18em 0.08em; margin-left: 0.3em; box-shadow: -0.12em 0.1em 0 var(--or); }

  .ap-mont { position: relative; height: 92vw; margin-top: 40px; }
  .ap-beam { position: absolute; left: -30%; right: -30%; top: 34%; height: 20%; background: var(--wh); transform: rotate(-24deg); opacity: 0.92; clip-path: polygon(0 30%, 100% 0, 100% 100%, 0 70%); }
  .ap-sel { position: absolute; outline: 1.5px solid var(--or); }
  .ap-sel-hero { left: 6%; top: 12%; width: 84%; aspect-ratio: 4 / 3; transform: rotate(4deg); }
  .ap-cur-a { right: 2%; bottom: 8%; }
  .ap-chip { position: absolute; z-index: 5; display: inline-flex; align-items: center; gap: 10px; background: var(--wh); color: var(--ink); font-size: 0.8rem; font-weight: 600; padding: 6px 12px 6px 6px; line-height: 1.2; max-width: 240px; }
  .ap-chip b { font-family: var(--fd); font-weight: 400; font-size: 1.5rem; background: var(--red); color: #fff; padding: 4px 8px; line-height: 1; }
  .ap-chip-r { left: 0; bottom: 0; }

  .ap-offer { position: relative; z-index: 5; display: grid; gap: 22px; margin-top: 32px; }
  .ap-lead { font-size: 1.08rem; line-height: 1.5; max-width: 40ch; color: #e5dfd7; }
  .ap-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 22px 30px; }
  .ap-cta-sel { position: relative; display: inline-flex; outline: 1.5px dashed rgb(255 87 34 / 0.8); outline-offset: 6px; }
  .ap-cur-you { right: -26px; bottom: -40px; }

  .ap-status { position: relative; z-index: 3; border-top: 1px solid var(--line); background: rgb(14 12 11 / 0.7); }
  .ap-status-in { display: flex; gap: 10px 28px; overflow-x: auto; scrollbar-width: none; padding-block: 14px; font-size: 0.9rem; font-weight: 600; white-space: nowrap; }
  .ap-status-in i { font-style: normal; color: var(--muted); font-weight: 500; margin-right: 8px; }
  .ap-status-in span:first-child::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--or); margin-right: 10px; vertical-align: 2px; }

  @media (min-width: 1000px) {
    .ap-first-in { min-height: min(calc(100svh - 64px - 50px), 860px); display: grid; grid-template-columns: 1.1fr 0.9fr; grid-template-rows: auto 1fr auto; padding-top: 34px; padding-bottom: 56px; }
    .ap-kick { grid-column: 1 / -1; justify-self: start; }
    .ap-h1 { grid-column: 1 / -1; grid-row: 2; margin-top: clamp(80px, 14vh, 150px); align-self: start; position: relative; z-index: 5; }
    .ap-h1 .l1 { font-size: clamp(5.6rem, 9.4vw, 9rem); }
    .ap-h1 .l2 { font-size: clamp(5.6rem, 9.4vw, 9rem); }
    .ap-mont { position: absolute; right: var(--gut); top: 4%; bottom: 6%; width: 46%; height: auto; margin: 0; }
    .ap-beam { left: -6%; right: -30%; top: 58%; height: 22%; }
    .ap-sel-hero { left: 6%; top: 6%; width: 90%; aspect-ratio: auto; height: 62%; transform: rotate(5deg); }
    .ap-cur-a { right: auto; left: -4%; top: 60%; bottom: auto; }
    .ap-chip-r { left: auto; right: 4%; bottom: 10%; }
    .ap-offer { grid-column: 1; grid-row: 3; align-self: end; }
    .ap-lead { font-size: 1.14rem; }
  }

  /* Заголовки секций */
  .ap-sec { position: relative; padding-block: clamp(72px, 9vw, 130px); }
  .ap-h2 { font-family: var(--fd); font-weight: 400; text-transform: uppercase; font-size: clamp(2.4rem, 10.4vw, 6.4rem); line-height: 0.95; letter-spacing: -0.02em; margin: 0; }
  .ap-h2 em { font-style: normal; display: inline-block; background: var(--red); color: var(--wh); padding: 0.02em 0.16em 0.07em; margin-top: 0.06em; }
  .ap-tilt { transform: rotate(-4deg); transform-origin: 0 100%; }
  .ap-shead { display: grid; gap: 22px; margin-bottom: clamp(44px, 6vw, 80px); }
  .ap-note { font-size: 1.02rem; line-height: 1.5; color: var(--muted); max-width: 38ch; }
  @media (min-width: 1000px) {
    .ap-shead { grid-template-columns: 1fr auto; align-items: end; }
    .ap-note { padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  }

  /* Программа */
  .ap-prog { border-bottom: 1px solid var(--line); }
  .ap-prog-in { display: grid; gap: 48px; }
  .ap-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ap-points li { position: relative; display: grid; grid-template-columns: 64px 1fr; gap: 18px; padding: 20px 18px 22px; border: 1px solid var(--line); transition: border-color 0.2s ease, background-color 0.2s ease; }
  .ap-points li .h { opacity: 0; transition: opacity 0.2s ease; }
  .ap-points li:hover { border-color: var(--or); background: rgb(255 87 34 / 0.05); }
  .ap-points li:hover .h { opacity: 1; }
  .ap-pn { font-family: var(--fd); font-size: 2.6rem; line-height: 0.9; color: transparent; -webkit-text-stroke: 1.2px var(--red); }
  .ap-points h3 { font-weight: 800; font-size: 1.35rem; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 8px; }
  .ap-points p { font-size: 1rem; line-height: 1.5; color: var(--muted); max-width: 46ch; }
  @media (min-width: 1000px) {
    .ap-prog-in { gap: 72px; }
    .ap-points { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .ap-points li { grid-template-columns: 1fr; gap: 22px; align-content: start; }
    .ap-points li { padding: 26px 24px 28px; }
    .ap-points li:nth-child(even) { transform: translateY(40px); }
    .ap-points li:nth-child(even)[data-p] { --y0: 40px; }
  }

  /* Зоны-слои */
  .ap-layers { display: grid; gap: 28px; }
  .ap-lnav { display: none; }
  .ap-stage { display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; min-width: 0; }
  .ap-zone { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; min-width: 0; }
  .ap-zmedia { position: relative; aspect-ratio: 4 / 3; outline: 1.5px solid var(--or); }
  .ap-zlab { position: absolute; left: -1px; top: -28px; background: var(--or); color: var(--ink); font-size: 0.76rem; font-weight: 700; padding: 4px 8px; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ap-ztx { display: grid; gap: 12px; justify-items: start; }
  .ap-ztx h3 { font-family: var(--fd); font-weight: 400; text-transform: uppercase; font-size: clamp(1.5rem, 6.2vw, 3rem); line-height: 1.04; letter-spacing: -0.02em; margin: 0; }
  .ap-ztx p { font-size: 1.02rem; line-height: 1.55; color: var(--muted); max-width: 46ch; }
  .ap-heat { position: relative; width: 100%; height: 100%; overflow: hidden; display: flex; align-items: center; justify-content: center; font-family: var(--fd); line-height: 0.8; font-size: 21vw; background: radial-gradient(120% 90% at 20% 110%, var(--red), transparent 60%), radial-gradient(90% 70% at 90% -10%, rgb(255 87 34 / 0.6), transparent 60%), var(--ink-2); }
  .ap-heat::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgb(14 12 11 / 0.35) 0 1px, transparent 1px 4px); }
  .ap-heat span:first-child { color: var(--wh); }
  .ap-heat span:nth-child(2) { color: transparent; -webkit-text-stroke: 2px var(--wh); margin-left: 0.06em; }
  .ap-heat b { font-family: var(--fb); font-weight: 800; font-size: 0.18em; align-self: flex-start; margin: 0.6em 0 0 0.2em; }
  @media (min-width: 1000px) {
    .ap-layers.is-js { grid-template-columns: 4fr 8fr; gap: 56px; align-items: start; }
    .ap-layers.is-js .ap-lnav { display: grid; gap: 4px; border: 1px solid var(--line); padding: 8px; position: sticky; top: 100px; }
    .ap-lnav button { all: unset; box-sizing: border-box; display: grid; grid-template-columns: 34px 1fr 14px; align-items: center; gap: 10px; padding: 16px 14px; cursor: pointer; font-weight: 700; font-size: 1.15rem; color: var(--muted); transition: background-color 0.2s ease, color 0.2s ease; }
    .ap-lnav button :global(svg) { width: 9px; height: 14px; opacity: 0; transition: opacity 0.2s ease, transform 0.2s var(--ez); }
    .ap-lnav button:hover { color: var(--wh); background: rgb(244 241 236 / 0.05); }
    .ap-lnav button[aria-selected='true'] { background: var(--red); color: #fff; }
    .ap-lnav button[aria-selected='true'] :global(svg) { opacity: 1; }
    .ap-lnav button:focus-visible { outline: 2px solid var(--or); outline-offset: 2px; }
    .ap-lnum { font-size: 0.8rem; font-weight: 600; opacity: 0.7; }
    .ap-layers.is-js .ap-stage { display: block; }
    .ap-layers.is-js .ap-zone { display: none; }
    .ap-layers.is-js .ap-zone.is-on { display: grid; }
    .ap-layers.is-js .ap-zone.is-anim { animation: ap-layer 0.45s var(--ez); }
    .ap-zone { gap: 26px; }
    .ap-zmedia { aspect-ratio: 16 / 10; }
    .ap-ztx { grid-template-columns: 1fr auto; align-items: end; column-gap: 40px; }
    .ap-ztx h3, .ap-ztx p { grid-column: 1; }
    .ap-ztx .ap-link { grid-column: 2; grid-row: 1 / span 2; }
    .ap-heat { font-size: 15rem; }
  }
  @keyframes ap-layer { from { opacity: 0; transform: translateY(14px); } }

  /* Тарифы */
  .ap-price { padding-bottom: 0; }
  .ap-plans { display: grid; gap: 26px; }
  .apl { position: relative; display: flex; flex-direction: column; gap: 14px; padding: 0 22px 24px; border: 1px solid var(--line); background: var(--ink-2); }
  .apl-head { margin: 0 -22px; padding: 22px 22px 20px; background: var(--wh); color: var(--ink); clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%); padding-bottom: 34px; }
  .apl-head h3 { font-family: var(--fd); font-weight: 400; text-transform: uppercase; font-size: 1.7rem; line-height: 1; letter-spacing: -0.01em; margin: 0 0 6px; }
  .apl-head p { font-size: 0.92rem; font-weight: 600; }
  .apl-price { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .apl-price b { font-family: var(--fd); font-weight: 400; font-size: clamp(3.6rem, 16vw, 5.2rem); line-height: 0.85; letter-spacing: -0.03em; font-variant-numeric: lining-nums; }
  .apl-price span { font-size: 0.92rem; font-weight: 600; color: var(--muted); padding-bottom: 6px; }
  .apl-year { font-size: 0.9rem; color: var(--muted); padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .apl ul { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 9px; font-size: 0.98rem; line-height: 1.35; }
  .apl li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; }
  .apl li :global(svg) { width: 20px; height: 20px; color: var(--or); }
  .apl li.no { opacity: 0.5; }
  .apl li.no :global(svg) { color: var(--muted); }
  .apl .ap-btn { margin-top: auto; }
  .apl-day .ap-btn, .apl-all .ap-btn { background: transparent; box-shadow: inset 0 0 0 1.5px var(--wh); color: var(--wh); }
  .apl-day .ap-btn:hover, .apl-all .ap-btn:hover { background: var(--wh); color: var(--ink); }
