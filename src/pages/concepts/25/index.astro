---
// Концепция 25 «Агитпроп 2.0»: конструктивистский плакат, пересобранный как экран 2026 года.
// Диагональные лозунги, красная плашка, фотомонтаж из фото зала, а поверх элементы интерфейса:
// рамки выделения с маркерами, курсоры с подписями, метки обреза, строки развёртки и аккуратный сдвиг каналов.
// Чёрный, белый, красный и оранжевый. Dela Gothic One для лозунгов, Golos Text для текста и подписей.
// Движение: строки развёртки и курсоры (только transform), зоны переключаются как слои, блоки собираются при прокрутке.
import dgCyr from '@fontsource/dela-gothic-one/files/dela-gothic-one-cyrillic-400-normal.woff2?url';
import dgLat from '@fontsource/dela-gothic-one/files/dela-gothic-one-latin-400-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, programs } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (url: string, range: string) => `@font-face{font-family:'Dela w';font-style:normal;font-display:swap;font-weight:400;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = ff(dgCyr, UR) + ff(dgLat, UL);

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const sidePromos = promos.filter((p) => p.slug !== '1-rubl');
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const layers = [
  { id: 'zal', title: z.zal.title, text: cap(z.zal.text), photo: '/images/free-weights.jpg', alt: 'Свободные веса в зале Urban210', tag: site.facts.area, href: z.zal.href },
  { id: 'cardio', title: z.cardio.title, text: z.cardio.text, photo: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне', tag: 'Technogym Skillrun', href: z.cardio.href },
  { id: 'group', title: z.group.title, text: cap(z.group.text), photo: '/images/group.jpg', alt: 'Групповая тренировка в зале 150 м²', tag: programs.flatMap((p) => p.items).slice(0, 5).join(' · '), href: z.group.href },
  { id: 'spa', title: z.spa.title, text: z.spa.text, photo: null, alt: '', tag: `В тарифе «${plans[2].name}»`, href: z.spa.href },
];
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
const cursorTone = ['red', 'or', 'wh'];
---
<Layout title="Концепция 25 «Агитпроп 2.0»" description="Концепция дизайна сайта Urban210: конструктивистский плакат, пересобранный как интерфейс, фотомонтаж, диагональные лозунги и курсоры." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={dgCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>
  <div class="ap">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="ap-cur" viewBox="0 0 16 20"><path d="M1 1v16.5l4.6-4.4 3 6.4 3-1.4-3-6.3H15z" stroke="#0e0c0b" stroke-width="1.4" stroke-linejoin="round" /></symbol>
    </svg>

    <header class="ap-top">
      <div class="ap-w ap-top-in">
        <a class="ap-logo" href="/concepts/25/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="ap-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#komanda">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="ap-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="ap-btn ap-btn-s" href="#zayavka" data-lead={trial.title} data-block="25_header">День за 1 ₽<Icon name="chev" /></a>
      </div>
    </header>

    <!-- Первый экран -->
    <section class="ap-first" aria-labelledby="ap-h1">
      <div class="ap-bg" aria-hidden="true">
        <Image src={img('/images/zal.jpg')} alt="" widths={[480, 640, 960, 1440]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={45} />
        <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none"></video>
        <span class="ap-scan"></span>
      </div>
      <span class="ap-crop ap-crop-tl" aria-hidden="true"></span><span class="ap-crop ap-crop-tr" aria-hidden="true"></span>
      <span class="ap-crop ap-crop-bl" aria-hidden="true"></span><span class="ap-crop ap-crop-br" aria-hidden="true"></span>

      <div class="ap-w ap-first-in">
        <p class="ap-kick"><span class="ap-dot"></span>Фитнес-клуб · {site.city} · {site.address.short}</p>

        <h1 id="ap-h1" class="ap-h1">
          <span class="l1">Подпишись</span>
          <span class="l2"><span>на себя</span></span>
        </h1>

        <div class="ap-mont" aria-hidden="true">
          <span class="ap-beam"></span>
          <div class="ap-sel ap-sel-hero">
            <div class="ap-rgb">
              <Image src={img('/images/group-strength.jpg')} alt="" widths={[420, 640, 860]} sizes="(min-width: 1000px) 40vw, 86vw" loading="eager" format="webp" quality={45} />
              <span class="ap-rgb-r"><Image src={img('/images/group-strength.jpg')} alt="" widths={[420, 640, 860]} sizes="(min-width: 1000px) 40vw, 86vw" loading="eager" format="webp" quality={45} /></span>
            </div>
            <i class="h h1"></i><i class="h h2"></i><i class="h h3"></i><i class="h h4"></i><i class="h h5"></i><i class="h h6"></i><i class="h h7"></i><i class="h h8"></i>
            <span class="ap-sel-lab">Зал · {site.facts.area}</span>
          </div>
          <span class="ap-cursor ap-cursor-or ap-cur-a"><svg><use href="#ap-cur" /></svg><b>{trainers[0].name.split(' ')[0]}, тренер</b></span>
          <span class="ap-chip ap-chip-r"><b>{rating}</b>Яндекс Карты, {site.rating.text}</span>
        </div>

        <div class="ap-offer">
          <p class="ap-lead">Первый день в Urban210 за&nbsp;1&nbsp;₽. Дальше подписка от {num(plans[0].month)}&nbsp;₽ в месяц. Вступительного взноса нет.</p>
          <div class="ap-cta">
            <span class="ap-cta-sel">
              <a class="ap-btn" href="#zayavka" data-lead={trial.title} data-block="25_hero">Первый день за 1 ₽<Icon name="chev" /></a>
              <span class="ap-cursor ap-cursor-wh ap-cur-you" aria-hidden="true"><svg><use href="#ap-cur" /></svg><b>Вы</b></span>
            </span>
            <a class="ap-link" href="#tarify">Тарифы</a>
          </div>
        </div>
      </div>

      <div class="ap-status" aria-label="Коротко о клубе">
        <div class="ap-w ap-status-in">
          <span><i>Пн–Пт</i>06:30–23:30</span>
          <span><i>Сб–Вс</i>07:30–22:30</span>
          <span><i>Парковка</i>50 мест бесплатно</span>
          <span><i>Взнос</i>0 ₽</span>
          <span><i>Тренажёры</i>{site.facts.machines}</span>
        </div>
      </div>
    </section>

    <!-- Программа: причины -->
    <section class="ap-sec ap-prog" aria-labelledby="ap-prog-h" data-m>
      <div class="ap-w ap-prog-in">
        <h2 id="ap-prog-h" class="ap-h2 ap-tilt" data-p style="--x:-40px">Программа <em>клуба</em></h2>
        <ol class="ap-points">
          {reasons.map((r, i) => (
            <li data-p style={`--y:24px;--d:${i * 80}ms`}>
              <span class="ap-pn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{r.title}</h3>
                <p>{cap(r.text)}</p>
              </div>
              <i class="h h1"></i><i class="h h3"></i><i class="h h6"></i><i class="h h8"></i>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Зоны как слои -->
    <section class="ap-sec ap-zones" id="zony" aria-labelledby="ap-zones-h">
      <div class="ap-w">
        <div class="ap-shead" data-m>
          <h2 id="ap-zones-h" class="ap-h2 ap-tilt" data-p style="--x:-40px">Четыре <em>зоны</em></h2>
          <p class="ap-note" data-p style="--d:120ms">Один абонемент, четыре слоя клуба. Выберите слой, чтобы посмотреть.</p>
        </div>
        <div class="ap-layers" data-layers>
          <div class="ap-lnav" role="tablist" aria-label="Зоны клуба">
            {layers.map((l, i) => (
              <button type="button" role="tab" id={`ap-tab-${l.id}`} aria-controls={`ap-z-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={l.id}>
                <span class="ap-lnum">{String(i + 1).padStart(2, '0')}</span>{l.title}<Icon name="chev1" />
              </button>
            ))}
          </div>
          <div class="ap-stage">
            {layers.map((l, i) => (
              <article class={`ap-zone ap-zone-${l.id}${i === 0 ? ' is-on' : ''}`} id={`ap-z-${l.id}`} role="tabpanel" aria-labelledby={`ap-tab-${l.id}`} data-panel={l.id}>
                <div class="ap-zmedia">
                  {l.photo ? (
                    <div class="ap-rgb">
                      <Image src={img(l.photo)} alt={l.alt} widths={[480, 720, 1000]} sizes="(min-width: 1000px) 62vw, 92vw" loading="lazy" format="avif" quality={45} />
                      <span class="ap-rgb-r" aria-hidden="true"><Image src={img(l.photo)} alt="" widths={[480, 720, 1000]} sizes="(min-width: 1000px) 62vw, 92vw" loading="lazy" format="avif" quality={45} /></span>
                    </div>
                  ) : (
                    <div class="ap-heat" aria-hidden="true"><span>40</span><span>50</span><b>°C</b></div>
                  )}
                  <span class="ap-zlab" aria-hidden="true">{l.tag}</span>
                </div>
                <div class="ap-ztx">
                  <h3>{l.title}</h3>
                  <p>{l.text}</p>
                  <a class="ap-link" href={l.href}>Подробнее</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="ap-sec ap-price" id="tarify" aria-labelledby="ap-price-h">
      <div class="ap-w">
        <div class="ap-shead" data-m>
          <h2 id="ap-price-h" class="ap-h2 ap-tilt" data-p style="--x:-40px">Выбери <em>подписку</em></h2>
          <p class="ap-note" data-p style="--d:120ms">Вступительного взноса нет. Заморозка 30 дней в году бесплатно.</p>
        </div>
        <div class="ap-plans" data-m>
          {plans.map((p, i) => (
            <article class={`apl apl-${p.id}`} data-p style={`--y:40px;--d:${i * 90}ms`}>
              {p.id === 'full' && <>
                <i class="h h1"></i><i class="h h2"></i><i class="h h3"></i><i class="h h4"></i><i class="h h5"></i><i class="h h6"></i><i class="h h7"></i><i class="h h8"></i>
                <span class="ap-cursor ap-cursor-red ap-cur-plan" aria-hidden="true"><svg><use href="#ap-cur" /></svg><b>{p.tag}</b></span>
              </>}
              <header class="apl-head">
                <h3>{p.name}</h3>
                <p>{cap(p.hours)}</p>
              </header>
              <p class="apl-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="apl-year">За год {rub(p.year)}, это {perDay(p.year, 365)}&nbsp;₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="ap-btn ap-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`25_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>
      </div>

      <div class="ap-try" data-m>
        <div class="ap-w ap-try-in">
          <p class="ap-one" aria-hidden="true" data-p style="--x:-60px"><span>1</span><span>₽</span></p>
          <div class="ap-try-tx" data-p style="--y:30px;--d:150ms">
            <h3>Пробный день</h3>
            <p>{trial.text}</p>
            <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
            <a class="ap-btn ap-btn-k" href="#zayavka" data-lead={trial.title} data-block="25_trial">{trialPromo.cta}<Icon name="chev" /></a>
          </div>
        </div>
      </div>

      <div class="ap-w ap-side">
        {sidePromos.map((pr) => (
          <article class="ap-sp" data-rise>
            <h3>{pr.title}</h3>
            <p>{pr.text}</p>
            <a class="ap-link" href="#zayavka" data-lead={pr.goal} data-block={`25_promo_${pr.slug}`}>{pr.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- Команда -->
    <section class="ap-sec ap-team" id="komanda" aria-labelledby="ap-team-h">
      <div class="ap-w">
        <div class="ap-shead" data-m>
          <h2 id="ap-team-h" class="ap-h2 ap-tilt" data-p style="--x:-40px">Тренеры <em>в сети</em></h2>
          <p class="ap-note" data-p style="--d:120ms">Поставят технику и соберут программу под вашу цель.</p>
        </div>
        <div class="ap-coaches">
          {trainers.map((t, i) => (
            <figure class={`apc apc-${i}`} data-m>
              <div class="apc-img" data-p style={`--y:40px;--d:${i * 90}ms`}>
                <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 1000px) 28vw, 86vw" loading="lazy" format="avif" quality={50} />
                <span class="ap-crop ap-crop-tl"></span><span class="ap-crop ap-crop-br"></span>
              </div>
              <span class={`ap-cursor ap-cursor-${cursorTone[i]} apc-cur`} aria-hidden="true"><svg><use href="#ap-cur" /></svg><b>{t.name.split(' ')[0]}</b></span>
              <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="ap-pers" data-rise>
          <p class="ap-pers-k">Персональные тренировки</p>
          <p class="ap-pers-p">{personalLine}</p>
          <p class="ap-pers-t">{personal.firstFree}. Тренер поставит технику, составит программу под вашу цель и будет следить за прогрессом.</p>
          <a class="ap-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="25_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы как комментарии -->
    <section class="ap-sec ap-rev" id="otzyvy" aria-labelledby="ap-rev-h">
      <div class="ap-w">
        <div class="ap-shead ap-rev-head" data-m>
          <h2 id="ap-rev-h" class="ap-h2 ap-tilt" data-p style="--x:-40px">Голос <em>зала</em></h2>
          <a class="ap-score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-p style="--d:120ms">
            <b>{rating}</b><span>из 5 на Яндекс Картах<br />{site.rating.text}</span>
          </a>
        </div>
        <div class="ap-comments">
          {reviews.map((r, i) => (
            <blockquote class={`apr apr-${i}`} data-rise>
              <header>
                <span class="apr-av" aria-hidden="true">{initials(r.name)}</span>
                <b>{r.name}</b>
                <span>{r.source}</span>
              </header>
              <p>{r.text}</p>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="ap-final" id="zayavka" aria-labelledby="ap-final-h" data-m>
      <span class="ap-final-beam" aria-hidden="true"></span>
      <div class="ap-w ap-final-in">
        <div class="ap-final-tx">
          <h2 id="ap-final-h" class="ap-h2 ap-final-h" data-p style="--x:-50px"><span>Твой ход.</span> <span>Первый день</span> <span class="k">за 1 ₽</span></h2>
          <dl class="ap-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест под видеонаблюдением</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="ap-form" data-p style="--y:50px;--d:200ms">
          <div class="ap-form-sel">
            <i class="h h1"></i><i class="h h3"></i><i class="h h6"></i><i class="h h8"></i>
            <span class="ap-sel-lab">Заявка · 3 поля</span>
            <LeadForm id="ap" block="25_final" />
          </div>
          <span class="ap-cursor ap-cursor-wh ap-cur-form" aria-hidden="true"><svg><use href="#ap-cur" /></svg><b>Вы</b></span>
        </div>
      </div>
    </section>

    <footer class="ap-foot">
      <div class="ap-w">
        <p class="ap-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="ap-foot-cols">
          <div>
            <h2>Клуб</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>Клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>Документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="ap-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Сборка блоков при прокрутке и переключение зон как слоёв (клавиатура: стрелки).
  const groups = document.querySelectorAll<HTMLElement>('.ap [data-m]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) groups.forEach((g) => g.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    groups.forEach((g) => io.observe(g));
  }

  const box = document.querySelector<HTMLElement>('[data-layers]');
  if (box) {
    box.classList.add('is-js');
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...box.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (id: string, focus = false) => {
      tabs.forEach((t) => { const on = t.dataset.tab === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
      panels.forEach((p) => { const on = p.dataset.panel === id; if (on && !p.classList.contains('is-on') && !reduce) p.classList.add('is-anim'); p.classList.toggle('is-on', on); });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!));
      t.addEventListener('mouseenter', () => { if (matchMedia('(hover: hover)').matches) show(t.dataset.tab!); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        show(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });
  }
</script>

