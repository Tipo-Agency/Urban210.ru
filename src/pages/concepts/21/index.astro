  }

  .fk-coupons { display: grid; gap: 22px; margin-top: clamp(56px, 7vw, 96px); }
  .cp { position: relative; padding: 30px 26px 30px 84px; display: grid; gap: 10px; justify-items: start; background: radial-gradient(circle at 0 50%, var(--paper-3) 16px, transparent 17px), radial-gradient(circle at 100% 50%, var(--paper-3) 16px, transparent 17px), var(--paper-2); border-radius: 20px; }
  .cp::after { content: ''; position: absolute; left: 62px; top: 18px; bottom: 18px; border-left: 2px dashed rgb(27 29 46 / 0.35); }
  .cp-st { position: absolute; left: 16px; top: 30px; width: 34px; height: 34px; color: var(--red); }
  .cp-1 .cp-st { color: var(--blue); }
  .cp h3 { font-family: var(--fd); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 2.3rem; line-height: 0.9; margin: 0; }
  .cp p { font-size: 1rem; line-height: 1.55; color: var(--muted); max-width: 46ch; }
  .cp .fk-link { font-size: 1.2rem; margin-top: 4px; }
  @media (min-width: 900px) { .fk-coupons { grid-template-columns: 1fr 1fr; gap: 32px; } .cp { padding: 36px 40px 36px 104px; } .cp::after { left: 78px; } .cp-st { left: 22px; width: 40px; height: 40px; } }

  /* Тренеры */
