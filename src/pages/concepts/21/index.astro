  .pc-gold svg { color: var(--gold); } .pc-gold b { background: radial-gradient(circle at 35% 30%, #ffe0a0, var(--gold)); }
  .pc-tails-x { position: absolute; z-index: -2; left: 50%; top: 52%; width: 70px; height: 80px; translate: -50% 0; background: linear-gradient(90deg, var(--red) 0 33%, var(--paper-3) 33% 66%, var(--blue) 66%); clip-path: polygon(0 0, 46% 0, 30% 100%, 15% 84%, 0 100%, 0 0, 54% 0, 100% 0, 100% 100%, 85% 84%, 70% 100%); opacity: 0; }
