<style>
  .fk :global(h2), .fk :global(h3) { hyphens: manual; -webkit-hyphens: manual; }
  .fk {
    --paper: #f2e6cc; --paper-2: #e9d8b4; --paper-3: #fbf4e4;
    --ink: #1b1d2e; --muted: #574f45;
    --red: #c62a1f; --red-d: #a11f16; --blue: #1f3f7a; --blue-d: #132a56; --or: #ff5722;
    --gold: #e2a53b; --silver: #b9bcc2; --bronze: #c07a43;
    --fd: 'Sofia Sans Extra Condensed Variable', 'Arial Narrow', sans-serif;
    --fn: 'Russo One', 'Arial Black', sans-serif;
    --fb: 'Golos Text Variable', system-ui, sans-serif;
    --ez: cubic-bezier(0.2, 0.8, 0.2, 1);
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --gut: clamp(16px, 4vw, 56px);
    --paper-tex: radial-gradient(rgb(120 90 40 / 0.07) 1px, transparent 1.4px) 0 0 / 5px 5px;
    background: var(--paper-tex), var(--paper); color: var(--ink); font-family: var(--fb); overflow-x: clip;
  }
  .fk-w { width: 100%; max-width: 1440px; margin: 0 auto; padding-inline: var(--gut); }

  /* Дуотоны печати: синий и красный */
  .duo-b, .duo-r { position: relative; isolation: isolate; overflow: hidden; }
  .duo-b :global(img), .duo-r :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.25) brightness(1.05); }
  .duo-b::before, .duo-r::before { content: ''; position: absolute; inset: 0; z-index: 1; mix-blend-mode: lighten; pointer-events: none; }
  .duo-b::after, .duo-r::after { content: ''; position: absolute; inset: 0; z-index: 1; mix-blend-mode: multiply; pointer-events: none; background: radial-gradient(rgb(0 0 0 / 0.16) 1px, transparent 1.6px) 0 0 / 5px 5px, var(--paper); }
  .duo-b::before { background: var(--blue); }
  .duo-r::before { background: var(--red-d); }
  .duo-k { position: relative; isolation: isolate; overflow: hidden; }
  .duo-k :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2) brightness(1.08); }
  .duo-k::before { content: ''; position: absolute; inset: 0; z-index: 1; mix-blend-mode: lighten; background: #24263a; pointer-events: none; }
  .duo-k::after { content: ''; position: absolute; inset: 0; z-index: 1; mix-blend-mode: multiply; pointer-events: none; background: radial-gradient(rgb(0 0 0 / 0.14) 1px, transparent 1.6px) 0 0 / 5px 5px, #f6e7c6; }

  /* Кнопки: круглые значки с двойной обводкой */
  .fk-btn {
    display: inline-flex; align-items: center; gap: 14px; min-height: 60px; padding: 0 30px;
    background: var(--red); color: var(--paper-3); text-decoration: none; border-radius: 999px;
    box-shadow: inset 0 0 0 3px var(--red), inset 0 0 0 5px rgb(251 244 228 / 0.85), 0 4px 0 var(--red-d);
    font-family: var(--fd); font-style: italic; font-weight: 850; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1;
    transition: background-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }
  .fk-btn :global(svg) { width: 20px; height: 18px; transition: transform 0.3s var(--ez); }
  .fk-btn:hover { background: var(--blue); box-shadow: inset 0 0 0 3px var(--blue), inset 0 0 0 5px rgb(251 244 228 / 0.85), 0 4px 0 var(--blue-d); }
  .fk-btn:hover :global(svg) { transform: translateX(5px); }
  .fk-btn:active { transform: translateY(3px); box-shadow: inset 0 0 0 3px var(--red), inset 0 0 0 5px rgb(251 244 228 / 0.85), 0 1px 0 var(--red-d); }
  .fk-btn-s { min-height: 44px; font-size: 1.2rem; padding: 0 20px; box-shadow: inset 0 0 0 2px var(--red), inset 0 0 0 4px rgb(251 244 228 / 0.85); }
  .fk-btn-w { width: 100%; justify-content: space-between; }
  .fk-btn-or { background: var(--or); color: var(--ink); box-shadow: inset 0 0 0 3px var(--or), inset 0 0 0 5px rgb(27 29 46 / 0.75), 0 4px 0 #c43d12; }
  .fk-link { font-family: var(--fd); font-style: italic; font-weight: 800; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; color: var(--blue); background: linear-gradient(currentColor, currentColor) 0 100% / 100% 3px no-repeat; padding-bottom: 4px; transition: color 0.2s ease; }
  .fk-link:hover { color: var(--red); }

  /* Шапка */
  .fk-top { position: sticky; top: 0; z-index: 30; background: var(--paper); border-bottom: 3px solid var(--blue); box-shadow: 0 3px 0 var(--paper), 0 6px 0 var(--red); }
  .fk-top-in { display: flex; align-items: center; gap: 28px; min-height: 64px; }
  .fk-logo { font-family: var(--fd); font-style: italic; font-weight: 900; font-size: 2.05rem; letter-spacing: 0.01em; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; line-height: 1; color: var(--blue); }
  .fk-logo :global(svg) { width: 20px; height: 19px; color: var(--red); transform: skewX(-10deg); }
  .fk-nav { display: none; gap: 26px; margin-left: auto; }
  .fk-nav a { font-family: var(--fd); font-weight: 750; font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; position: relative; }
  .fk-nav a::after { content: ''; position: absolute; left: 50%; bottom: -8px; width: 7px; height: 7px; border-radius: 50%; background: var(--red); transform: translateX(-50%) scale(0); transition: transform 0.3s var(--spring); }
  .fk-nav a:hover::after { transform: translateX(-50%) scale(1); }
  .fk-tel { display: none; font-weight: 650; text-decoration: none; font-size: 0.98rem; white-space: nowrap; }
  .fk-top .fk-btn { margin-left: auto; }
  .fk-hide-s { display: none; }
  .fk-hide-l { display: inline; }
  @media (min-width: 1100px) {
    .fk-nav, .fk-tel { display: flex; }
    .fk-top .fk-btn { margin-left: 0; }
    .fk-hide-s { display: inline; }
    .fk-hide-l { display: none; }
  }

  /* Лучи */
  .fk-rays { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .fk-rays::before { content: ''; position: absolute; left: 50%; top: 50%; width: 260vmax; aspect-ratio: 1; translate: -50% -50%; background: repeating-conic-gradient(from 0deg, rgb(226 165 59 / 0.2) 0 5deg, transparent 5deg 10deg); -webkit-mask: radial-gradient(closest-side, #000 8%, transparent 40%); mask: radial-gradient(closest-side, #000 8%, transparent 40%); }

  /* Первый экран */
  .fk-hero { position: relative; overflow: clip; border-bottom: 3px solid var(--blue); }
  .fk-hero > .fk-rays::before { left: 72%; top: 50%; }
  .fk-hero-in { position: relative; display: grid; padding-top: 30px; }
  .fk-ribbon-k { display: flex; max-width: 100%; }
  .fk-ribbon-k span { position: relative; background: var(--blue); color: var(--paper-3); font-family: var(--fd); font-weight: 800; font-size: 1.12rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 6px 16px 4px; margin-inline: 14px; white-space: nowrap; overflow: hidden; max-width: calc(100% - 28px); }
  .fk-ribbon-k span::before, .fk-ribbon-k span::after { content: ''; position: absolute; top: 5px; bottom: -5px; width: 22px; background: var(--blue-d); z-index: -1; }
  .fk-ribbon-k span::before { left: -14px; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 40% 50%); }
  .fk-ribbon-k span::after { right: -14px; clip-path: polygon(0 0, 100% 0, 60% 50%, 100% 100%, 0 100%); }
  .fk-ribbon-k { isolation: isolate; }
  .fk-ribbon-or span { background: var(--or); color: var(--ink); }
  .fk-ribbon-or span::before, .fk-ribbon-or span::after { background: #c43d12; }

  .fk-h1 { margin: 34px 0 0; font-family: var(--fd); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(5.2rem, 26vw, 13rem); line-height: 0.8; letter-spacing: -0.01em; hyphens: none; }
  .fk-h1 .l { display: block; }
  .fk-h1 .l1 { color: var(--blue); }
  .fk-h1 .l2 { color: var(--ink); font-size: 0.62em; line-height: 0.95; padding-left: 0.12em; }
  .fk-h1 .l3 { color: var(--red); text-shadow: 0.045em 0.045em 0 var(--gold); }
  .fk-lead { margin-top: 26px; max-width: 40ch; font-size: 1.06rem; line-height: 1.55; }
  .fk-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 26px; }

  .fk-comp { position: relative; height: 470px; margin: 26px calc(var(--gut) * -1) 0; }
  .fk-disc { position: absolute; z-index: 1; left: 50%; top: 8%; width: min(84vw, 380px); aspect-ratio: 1; translate: -50% 0; border-radius: 50%; background: radial-gradient(circle at 50% 38%, #2c55a0, var(--blue) 55%, var(--blue-d)); box-shadow: 0 0 0 8px var(--paper), 0 0 0 12px var(--red), 0 0 0 18px var(--paper), 0 0 0 20px var(--blue); }
  .fk-wreath { max-width: none; position: absolute; z-index: 2; left: 50%; top: calc(8% - 46px); width: min(108vw, 490px); aspect-ratio: 1; height: auto; translate: -50% 0; color: var(--gold); filter: drop-shadow(2px 3px 0 rgb(122 70 10 / 0.5)); }
  .fk-man { position: absolute; z-index: 3; bottom: 0; left: 50%; translate: -50% 0; height: 100%; width: auto; max-width: none; filter: grayscale(1) contrast(1.18) sepia(0.18) drop-shadow(8px 6px 0 rgb(198 42 31 / 0.9)); }
  .fk-st { position: absolute; z-index: 4; width: 34px; height: 34px; color: var(--gold); }
  .fk-st1 { left: 10%; top: 6%; width: 40px; height: 40px; color: var(--red); }
  .fk-st2 { right: 12%; top: 2%; }
  .fk-st3 { right: 6%; top: 40%; width: 24px; height: 24px; color: var(--blue); }
  .fk-medal { position: absolute; z-index: 5; left: 4%; top: 24%; width: 116px; display: grid; justify-items: center; transform-origin: 50% 0; }
  .fk-medal-rib { width: 54px; height: 70px; background: repeating-linear-gradient(90deg, var(--red) 0 12px, var(--paper-3) 12px 15px, var(--blue) 15px 27px, var(--paper-3) 27px 30px); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%); }
  .fk-medal-disc { margin-top: -26px; width: 116px; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffd27a, var(--gold) 45%, #b5791d); box-shadow: inset 0 0 0 5px #f7c867, inset 0 0 0 7px #a86c12, 0 6px 0 rgb(80 50 10 / 0.25); display: grid; place-content: center; text-align: center; color: var(--ink); }
  .fk-medal-disc b { font-family: var(--fn); font-weight: 400; font-size: 2.1rem; line-height: 1; }
  .fk-medal-disc small { font-family: var(--fd); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; line-height: 0.95; letter-spacing: 0.04em; margin-top: 2px; }
  .fk-rate { position: absolute; z-index: 5; right: 3%; top: 54%; width: 120px; aspect-ratio: 1; display: grid; place-content: center; text-align: center; color: var(--paper-3); transform: rotate(8deg); }
  .fk-rate svg { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--red); z-index: -1; filter: drop-shadow(3px 4px 0 var(--blue)); }
  .fk-rate { isolation: isolate; }
  .fk-rate b { font-family: var(--fn); font-weight: 400; font-size: 2.4rem; line-height: 1; }
  .fk-rate small { font-size: 0.62rem; line-height: 1.2; font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 4px; }
  .fk-banner { position: absolute; z-index: 6; left: 50%; bottom: 22px; translate: -50% 0; display: flex; isolation: isolate; white-space: nowrap; }
  .fk-banner span { position: relative; background: var(--red); color: var(--paper-3); font-family: var(--fd); font-style: italic; font-weight: 800; font-size: 1.12rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 8px 18px 6px; box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.18); }
  .fk-banner span::before, .fk-banner span::after { content: ''; position: absolute; top: 8px; bottom: -8px; width: 30px; background: var(--red-d); z-index: -1; }
  .fk-banner span::before { left: -20px; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 36% 50%); }
  .fk-banner span::after { right: -20px; clip-path: polygon(0 0, 100% 0, 64% 50%, 100% 100%, 0 100%); }

  @media (min-width: 1000px) {
    .fk-hero-in { grid-template-columns: 1fr 1fr; padding-top: 0; min-height: min(calc(100svh - 70px), 860px); }
    .fk-hero-tx { padding: 56px 0 64px; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 6; }
    .fk-h1 { font-size: clamp(8rem, 13.4vw, 13.6rem); margin-top: 40px; }
    .fk-lead { font-size: 1.15rem; margin-top: 36px; }
    .fk-cta { margin-top: 32px; }
    .fk-comp { height: auto; margin: 0 calc(var(--gut) * -1) 0 0; }
    .fk-disc { top: 12%; width: min(38vw, 540px); }
    .fk-wreath { top: calc(12% - 64px); width: min(52vw, 700px); }
    .fk-man { height: 90%; }
    .fk-medal { left: 4%; top: 20%; width: 150px; }
    .fk-medal-rib { width: 70px; height: 96px; background: repeating-linear-gradient(90deg, var(--red) 0 16px, var(--paper-3) 16px 19px, var(--blue) 19px 35px, var(--paper-3) 35px 38px); }
    .fk-medal-disc { width: 150px; margin-top: -34px; }
    .fk-medal-disc b { font-size: 2.8rem; }
    .fk-medal-disc small { font-size: 1.1rem; }
    .fk-rate { right: 5%; top: 50%; width: 160px; }
    .fk-rate b { font-size: 3.2rem; }
    .fk-rate small { font-size: 0.72rem; }
    .fk-st1 { left: 18%; top: 8%; width: 54px; height: 54px; }
    .fk-st2 { right: 14%; top: 5%; width: 42px; height: 42px; }
    .fk-st3 { right: 4%; top: 36%; width: 30px; height: 30px; }
    .fk-banner { bottom: 40px; }
    .fk-banner span { font-size: 1.35rem; padding: 10px 26px 8px; }
  }

  /* Лента */
  .fk-tape { position: relative; padding: 34px 0; overflow: clip; }
  .fk-tape-in { position: relative; margin-inline: -2%; background: var(--blue); color: var(--paper-3); transform: rotate(-1.6deg); box-shadow: 0 3px 0 var(--paper), 0 6px 0 var(--red); }
  .fk-run { display: flex; width: max-content; animation: fk-run 50s linear infinite; }
  .fk-run span { display: flex; align-items: center; gap: 22px; padding: 14px 22px 12px 0; white-space: nowrap; font-family: var(--fd); font-style: italic; font-weight: 850; font-size: 1.7rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .fk-tape-st { width: 20px; height: 20px; color: var(--gold); }
  @keyframes fk-run { to { transform: translateX(-50%); } }

  /* Секции и заголовки */
  .fk-sec { padding-block: clamp(72px, 10vw, 136px); }
  .fk-head { margin-bottom: clamp(36px, 5vw, 64px); }
  .fk-over { font-family: var(--fd); font-weight: 800; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--red); display: flex; align-items: center; gap: 10px; }
  .fk-over::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: currentColor; box-shadow: 16px 0 0 currentColor; margin-right: 16px; }
  .fk-h2 { margin: 14px 0 0; font-family: var(--fd); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(3.6rem, 15vw, 9rem); line-height: 0.84; letter-spacing: -0.005em; }
  .fk-h2 .b, .fk-h2 .r { display: block; }
  .fk-h2 .b { color: var(--blue); }
  .fk-h2 .r { color: var(--red); padding-left: clamp(20px, 6vw, 110px); }
  .fk-head-c { text-align: center; display: grid; justify-items: center; }
  .fk-head-c .fk-h2 .r { padding-left: 0; }
  .fk-head-t { margin-top: 22px; max-width: 52ch; font-size: 1.05rem; line-height: 1.55; color: var(--muted); }

  /* Нормы */
