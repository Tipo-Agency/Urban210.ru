  .pc-1 li:not(.no) :global(svg) { color: var(--gold); }
  .pc li.no { opacity: 0.55; }
  .pc .fk-btn { margin-top: auto; }
  .pc-1 .fk-btn { background: var(--or); color: var(--ink); box-shadow: inset 0 0 0 3px var(--or), inset 0 0 0 5px rgb(27 29 46 / 0.7), 0 4px 0 #c43d12; }
  .pc-1 .fk-btn:hover, .pc-2 .fk-btn:hover { background: var(--paper-3); color: var(--ink); box-shadow: inset 0 0 0 3px var(--paper-3), inset 0 0 0 5px rgb(27 29 46 / 0.6), 0 4px 0 rgb(0 0 0 / 0.25); }
  .pc-2 .fk-btn { background: var(--blue); box-shadow: inset 0 0 0 3px var(--blue), inset 0 0 0 5px rgb(251 244 228 / 0.85), 0 4px 0 var(--blue-d); }
