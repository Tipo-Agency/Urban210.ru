  .ch-oval { position: relative; width: 100%; aspect-ratio: 4 / 5; border-radius: 50%; box-shadow: 0 0 0 6px var(--paper-3), 0 0 0 10px var(--red); }
  .ch-oval :global(img) { object-position: 50% 18%; }
