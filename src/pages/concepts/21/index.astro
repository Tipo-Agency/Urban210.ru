  .ch figcaption b { position: relative; background: var(--red); color: var(--paper-3); font-family: var(--fd); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.9rem; line-height: 1; padding: 8px 20px 6px; border-radius: 999px; }
