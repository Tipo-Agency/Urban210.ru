  .ct-wreath { position: absolute; left: 50%; top: 14px; translate: -50% 0; width: 70px; height: 70px; color: var(--gold); clip-path: inset(50% 0 0 0); top: -16px; }
  .ct p { font-size: 1.04rem; line-height: 1.6; text-align: center; }
