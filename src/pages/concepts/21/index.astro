  .pc-1 .pc-price b { color: var(--paper-3); text-shadow: 4px 4px 0 var(--red); }
  .pc-2 .pc-price b { color: var(--paper-3); text-shadow: 4px 4px 0 var(--blue); }
  .pc-0 .pc-price b { text-shadow: 4px 4px 0 var(--gold); }
