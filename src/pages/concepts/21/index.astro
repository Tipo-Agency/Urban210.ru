---
// Концепция 21 «Физкультура»: советский спортивный плакат 1930–60-х, дух ГТО, переписанный для зала.
// Тёплая бумага, красный, глубокий синий и оранжевый, лучи, лавровые венки, медали с лентами, пьедестал.
// В отличие от 15 «Агитки»: праздничная и иллюстративная, круглые значки и ленты вместо острых клиньев.
// Никакой политической символики: только спортивные награды.
import sofCyr from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-cyrillic-wght-normal.woff2?url';
import sofLat from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-latin-wght-normal.woff2?url';
import sofCyrI from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-cyrillic-wght-italic.woff2?url';
import sofLatI from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-latin-wght-italic.woff2?url';
import rusCyr from '@fontsource/russo-one/files/russo-one-cyrillic-400-normal.woff2?url';
import rusLat from '@fontsource/russo-one/files/russo-one-latin-400-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons } from '../../../data/content';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+20BD,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (fam: string, style: string, url: string, range: string, w = '100 900') => `@font-face{font-family:'${fam}';font-style:${style};font-display:swap;font-weight:${w};src:url(${url}) format('woff2');unicode-range:${range}}`;
const SOF = 'Sofia Sans Extra Condensed Variable';
const fonts = [
  ff(SOF, 'normal', sofCyr, UR), ff(SOF, 'normal', sofLat, UL),
  ff(SOF, 'italic', sofCyrI, UR), ff(SOF, 'italic', sofLatI, UL),
  ff('Russo One', 'normal', rusCyr, UR, '400'), ff('Russo One', 'normal', rusLat, UL, '400'),
].join('');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const [tradein, friend] = [promos.find((p) => p.slug === 'trade-in')!, promos.find((p) => p.slug === '1-plus-1')!];
const dayRate = perDay(plans[0].month, 30);
const shownReasons = reasons.filter((r) => !r.title.startsWith('Нет вступ'));
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const ribbon = [`${plans[0].name} от ${dayRate} ₽ в день`, 'Парковка на 50 мест', `Пн–Пт ${site.hours[0].time}`, `Сб–Вс ${site.hours[1].time}`, `${rating} на Яндекс Картах`, site.facts.machines];
const roman = ['I', 'II', 'III', 'IV'];
const ranks = [{ r: 'III', m: 'bronze' }, { r: 'II', m: 'silver' }, { r: 'I', m: 'gold' }];

// Лавровая ветвь: листья по дуге окружности (r=80, центр 100,100), правая ветвь зеркалится
const f1 = (n: number) => Math.round(n * 10) / 10;
const leaves: string[] = [];
for (let deg = 98; deg <= 250; deg += 11) {
  const t = (deg * Math.PI) / 180;
  const x = 100 + 80 * Math.cos(t), y = 100 + 80 * Math.sin(t);
  const tan = deg + 90;
  for (const [side, off] of [[1, 7], [-1, -7]] as const) {
    const cx = x + off * Math.cos(t) * 0.9 - 4 * Math.sin(t);
    const cy = y + off * Math.sin(t) * 0.9 + 4 * Math.cos(t);
    leaves.push(`<ellipse cx="${f1(cx)}" cy="${f1(cy)}" rx="10" ry="3.8" transform="rotate(${f1(tan + side * 38)} ${f1(cx)} ${f1(cy)})"/>`);
  }
}
const arcStart = [100 + 80 * Math.cos((96 * Math.PI) / 180), 100 + 80 * Math.sin((96 * Math.PI) / 180)].map(f1);
const arcEnd = [100 + 80 * Math.cos((252 * Math.PI) / 180), 100 + 80 * Math.sin((252 * Math.PI) / 180)].map(f1);
const branch = `<path d="M${arcStart[0]} ${arcStart[1]} A80 80 0 0 1 ${arcEnd[0]} ${arcEnd[1]}" fill="none" stroke="currentColor" stroke-width="2.4"/>${leaves.join('')}`;
const laurel = `<symbol id="fk-laurel" viewBox="0 0 200 200"><g fill="currentColor">${branch}<g transform="translate(200 0) scale(-1 1)">${branch}</g></g></symbol>`;

const starPts = (cx: number, cy: number, R: number, r: number, n = 5) => Array.from({ length: n * 2 }, (_, i) => {
  const a = -Math.PI / 2 + (i * Math.PI) / n;
  const rr = i % 2 ? r : R;
  return `${f1(cx + rr * Math.cos(a))},${f1(cy + rr * Math.sin(a))}`;
}).join(' ');
const star = `<symbol id="fk-star" viewBox="0 0 100 100"><polygon points="${starPts(50, 52, 50, 21)}" fill="currentColor"/></symbol>`;
const rosette = `<symbol id="fk-rosette" viewBox="0 0 100 100"><polygon points="${starPts(50, 50, 50, 44, 24)}" fill="currentColor"/></symbol>`;
---
<Layout title="Концепция 21 «Физкультура»" description="Концепция дизайна сайта Urban210: советский спортивный плакат, медали, ленты и лавровые венки, тёплая бумага, красный и синий." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={sofCyrI} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sofCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs set:html={laurel + star + rosette} /></svg>

  <div class="fk">
    <header class="fk-top">
      <div class="fk-w fk-top-in">
        <a class="fk-logo" href="/concepts/21/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="fk-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="fk-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="fk-btn fk-btn-s" href="#zayavka" data-lead="Заявка с сайта" data-block="21_header"><span class="fk-hide-s">Оставить заявку</span><span class="fk-hide-l">Заявка</span></a>
      </div>
    </header>

    <!-- Первый экран: плакат с лучами -->
    <section class="fk-hero" aria-labelledby="fk-h1">
      <div class="fk-rays" aria-hidden="true"></div>
      <div class="fk-w fk-hero-in">
        <div class="fk-hero-tx">
          <p class="fk-ribbon-k"><span>Хабаровск · пр. 60-летия Октября, 210</span></p>
          <h1 id="fk-h1" class="fk-h1">
            <span class="l l1">Готов</span>
            <span class="l l2">к первому</span>
            <span class="l l3">дню?</span>
          </h1>
          <p class="fk-lead">Urban210 от {dayRate}&nbsp;₽ в&nbsp;день по дневной карте. Тренажёрный зал, кардио, групповые и SPA в Железнодорожном районе.</p>
          <div class="fk-cta">
            <a class="fk-btn" href="#tarify" data-block="21_hero">Выбрать карту<Icon name="chev" /></a>
            <a class="fk-link" href="#zayavka" data-lead="Заявка с сайта" data-block="21_hero">Оставить заявку</a>
          </div>
        </div>

        <div class="fk-comp" aria-hidden="true">
          <span class="fk-disc"></span>
          <svg class="fk-wreath" viewBox="0 0 200 200"><use href="#fk-laurel" /></svg>
          <Image class="fk-man" src={cutout} alt="" widths={[360, 520, 760]} sizes="(min-width: 1000px) 34vw, 78vw" loading="eager" fetchpriority="high" format="webp" quality={60} />
          <svg class="fk-st fk-st1"><use href="#fk-star" /></svg>
          <svg class="fk-st fk-st2"><use href="#fk-star" /></svg>
          <svg class="fk-st fk-st3"><use href="#fk-star" /></svg>
          <span class="fk-medal">
            <span class="fk-medal-rib"></span>
            <span class="fk-medal-disc"><b>{dayRate}&nbsp;₽</b><small>в&nbsp;день</small></span>
          </span>
          <span class="fk-rate"><svg><use href="#fk-rosette" /></svg><b>{rating}</b><small>Яндекс Карты<br />{site.rating.text}</small></span>
          <span class="fk-banner"><span>Александр Лазько, координатор зала</span></span>
        </div>
      </div>
    </section>

    <!-- Лента -->
    <div class="fk-tape" aria-hidden="true">
      <div class="fk-tape-in">
        <div class="fk-run">{[0, 1].map(() => <span>{ribbon.map((t) => <>{t}<svg class="fk-tape-st"><use href="#fk-star" /></svg></>)}</span>)}</div>
      </div>
    </div>

    <!-- Нормы клуба -->
    <section class="fk-sec fk-w" aria-labelledby="fk-norm-h">
      <div class="fk-head">
        <p class="fk-over">Нормы клуба</p>
        <h2 id="fk-norm-h" class="fk-h2"><span class="b">Три причины</span> <span class="r">прийти сегодня</span></h2>
      </div>
      <ol class="fk-norms">
        {shownReasons.map((r, i) => (
          <li data-rise style={`transition-delay:${i * 80}ms`}>
            <span class={`fk-badge fk-badge-${i}`} aria-hidden="true">
              <svg class="fk-badge-ros"><use href="#fk-rosette" /></svg>
              <span class="fk-badge-in">{roman[i]}</span>
            </span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Зоны: дисциплины -->
    <section class="fk-sec fk-zones-sec" id="zony" aria-labelledby="fk-zones-h">
      <div class="fk-w">
        <div class="fk-head">
          <p class="fk-over">Дисциплины</p>
          <h2 id="fk-zones-h" class="fk-h2"><span class="b">Четыре зоны</span> <span class="r">в одном клубе</span></h2>
        </div>
        <div class="fk-zones">
          {[
            { k: z.zal, src: '/images/free-weights.jpg', alt: 'Свободные веса в зале Urban210', t: cap(z.zal.text) },
            { k: z.cardio, src: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне', t: z.cardio.text },
            { k: z.group, src: '/images/group.jpg', alt: 'Групповая тренировка в зале 150 м²', t: cap(z.group.text) },
          ].map((x, i) => (
            <a class={`zc zc-${i}`} href={x.k.href} data-rise style={`transition-delay:${i * 90}ms`}>
              <div class="zc-arch duo-b">
                <Image src={img(x.src)} alt={x.alt} widths={[400, 600, 800]} sizes="(min-width: 1000px) 30vw, 92vw" loading="lazy" format="avif" quality={45} />
              </div>
              <span class="zc-n" aria-hidden="true"><svg><use href="#fk-rosette" /></svg><b>{i + 1}</b></span>
              <h3>{x.k.title}</h3>
              <p>{x.t}</p>
              <span class="zc-more">Подробнее<Icon name="chev" /></span>
            </a>
          ))}
          <a class="zc zc-spa" href={z.spa.href} data-rise>
            <div class="zc-heat" aria-hidden="true"><b>40–50</b><span>°C хаммам</span></div>
            <span class="zc-n" aria-hidden="true"><svg><use href="#fk-rosette" /></svg><b>4</b></span>
            <h3>{z.spa.title}</h3>
            <p>{z.spa.text}</p>
            <span class="zc-note">В тарифе «{plans[2].name}»</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Пьедестал: гости в зале -->
    <section class="fk-sec fk-podium-sec" aria-labelledby="fk-pod-h">
      <div class="fk-w">
        <div class="fk-head fk-head-c">
          <svg class="fk-head-wreath" viewBox="0 0 200 200" aria-hidden="true"><use href="#fk-laurel" /></svg>
          <h2 id="fk-pod-h" class="fk-h2"><span class="b">Сильнее</span> <span class="r">с каждым днём</span></h2>
          <p class="fk-head-t">Гости Urban210 на тренировках. Пьедестал здесь у каждого свой: первая тяга, первые десять минут бега, первый месяц без пропусков.</p>
        </div>
        <div class="fk-podium">
          {[
            { src: '/images/community/9.jpg', step: 2 },
            { src: '/images/community/2.jpg', step: 1 },
            { src: '/images/community/13.jpg', step: 3 },
          ].map((p, i) => (
            <figure class={`pd pd-${p.step}`} data-rise style={`transition-delay:${i * 100}ms`}>
              <div class="pd-img duo-r">
                <Image src={img(p.src)} alt="Гость клуба на тренировке в Urban210" widths={[300, 460]} sizes="(min-width: 1000px) 24vw, 32vw" loading="lazy" format="avif" quality={45} />
              </div>
              <span class="pd-step" aria-hidden="true"><b>{p.step}</b></span>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Тарифы: разряды -->
    <section class="fk-sec fk-prices" id="tarify" aria-labelledby="fk-price-h">
      <div class="fk-w">
        <div class="fk-head">
          <p class="fk-over">Тарифы</p>
          <h2 id="fk-price-h" class="fk-h2"><span class="b">Три разряда</span> <span class="r">от {dayRate}&nbsp;₽ в&nbsp;день</span></h2>
        </div>
        <div class="fk-plans">
          {plans.map((p, i) => (
            <article class={`pc pc-${i}`} data-rise style={`transition-delay:${i * 100}ms`}>
              <span class={`pc-medal pc-${ranks[i].m}`} aria-hidden="true">
                                <svg><use href="#fk-rosette" /></svg>
                <b>{ranks[i].r}</b>
              </span>
              {p.tag && <span class="pc-tag">{p.tag}</span>}
              <p class="pc-rank">{ranks[i].r} разряд</p>
              <h3>{p.name}</h3>
              <p class="pc-h">{cap(p.hours)}</p>
              <p class="pc-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="pc-year">За год {rub(p.year)}, это {perDay(p.year, 365)} ₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="fk-btn fk-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`21_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="fk-day" data-rise>
          <div class="tr-medal" aria-hidden="true">
            <span class="tr-rib"></span>
            <span class="tr-disc">
              <svg class="tr-wreath" viewBox="0 0 200 200"><use href="#fk-laurel" /></svg>
              <b>{dayRate}<i>₽</i></b>
            </span>
          </div>
          <div class="tr-tx">
            <p class="fk-over">Цена дня</p>
            <h3>{plans[0].name}</h3>
            <p>{rub(plans[0].month)} в месяц, это {dayRate}&nbsp;₽ в&nbsp;день. Тренажёрный зал и кардиозона {plans[0].hours}.</p>
            <ul>{plans[0].features.slice(1).map((t) => <li>{t}</li>)}</ul>
            <a class="fk-btn fk-btn-or" href="#zayavka" data-lead="Заявка с сайта" data-block="21_day">Оставить заявку<Icon name="chev" /></a>
          </div>
        </div>

        <div class="fk-coupons">
          {[tradein, friend].map((pr, i) => (
            <article class={`cp cp-${i}`} data-rise>
              <svg class="cp-st" aria-hidden="true"><use href="#fk-star" /></svg>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
              <a class="fk-link" href="#zayavka" data-lead={pr.goal} data-block={`21_promo_${pr.slug}`}>{pr.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Тренеры -->
    <section class="fk-sec fk-team" id="trenery" aria-labelledby="fk-team-h">
      <div class="fk-rays fk-rays-b" aria-hidden="true"></div>
      <div class="fk-w">
        <div class="fk-head">
          <p class="fk-over">Наставники</p>
          <h2 id="fk-team-h" class="fk-h2"><span class="b">Тренеры</span> <span class="r">ведут к цели</span></h2>
        </div>
        <div class="fk-coaches">
          {trainers.map((t, i) => (
            <figure class="ch" data-rise style={`transition-delay:${i * 100}ms`}>
              <div class="ch-frame">
                <svg class="ch-wreath" viewBox="0 0 200 200" aria-hidden="true"><use href="#fk-laurel" /></svg>
                <div class="ch-oval duo-k">
                  <Image src={img(t.photo)} alt={t.name} widths={[320, 480]} sizes="(min-width: 1000px) 22vw, 64vw" loading="lazy" format="avif" quality={50} />
                </div>
              </div>
              <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="fk-personal" data-rise>
          <div>
            <p class="fk-over">Персональные тренировки</p>
            <p class="fk-personal-p">{personalLine}</p>
            <p class="fk-personal-t">{personal.firstFree}. Тренер поставит технику, составит программу под вашу цель и будет следить за прогрессом.</p>
          </div>
          <a class="fk-btn fk-btn-or" href="#zayavka" data-lead="Персональные тренировки" data-block="21_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы: грамоты -->
    <section class="fk-sec fk-w fk-rev" id="otzyvy" aria-labelledby="fk-rev-h">
      <div class="fk-rev-head">
        <div class="fk-head">
          <p class="fk-over">Отзывы</p>
          <h2 id="fk-rev-h" class="fk-h2"><span class="b">Грамоты</span> <span class="r">от гостей</span></h2>
        </div>
        <a class="fk-score" href={site.maps.yandexReviews} target="_blank" rel="noopener">
          <span class="fk-score-b"><svg aria-hidden="true"><use href="#fk-rosette" /></svg><b>{rating}</b></span>
          <span class="fk-score-t">из 5 на Яндекс Картах<br />{site.rating.text}</span>
        </a>
      </div>
      <div class="fk-certs">
        {reviews.map((r, i) => (
          <blockquote class="ct" data-rise style={`transition-delay:${(i % 2) * 90}ms`}>
            <svg class="ct-wreath" viewBox="0 0 200 200" aria-hidden="true"><use href="#fk-laurel" /></svg>
            <p>{r.text}</p>
            <footer><b>{r.name}</b><span>{r.source}</span></footer>
          </blockquote>
        ))}
      </div>
    </section>

    <!-- Заявка -->
    <section class="fk-final" id="zayavka" aria-labelledby="fk-final-h">
      <div class="fk-rays fk-rays-f" aria-hidden="true"></div>
      <div class="fk-w fi-in">
        <div class="fi-tx">
          <p class="fk-ribbon-k fk-ribbon-or"><span>Готов к первому дню?</span></p>
          <h2 id="fk-final-h" class="fk-h2"><span class="b">Старт</span> <span class="r">сегодня</span></h2>
          <dl class="fi-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест под видеонаблюдением</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="fi-form">
          <span class="fi-medal" aria-hidden="true"><svg><use href="#fk-rosette" /></svg><b>{dayRate} ₽</b></span>
          <LeadForm id="fk" block="21_final" />
        </div>
      </div>
    </section>

    <footer class="fk-foot">
      <div class="fk-w">
        <div class="fk-foot-top">
          <p class="fk-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
          <p class="fk-foot-s">Фитнес-клуб в Хабаровске</p>
        </div>
        <div class="fk-foot-cols">
          <div>
