  .fk-personal { margin-top: clamp(72px, 9vw, 130px); padding: 30px 26px; border-radius: 28px; background: var(--blue-d); box-shadow: inset 0 0 0 2px rgb(251 244 228 / 0.25); display: grid; gap: 22px; justify-items: start; }
  .fk-personal-p { margin-top: 8px; font-family: var(--fd); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(2.6rem, 10vw, 5rem); line-height: 0.9; }
