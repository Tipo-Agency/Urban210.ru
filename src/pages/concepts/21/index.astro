  .zc-more { margin: 6px 12px 0; display: inline-flex; align-items: center; gap: 8px; font-family: var(--fd); font-style: italic; font-weight: 800; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 0.04em; color: var(--red); }
