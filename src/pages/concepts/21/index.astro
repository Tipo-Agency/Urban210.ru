  .tr-rib { width: 120px; height: 150px; background: repeating-linear-gradient(90deg, var(--red) 0 26px, var(--paper-3) 26px 32px, var(--blue) 32px 58px, var(--paper-3) 58px 64px, var(--red) 64px 90px, var(--paper-3) 90px 96px, var(--blue) 96px 120px); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%); }
  .tr-disc { position: relative; margin-top: -60px; width: min(78vw, 330px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 34% 28%, #ffd8a0, var(--or) 42%, #d9420f 80%); box-shadow: inset 0 0 0 10px #ff8a50, inset 0 0 0 14px #b8370c, 0 12px 0 rgb(100 40 10 / 0.25); display: grid; place-items: center; }
  .tr-wreath { position: absolute; inset: 9%; width: 82%; height: 82%; color: var(--paper-3); opacity: 0.9; }
