  .fk-score { display: flex; align-items: center; gap: 16px; text-decoration: none; justify-self: start; }
  .fk-score-b { position: relative; width: 140px; aspect-ratio: 1; display: grid; place-items: center; isolation: isolate; color: var(--paper-3); }
  .fk-score-b svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; color: var(--blue); filter: drop-shadow(5px 5px 0 var(--red)); }
  .fk-score-b b { font-family: var(--fn); font-weight: 400; font-size: 3.2rem; line-height: 1; }
  .fk-score-t { font-weight: 600; line-height: 1.35; padding-bottom: 2px; background: linear-gradient(var(--red), var(--red)) 0 100% / 100% 2px no-repeat; }
  @media (min-width: 900px) { .fk-rev-head { grid-template-columns: 1fr auto; } .fk-score-b { width: 180px; } .fk-score-b b { font-size: 4.2rem; } }
  .fk-certs { display: grid; gap: 22px; }
