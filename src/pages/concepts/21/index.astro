  @media (min-width: 900px) { .fk-certs { grid-template-columns: 1fr 1fr; gap: 28px; } .ct { padding: 70px 44px 32px; } .ct:nth-child(even) { translate: 0 30px; } .fk-certs { padding-bottom: 30px; } }

  /* Заявка */
  .fk-final { position: relative; background: var(--red); color: var(--paper-3); overflow: clip; padding: clamp(80px, 11vw, 140px) 0; border-top: 6px solid var(--blue); }
  .fk-rays-f::before { background: repeating-conic-gradient(from 0deg, rgb(255 210 150 / 0.16) 0 5deg, transparent 5deg 10deg); left: 30%; top: 30%; }
  .fi-in { position: relative; display: grid; gap: 52px; }
