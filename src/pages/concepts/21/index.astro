  .pc-tag { position: absolute; top: 18px; right: 18px; background: var(--or); color: var(--ink); border-radius: 999px; padding: 5px 12px 3px; font-family: var(--fd); font-weight: 850; text-transform: uppercase; font-size: 1rem; letter-spacing: 0.06em; }
