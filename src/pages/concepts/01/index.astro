---
// Концепция 01 «Монохром»: светлый редакционный журнал. Только чёрное и белое, Onest 300/500,
// большие ч/б фото с подписями, много воздуха. Движение спокойное: фото открывается шторкой
// и медленно отъезжает, ночная полоса с видео зала. Оранжевый только точкой в шапке.
import { Image } from 'astro:assets';
import onestCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onestExt from '@fontsource-variable/onest/files/onest-latin-ext-wght-normal.woff2?url';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, nav, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, programs, zones } from '../../../data/content';

const fonts = `
@font-face{font-family:'Onest m';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestCyr}) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Onest m';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestLat}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Onest m';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestExt}) format('woff2');unicode-range:U+0100-02BA,U+20A0-20AB,U+20AD-20C0}`;

const rating = site.rating.value.toString().replace('.', ',');
const hours = site.hours.map((h) => `${h.days} ${h.time}`);
const zal = zones[0], cardio = zones[1], group = zones[2], spa = zones[3];
const dayCard = plans[0];
const fromDay = perDay(dayCard.month, 30);
const cap = (t: string) => t[0].toUpperCase() + t.slice(1);
const facts = [
  { n: rating, t: `на Яндекс Картах, ${site.rating.text}` },
  { n: `${fromDay} ₽`, t: 'в день по дневной карте' },
  { n: '6:30', t: 'открываемся по будням' },
  { n: '50', t: 'мест на бесплатной парковке' },
];
---
<Layout title="Концепция 01 «Монохром»" description="Концепция дизайна сайта Urban210: чёрно-белый редакционный журнал." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={onestCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="mono">
    <header class="m-top">
      <a class="m-logo" href="/concepts/01/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
      <nav class="m-nav" aria-label="Меню">
        <a href="#club">Клуб</a><a href="#price">Абонементы</a><a href="#team">Тренеры</a><a href="#contacts">Контакты</a>
      </nav>
      <a class="m-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="m-cta" href="#price" data-block="01_header"><i class="m-dot" aria-hidden="true"></i><span class="m-cta-l">Выбрать карту</span><span class="m-cta-s">Карты</span></a>
    </header>

    <section class="m-hero" aria-labelledby="m-h">
      <div class="m-hero-text">
        <p class="m-cap">Фитнес-клуб в Хабаровске, {site.district.toLowerCase()}</p>
        <h1 id="m-h"><span class="ln"><span>Тренируйтесь</span></span><span class="ln"><span>без суеты</span></span></h1>
        <div class="m-hero-side">
          <p>Более 1300 м² на двух этажах, 60+ тренажёров Technogym и Matrix, сауна и хаммам. Свободно даже вечером.</p>
          <div class="m-acts">
            <a class="m-btn" href="#price" data-block="01_hero">Выбрать карту<Icon name="chev" /></a>
            <a class="m-link" href="#price">От {fromDay} ₽ в день</a>
          </div>
        </div>
      </div>
      <figure class="m-hero-fig">
        <div class="m-hero-ph">
          <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210: ряды тренажёров у панорамных окон" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
        </div>
        <figcaption><span>Тренажёрный зал Urban210</span><span>{site.address.short}</span></figcaption>
      </figure>
    </section>

    <section class="m-facts" aria-label="Коротко о клубе">
      {facts.map((f) => <div class="m-fact" data-rise><b>{f.n}</b><span>{f.t}</span></div>)}
    </section>

    <section class="m-intro" aria-label="О клубе">
      <p class="m-cap">О клубе</p>
      <p class="m-state" data-rise>Один клуб рядом с домом. <span>Без очередей к тренажёрам и без спешки.</span> Дневная карта от {fromDay} ₽ в день.</p>
    </section>

    <section class="m-zones" id="club" aria-labelledby="m-z">
      <div class="m-head">
        <h2 id="m-z">Клуб</h2>
        <p>Четыре пространства: зал, кардио, групповые программы и SPA. Всё под одной крышей.</p>
      </div>

      <article class="m-z m-z1">
        <figure class="m-ph m-reveal" data-rise><Image src={img('/images/free-weights.jpg')} alt="Гантельный ряд в зоне свободных весов" widths={[640, 960, 1280]} sizes="(min-width: 960px) 62vw, 100vw" format="avif" quality={45} /></figure>
        <div class="m-z-text">
          <span class="m-no">I</span>
          <h3>{zal.title}</h3>
          <p>{cap(zal.text)}</p>
          <a class="m-link" href={zal.href}>Подробнее о зале</a>
        </div>
      </article>

      <article class="m-z m-z2">
        <div class="m-z-text">
          <span class="m-no">II</span>
          <h3>{cardio.title}</h3>
          <p>{cardio.text} На втором этаже, свободная дорожка находится почти всегда.</p>
          <a class="m-link" href={cardio.href}>Смотреть кардиозону</a>
        </div>
        <figure class="m-ph m-reveal" data-rise><Image src={img('/images/cardio.jpg')} alt="Ряд беговых дорожек в кардиозоне" widths={[640, 960, 1280]} sizes="(min-width: 960px) 54vw, 100vw" format="avif" quality={45} /></figure>
      </article>

      <article class="m-z m-z3">
        <figure class="m-ph m-reveal" data-rise><Image src={img('/images/group.jpg')} alt="Групповое занятие в зале групповых программ" widths={[640, 960, 1280]} sizes="(min-width: 960px) 46vw, 100vw" format="avif" quality={45} /></figure>
        <div class="m-z-text">
          <span class="m-no">III</span>
          <h3>{group.title}</h3>
          <p>{cap(group.text)}</p>
          <p class="m-prog">{programs.flatMap((p) => p.items).join(' · ')}</p>
          <a class="m-link" href={group.href}>Расписание и направления</a>
        </div>
        <aside class="m-spa" data-rise>
          <span class="m-no">IV</span>
          <h3>{spa.title}</h3>
          <p class="m-spa-big">Финская сауна, хаммам 40–50 °C и релакс-зона с массажными креслами.</p>
          <p>Входит в абонемент «Всё включено».</p>
          <a class="m-link" href={spa.href}>Об SPA-зоне</a>
        </aside>
      </article>
    </section>

    <section class="m-night" aria-labelledby="m-n">
      <div class="m-night-media">
        <Image src={img('/images/hero.jpg')} alt="" widths={[640, 1280, 1920]} sizes="100vw" format="avif" quality={45} />
        <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
      </div>
      <div class="m-night-in">
        <p class="m-cap">Вечером</p>
        <h2 id="m-n" data-rise>Открыто до 23:30</h2>
        <ul>{site.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}</ul>
      </div>
    </section>

    <section class="m-price" id="price" aria-labelledby="m-p">
      <div class="m-head">
        <h2 id="m-p">Абонементы</h2>
        <p>Один раз в год абонемент можно бесплатно заморозить на 30 дней.</p>
      </div>
      <div class="m-plans">
        {plans.map((p) => (
          <article class:list={['m-plan', p.id === 'full' && 'is-inv']} data-rise>
            <div class="m-plan-h">
              <h3>{p.name}</h3>
              {p.tag && <span class="m-tag">{p.tag}</span>}
            </div>
            <p class="m-hrs">{p.hours[0].toUpperCase() + p.hours.slice(1)}</p>
            <p class="m-sum"><b>{rub(p.month)}</b><span>в месяц</span></p>
            <p class="m-year">{rub(p.year)} за год, это {perDay(p.year, 365)} ₽ в день</p>
            <ul>
              {p.features.map((f) => <li>{f}</li>)}
              {p.excluded?.map((f) => <li class="no">{f}</li>)}
            </ul>
            <a class="m-btn m-btn-wide" href="#lead" data-lead={p.name} data-block={`01_${p.id}`}>Выбрать<Icon name="chev" /></a>
          </article>
        ))}
      </div>

      <div class="m-offer" data-rise>
        <p class="m-one">{fromDay} ₽</p>
        <div>
          <h3>В день по дневной карте</h3>
          <p>{dayCard.name}: {rub(dayCard.month)} в месяц, зал и кардиозона {dayCard.hours}.</p>
        </div>
        <a class="m-btn" href="#lead" data-lead="Заявка с сайта" data-block="01_offer">Оставить заявку<Icon name="chev" /></a>
      </div>
      <p class="m-note">Персональные тренировки: {personal.pack} занятий за {rub(personal.price)}. {personal.firstFree}.</p>
    </section>

    <section class="m-team" id="team" aria-labelledby="m-t">
      <div class="m-head">
        <h2 id="m-t">Тренеры</h2>
        <p>Поставят технику, составят программу под вашу цель и будут следить за прогрессом.</p>
      </div>
      <ul class="m-team-list">
        {trainers.map((t) => (
          <li data-rise>
            <figure class="m-ph"><Image src={img(t.photo)} alt={t.name} widths={[400, 700]} sizes="(min-width: 960px) 30vw, 78vw" format="avif" quality={45} /></figure>
            <p class="m-name">{t.name}</p>
            <p class="m-role">{t.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="m-voice" aria-labelledby="m-v">
      <div class="m-rate">
        <h2 id="m-v" class="sr">Отзывы</h2>
        <p class="m-rate-n">{rating}</p>
        <p>Средняя оценка на Яндекс Картах, {site.rating.text}.</p>
        <a class="m-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать все отзывы</a>
      </div>
      <div class="m-quotes">
        {[reviews[0], reviews[1]].map((r, i) => (
          <figure class:list={['m-q', i === 0 && 'is-big']} data-rise>
            <blockquote>«{r.text}»</blockquote>
            <figcaption>{r.name}, {r.source}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="m-lead" id="lead" aria-labelledby="m-l">
      <figure class="m-lead-ph m-reveal" data-rise>
        <Image src={img('/images/group-strength.jpg')} alt="Силовая групповая тренировка с гантелями" widths={[640, 960, 1280]} sizes="(min-width: 960px) 50vw, 100vw" format="avif" quality={45} />
      </figure>
      <div class="m-lead-in">
        <p class="m-cap">Первый визит</p>
        <h2 id="m-l">Приходите<br />знакомиться</h2>
        <p class="m-lead-p">Оставьте телефон, администратор перезвонит, поможет выбрать карту и подберёт время.</p>
        <LeadForm block="01_final" id="m01" />
        <p class="m-alt">Удобнее написать: <a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener">WhatsApp</a> или <a href={telegramLink('concept_01')} target="_blank" rel="noopener">Telegram</a></p>
      </div>
    </section>

    <footer class="m-foot" id="contacts">
      <div class="m-foot-grid">
        <div>
          <p class="m-cap">Адрес</p>
          <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
          <p class="m-mut">{site.parking}</p>
          <p><a class="m-link" href={site.maps.yandex} target="_blank" rel="noopener">Открыть на карте</a></p>
        </div>
        <div>
          <p class="m-cap">Часы работы</p>
          {hours.map((h) => <p>{h}</p>)}
        </div>
        <div>
          <p class="m-cap">Связь</p>
          <p><a href={site.phone.href}>{site.phone.display}</a></p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><a href={site.instagram} target="_blank" rel="noopener">Instagram</a> · <a href={telegramLink('concept_01_footer')} target="_blank" rel="noopener">Telegram</a></p>
        </div>
        <nav aria-label="Разделы">
          <p class="m-cap">Разделы</p>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
      <p class="m-word" aria-hidden="true">URBAN210<Icon name="chev" /></p>
      <div class="m-legal">
        <span>© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</span>
        <span><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Договор-оферта</a> · <a href="/rules/">Правила клуба</a></span>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  body:has(.mono) { background: #f3f2ef; color: #121211; }
  body:has(.mono) ::selection { background: #121211; color: #f3f2ef; }
  body:has(.mono) :focus-visible { outline-color: #121211; }
  /* липкая панель и окно заявки в той же гамме */
  body:has(.mono) .mbar { background: rgb(243 242 239 / 0.94); border-top-color: rgb(18 18 17 / 0.12); color: #121211; font-family: 'Onest m', sans-serif; }
  body:has(.mono) .mbar a.ic { border-color: rgb(18 18 17 / 0.2); border-radius: 0; }
  body:has(.mono) .mbar .btn { --b: #121211; --c: #f3f2ef; border-radius: 0; font-weight: 500; }
  body:has(.mono) dialog.lead::backdrop { background: rgb(243 242 239 / 0.82); }
  body:has(.mono) .form { background: #f3f2ef; color: #121211; --ink: #121211; --muted: #5f5e5a; --line: rgb(18 18 17 / 0.18); --card: transparent; border-radius: 0; font-family: 'Onest m', sans-serif; gap: 18px; color-scheme: light; }
  body:has(.mono) dialog.lead .form { border-color: rgb(18 18 17 / 0.2); }
  body:has(.mono) .form h3 { font-family: 'Onest m', sans-serif; font-weight: 400; font-size: 1.6rem; letter-spacing: -0.03em; }
  body:has(.mono) .field input { border: 0; border-bottom: 1px solid rgb(18 18 17 / 0.3); border-radius: 0; padding: 0; background: transparent; min-height: 52px; font-size: 1.1rem; }
  body:has(.mono) .field input:focus { border-color: #121211; }
  body:has(.mono) .consent input { accent-color: #121211; }
  body:has(.mono) .form .btn { --b: #121211; --c: #f3f2ef; border-radius: 0; font-weight: 500; min-height: 60px; justify-content: space-between; padding: 0 24px; }
  body:has(.mono) .form .btn:hover { --b: #000; }
  body:has(.mono) .form-done .ok { background: #121211; color: #f3f2ef; }
  body:has(.mono) .form-msg.is-err { background: rgb(18 18 17 / 0.06); color: #121211; }
  body:has(.mono) .field .err, body:has(.mono) .consent.bad { color: #b3261e; }
</style>

<style>
  .mono {
    --paper: #f3f2ef; --ink: #121211; --mut: #5f5e5a; --line: rgb(18 18 17 / 0.14);
    --g: clamp(16px, 4vw, 64px); --sec: clamp(96px, 12vw, 200px);
    --slow: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Onest m', system-ui, sans-serif; font-weight: 400; color: var(--ink); background: var(--paper);
    font-size: 17px; line-height: 1.6;
  }
  .mono :global(:is(h1, h2, h3)) { font-family: 'Onest m', system-ui, sans-serif; font-weight: 300; letter-spacing: -0.045em; line-height: 1; hyphens: manual; -webkit-hyphens: manual; }
  .mono a { text-decoration: none; }
  .m-cap { font-size: 0.82rem; font-weight: 500; letter-spacing: 0.01em; color: var(--mut); }
  .m-mut { color: var(--mut); }

  /* ---------- Шапка ---------- */
  .m-top { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: clamp(16px, 3vw, 44px); height: 68px; padding-inline: var(--g); background: rgb(243 242 239 / 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .m-logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 0.98rem; letter-spacing: 0.34em; margin-right: auto; }
  .m-logo :global(svg) { width: 13px; height: 12px; }
  .m-nav { display: none; gap: 32px; font-size: 0.95rem; }
  .m-nav a, .m-tel { position: relative; }
  .m-nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.5s var(--slow); }
  .m-nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .m-tel { display: none; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .m-cta { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 18px; border: 1px solid var(--ink); font-size: 0.92rem; font-weight: 500; transition: background-color 0.4s var(--slow), color 0.4s var(--slow); }
  .m-cta:hover { background: var(--ink); color: var(--paper); }
  .m-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5722; flex: none; }
  .m-cta-l { display: none; }
  @media (min-width: 720px) { .m-cta-l { display: inline; } .m-cta-s { display: none; } }
  @media (min-width: 1060px) { .m-nav { display: flex; } .m-logo { margin-right: 0; } .m-nav { margin-right: auto; margin-left: 24px; } }
  @media (min-width: 1240px) { .m-tel { display: inline; } }

  /* ---------- Первый экран ---------- */
  .m-hero { padding-top: clamp(40px, 6vw, 72px); }
  .m-hero-text { padding-inline: var(--g); display: grid; gap: 24px; }
  .m-hero h1 { font-size: clamp(3.4rem, 0.6rem + 9.6vw, 10.4rem); line-height: 0.92; letter-spacing: -0.06em; font-weight: 300; margin-left: -0.05em; }
  .m-hero h1 .ln { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .m-hero h1 .ln > span { display: block; }
  .m-hero-side { display: grid; gap: 28px; max-width: 520px; }
  .m-hero-side > p { font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem); line-height: 1.5; text-wrap: pretty; }
  .m-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .m-hero-fig { margin: clamp(40px, 5vw, 64px) 0 0; }
  .m-hero-ph { overflow: hidden; aspect-ratio: 4 / 5; background: #d9d8d4; }
  .m-hero-ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 78%; filter: grayscale(1) contrast(1.06) brightness(1.02); }
  .m-hero-fig figcaption, .m-ph + figcaption { display: flex; justify-content: space-between; gap: 16px; padding: 14px var(--g) 0; font-size: 0.82rem; color: var(--mut); }
  @media (min-width: 960px) {
    .m-hero-text { grid-template-columns: 1fr minmax(320px, 420px); align-items: end; column-gap: 48px; }
    .m-hero-text .m-cap { grid-column: 1 / -1; }
    .m-hero-side { padding-bottom: 1.2rem; }
    .m-hero-ph { aspect-ratio: auto; height: clamp(460px, 74vh, 900px); }
  }

  /* кнопки и ссылки */
  .m-btn { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 22px 0 24px; background: var(--ink); color: var(--paper); font-weight: 500; font-size: 0.98rem; transition: background-color 0.4s var(--slow), transform 0.2s ease; }
  .m-btn :global(svg) { width: 17px; height: 12px; transition: transform 0.5s var(--slow); }
  .m-btn:hover { background: #000; }
  .m-btn:hover :global(svg) { transform: translateX(6px); }
  .m-btn:active { transform: scale(0.97); }
  .m-btn-wide { width: 100%; }
