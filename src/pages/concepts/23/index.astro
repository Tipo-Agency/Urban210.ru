---
// Концепция 23 «Польская школа»: польский плакат 60-х (Леница, Томашевский, Свежи).
// Плоские поля цвета, вырезанная бумага, кисть, фото как коллаж с рваным краем, рукописные заголовки.
// Метафоры: блин штанги вместо солнца («раньше солнца», клуб открыт с 6:30), шевроны логотипа летят птицами,
// тарифы показаны временем суток: солнце, солнце и луна, солнце, луна и пар.
// Движение: плакаты ложатся на место при прокрутке, лучи солнца медленно вращаются, птицы парят. Всё выключается при reduced motion.
import delaCyr from '@fontsource/dela-gothic-one/files/dela-gothic-one-cyrillic-400-normal.woff2?url';
import delaLat from '@fontsource/dela-gothic-one/files/dela-gothic-one-latin-400-normal.woff2?url';
import corCyrI from '@fontsource-variable/cormorant/files/cormorant-cyrillic-wght-italic.woff2?url';
import corLatI from '@fontsource-variable/cormorant/files/cormorant-latin-wght-italic.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, reasons, programs } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (fam: string, style: string, w: string, url: string, range: string) => `@font-face{font-family:'${fam}';font-style:${style};font-display:swap;font-weight:${w};src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = [
  ff('Dela Gothic One', 'normal', '400', delaCyr, UR), ff('Dela Gothic One', 'normal', '400', delaLat, UL),
  ff('Cormorant Variable', 'italic', '300 700', corCyrI, UR), ff('Cormorant Variable', 'italic', '300 700', corLatI, UL),
].join('');

// Рваный край бумаги: детерминированный «шум» по периметру, чтобы край был одинаковым при каждой сборке
const rnd = (seed: number) => () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const torn = (seed: number, j = 2.2, steps = 14, sides = 'trbl') => {
  const r = rnd(seed);
  const pts: string[] = [];
  const k = (v: number) => (v * j).toFixed(2);
  for (let i = 0; i <= steps; i++) pts.push(`${(i / steps * 100).toFixed(1)}% ${sides.includes('t') ? k(r()) : 0}%`);
  for (let i = 1; i <= steps; i++) pts.push(`${sides.includes('r') ? (100 - +k(r())).toFixed(2) : 100}% ${(i / steps * 100).toFixed(1)}%`);
  for (let i = steps - 1; i >= 0; i--) pts.push(`${(i / steps * 100).toFixed(1)}% ${sides.includes('b') ? (100 - +k(r())).toFixed(2) : 100}%`);
  for (let i = steps - 1; i > 0; i--) pts.push(`${sides.includes('l') ? k(r()) : 0}% ${(i / steps * 100).toFixed(1)}%`);
  return `clip-path:polygon(${pts.join(',')})`;
};
// Лучи солнца как мазки кисти: сужаются к концу, длина гуляет
const rays = (() => {
  const r = rnd(7);
  const out: string[] = [];
  const n = 16;
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2 + (r() - 0.5) * 0.08;
    const r1 = 162, r2 = 214 + r() * 34, w1 = 9 + r() * 4, w2 = 2;
    const p = (rad: number, off: number) => {
      const x = 250 + Math.cos(a) * rad - Math.sin(a) * off;
      const y = 250 + Math.sin(a) * rad + Math.cos(a) * off;
      return `${x.toFixed(1)} ${y.toFixed(1)}`;
    };
    out.push(`M${p(r1, -w1)} Q${p((r1 + r2) / 2, -w1 * 0.9 + 3)} ${p(r2, -w2)} L${p(r2 + 4, 0)} L${p(r2, w2)} Q${p((r1 + r2) / 2, w1 * 0.8)} ${p(r1, w1)} Z`);
  }
  return out.join(' ');
})();

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const [trialPromo, tradein, friend] = [promos.find((p) => p.slug === '1-rubl')!, promos.find((p) => p.slug === 'trade-in')!, promos.find((p) => p.slug === '1-plus-1')!];
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const planSkin = ['paper', 'orange', 'green'];
const planWord = ['солнце', 'солнце и луна', 'солнце, луна и пар'];
const tags = programs.flatMap((p) => p.items);
const blobs = ['62% 38% 55% 45% / 48% 60% 40% 52%', '45% 55% 40% 60% / 60% 42% 58% 40%', '55% 45% 62% 38% / 40% 55% 45% 60%', '40% 60% 50% 50% / 55% 45% 55% 45%'];
---
<Layout title="Концепция 23 «Польская школа»" description="Концепция дизайна сайта Urban210: польская школа плаката, вырезанная бумага, кисть и коллаж, клуб открывается раньше солнца." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={delaCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>
  <div class="pk">
    <!-- Фильтры «руки»: неровный край у букв и бумажных форм -->
    <svg class="pk-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="pk-hand" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="4" /></filter>
      <filter id="pk-paper" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.022" numOctaves="3" seed="9" /><feDisplacementMap in="SourceGraphic" scale="9" /></filter>
      <symbol id="pk-bird" viewBox="0 0 16 10"><path d="M0 0h3.6L8 5.4 12.4 0H16L8 10z" /></symbol>
    </svg>

    <header class="pk-top">
      <div class="pk-w pk-top-in">
        <a class="pk-logo" href="/concepts/23/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="pk-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="pk-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="pk-btn pk-btn-s" href="#zayavka" data-lead={trial.title} data-block="23_header"><span>Пробный<span class="pk-hide-s">&nbsp;день</span>&nbsp;за&nbsp;1&nbsp;₽</span></a>
      </div>
    </header>

    <!-- Первый экран: плакат «Раньше солнца» -->
    <section class="pk-hero" aria-labelledby="pk-h1">
      <div class="pk-w pk-hero-g">
        <div class="pk-hero-tx">
          <p class="pk-poet">Хабаровск, Железнодорожный район</p>
          <h1 id="pk-h1" class="pk-h1">
            <span class="l">Раньше</span>
            <span class="l l2">солнца<svg class="pk-swash" viewBox="0 0 400 34" preserveAspectRatio="none" aria-hidden="true"><path d="M4 22C70 9 190 4 396 12l-2 9C230 15 100 20 8 31z" /></svg></span>
          </h1>
          <p class="pk-lead">Urban210 открывается в&nbsp;6:30 по будням и в&nbsp;7:30 по выходным. Зал, кардио, групповые и SPA. Первый день за&nbsp;1&nbsp;₽, вступительного взноса нет.</p>
          <div class="pk-cta">
            <a class="pk-btn" href="#zayavka" data-lead={trial.title} data-block="23_hero">Записаться за 1 ₽<Icon name="chev" /></a>
            <a class="pk-link" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>

        <div class="pk-poster" aria-hidden="true">
          <svg class="pp-sun" viewBox="0 0 500 500">
            <path class="pp-rays" d={rays} />
            <circle cx="250" cy="250" r="150" class="pp-plate" />
            <circle cx="250" cy="250" r="118" class="pp-rim" />
            <circle cx="250" cy="250" r="30" class="pp-hole" />
            <defs><path id="pk-ring" d="M250 250m-134 0a134 134 0 1 1 268 0a134 134 0 1 1 -268 0" /></defs>
            <text class="pp-ringtx"><textPath href="#pk-ring" startOffset="3%">URBAN210 · Пн–Пт с 6:30</textPath></text>
          </svg>
          <div class="pp-ground" style={torn(11, 3.2, 18, 't')}>
            <Image src={img('/images/zal.jpg')} alt="" widths={[480, 640, 900]} sizes="(min-width: 1000px) 40vw, 92vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
          </div>
          <span class="pp-hill" style={torn(5, 6, 10, 't')}></span>
          <svg class="pp-birds" viewBox="0 0 300 160">
            <use href="#pk-bird" x="20" y="40" width="34" height="22" class="b b1" />
            <use href="#pk-bird" x="80" y="18" width="24" height="15" class="b b2" />
            <use href="#pk-bird" x="120" y="58" width="18" height="11" class="b b3" />
            <use href="#pk-bird" x="200" y="30" width="28" height="18" class="b b4" />
            <use href="#pk-bird" x="250" y="74" width="16" height="10" class="b b5" />
          </svg>
          <span class="pp-letter">6:30</span>
          <span class="pp-sign">URBAN210<Icon name="chev" /></span>
        </div>
      </div>
    </section>

    <!-- Четыре простые вещи -->
    <section class="pk-sec pk-why" aria-labelledby="pk-why-h">
      <div class="pk-w" data-m>
        <h2 id="pk-why-h" class="pk-h2" data-s style="--x:-30px;--r:-2deg">Четыре простые вещи</h2>
        <p class="pk-poet pk-why-poet" data-s style="--d:120ms">из-за которых в зал хочется вернуться</p>
        <ol class="pk-reasons">
          {reasons.map((r, i) => (
            <li data-s style={`--y:40px;--r:${i % 2 ? 3 : -3}deg;--d:${i * 90}ms`}>
              <span class={`rs rs-${i}`} style={`border-radius:${blobs[i]}`} aria-hidden="true"></span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Зоны: выставка плакатов -->
    <section class="pk-sec pk-zones-s" id="zony" aria-labelledby="pk-zones-h">
      <div class="pk-w">
        <div class="pk-head" data-m>
          <h2 id="pk-zones-h" class="pk-h2" data-s style="--x:-30px;--r:-2deg">Четыре зоны, четыре плаката</h2>
          <p class="pk-note" data-s style="--d:120ms">{cap(site.facts.area)}, {site.facts.machines} {site.facts.brands}, {site.facts.freeWeights}.</p>
        </div>
        <div class="pk-zones">
          <a class="pz pz-zal" href={z.zal.href} data-m>
            <div class="pz-art" aria-hidden="true">
              <span class="pz-sun" data-s style="--y:60px;--s:.5"></span>
              <div class="pz-photo" style={torn(21, 2.6, 12)} data-s >
                <Image src={img('/images/free-weights.jpg')} alt="" widths={[360, 560, 720]} sizes="(min-width: 1000px) 24vw, 86vw" loading="lazy" format="avif" quality={45} />
              </div>
            </div>
            <div class="pz-tx">
              <h3>{z.zal.title}</h3>
              <p>{cap(z.zal.text)}</p>
            </div>
            <span class="pz-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="pz pz-cardio" href={z.cardio.href} data-m>
            <div class="pz-art" aria-hidden="true">
              <svg class="pz-road" viewBox="0 0 300 200" preserveAspectRatio="none" data-s style="--y:40px"><path d="M120 0h60l120 200H0z" /><path class="dash" d="M150 10v180" /></svg>
              <div class="pz-photo pz-round" data-s style="--s:.6;--d:120ms">
                <Image src={img('/images/cardio.jpg')} alt="" widths={[360, 560]} sizes="(min-width: 1000px) 18vw, 60vw" loading="lazy" format="avif" quality={45} />
              </div>
            </div>
            <div class="pz-tx">
              <h3>{z.cardio.title}</h3>
              <p>{z.cardio.text}</p>
            </div>
            <span class="pz-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="pz pz-group" href={z.group.href} data-m>
            <div class="pz-art" aria-hidden="true">
              <div class="pz-photo" style={torn(33, 2.4, 12)} data-s>
                <Image src={img('/images/group.jpg')} alt="" widths={[360, 560, 720]} sizes="(min-width: 1000px) 24vw, 86vw" loading="lazy" format="avif" quality={45} />
              </div>
              <svg class="pz-notes" viewBox="0 0 120 90" data-s style="--y:-30px;--r:-12deg;--d:160ms"><circle cx="20" cy="70" r="12" /><circle cx="78" cy="60" r="12" /><path d="M29 70V12l60-10v58h-4V8L33 17v53z" /></svg>
            </div>
            <div class="pz-tx">
              <h3>{z.group.title}</h3>
              <p>{cap(z.group.text)}</p>
              <ul class="pz-tags">{tags.map((t) => <li>{t}</li>)}</ul>
            </div>
            <span class="pz-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
          <a class="pz pz-spa" href={z.spa.href} data-m>
            <div class="pz-art" aria-hidden="true">
              <span class="pz-moon" data-s style="--x:40px;--y:-40px;--r:-30deg"><svg viewBox="144 24 72 72"><path d="M178 28a32 32 0 1 0 30 46a26 26 0 1 1 -30 -46z" /></svg></span>
              <svg class="pz-steam" viewBox="0 0 200 160" data-s style="--y:40px;--d:140ms"><path d="M40 160c-30-30 30-50 0-80s30-50 10-80" /><path d="M100 160c-30-30 30-50 0-80s30-50 10-80" /><path d="M160 160c-30-30 30-50 0-80s30-50 10-80" /></svg>
            </div>
            <div class="pz-tx">
              <h3>{z.spa.title}</h3>
              <p>{z.spa.text}</p>
              <p class="pz-note">В тарифе «{plans[2].name}»</p>
            </div>
            <span class="pz-go" aria-hidden="true"><Icon name="chev" /></span>
          </a>
        </div>
      </div>
    </section>

    <!-- Тарифы по солнцу -->
    <section class="pk-sec pk-prices" id="tarify" aria-labelledby="pk-price-h">
      <div class="pk-w">
        <div class="pk-head" data-m>
          <h2 id="pk-price-h" class="pk-h2" data-s style="--x:-30px;--r:-2deg">Абонемент по солнцу</h2>
          <p class="pk-note" data-s style="--d:120ms">Дневная карта до 16:00, полный день до закрытия, всё включено с группами и SPA. Вступительного взноса нет.</p>
        </div>
        <div class="pk-plans" data-m>
          {plans.map((p, i) => (
            <article class={`pc pc-${planSkin[i]}`} data-s style={`--y:70px;--r:${(i - 1) * 3}deg;--d:${i * 110}ms`}>
              <div class="pc-sky" aria-hidden="true">
                <svg viewBox="0 0 240 110">
                  <g class="pc-sun"><circle cx={i === 0 ? 120 : 70} cy="58" r="30" /><path d="M0 0" /></g>
                  {i > 0 && <path class="pc-moon" d="M178 28a32 32 0 1 0 30 46a26 26 0 1 1 -30 -46z" />}
                  {i > 1 && <path class="pc-steam" d="M108 104c-14-14 14-22 0-36s14-22 4-36M132 104c-14-14 14-22 0-36s14-22 4-36" />}
                </svg>
                <span class="pc-word">{planWord[i]}</span>
              </div>
              {p.tag && <span class="pc-tag" style={`border-radius:${blobs[i + 1]}`}>{p.tag}</span>}
              <h3>{p.name}</h3>
              <p class="pc-h">{cap(p.hours)}</p>
              <p class="pc-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="pc-year">За год {rub(p.year)}, это {perDay(p.year, 365)} ₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="pk-btn pk-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`23_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="pk-trial" data-m>
          <div class="tr-art" aria-hidden="true">
            <span class="tr-coin" data-s style="--y:-120px;--r:-40deg;--s:.6"><b>1</b><i>₽</i></span>
            <svg class="tr-birds" viewBox="0 0 200 120" data-s style="--x:-80px;--y:40px;--d:200ms">
              <use href="#pk-bird" x="10" y="60" width="44" height="28" />
              <use href="#pk-bird" x="80" y="20" width="30" height="19" />
              <use href="#pk-bird" x="140" y="70" width="24" height="15" />
            </svg>
          </div>
          <div class="tr-tx" data-s style="--y:40px;--d:160ms">
            <p class="pk-poet">одна монета, один день</p>
            <h3>Пробный день</h3>
            <p>{trial.text}</p>
            <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
            <a class="pk-btn pk-btn-ink" href="#zayavka" data-lead={trial.title} data-block="23_trial">{trialPromo.cta}<Icon name="chev" /></a>
          </div>
        </div>

        <div class="pk-offers">
          {[tradein, friend].map((pr, i) => (
            <article class={`po po-${i}`} data-m>
              <div data-s style={`--y:30px;--r:${i ? 2 : -2}deg`}>
                <h3>{pr.title}</h3>
                <p>{pr.text}</p>
                <a class="pk-link" href="#zayavka" data-lead={pr.goal} data-block={`23_promo_${pr.slug}`}>{pr.cta}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Тренеры -->
    <section class="pk-sec pk-team" id="trenery" aria-labelledby="pk-team-h">
      <div class="pk-w">
        <div class="pk-head" data-m>
          <h2 id="pk-team-h" class="pk-h2" data-s style="--x:-30px;--r:-2deg">Кто встретит в зале</h2>
          <p class="pk-note" data-s style="--d:120ms">Тренеры покажут тренажёры, поставят технику и помогут составить первую программу.</p>
        </div>
        <div class="pk-coaches">
          {trainers.map((t, i) => (
            <figure class={`pt pt-${i}`} data-m>
              <span class="pt-blob" style={`border-radius:${blobs[i]}`} data-s aria-hidden="true"></span>
              <div class="pt-img" style={torn(40 + i * 7, 2.4, 10)} data-s>
                <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 900px) 26vw, 76vw" loading="lazy" format="avif" quality={50} />
              </div>
              <figcaption data-s><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="pk-personal" data-m>
          <div data-s style="--x:-30px">
            <p class="pk-poet">персональные тренировки</p>
            <p class="ps-p">{personalLine}</p>
            <p class="ps-t">{personal.firstFree}. Тренер поставит технику, составит программу под вашу цель и будет следить за прогрессом.</p>
          </div>
          <a class="pk-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="23_personal" data-s style="--x:30px;--d:120ms">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="pk-sec pk-rev" id="otzyvy" aria-labelledby="pk-rev-h">
      <div class="pk-w">
        <div class="pk-rev-head" data-m>
          <h2 id="pk-rev-h" class="pk-h2" data-s style="--x:-30px;--r:-2deg">Что пишут гости</h2>
          <a class="pk-score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-s style="--r:-40deg;--s:.5;--d:120ms">
            <span class="sc-sun" aria-hidden="true"><svg viewBox="0 0 500 500"><path d={rays} /></svg></span>
            <b>{rating}</b>
            <span class="sc-tx">из 5 на Яндекс Картах, {site.rating.text}</span>
          </a>
        </div>
        <div class="pk-bubbles" data-m>
          {reviews.map((r, i) => (
            <blockquote class={`pb pb-${i}`} data-s style={`--y:40px;--r:${i % 2 ? 2 : -2}deg;--d:${i * 90}ms`}>
