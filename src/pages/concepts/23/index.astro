<script>
  // Плакаты ложатся на место, когда группа попадает в экран. Один раз.
  const root = document.querySelector('.pk');
  const groups = document.querySelectorAll<HTMLElement>('.pk [data-m]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root) requestAnimationFrame(() => root.classList.add('is-ready'));
  if (reduce || !('IntersectionObserver' in window)) groups.forEach((g) => g.classList.add('on'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    groups.forEach((g) => io.observe(g));
  }
</script>

