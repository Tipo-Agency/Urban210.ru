---
// Концепция 03 «Ночь»: тёмный премиальный клуб. Почти чёрный синий графит, холодные световые трубки
// (двойной шеврон » из логотипа, как светильники на потолке зала), Cormorant светлым начертанием и Manrope.
// Движение: трубки загораются с мерцанием, как лампы при включении; линии-разделители прочерчиваются светом.
import '@fontsource-variable/cormorant/wght.css';
import '@fontsource-variable/cormorant/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs } from '../../../data/content';
import heroImg from '../../../assets/images/hero.jpg';

const dayCard = plans[0];
const fromDay = perDay(dayCard.month, 30);
const weekday = site.hours[0];
const weekend = site.hours[1];
const rating = site.rating.value.toString().replace('.', ',');
const stats = [
  { n: '1300', u: 'м²', l: 'площадь клуба' },
  { n: '60+', u: '', l: `тренажёров ${site.facts.brands}` },
  { n: '150', u: 'м²', l: 'зал групповых программ' },
  { n: '60', u: 'кг', l: 'свободные веса, до' },
];
const zoneList = zones.map((z) => ({ ...z, img: z.image ? img(z.image) : null }));
const classes = programs.flatMap((p) => p.items);
const quotes = reviews.slice(0, 3).map((r) => ({ ...r, short: r.text.split('. ').slice(0, 2).join('. ').replace(/\.?$/, '.') }));
const trainerPhotos = trainers.map((t) => ({ ...t, img: img(t.photo) }));

// Потолок из световых трубок: ряды шевронов, дальние ряды меньше и тусклее
const ceiling = [
  { y: 0, s: 1, n: 5 },
  { y: 30, s: 0.7, n: 6 },
  { y: 52, s: 0.5, n: 7 },
  { y: 68, s: 0.36, n: 8 },
];
---
<Layout title="Концепция 03 «Ночь»" description="Концепция дизайна сайта Urban210: тёмный премиальный клуб со световыми линиями." noindex bare>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="n3-tube" viewBox="-12 -12 124 88">
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="#6eb9ff" stroke-width="16" opacity="0.08" d="M6 4 38 32 6 60M44 4 76 32 44 60" />
          <path stroke="#6eb9ff" stroke-width="6" opacity="0.34" d="M6 4 38 32 6 60M44 4 76 32 44 60" />
          <path stroke="#f2fbff" stroke-width="2.4" d="M6 4 38 32 6 60M44 4 76 32 44 60" />
        </g>
      </symbol>
    </defs>
  </svg>

  <div class="n3">
    <header class="n3-top">
      <a class="n3-logo" href="/concepts/03/" aria-label="Urban210, на главную">URBAN<b>210</b><Icon name="chev" /></a>
      <nav class="n3-nav" aria-label="Меню">
        <a href="#zones">Пространство</a>
        <a href="#price">Членство</a>
        <a href="#team">Тренеры</a>
        <a href="#reviews">Отзывы</a>
        <a href="#visit">Контакты</a>
      </nav>
      <a class="n3-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="n3-btn n3-btn-sm" href="#price" data-block="n3_header">Выбрать карту</a>
    </header>

    <!-- Первый экран -->
    <section class="n3-hero" aria-labelledby="n3-h">
      <div class="n3-media">
        <Image src={heroImg} alt="" widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
        <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
        <span class="n3-tint" aria-hidden="true"></span>
      </div>

      <div class="n3-ceiling" aria-hidden="true">
        {ceiling.map((row, r) => (
          <div class="n3-row" style={`--y:${row.y}%;--s:${row.s};--n:${row.n}`}>
            {Array.from({ length: row.n }).map((_, i) => (
              <svg class="n3-t" style={`--d:${(r * 0.18 + ((i * 7 + r * 3) % 5) * 0.16).toFixed(2)}s`} viewBox="-12 -12 124 88"><use href="#n3-tube" /></svg>
            ))}
          </div>
        ))}
      </div>

      <div class="n3-hero-in">
        <p class="n3-kick">Фитнес-клуб в Хабаровске</p>
        <h1 id="n3-h">Свет в зале<br />горит <em>до&nbsp;23:30</em></h1>
        <div class="n3-hero-row">
          <p class="n3-hero-p">По будням с 06:30, в выходные до 22:30. Тренажёрный зал {site.facts.area}, групповые программы и SPA с хаммамом. Дневная карта от {fromDay}&nbsp;₽ в день.</p>
          <div class="n3-hero-cta">
            <a class="n3-btn" href="#price" data-block="n3_hero">Выбрать карту<Icon name="chev" /></a>
            <a class="n3-ghost" href="#price">Членство от {rub(plans[0].month)}</a>
          </div>
        </div>
      </div>

      <ul class="n3-facts" aria-label="Коротко о клубе">
        <li><b>{rating}</b><span>Яндекс Карты · {site.rating.text}</span></li>
        <li><b>{weekday.time}</b><span>{weekday.days}</span></li>
        <li><b>{weekend.time}</b><span>{weekend.days}</span></li>
        <li><b>50</b><span>мест на бесплатной парковке</span></li>
      </ul>
    </section>

    <!-- Манифест и цифры -->
    <section class="n3-sec n3-intro" aria-labelledby="n3-i">
      <div class="n3-wrap">
        <h2 id="n3-i" class="n3-statement" data-rise>Один клуб у дома вместо сети. Большой зал без очередей к&nbsp;тренажёрам, парковка у входа и <em>вечер, который остаётся вашим.</em></h2>
        <hr class="n3-rule" data-rise />
        <ul class="n3-stats">
          {stats.map((s) => <li><b>{s.n}<small>{s.u}</small></b><span>{s.l}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- Зоны -->
    <section class="n3-sec n3-zones-sec" id="zones" aria-labelledby="n3-z">
      <div class="n3-wrap">
        <div class="n3-head">
          <h2 id="n3-z">Пространство</h2>
          <p>Четыре зоны в одном клубе. Каждая со своим светом и темпом.</p>
        </div>
        <ul class="n3-zones">
          {zoneList.map((z) => (
            <li class:list={['n3-zone', `z-${z.id}`]}>
              <a href={z.href}>
                {z.img ? (
                  <span class="n3-ph"><Image src={z.img} alt="" widths={[480, 800, 1200]} sizes="(min-width: 980px) 50vw, 100vw" format="avif" quality={45} /></span>
                ) : (
                  <span class="n3-spa" aria-hidden="true">
                    <svg viewBox="0 0 200 200"><circle class="c1" cx="100" cy="100" r="78" /><circle class="c2" cx="100" cy="100" r="54" /><circle class="c3" cx="100" cy="100" r="30" /></svg>
                  </span>
                )}
                <span class="n3-zone-txt">
                  <span class="n3-zone-t">{z.title}</span>
                  <span class="n3-zone-d">{z.text}</span>
                </span>
                <Icon name="chev" class="n3-zone-i" />
              </a>
            </li>
          ))}
        </ul>
        <div class="n3-classes">
          <p>Групповые программы</p>
          <ul>{classes.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- Членство -->
    <section class="n3-sec n3-price" id="price" aria-labelledby="n3-p">
      <div class="n3-wrap">
        <div class="n3-head">
          <h2 id="n3-p">Членство</h2>
          <p>Безлимит в выбранное время, при оплате за год дешевле.</p>
        </div>
        <div class="n3-plans">
          {plans.map((p) => (
            <article class:list={['n3-plan', p.id === 'full' && 'is-lit']}>
              <header>
                <h3>{p.name}</h3>
                {p.tag && <span class="n3-tag">{p.tag}</span>}
              </header>
              <p class="n3-hours">{p.hours}</p>
              <p class="n3-amount"><b>{p.month.toLocaleString('ru-RU').replace(/\s/g, '\u00a0')}</b><span>₽ в месяц</span></p>
              <p class="n3-alt">{rub(p.year)} за год · {perDay(p.month, 30)} ₽ в день</p>
              <ul class="n3-inc">
                {p.features.map((f) => <li>{f}</li>)}
                {p.excluded?.map((f) => <li class="off">{f}</li>)}
              </ul>
              <a class:list={['n3-btn', p.id !== 'full' && 'is-line']} href="#visit" data-lead={p.name} data-block={`n3_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="n3-offer" data-rise>
          <p class="n3-neon" aria-hidden="true">{fromDay}<span>₽</span></p>
          <div>
            <h3>От {fromDay}&nbsp;₽ в день</h3>
            <p>{dayCard.name}: {rub(dayCard.month)} в месяц. Зал и кардиозона {dayCard.hours}.</p>
            <a class="n3-btn" href="#visit" data-lead="Заявка с сайта" data-block="n3_offer">Оставить заявку<Icon name="chev" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Тренеры -->
    <section class="n3-sec" id="team" aria-labelledby="n3-t">
      <div class="n3-wrap">
        <div class="n3-head">
          <h2 id="n3-t">Тренеры</h2>
          <p>Поставят технику и соберут программу под вашу цель. {personal.pack} персональных тренировок за {rub(personal.price)}, первая бесплатно при покупке подписки.</p>
        </div>
        <ul class="n3-team">
          {trainerPhotos.map((t) => (
            <li>
              <span class="n3-ph n3-ph-sq"><Image src={t.img} alt={t.name} widths={[400, 700]} sizes="(min-width: 980px) 30vw, 90vw" format="avif" quality={50} /></span>
              <h3>{t.name}</h3>
              <p>{t.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="n3-sec n3-reviews" id="reviews" aria-labelledby="n3-r">
      <div class="n3-wrap">
        <div class="n3-score">
          <p class="n3-score-n" aria-hidden="true">{rating}</p>
          <div>
            <h2 id="n3-r">Рейтинг {rating} из 5</h2>
            <p>{site.rating.text} на Яндекс Картах и в 2ГИС. <a href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать все</a></p>
          </div>
        </div>
        <div class="n3-quotes">
          {quotes.map((q) => (
            <figure>
              <blockquote>«{q.short}»</blockquote>
              <figcaption>{q.name} · {q.source}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="n3-sec n3-visit" id="visit" aria-labelledby="n3-v">
      <div class="n3-wrap n3-visit-in">
        <div class="n3-visit-txt">
          <h2 id="n3-v">Приходите <em>вечером</em></h2>
          <p class="n3-visit-p">Оставьте телефон, администратор перезвонит и подберёт время. Покажем зал, раздевалки и SPA, тренер поможет с первой программой.</p>
          <dl class="n3-info">
            <div><dt>Адрес</dt><dd>{site.address.short}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{weekday.days} {weekday.time}<br />{weekend.days} {weekend.time}</dd></div>
            <div><dt>Парковка</dt><dd>{site.parking}</dd></div>
            <div><dt>Связь</dt><dd><a href={site.phone.href}>{site.phone.display}</a><br /><a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener">WhatsApp</a> · <a href={telegramLink('n3_visit')} target="_blank" rel="noopener">Telegram</a></dd></div>
          </dl>
        </div>
        <div class="n3-form">
          <LeadForm id="n3" block="n3_final" />
        </div>
      </div>
    </section>

    <footer class="n3-foot">
      <div class="n3-wrap">
        <p class="n3-big" aria-hidden="true">URBAN<b>210</b><Icon name="chev" /></p>
        <div class="n3-foot-row">
          <p>{site.address.locality}, {site.address.street}</p>
          <nav aria-label="Разделы">
            <a href="/price/">Тарифы</a><a href="/zal/">Зал</a><a href="/group/">Групповые</a><a href="/spa/">SPA</a><a href="/trainers/">Тренеры</a><a href="/contacts/">Контакты</a>
          </nav>
          <p><a href={site.instagram} target="_blank" rel="noopener">Instagram</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <p class="n3-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn} · <a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Договор-оферта</a></p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  body:has(.n3) {
    --bg: #05070c; --card: #0c111c; --raise: #121a29; --ink: #e9eef7; --muted: #8f9bb0;
    --line: rgb(175 205 255 / 0.14); --accent: #d9f0ff; --accent-ink: #06101c;
    background: #05070c; color: #e9eef7;
    font-family: 'Manrope Variable', system-ui, sans-serif;
  }
  body:has(.n3) ::selection { background: #bfe6ff; color: #06101c; }
  body:has(.n3) :focus-visible { outline-color: #9fd6ff; }
  body:has(.n3) .mbar { background: rgb(5 7 12 / 0.9); }
  body:has(.n3) .mbar .btn, body:has(.n3) dialog.lead .btn { background: #e3f3ff; color: #06101c; border-radius: 999px; box-shadow: 0 0 24px rgb(110 185 255 / 0.35); }
  body:has(.n3) .mbar a.ic { border-radius: 999px; }
  body:has(.n3) dialog.lead .form { background: #0a0f1a; border-radius: 20px; }
  /* метрики запасного шрифта подогнаны под Cormorant, чтобы заголовок не прыгал при загрузке */
  @font-face { font-family: 'Cormorant Fallback'; src: local('Times New Roman'), local('Times'); size-adjust: 89%; ascent-override: 103%; descent-override: 32%; line-gap-override: 0%; }
  body:has(.n3) dialog.lead h3 { font-family: 'Cormorant Variable', serif; font-weight: 400; font-size: 2rem; letter-spacing: -0.01em; }
  body:has(.n3) dialog.lead .field input { border-radius: 12px; }
  body:has(.n3) .form-done .ok { background: #d9f0ff; box-shadow: 0 0 30px rgb(110 185 255 / 0.5); }
</style>

<style>
  .n3 {
    --neon: #c9ebff;
    --glow: 110 185 255;
    --bg2: #080c15;
    --panel: #0b101b;
    --ink: #e9eef7;
    --mut: #8f9bb0;
    --line: rgb(175 205 255 / 0.13);
    --serif: 'Cormorant Variable', 'Cormorant Fallback', serif;
    --sans: 'Manrope Variable', system-ui, sans-serif;
    --w: 1320px;
    --g: clamp(16px, 4vw, 56px);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
    overflow-x: clip;
  }
  .n3 :global(h1), .n3 :global(h2), .n3 :global(h3) { font-family: var(--serif); font-weight: 300; letter-spacing: -0.015em; line-height: 1; }
  .n3 :global(em) { font-style: italic; font-weight: 300; color: var(--neon); }
  .n3-wrap { max-width: var(--w); margin-inline: auto; padding-inline: var(--g); }
  .n3-sec { padding-block: clamp(88px, 11vw, 168px); position: relative; }

  /* ---------- Кнопки ---------- */
  .n3-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    min-height: 52px; padding: 0 24px 0 28px; border-radius: 999px;
    background: #e3f3ff; color: #06101c; text-decoration: none;
    font: 650 0.95rem/1 var(--sans); letter-spacing: 0.01em; white-space: nowrap;
    box-shadow: 0 0 0 1px rgb(201 235 255 / 0.6), 0 0 28px rgb(var(--glow) / 0.32), 0 0 80px rgb(var(--glow) / 0.12);
    transition: box-shadow 0.3s var(--ease), transform 0.2s var(--ease), background-color 0.3s var(--ease);
  }
  .n3-btn :global(svg) { width: 17px; height: 12px; transition: transform 0.3s var(--ease); }
  .n3-btn:hover { background: #fff; box-shadow: 0 0 0 1px #fff, 0 0 36px rgb(var(--glow) / 0.55), 0 0 110px rgb(var(--glow) / 0.22); }
  .n3-btn:hover :global(svg) { transform: translateX(4px); }
  .n3-btn:active { transform: scale(0.96); }
  .n3-btn.is-line { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px rgb(201 235 255 / 0.35); }
  .n3-btn.is-line:hover { box-shadow: inset 0 0 0 1px var(--neon), 0 0 24px rgb(var(--glow) / 0.3); }
  .n3-btn-sm { min-height: 42px; padding: 0 18px; font-size: 0.85rem; }
  .n3-ghost { color: var(--ink); font-weight: 600; font-size: 0.95rem; text-decoration: none; padding-block: 12px; border-bottom: 1px solid rgb(201 235 255 / 0.35); transition: border-color 0.3s; }
  .n3-ghost:hover { border-color: var(--neon); }

  /* ---------- Шапка ---------- */
  .n3-top {
    position: fixed; z-index: 30; inset: 0 0 auto; display: flex; align-items: center; gap: 28px;
    height: 72px; padding-inline: var(--g);
    background: linear-gradient(rgb(5 7 12 / 0.7), rgb(5 7 12 / 0));
    transition: background-color 0.3s;
  }
  @supports (animation-timeline: scroll()) {
    .n3-top { animation: n3-head linear both; animation-timeline: scroll(); animation-range: 0 240px; }
    @keyframes n3-head { to { background-color: rgb(5 7 12 / 0.92); box-shadow: 0 1px 0 var(--line); } }
  }
  .n3-logo { display: inline-flex; align-items: center; gap: 2px; font: 300 1.05rem/1 var(--sans); letter-spacing: 0.32em; text-decoration: none; color: var(--ink); }
  .n3-logo b { font-weight: 700; letter-spacing: 0.12em; }
  .n3-logo :global(svg) { width: 15px; height: 13px; margin-left: 8px; color: var(--neon); filter: drop-shadow(0 0 6px rgb(var(--glow) / 0.9)); }
  .n3-nav { display: none; gap: 30px; margin-left: auto; }
  .n3-nav a, .n3-tel { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; color: rgb(233 238 247 / 0.78); transition: color 0.2s; }
  .n3-nav a:hover, .n3-tel:hover { color: #fff; }
  .n3-tel { display: none; letter-spacing: 0.06em; }
  .n3-top .n3-btn { margin-left: auto; }
  @media (min-width: 1100px) {
    .n3-nav { display: flex; }
    .n3-tel { display: inline; }
    .n3-top .n3-btn { margin-left: 0; }
  }
  @media (max-width: 420px) {
    .n3-logo { letter-spacing: 0.22em; font-size: 0.95rem; }
    .n3-btn-sm { padding: 0 14px; font-size: 0.8rem; }
  }

  /* ---------- Первый экран ---------- */
  .n3-hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; overflow: hidden; isolation: isolate; }
  .n3-media { position: absolute; inset: 0; z-index: -2; }
  .n3-media :global(img), .n3-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.62) contrast(1.15); }
  .n3-media video { opacity: 0; transition: opacity 1.6s var(--ease); }
  .n3-media :global(video.is-on) { opacity: 1; }
  .n3-tint { position: absolute; inset: 0; background: #0c2a55; mix-blend-mode: color; opacity: 0.7; }
  .n3-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(70% 45% at 50% 12%, rgb(var(--glow) / 0.14), transparent 70%),
      radial-gradient(120% 70% at 50% 0%, rgb(5 7 12 / 0) 0%, rgb(5 7 12 / 0.35) 60%, rgb(5 7 12 / 0.9) 100%),
      linear-gradient(180deg, rgb(5 7 12 / 0.55) 0%, rgb(5 7 12 / 0) 30%, rgb(5 7 12 / 0.2) 55%, #05070c 100%);
  }

  .n3-ceiling { position: absolute; inset: 104px 0 auto; height: calc(40% - 104px); z-index: -1; pointer-events: none; }
  .n3-row { position: absolute; left: 50%; top: var(--y); display: flex; gap: calc(var(--s) * clamp(40px, 7vw, 120px)); transform: translateX(-50%); opacity: calc(0.35 + var(--s) * 0.65); }
  .n3-t { width: calc(var(--s) * clamp(70px, 9vw, 150px)); height: auto; flex: none; overflow: visible; }
  :global(.js) .n3-t { opacity: 0; animation: n3-on 1.6s steps(1, end) var(--d) forwards, n3-hum 6s ease-in-out calc(var(--d) + 2s) infinite; }
  @keyframes n3-on {
