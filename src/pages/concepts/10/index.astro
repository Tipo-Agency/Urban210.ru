---
// Концепция 10 «Район»: уличный зин с гордостью за Хабаровск. Бумага, ксерокс, скотч и наклейки,
// Rubik Mono One + Golos, оранжевый, чёрный и белый. Цены как объявления на столбе с отрывными язычками.
// Движение: наклейки покачиваются и отклеиваются уголком при наведении, куски коллажа слегка плывут при прокрутке.
import '@fontsource/rubik-mono-one/cyrillic-400.css';
import '@fontsource/rubik-mono-one/latin-400.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub } from '../../../data/pricing';
import { reviews, trainers, zones, programs, promos } from '../../../data/content';
import coach from '../../../assets/images/trainers/lazko-cutout.webp';

const rating = site.rating.value.toString().replace('.', ',');
const fmt = (n: number) => String(n);
const fromDay = perDay(plans[0].month, 30);
const tags = programs.flatMap((p) => p.items);
const ticker = ['Хабаровск', 'Железнодорожный район', 'пр. 60-летия Октября, 210', 'с 6:30 по будням', `от ${fromDay} ₽ в день`, 'парковка на 50 мест'];
const crew = ['/images/community/13.jpg', '/images/community/3.jpg', '/images/community/2.jpg', '/images/community/11.jpg', '/images/community/9.jpg', '/images/community/15.jpg'];
const tel = site.phone.display.replace('+7 (4212) ', '');
const tabs = Array.from({ length: 6 });
const spa = zones.find((z) => z.id === 'spa')!;
---
<Layout title="Концепция 10 «Район»" description="Концепция дизайна сайта Urban210: уличный зин про фитнес-клуб Железнодорожного района Хабаровска." noindex bare>
  <div class="rn">
    <header class="rn-top">
      <a class="rn-logo" href="/concepts/10/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
      <nav class="rn-nav" aria-label="Меню">
        <a href="#zones">Зал</a><a href="#groups">Группы</a><a href="#price">Цены</a><a href="#crew">Свои</a><a href="#come">Адрес</a>
      </nav>
      <a class="rn-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="rn-btn sm" href="#price" data-block="10_header">Выбрать карту</a>
    </header>

    <section class="rn-hero" aria-labelledby="rn-h">
      <div class="rn-hero-tx">
        <p class="rn-stamp">Хабаровск · Железнодорожный район</p>
        <h1 id="rn-h"><span>Наш</span> <span>район.</span> <span>Наш <mark>зал.</mark></span></h1>
        <p class="rn-lead">Фитнес-клуб на проспекте 60-летия Октября, 210. {site.facts.machines}, групповые, сауна и хаммам. Открываемся в 6:30, у входа бесплатная парковка на 50 машин.</p>
        <div class="rn-cta">
          <a class="rn-btn" href="#price" data-block="10_hero">Выбрать карту<Icon name="chev" /></a>
          <a class="rn-under" href="#price">от {fromDay} ₽ в день</a>
        </div>
      </div>

      <div class="rn-hero-art" aria-hidden="true">
        <div class="rn-frame rn-xerox" style="--r:2.5deg">
          <Image src={img('/images/zal.jpg')} alt="" widths={[480, 720, 960]} sizes="(min-width: 1000px) 42vw, 88vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
          <video data-hero-video data-src="/video/hero-bw.mp4" poster="/video/hero-bw-poster.jpg" muted loop playsinline preload="none"></video>
          <span class="rn-tape t1"></span><span class="rn-tape t2"></span>
        </div>
        <Image class="rn-coach" src={coach} alt="" widths={[300, 460, 620]} sizes="(min-width: 1000px) 22vw, 46vw" loading="eager" format="webp" quality={55} />
        <span class="rn-sticker rn-round" style="--r:-12deg"><b>{fromDay}<span class="rn-rub">₽</span></b>в день,<br />дневная</span>
        <span class="rn-sticker rn-rate" style="--r:4deg"><b>{rating}</b>Яндекс Карты<br />{site.rating.text}</span>
        <span class="rn-hand rn-hand-coach">Александр Лазько,<br />координатор зала</span>
        <svg class="rn-arrow a-coach" viewBox="0 0 120 90" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 10c30 2 62 12 78 38 6 10 9 20 10 32" /><path d="M82 66l14 16 10-20" /></svg>
      </div>
    </section>

    <div class="rn-tickers" aria-hidden="true">
      <div class="rn-tick b"><div>{[0, 1].map(() => ticker.map((t) => <span>{t}<Icon name="chev" /></span>))}</div></div>
      <div class="rn-tick o"><div>{[0, 1].map(() => ticker.slice().reverse().map((t) => <span>{t}<Icon name="chev" /></span>))}</div></div>
    </div>

    <section class="rn-sec" id="zones" aria-labelledby="rn-z">
      <div class="rn-head">
        <h2 id="rn-z">Что есть <mark>на районе</mark></h2>
        <p>{site.facts.area} на двух этажах: внизу тренажёры и веса, наверху кардио. Свободно даже вечером.</p>
      </div>
      <div class="rn-collage">
        <figure class="rn-piece p-zal" style="--r:-1.5deg;--d:-26px">
          <div class="rn-xerox"><Image src={img('/images/machines.jpg')} alt="Тренажёры в зале Urban210" widths={[480, 760, 1000]} sizes="(min-width: 1000px) 46vw, 92vw" format="avif" quality={45} /></div>
          <span class="rn-tape t1"></span>
          <figcaption><b class="rn-label" style="--r:-3deg">Тренажёрный зал</b><span>{zones[0].text}</span></figcaption>
        </figure>
        <figure class="rn-piece p-cardio" style="--r:2deg;--d:30px">
          <div class="rn-duo"><Image src={img('/images/cardio.jpg')} alt="Кардиозона с беговыми дорожками" widths={[420, 640, 820]} sizes="(min-width: 1000px) 34vw, 92vw" format="avif" quality={45} /></div>
          <span class="rn-tape t2"></span>
          <figcaption><b class="rn-label" style="--r:2deg">Кардио</b><span>{zones[1].text}</span></figcaption>
        </figure>
        <figure class="rn-piece p-weights" style="--r:1deg;--d:-14px">
          <div class="rn-xerox"><Image src={img('/images/free-weights.jpg')} alt="Гантельный ряд" widths={[400, 600, 800]} sizes="(min-width: 1000px) 30vw, 92vw" format="avif" quality={45} /></div>
          <span class="rn-tape t1"></span>
          <figcaption><b class="rn-label" style="--r:-2deg">Веса</b><span>{site.facts.freeWeights}, скамьи и стойки для приседа.</span></figcaption>
        </figure>
        <article class="rn-piece p-spa" id="spa" style="--r:-2deg;--d:22px">
          <p class="rn-spa-k">После зала</p>
          <h3>Сауна<br />и хаммам</h3>
          <p class="rn-spa-t"><b>40–50 °C</b>{spa.text.replace('Финская сауна, хаммам 40–50 °C и', 'Плюс')}</p>
          <span class="rn-sticker rn-mini" style="--r:8deg">в «{plans[2].name}»</span>
        </article>
      </div>
    </section>

    <section class="rn-sec rn-groups" id="groups" aria-labelledby="rn-g">
      <div class="rn-groups-tx">
        <h2 id="rn-g">Группы. <mark>Выбирай</mark> наклейку</h2>
        <p>{tags.length} направлений в {site.facts.groupHall.replace('зал групповых программ ', 'зале групповых на ')}. Запись в приложении клуба, в «{plans[2].name}» без доплат.</p>
        <div class="rn-groups-ph rn-xerox" style="--r:-2deg">
          <Image src={img('/images/group.jpg')} alt="Групповое занятие" widths={[420, 640, 860]} sizes="(min-width: 1000px) 36vw, 92vw" format="avif" quality={45} />
          <span class="rn-tape t2"></span>
        </div>
      </div>
      <ul class="rn-tags">
        {programs.map((p, gi) => p.items.map((t, i) => (
          <li class:list={['rn-sticker', 'rn-tag', `g${gi}`]} style={`--r:${[-6, 4, -2, 7, -5, 3, -8, 5, -3][(gi * 3 + i) % 9]}deg`}>
            <b>{t}</b><span>{p.group}</span>
          </li>
        )))}
      </ul>
    </section>

    <section class="rn-sec rn-price" id="price" aria-labelledby="rn-p">
      <div class="rn-head">
        <h2 id="rn-p">Цены <mark>на столбе</mark></h2>
        <p>Цена висит прямо тут, не надо звонить и узнавать.</p>
      </div>
      <div class="rn-flyers">
        {plans.map((p, i) => (
          <article class:list={['rn-flyer', p.id === 'all' && 'hot']} style={`--r:${[-1.6, 1.2, -0.8][i]}deg;--d:${[-12, 10, -18][i]}px`}>
            <span class="rn-tape top"></span>
            {p.tag && <span class="rn-sticker rn-mini corner" style={`--r:${i % 2 ? -9 : 9}deg`}>{p.tag}</span>}
            <h3>{p.name}</h3>
            <p class="rn-hrs">{p.hours}</p>
            <p class="rn-sum"><b>{fmt(p.month)}</b><span class="rn-rub">₽</span><small>в месяц</small></p>
            <p class="rn-year">или {rub(p.year)} за год, {perDay(p.year, 365)} ₽ в день</p>
            <ul>
              {p.features.map((f) => <li><Icon name="chev1" />{f}</li>)}
              {p.excluded?.map((f) => <li class="no"><Icon name="minus" />{f}</li>)}
            </ul>
            <a class:list={['rn-btn', 'wide', p.id !== 'all' && 'dark']} href="#come" data-lead={`Абонемент «${p.name}»`} data-block={`10_${p.id}`}>Беру этот<Icon name="chev" /></a>
            <a class="rn-tabs" href={site.phone.href} aria-label={`Позвонить: ${site.phone.display}`}>
              {tabs.map((_, k) => <span class:list={[k === 2 && 'gone']}>{tel}</span>)}
            </a>
          </article>
        ))}
      </div>

      <div class="rn-offer">
        <span class="rn-sticker rn-big" style="--r:-8deg" aria-hidden="true"><b>{fromDay}<span class="rn-rub">₽</span></b>за день</span>
        <div class="rn-offer-tx">
          <h3>Зал от {fromDay} ₽ в день</h3>
          <p>{plans[0].name} за {rub(plans[0].month)} в месяц: зал и кардиозона {plans[0].hours}. Не знаешь, что выбрать? Администратор подскажет.</p>
          <a class="rn-btn" href="#come" data-lead="Заявка с сайта" data-block="10_offer">Оставить заявку<Icon name="chev" /></a>
        </div>
        <ul class="rn-promos">
          {promos.filter((p) => ['trade-in', '1-plus-1'].includes(p.slug)).map((p, i) => (
            <li><a class="rn-sticker rn-promo" href={`/promo/${p.slug}/`} style={`--r:${i ? 3 : -2}deg`}><b>{p.title}</b><span>{p.short}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="rn-sec" id="crew" aria-labelledby="rn-c">
      <div class="rn-head">
        <h2 id="rn-c">Свои <mark>люди</mark></h2>
        <p>Тренеры, которые знают зал наизусть, и соседи, с которыми здороваешься у стойки.</p>
      </div>
      <ul class="rn-ids">
        {trainers.map((t, i) => (
          <li class="rn-id" style={`--r:${[-2, 1.5, -1][i]}deg;--d:${[14, -16, 10][i]}px`}>
            <p class="rn-id-k">Пропуск</p>
            <div class="rn-xerox"><Image src={img(t.photo)} alt={t.name} widths={[300, 460, 600]} sizes="(min-width: 900px) 26vw, 80vw" format="avif" quality={45} /></div>
            <h3>{t.name}</h3>
            <p>{t.role}</p>
            <span class="rn-stampmark" aria-hidden="true">тренер<Icon name="chev" /></span>
          </li>
        ))}
      </ul>
      <div class="rn-crew" aria-label="Гости клуба">
        {crew.map((c, i) => (
          <figure class="rn-print" style={`--r:${[-4, 3, -2, 5, -3, 2][i]}deg`}>
            <div class="rn-xerox"><Image src={img(c)} alt="Гость клуба Urban210" widths={[240, 360]} sizes="(min-width: 900px) 15vw, 42vw" format="avif" quality={42} /></div>
            <span class="rn-tape t1"></span>
          </figure>
        ))}
        <span class="rn-hand rn-hand-crew">тренируются<br />на районе</span>
      </div>
    </section>

    <section class="rn-sec rn-rev" aria-labelledby="rn-r">
      <div class="rn-score">
        <h2 id="rn-r">Район <mark>говорит</mark></h2>
        <p class="rn-num"><b>{rating}</b>
          <svg viewBox="0 0 240 140" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true"><path d="M150 14C80 2 14 28 12 74c-2 44 82 62 150 50 54-10 78-46 62-76-14-26-60-38-118-28" /></svg>
        </p>
        <p>на Яндекс Картах, {site.rating.text}</p>
        <a class="rn-under" href={site.maps.yandexReviews} target="_blank" rel="noopener">все отзывы</a>
      </div>
      <ul class="rn-notes">
        {reviews.map((r, i) => (
          <li class:list={['rn-note', `n${i}`]} style={`--r:${[-1.5, 1.8, -1, 1.2][i]}deg`}>
            <span class="rn-tape top"></span>
            <p>«{r.text}»</p>
            <span class="rn-note-by"><b>{r.name}</b>{r.source}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="rn-come" id="come" aria-labelledby="rn-f">
      <div class="rn-come-in">
        <div class="rn-come-tx">
          <h2 id="rn-f">Заходи <mark>по-соседски</mark></h2>
          <p class="rn-lead">Оставь телефон, администратор перезвонит и поможет выбрать абонемент. С собой форма, сменка, полотенце и паспорт.</p>
          <div class="rn-sign" aria-label="Адрес">
            <span>{site.address.locality}</span>
            <b>пр. 60-летия Октября</b>
            <i>210</i>
          </div>
          <dl class="rn-info">
            <div><dt>Будни</dt><dd>{site.hours[0].time}</dd></div>
            <div><dt>Выходные</dt><dd>{site.hours[1].time}</dd></div>
            <div><dt>Парковка</dt><dd>50 мест, бесплатно</dd></div>
            <div><dt>Звонок</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
          <p class="rn-msg"><a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a><a href={telegramLink('concept_10')} target="_blank" rel="noopener"><Icon name="tg" />Telegram</a><a href={site.maps.twoGis} target="_blank" rel="noopener"><Icon name="pin" />2ГИС</a></p>
        </div>
        <div class="rn-come-form">
          <span class="rn-tape t1"></span><span class="rn-tape t2"></span>
          <span class="rn-hand rn-hand-form">сюда</span>
          <svg class="rn-arrow a-form" viewBox="0 0 110 80" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8c10 34 40 56 86 58" /><path d="M78 52l18 14-18 12" /></svg>
          <LeadForm id="rn" block="10_final" />
        </div>
      </div>
    </section>

    <footer class="rn-foot">
      <p class="rn-foot-logo" aria-hidden="true">URBAN210<Icon name="chev" /></p>
      <div class="rn-foot-cols">
        <div><h2>Где</h2><p>{site.address.locality}, {site.address.street}<br />{site.district}</p></div>
        <div><h2>Когда</h2><p>{site.hours.map((h) => <>{h.days}: {h.time}<br /></>)}</p></div>
        <div><h2>Связь</h2><p><a href={site.phone.href}>{site.phone.display}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p></div>
        <div><h2>Бумаги</h2><p><a href="/rules/">Правила клуба</a><br /><a href="/oferta/">Договор-оферта</a><br /><a href="/policy/">Политика конфиденциальности</a></p></div>
      </div>
      <p class="rn-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
    </footer>
  </div>
</Layout>

<script>
  // Наклейки отклеиваются по тапу на телефоне так же, как по наведению на десктопе
  document.querySelectorAll<HTMLElement>('.rn-sticker').forEach((s) => {
    s.addEventListener('touchstart', () => {
      s.classList.add('peel');
      setTimeout(() => s.classList.remove('peel'), 900);
    }, { passive: true });
  });
</script>

<style is:global>
  body:has(.rn) {
    --bg: #f3efe6;
    --card: #ffffff;
    --raise: #ebe5d8;
    --ink: #141210;
    --muted: #4f4842;
    --line: rgb(20 18 16 / 0.2);
    --accent: #ff5722;
    --accent-ink: #141210;
    --font-display: 'Rubik Mono One', 'Arial Black', sans-serif;
    background: #f3efe6;
    color: #141210;
    color-scheme: light;
  }
  body:has(.rn) .btn { border-radius: 0; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
  body:has(.rn) .btn:hover { --b: #141210; --c: #ff5722; }
  body:has(.rn) .form h3 { font-weight: 400; letter-spacing: -0.02em; text-transform: uppercase; }
  body:has(.rn) .field input { border-radius: 0; border: 2px solid #141210; background: #fff; }
  body:has(.rn) .field input:focus { border-color: #ff5722; }
  body:has(.rn) .form-msg.is-err { background: #ffe0d4; color: #8a2a0c; border-radius: 0; }
  body:has(.rn) .field .err, body:has(.rn) .consent.bad { color: #c2360a; }
  body:has(.rn) dialog.lead .form { border-radius: 0; border: 2px solid #141210; }
  body:has(.rn) .mbar { background: rgb(243 239 230 / 0.95); border-top: 2px solid #141210; }
  body:has(.rn) .mbar a.ic { border: 2px solid #141210; border-radius: 0; }
</style>

<style>
  .rn {
    --paper: #f3efe6;
    --white: #fffdf8;
    --ink: #141210;
    --or: #ff5722;
    --or-2: #ff7a4d;
    --grey: #4f4842;
    --mono: 'Rubik Mono One', 'Arial Black', sans-serif;
    --g: clamp(18px, 4.5vw, 64px);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow-x: clip;
    font-family: 'Golos Text Variable', system-ui, sans-serif;
    background:
      radial-gradient(rgb(20 18 16 / 0.07) 1px, transparent 1.2px) 0 0 / 5px 5px,
      var(--paper);
  }
  .rn :global(h1), .rn :global(h2), .rn :global(h3) { font-family: var(--mono); font-weight: 400; letter-spacing: -0.04em; word-spacing: -0.3em; line-height: 0.98; text-transform: uppercase; hyphens: manual; }
  .rn h2 { font-size: clamp(1.9rem, 1rem + 3.6vw, 4.4rem); line-height: 1.04; max-width: 14ch; }
  .rn mark { background: var(--or); color: var(--ink); padding: 0 0.12em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .rn-rub { font-family: 'Golos Text Variable', sans-serif; font-weight: 800; letter-spacing: 0; }

  /* Шапка */
  .rn-top { position: relative; z-index: 6; display: flex; align-items: center; gap: 24px; padding: 18px var(--g); max-width: 1480px; margin: 0 auto; }
  .rn-logo { display: inline-flex; align-items: center; gap: 6px; padding: 9px 12px 8px; background: var(--ink); color: var(--paper); font: 400 0.95rem/1 var(--mono); letter-spacing: -0.02em; text-decoration: none; transform: rotate(-2deg); }
  .rn-logo :global(svg) { width: 15px; height: 12px; color: var(--or); }
  .rn-nav { display: none; gap: 6px; margin-left: auto; }
  .rn-nav a { padding: 6px 10px; font-weight: 700; font-size: 0.98rem; text-decoration: none; text-transform: lowercase; }
  .rn-nav a:hover { background: var(--ink); color: var(--paper); }
  .rn-tel { display: none; font-weight: 700; text-decoration: none; }
  .rn-top .rn-btn { margin-left: auto; }
  @media (min-width: 1100px) { .rn-nav, .rn-tel { display: flex; } .rn-top .rn-btn { margin-left: 0; } }

  /* Кнопки */
  .rn-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 58px; padding: 0 22px; background: var(--or); color: var(--ink); border: 2.5px solid var(--ink); font-weight: 800; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; box-shadow: 0 10px 18px -12px rgb(20 18 16 / 0.6); transition: transform 0.3s var(--ease), background-color 0.2s, color 0.2s; }
  .rn-btn :global(svg) { width: 18px; height: 14px; transition: transform 0.3s var(--ease); }
  .rn-btn:hover { background: var(--ink); color: var(--or); transform: rotate(-1.5deg); }
  .rn-btn:hover :global(svg) { transform: translateX(4px); }
  .rn-btn.sm { min-height: 44px; padding: 0 14px; font-size: 0.88rem; transform: rotate(2deg); }
  .rn-btn.sm:hover { transform: rotate(-2deg); }
  .rn-btn.dark { background: var(--ink); color: var(--paper); }
