---
// Концепция 12 «Слова»: только кинетическая типографика. Огромные слова держат каждую секцию,
// фото и видео зала видны сквозь буквы (текст поверх медиа в режиме darken: настоящий текст в DOM),
// строки разъезжаются, растут и сдвигаются при прокрутке (GSAP ScrollTrigger, scrub, грузится после load).
// Три цвета: чёрный, белый, оранжевый. Без JS и при reduced motion всё стоит на месте и читается.
import ssCyr from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-cyrillic-wght-normal.woff2?url';
import ssLat from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-latin-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Sofia w';font-style:normal;font-display:swap;font-weight:1 1000;src:url(${ssCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Sofia w';font-style:normal;font-display:swap;font-weight:1 1000;src:url(${ssLat}) format('woff2');unicode-range:${UL}}`;

const rating = site.rating.value.toString().replace('.', ',');
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const zoneRows = [
  { word: 'Зал', zone: z.zal, photo: '/images/free-weights.jpg' },
  { word: 'Кардио', zone: z.cardio, photo: '/images/cardio.jpg' },
  { word: 'Группы', zone: z.group, photo: '/images/group.jpg' },
  { word: 'SPA', zone: z.spa, photo: null },
];
const facts = [
  { big: '1300', unit: 'м²', text: 'больше 1300 квадратных метров на двух этажах', style: 'solid' },
  { big: '60+', unit: 'тренажёров', text: site.facts.brands, style: 'photo', photo: '/images/machines.jpg' },
  { big: '60', unit: 'кг', pre: 'до', text: 'свободные веса: гантели, грифы, блины', style: 'thin' },
  { big: '50', unit: 'мест', text: 'бесплатная парковка под видеонаблюдением', style: 'or' },
];
const firstName = (n: string) => n.split(' ')[0];
const lastName = (n: string) => n.split(' ').slice(1).join(' ');
const quotes = [
  { say: 'Нет очередей', r: reviews[0] },
  { say: 'Очередь не собирается', r: reviews[1] },
  { say: 'Просторные раздевалки', r: reviews[2] },
  { say: 'Всегда чисто', r: reviews[3] },
];
const dayCard = plans[0];
const fromDay = perDay(dayCard.month, 30);
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const personalLine = `${personal.pack} тренировок за ${rub(personal.price)}`;
const n = (x: number) => x.toLocaleString('ru-RU').replace(/\s/g, ' ');
const hours = site.hours.map((h) => `${h.days} ${h.time}`);
---
<Layout title="Концепция 12 «Слова»" description="Концепция дизайна сайта Urban210: кинетическая типографика, фото зала сквозь буквы." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={ssCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="sl">
    <header class="bar">
      <a class="mark" href="/concepts/12/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
      <nav class="bar-nav" aria-label="Разделы">
        <a href="#zony">Зоны</a><a href="#ceny">Цены</a><a href="#lyudi">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
      </nav>
      <a class="bar-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="pill" href="#ceny" data-block="12_header">Выбрать карту<Icon name="chev" /></a>
    </header>

    <main>
      <!-- Первый экран: видео сквозь буквы -->
      <section class="y-hero" aria-labelledby="h1">
        <h1 id="h1" class="hero-h">
          <span class="kn hero-kn" data-kn>
            <span class="kn-m" aria-hidden="true">
              <Image src={img('/images/zal.jpg')} alt="" widths={[640, 1000, 1600]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
            </span>
            <span class="kn-t"><span class="hl" data-x="-5"><span class="hl-i">Свой</span></span> <span class="hl" data-x="6"><span class="hl-i">зал</span></span></span>
          </span>
          <span class="hero-or" data-x="-3"><span class="hl-i">от&nbsp;{fromDay}&nbsp;₽</span></span>
        </h1>
        <div class="hero-side">
          <p>Фитнес-клуб Urban210 в Хабаровске. {dayCard.name}: {rub(dayCard.month)} в месяц, это {fromDay}&nbsp;₽ в&nbsp;день.</p>
          <a class="pill pill-l" href="#ceny" data-block="12_hero">Выбрать карту<Icon name="chev" /></a>
        </div>
        <ul class="hero-meta">
          {site.hours.map((h) => <li><b>{h.time}</b><span>{h.days}</span></li>)}
          <li><b>{rating}</b><span>Яндекс Карты, {site.rating.text}</span></li>
          <li><b>{fromDay} ₽</b><span>в день по дневной карте</span></li>
        </ul>
      </section>

      <!-- Цифры: строки въезжают с разных сторон -->
      <section class="facts" aria-label="Клуб в цифрах">
        {facts.map((f, i) => (
          <div class={`fact fact-${f.style}`} data-slide={i % 2 ? '1' : '-1'}>
            <p class="fact-w">
              {f.style === 'photo' ? (
                <span class="kn" data-kn>
                  <span class="kn-m" aria-hidden="true"><Image src={img(f.photo!)} alt="" widths={[480, 900, 1400]} sizes="100vw" format="avif" quality={35} /></span>
                  <span class="kn-t">{f.big} {f.unit}</span>
                </span>
              ) : <span>{f.pre && <span class="u">{f.pre} </span>}{f.big} <span class="u">{f.unit}</span></span>}
            </p>
            <p class="fact-t">{f.text}</p>
          </div>
        ))}
      </section>

      <!-- Зоны -->
      <section class="y-zones" id="zony" aria-labelledby="zones-h">
        <h2 id="zones-h" class="kick">Что внутри</h2>
        {zoneRows.map((r, i) => (
          <a class="y-zone" href={r.zone.href} data-grow>
            <span class="zone-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="zone-w">
              {r.photo ? (
                <span class="kn" data-kn>
                  <span class="kn-m" aria-hidden="true"><Image src={img(r.photo)} alt="" widths={[480, 900, 1400]} sizes="100vw" format="avif" quality={35} /></span>
                  <span class="kn-t">{r.word}</span>
                </span>
              ) : <span class="zone-or">{r.word}</span>}
            </h3>
            <span class="zone-d">
              <b>{r.zone.title}</b>
              <span>{r.zone.text}</span>
              <span class="y-zone-go">Подробнее<Icon name="chev" /></span>
            </span>
          </a>
        ))}
      </section>

      <!-- Цена дня -->
      <section class="one" aria-labelledby="one-h">
        <div class="one-in">
          <p class="one-big" aria-hidden="true" data-scale>{fromDay}&nbsp;₽</p>
          <div class="one-txt">
            <h2 id="one-h">От {fromDay}&nbsp;₽ в&nbsp;день</h2>
            <p>{dayCard.name}: {rub(dayCard.month)} в месяц. Зал и кардиозона {dayCard.hours}.</p>
            <p class="one-terms">{dayCard.features.join('. ')}.</p>
            <a class="pill pill-k" href="#zayavka" data-lead="Заявка с сайта" data-block="12_offer">Оставить заявку<Icon name="chev" /></a>
          </div>
        </div>
      </section>

      <!-- Цены -->
      <section class="prices" id="ceny" aria-labelledby="price-h">
        <div class="run" aria-hidden="true" data-run>
          <span data-weight>Цены от {fromDay} ₽<Icon name="chev" />Цены от {fromDay} ₽<Icon name="chev" />Цены от {fromDay} ₽<Icon name="chev" /></span>
        </div>
        <h2 id="price-h" class="sr">Цены на абонементы</h2>
        <p class="prices-lead">Безлимит в своё время, при оплате за год дешевле.</p>
        <div class="rows">
          {plans.map((p) => (
            <article class={`row ${p.id === 'full' ? 'row-hot' : ''}`} data-grow>
              <div class="row-a">
                <h3>{p.name}{p.tag && <span class="tag">{p.tag}</span>}</h3>
                <p class="row-h">{p.hours.charAt(0).toUpperCase() + p.hours.slice(1)}</p>
                <ul>
                  {p.features.map((f) => <li>{f}</li>)}
                  {p.excluded?.map((f) => <li class="no">Без: {f.toLowerCase()}</li>)}
                </ul>
              </div>
              <div class="row-b">
                <p class="row-p">{n(p.month)}<span>₽ / мес</span></p>
                <p class="row-y">{rub(p.year)} за год</p>
                <a class="pill pill-k" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`12_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
              </div>
            </article>
          ))}
        </div>
        <div class="deals">
          <a href="#zayavka" data-lead={tradein.goal} data-block="12_tradein"><b>{tradein.title}</b><span>{tradein.short}</span><Icon name="chev" /></a>
          <a href="#zayavka" data-lead={friend.goal} data-block="12_friend"><b>{friend.title}</b><span>{friend.short}</span><Icon name="chev" /></a>
        </div>
      </section>

      <!-- Тренеры: имена с портретом внутри -->
      <section class="people" id="lyudi" aria-labelledby="people-h">
        <h2 id="people-h" class="kick">Тренеры</h2>
        {trainers.map((t, i) => (
          <article class="person" data-slide={i % 2 ? '1' : '-1'}>
            <p class="person-w">
              <span class="kn" data-kn>
                <span class="kn-m kn-face" aria-hidden="true"><Image src={img(t.photo)} alt="" widths={[600, 900]} sizes="100vw" format="avif" quality={50} /></span>
                <span class="kn-t">{firstName(t.name)}</span>
              </span>
            </p>
            <div class="person-d">
              <Image class="person-ph" src={img(t.photo)} alt={t.name} widths={[160]} sizes="80px" format="avif" quality={50} />
              <p><b>{t.name}</b><span>{t.role}</span></p>
            </div>
          </article>
        ))}
        <div class="pt">
          <p class="pt-t"><b>Персонально.</b> Тренер поставит технику и составит программу под цель. {personalLine}. {personal.firstFree}.</p>
          <a class="pill pill-l" href="#zayavka" data-lead="Персональные тренировки" data-block="12_personal">Подобрать тренера<Icon name="chev" /></a>
        </div>
      </section>

      <!-- Отзывы -->
      <section class="voices" id="otzyvy" aria-labelledby="voices-h">
        <div class="rate">
          <p class="rate-n" aria-hidden="true" data-scale>{rating}</p>
          <div>
            <h2 id="voices-h">{rating} на Яндекс Картах</h2>
            <p>{site.rating.text}. Чаще всего пишут про простор и порядок.</p>
            <a class="y-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Читать все отзывы<Icon name="chev" /></a>
          </div>
        </div>
        {quotes.map((q, i) => (
          <figure class="q" data-slide={i % 2 ? '1' : '-1'}>
            <p class="q-w" aria-hidden="true">«{q.say}»</p>
            <figcaption>
              <blockquote><p>{q.r.text}</p></blockquote>
              <span><b>{q.r.name}</b>, {q.r.source}</span>
            </figcaption>
          </figure>
        ))}
      </section>

      <!-- Заявка -->
      <section class="end" id="zayavka" aria-labelledby="end-h">
        <div class="run run-kn" aria-hidden="true" data-run>
          <span class="kn" data-kn>
            <span class="kn-m"><Image src={img('/images/functional.jpg')} alt="" widths={[480, 900, 1400]} sizes="100vw" format="avif" quality={35} /></span>
            <span class="kn-t">Приходи · Приходи · Приходи ·</span>
          </span>
        </div>
        <div class="end-in">
          <div class="end-txt">
            <h2 id="end-h">Приходи в зал от&nbsp;{fromDay}&nbsp;₽ в&nbsp;день</h2>
            <dl>
              <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}, {site.district}</dd></div>
              <div><dt>Часы</dt><dd>{hours.join(', ')}</dd></div>
              <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
              <div><dt>Парковка</dt><dd>{site.parking}</dd></div>
            </dl>
            <p class="end-msg">
              <a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a>
              <a href={telegramLink('concept12')} target="_blank" rel="noopener"><Icon name="tg" />Telegram</a>
            </p>
          </div>
          <LeadForm id="c12" block="12_final" />
        </div>
      </section>
    </main>

    <footer class="foot">
      <p class="foot-w" aria-hidden="true">URBAN210<Icon name="chev" /></p>
      <div class="foot-g">
        <p>{site.address.locality}, {site.address.street}<br />{hours.join(' · ')}</p>
        <p><a href={site.phone.href}>{site.phone.display}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p>
        <p><a href="/price/">Тарифы</a> · <a href="/zal/">Зал</a> · <a href="/group/">Групповые</a> · <a href="/spa/">SPA</a> · <a href="/trainers/">Тренеры</a> · <a href="/promo/">Акции</a></p>
        <p><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Договор-оферта</a> · <a href="/rules/">Правила клуба</a></p>
      </div>
      <p class="foot-l">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
    </footer>
  </div>
</Layout>

<script>
  // Движение слов: GSAP и ScrollTrigger грузятся после load, только если пользователь не просил меньше анимации.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  async function kinetic() {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('kin');

    // Первый экран: строки расходятся, фото внутри букв медленно едет
    const hero = document.querySelector('.y-hero');
    gsap.utils.toArray<HTMLElement>('.y-hero [data-x]').forEach((el) => {
      gsap.to(el, { xPercent: Number(el.dataset.x), ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 } });
    });

    // Фото и видео внутри букв: окно-параллакс
    gsap.utils.toArray<HTMLElement>('[data-kn]').forEach((kn) => {
      const m = kn.querySelector('.kn-m');
      if (!m) return;
      gsap.fromTo(m, { yPercent: -8 }, { yPercent: 8, ease: 'none', scrollTrigger: { trigger: kn, start: 'top bottom', end: 'bottom top', scrub: true } });
    });

    // Строки въезжают сбоку и встают на место (один раз, чтобы текст потом спокойно читался)
    gsap.utils.toArray<HTMLElement>('[data-slide]').forEach((el) => {
      const dir = Number(el.dataset.slide);
      gsap.from(el.firstElementChild, { xPercent: 45 * dir, opacity: 0, duration: 1.3, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
    });

    // Слова зон и цены растут из маленьких
    gsap.utils.toArray<HTMLElement>('[data-grow]').forEach((el) => {
      const w = el.querySelector('.zone-w, .row-p');
      if (w) gsap.from(w, { scale: 0.6, opacity: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 85%', once: true } });
    });

    // Цена дня и рейтинг вырастают на весь экран
    gsap.utils.toArray<HTMLElement>('[data-scale]').forEach((el) => {
      gsap.from(el, { scale: 0.4, opacity: 0, duration: 1.5, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 80%', once: true } });
    });

    // Вес шрифта бегущей строки меняется вместе с прокруткой: от тонкого к жирному
    document.querySelectorAll<HTMLElement>('[data-weight]').forEach((el) => {
      gsap.fromTo(el, { fontWeight: 250 }, { fontWeight: 900, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'center 40%', scrub: 0.4 } });
    });

    // Бегущие строки двигаются вместе с прокруткой
    gsap.utils.toArray<HTMLElement>('[data-run]').forEach((el) => {
      gsap.fromTo(el.firstElementChild, { xPercent: 0 }, { xPercent: -34, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.4 } });
    });

    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }
  if (!reduce) {
    const go = () => kinetic().catch(() => {});
    if (document.readyState === 'complete') go();
    else addEventListener('load', go, { once: true });
  }
</script>

<style is:global>
  body:has(.sl) { background: #0b0a09; color: #f4f1ec; }
  body:has(.sl) ::selection { background: #ff5722; color: #0b0a09; }
  body:has(.sl) :focus-visible { outline: 3px solid #ff5722; outline-offset: 3px; border-radius: 0; }
  body:has(.sl) .form { background: #f4f1ec; color: #0b0a09; --muted: #55504a; --card: #fff; --line: rgb(11 10 9 / 0.2); border-radius: 0; gap: 14px; padding: clamp(24px, 3vw, 40px); }
  body:has(.sl) .form h3 { font-family: 'Sofia w', var(--font-body); font-weight: 900; font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); line-height: 0.88; letter-spacing: -0.01em; text-transform: uppercase; }
  body:has(.sl) .form .field { color: #55504a; }
  body:has(.sl) .form .field input { background: #fff; border: 0; border-bottom: 2px solid #0b0a09; border-radius: 0; font-size: 1.1rem; }
  body:has(.sl) .form .field input:focus { border-color: #ff5722; }
  body:has(.sl) .form .field .err, body:has(.sl) .form .consent.bad { color: #b52a00; }
  body:has(.sl) .form .field.bad input { border-color: #b52a00; }
  body:has(.sl) .form .consent { color: #55504a; }
  body:has(.sl) .form .btn { border-radius: 0; min-height: 62px; background: #0b0a09; color: #f4f1ec; font-family: 'Sofia w', var(--font-body); font-weight: 800; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.01em; }
  body:has(.sl) .form .btn:hover { background: #ff5722; color: #0b0a09; }
  body:has(.sl) .form .btn .chev { color: #ff5722; }
  body:has(.sl) .form .btn:hover .chev { color: #0b0a09; }
  body:has(.sl) .form .form-note, body:has(.sl) .form .muted { color: #55504a; }
  body:has(.sl) .form .form-msg.is-err { background: #ffe5db; color: #8f2100; border-radius: 0; }
  body:has(.sl) .form .form-done .ok { color: #0b0a09; }
  body:has(.sl) dialog.lead::backdrop { background: rgb(11 10 9 / 0.86); backdrop-filter: none; }
  body:has(.sl) dialog.lead .form { border: 0; }
  body:has(.sl) dialog.lead .x { color: #0b0a09; }
  body:has(.sl) .mbar { background: #0b0a09; border-top: 1px solid rgb(244 241 236 / 0.16); }
  body:has(.sl) .mbar a.ic { border-radius: 0; border-color: rgb(244 241 236 / 0.24); }
  body:has(.sl) .mbar .btn { border-radius: 0; font-family: 'Sofia w', var(--font-body); font-weight: 850; font-size: 1.35rem; text-transform: uppercase; }
</style>

<style>
  .sl {
    --bk: #0b0a09; --wh: #f4f1ec; --or: #ff5722; --mut: #a8a199;
    --w: 'Sofia w', 'Arial Narrow', system-ui, sans-serif;
    --g: clamp(16px, 3vw, 44px);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    overflow-x: clip;
  }
  .sl :global(h1), .sl :global(h2), .sl :global(h3) { font-family: var(--w); letter-spacing: -0.01em; text-wrap: initial; }

  /* Текст поверх медиа в режиме darken: белые буквы показывают фото, чёрный фон его прячет */
  .kn { position: relative; display: inline-block; isolation: isolate; overflow: hidden; vertical-align: top; }
  .kn-m { position: absolute; inset: -10% 0; z-index: 0; }
  .kn-m :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(1.35); }
