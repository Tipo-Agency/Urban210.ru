---
// Концепция 02 «Красный свет»: зал как клуб ночью. Фото и видео в красном дуотоне (CSS blend),
// узкий Tektur капсом через ось ширины, дышащий свет на первом экране, перекрёстные бегущие ленты.
// Зоны «включают свет», когда доходят до экрана, цена дня загорается как неоновая вывеска.
import { Image } from 'astro:assets';
import tkCyr from '@fontsource-variable/tektur/files/tektur-cyrillic-standard-normal.woff2?url';
import tkLat from '@fontsource-variable/tektur/files/tektur-latin-standard-normal.woff2?url';
import tkExt from '@fontsource-variable/tektur/files/tektur-latin-ext-standard-normal.woff2?url';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, nav, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, programs, zones } from '../../../data/content';

const fonts = `
@font-face{font-family:'Tektur r';font-style:normal;font-display:swap;font-weight:400 900;font-stretch:75% 100%;src:url(${tkCyr}) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Tektur r';font-style:normal;font-display:swap;font-weight:400 900;font-stretch:75% 100%;src:url(${tkLat}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Tektur r';font-style:normal;font-display:swap;font-weight:400 900;font-stretch:75% 100%;src:url(${tkExt}) format('woff2');unicode-range:U+0100-02BA,U+20A0-20AB,U+20AD-20C0}`;

const rating = site.rating.value.toString().replace('.', ',');
const dayCard = plans[0];
const fromDay = perDay(dayCard.month, 30);
const cap = (t: string) => t[0].toUpperCase() + t.slice(1);
const tape = [`От ${fromDay} ₽ в день`, 'Без очередей к тренажёрам', '60+ тренажёров', `${rating} на Яндекс Картах`, 'Парковка на 50 мест', 'Сауна и хаммам', 'До 23:30 по будням'];
const rooms = [
  { t: 'Железо', sub: zones[0].title, s: cap(zones[0].text), i: '/images/free-weights.jpg', href: zones[0].href, pos: '50% 60%' },
  { t: 'Кардио', sub: zones[1].title, s: zones[1].text, i: '/images/cardio.jpg', href: zones[1].href, pos: '50% 55%' },
  { t: 'Группы', sub: zones[2].title, s: `${cap(zones[2].text)} ${programs.flatMap((p) => p.items).join(', ')}.`, i: '/images/group.jpg', href: zones[2].href, pos: '50% 70%' },
];
const spa = zones[3];
const quotes = reviews.slice(0, 3).map((r) => ({ q: r.text.split('. ').slice(0, 2).join('. ').replace(/\.?$/, '.'), n: r.name, s: r.source }));
---
<Layout title="Концепция 02 «Красный свет»" description="Концепция дизайна сайта Urban210: клуб в красном свете." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={tkCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="rl">
    <header class="r-top">
      <a class="r-logo" href="/concepts/02/" aria-label="Urban210, на главную">URBAN<b>210</b><Icon name="chev" /></a>
      <nav class="r-nav" aria-label="Меню"><a href="#rooms">Зоны</a><a href="#price">Цены</a><a href="#team">Тренеры</a><a href="#contacts">Контакты</a></nav>
      <a class="r-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="r-pill" href="#price" data-block="02_header"><span class="r-pd">Выбрать карту</span><span class="r-pm">Цены</span></a>
    </header>

    <section class="r-hero" aria-labelledby="r-h">
      <div class="r-hero-media r-duo">
        <Image src={img('/images/hero.jpg')} alt="" widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={45} />
        <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
      </div>
      <div class="r-glow" aria-hidden="true"></div>
      <div class="r-hero-in">
        <p class="r-live"><i aria-hidden="true"></i>{site.address.locality}, {site.address.short}</p>
        <h1 id="r-h"><span>Зал</span><span>не гаснет</span><span class="r-hot">до 23:30</span></h1>
        <div class="r-hero-row">
          <p>По будням с 6:30 до 23:30, в выходные до 22:30. Дневная карта от {fromDay} ₽ в день.</p>
          <div class="r-acts">
            <a class="r-btn" href="#price" data-block="02_hero">Выбрать карту<Icon name="chev" /></a>
            <a class="r-ghost" href="#price">Цены от {rub(plans[0].month)}</a>
          </div>
        </div>
      </div>
    </section>

    <div class="r-tapes" aria-label="Коротко о клубе">
      <div class="r-tape r-tape-a"><div class="r-track">{[0, 1].map((k) => <p aria-hidden={k === 1 ? 'true' : undefined}>{tape.map((t) => <span>{t}<Icon name="chev" /></span>)}</p>)}</div></div>
      <div class="r-tape r-tape-b" aria-hidden="true"><div class="r-track">{[0, 1].map(() => <p>{tape.slice().reverse().map((t) => <span>{t}<Icon name="chev" /></span>)}</p>)}</div></div>
    </div>

    <section class="r-sec" id="rooms" aria-labelledby="r-z">
      <div class="r-head">
        <h2 id="r-z">Что внутри</h2>
        <p>Более 1300 м², 60+ тренажёров Technogym и Matrix. Очередей к тренажёрам нет даже вечером.</p>
      </div>
      <div class="r-rooms">
        {rooms.map((r) => (
          <article class="r-room" data-rise>
            <div class="r-room-ph r-duo">
              <Image src={img(r.i)} alt="" widths={[640, 1024, 1600]} sizes="100vw" format="avif" quality={45} style={`object-position:${r.pos}`} />
            </div>
            <div class="r-room-in">
              <h3><span class="r-room-t">{r.t}</span><span class="r-room-s">{r.sub}</span></h3>
              <div class="r-room-txt">
                <p>{r.s}</p>
                <a class="r-arrow" href={r.href}>Подробнее<Icon name="chev" /></a>
              </div>
            </div>
          </article>
        ))}
        <article class="r-room r-spa" data-rise>
          <div class="r-heat" aria-hidden="true"></div>
          <div class="r-room-in">
            <h3><span class="r-room-t">Жар</span><span class="r-room-s">{spa.title}</span></h3>
            <div class="r-room-txt">
              <p>{spa.text} Входит в «Всё включено».</p>
              <a class="r-arrow" href={spa.href}>Подробнее<Icon name="chev" /></a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="r-sec" id="price" aria-labelledby="r-p">
      <div class="r-head">
        <h2 id="r-p">Сколько стоит</h2>
        <p>Цена за месяц, при оплате за год дешевле.</p>
      </div>
      <div class="r-plans">
        {plans.map((p) => (
          <article class:list={['r-plan', p.id === 'all' && 'is-hot']} data-rise>
            <div class="r-plan-top">
              <h3>{p.name}</h3>
              {p.tag && <span class="r-tag">{p.tag}</span>}
            </div>
            <p class="r-hrs">{cap(p.hours)}</p>
            <p class="r-sum"><b>{p.month.toLocaleString('ru-RU').replace(/\s/g, ' ')}</b><span>₽<br />в месяц</span></p>
            <p class="r-year">{rub(p.year)} за год · {perDay(p.year, 365)} ₽ в день</p>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a class="r-btn r-btn-wide" href="#lead" data-lead={p.name} data-block={`02_${p.id}`}>Выбрать<Icon name="chev" /></a>
          </article>
        ))}
      </div>

      <div class="r-offer" data-rise>
        <p class="r-neon" aria-hidden="true">{fromDay} ₽</p>
        <div class="r-offer-txt">
          <h3>От {fromDay} ₽ в день</h3>
          <p>{dayCard.name}: {rub(dayCard.month)} в месяц. Зал и кардиозона {dayCard.hours}.</p>
          <a class="r-btn" href="#lead" data-lead="Заявка с сайта" data-block="02_offer">Оставить заявку<Icon name="chev" /></a>
        </div>
      </div>
      <p class="r-note">Персональные тренировки: {personal.pack} занятий за {rub(personal.price)}. {personal.firstFree}.</p>
    </section>

    <section class="r-sec" id="team" aria-labelledby="r-t">
      <div class="r-head">
        <h2 id="r-t">Кто тренирует</h2>
        <p>Поставят технику, соберут программу под цель и проследят за прогрессом.</p>
      </div>
      <ul class="r-team">
        {trainers.map((t) => (
          <li data-rise>
            <div class="r-face r-duo"><Image src={img(t.photo)} alt={t.name} widths={[400, 700]} sizes="(min-width: 960px) 32vw, 80vw" format="avif" quality={45} /></div>
            <p class="r-name">{t.name}</p>
            <p class="r-role">{t.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="r-sec r-voice" aria-labelledby="r-v">
      <div class="r-rate">
        <p class="r-rate-n">{rating}</p>
        <div>
          <h2 id="r-v">Что говорят</h2>
          <p>Яндекс Карты, {site.rating.text}. <a href={site.maps.yandexReviews} target="_blank" rel="noopener">Все отзывы</a></p>
        </div>
      </div>
      <div class="r-quotes">
        {quotes.map((q) => (
          <figure class="r-q" data-rise>
            <blockquote>«{q.q}»</blockquote>
            <figcaption><b>{q.n}</b> · {q.s}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="r-lead" id="lead" aria-labelledby="r-l">
      <div class="r-lead-glow" aria-hidden="true"></div>
      <div class="r-lead-in">
        <div class="r-lead-txt">
          <h2 id="r-l">Приходи<br />в зал<br /><span class="r-hot">от {fromDay} ₽ в день</span></h2>
          <p>Оставь телефон, администратор перезвонит, поможет выбрать карту и подберёт время.</p>
          <p class="r-alt"><a href={site.phone.href}>{site.phone.display}</a><a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener">WhatsApp</a><a href={telegramLink('concept_02')} target="_blank" rel="noopener">Telegram</a></p>
        </div>
        <LeadForm block="02_final" id="r02" title="Оставить заявку" />
      </div>
    </section>

    <footer class="r-foot" id="contacts">
      <p class="r-word" aria-hidden="true">URBAN210<Icon name="chev" /></p>
      <div class="r-foot-grid">
        <div>
          <h2>Где</h2>
          <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
          <p class="r-mut">{site.parking}</p>
          <a class="r-arrow" href={site.maps.yandex} target="_blank" rel="noopener">На карте<Icon name="chev" /></a>
        </div>
        <div>
          <h2>Когда</h2>
          {site.hours.map((h) => <p>{h.days} {h.time}</p>)}
        </div>
        <div>
          <h2>Связь</h2>
          <p><a href={site.phone.href}>{site.phone.display}</a></p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><a href={site.instagram} target="_blank" rel="noopener">Instagram</a> · <a href={telegramLink('concept_02_footer')} target="_blank" rel="noopener">Telegram</a></p>
        </div>
        <nav aria-label="Разделы">
          <h2>Разделы</h2>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
      <div class="r-legal">
        <span>© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</span>
        <span><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Оферта</a> · <a href="/rules/">Правила клуба</a></span>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  body:has(.rl) { background: #0a0405; color: #fff1ec; }
  body:has(.rl) ::selection { background: #ff2b1c; color: #0a0405; }
  body:has(.rl) :focus-visible { outline-color: #ff5a1f; }
  body:has(.rl) .mbar { background: rgb(10 4 5 / 0.94); border-top-color: rgb(255 60 40 / 0.25); }
  body:has(.rl) .mbar a.ic { border-color: rgb(255 80 60 / 0.3); border-radius: 2px; }
  body:has(.rl) .mbar .btn, body:has(.rl) .form .btn { --b: #ff2b1c; --c: #0a0405; border-radius: 2px; font-family: 'Tektur r', sans-serif; font-stretch: 85%; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
  body:has(.rl) .mbar .btn:hover, body:has(.rl) .form .btn:hover { --b: #ff4a2a; }
  body:has(.rl) .form .btn { min-height: 60px; font-size: 1.08rem; box-shadow: 0 10px 40px -8px rgb(255 43 28 / 0.6); }
  body:has(.rl) dialog.lead::backdrop { background: rgb(20 2 2 / 0.82); }
  body:has(.rl) .form { background: #130708; --card: #1d0b0b; --line: rgb(255 90 70 / 0.22); --muted: #cfa79f; --ink: #fff1ec; --accent: #ff2b1c; border-radius: 2px; }
  body:has(.rl) dialog.lead .form { border-color: rgb(255 60 40 / 0.35); }
  body:has(.rl) .form h3 { font-family: 'Tektur r', sans-serif; font-stretch: 80%; font-weight: 800; text-transform: uppercase; letter-spacing: 0; font-size: 1.7rem; line-height: 1; }
  body:has(.rl) .field input { border-radius: 2px; }
  body:has(.rl) .field input:focus { border-color: #ff2b1c; }
  body:has(.rl) .consent input { accent-color: #ff2b1c; }
  body:has(.rl) .form-done .ok { background: #ff2b1c; color: #0a0405; }
</style>

<style>
  .rl {
    --bg: #0a0405; --ink: #fff1ec; --mut: #cfa79f; --red: #ff2b1c; --hot: #ff5a1f; --line: rgb(255 80 60 / 0.2);
    --g: clamp(16px, 4vw, 56px); --sec: clamp(88px, 11vw, 180px);
    --tk: 'Tektur r', 'Arial Narrow', sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--bg); color: var(--ink);
  }
  .rl :global(:is(h1, h2, h3)) { font-family: var(--tk); font-stretch: 75%; font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.86; hyphens: manual; -webkit-hyphens: manual; }
  .rl a { text-decoration: none; }
  .r-mut { color: var(--mut); }

  /* дуотон: ч/б картинка умножается на красный, свет остаётся красным, тень чёрной */
  .r-duo { position: relative; overflow: hidden; background: linear-gradient(160deg, #ff3a1c, #c4100c 70%); isolation: isolate; }
  .r-duo :global(img), .r-duo video { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.35) brightness(1.08); mix-blend-mode: multiply; }
  .r-duo::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 80% at 70% 10%, rgb(255 150 90 / 0.35), transparent 55%); mix-blend-mode: screen; pointer-events: none; }

  /* ---------- Шапка ---------- */
  .r-top { position: fixed; inset: 0 0 auto; z-index: 30; display: flex; align-items: center; gap: clamp(16px, 3vw, 40px); height: 72px; padding-inline: var(--g); background: linear-gradient(180deg, rgb(10 4 5 / 0.92), rgb(10 4 5 / 0)); }
  .r-logo { display: inline-flex; align-items: center; gap: 2px; font-family: var(--tk); font-stretch: 80%; font-weight: 800; font-size: 1.45rem; letter-spacing: 0.01em; margin-right: auto; }
  .r-logo b { color: var(--red); font-weight: 800; }
  .r-logo :global(svg) { width: 17px; height: 15px; margin-left: 5px; color: var(--red); }
  .r-nav { display: none; gap: 28px; margin-right: auto; font-family: var(--tk); font-stretch: 85%; font-weight: 600; text-transform: uppercase; font-size: 0.95rem; letter-spacing: 0.06em; }
  .r-nav a { transition: color 0.2s ease; }
  .r-nav a:hover { color: var(--red); }
  .r-tel { display: none; font-family: var(--tk); font-stretch: 85%; font-weight: 600; font-size: 1rem; font-variant-numeric: tabular-nums; }
  .r-pill { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 99px; background: var(--red); color: var(--bg); font-family: var(--tk); font-stretch: 85%; font-weight: 800; text-transform: uppercase; font-size: 0.98rem; box-shadow: 0 0 0 0 rgb(255 43 28 / 0.5); animation: r-ring 2.6s ease-out infinite; }
  .r-pill { gap: 0; }
  .r-pd { display: none; }
  @media (min-width: 560px) { .r-pd { display: inline; } .r-pm { display: none; } }
  @media (min-width: 1000px) { .r-nav { display: flex; } .r-logo { margin-right: 24px; } }
  @media (min-width: 1200px) { .r-tel { display: inline; } }

  /* ---------- Первый экран ---------- */
  .r-hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  .r-hero-media { position: absolute; inset: 0; }
  .r-hero-media :global(img), .r-hero-media video { position: absolute; inset: 0; filter: grayscale(1) contrast(1.25) brightness(2.6); }
  @media (max-width: 959px) { .r-hero-media :global(img) { object-position: 62% 50%; } }
  .r-hero-media video { opacity: 0; transition: opacity 1.6s ease; }
  .r-hero-media video:global(.is-on) { opacity: 1; }
  .r-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 4 5 / 0.35) 0%, rgb(10 4 5 / 0) 28%, rgb(10 4 5 / 0.25) 55%, rgb(10 4 5 / 0.82) 82%, var(--bg) 100%); pointer-events: none; }
  .r-glow { position: absolute; inset: -10%; background: radial-gradient(38% 50% at 74% 34%, rgb(255 36 16 / 0.62), transparent 72%), radial-gradient(30% 40% at 12% 78%, rgb(255 20 10 / 0.4), transparent 70%), radial-gradient(60% 30% at 50% 0%, rgb(255 30 20 / 0.28), transparent 70%); mix-blend-mode: screen; pointer-events: none; z-index: 1; }
  .r-hero-in { position: relative; z-index: 2; display: grid; gap: clamp(20px, 3vw, 36px); padding: 120px var(--g) clamp(36px, 5vw, 64px); }
  .r-live { display: inline-flex; align-items: center; gap: 10px; font-family: var(--tk); font-stretch: 85%; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.85rem; color: #ffd9cf; }
  .r-live i { width: 9px; height: 9px; border-radius: 50%; background: var(--red); box-shadow: 0 0 12px 2px var(--red); animation: r-blink 1.6s ease-in-out infinite; }
  .r-hero h1 { display: grid; font-size: clamp(4.4rem, 1rem + 14vw, 15rem); font-weight: 900; line-height: 0.8; letter-spacing: -0.015em; margin-left: -0.04em; }
  .r-hot { color: var(--red); text-shadow: 0 0 0.25em rgb(255 43 28 / 0.55); }
  .r-hero-row { display: grid; gap: 24px; }
  .r-hero-row > p { max-width: 44ch; font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem); line-height: 1.5; color: #ffe3db; }
  .r-acts { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  @media (min-width: 960px) { .r-hero-row { grid-template-columns: 1fr auto; align-items: end; } }

  .r-btn { display: inline-flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 60px; padding: 0 22px 0 26px; background: var(--red); color: var(--bg); font-family: var(--tk); font-stretch: 85%; font-weight: 800; text-transform: uppercase; font-size: 1.1rem; letter-spacing: 0.01em; border-radius: 2px; box-shadow: 0 12px 44px -10px rgb(255 43 28 / 0.7); transition: background-color 0.25s ease, box-shadow 0.25s ease, transform 0.16s ease; }
  .r-btn :global(svg) { width: 20px; height: 16px; transition: transform 0.35s var(--ease); }
  .r-btn:hover { background: #ff4a2a; box-shadow: 0 14px 60px -8px rgb(255 43 28 / 0.95); }
  .r-btn:hover :global(svg) { transform: translateX(5px); }
  .r-btn:active { transform: scale(0.97); }
  .r-btn-wide { width: 100%; }
  .r-ghost { display: inline-flex; align-items: center; min-height: 60px; padding: 0 22px; border: 1px solid rgb(255 220 210 / 0.4); border-radius: 2px; font-family: var(--tk); font-stretch: 85%; font-weight: 600; text-transform: uppercase; font-size: 1rem; transition: border-color 0.25s ease, color 0.25s ease; }
  .r-ghost:hover { border-color: var(--red); color: var(--red); }
  .r-arrow { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-family: var(--tk); font-stretch: 85%; font-weight: 700; text-transform: uppercase; font-size: 0.95rem; letter-spacing: 0.04em; color: var(--ink); }
  .r-arrow :global(svg) { width: 15px; height: 12px; color: var(--red); transition: transform 0.35s var(--ease); }
  .r-arrow:hover :global(svg) { transform: translateX(5px); }

  /* ---------- Ленты ---------- */
