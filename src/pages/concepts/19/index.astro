---
// Концепция 19 «Цифры»: клуб как инфографика в духе FT и годового отчёта.
// Светлая бумага, Onest для текста и больших цифр, IBM Plex Mono для подписей и значений,
// один акцент #ff5722. Графики только по реальным данным из src/data: часы работы по дням,
// цена дня по тарифам, матрица «что входит», площадь в масштабе, шкала рейтинга.
// Графики дорисовываются при прокрутке (GSAP грузится лениво), без анимации всё видно сразу.
import { Image } from 'astro:assets';
import onestCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import '@fontsource/ibm-plex-mono/cyrillic-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/cyrillic-500.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs } from '../../../data/content';

const fonts = `
@font-face{font-family:'Onest n';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestCyr}) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Onest n';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestLat}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;

const num = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const [day, full, all] = plans;
const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;
const programCount = programs.reduce((s, p) => s + p.items.length, 0);

// Недельная сетка: 7 дней × 36 получасов с 06:00 до 24:00
const days = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
const toH = (t: string) => { const [h, m] = t.split(':').map(Number); return h + m / 60; };
const [wdO, wdC] = site.hours[0].time.split('–').map(toH);
const [weO, weC] = site.hours[1].time.split('–').map(toH);
const dayCardEnd = 16;
const START = 0, SLOTS = 48;
const week = days.map((d, i) => {
  const [o, c] = i < 5 ? [wdO, wdC] : [weO, weC];
  return {
    d, o, c,
    cells: Array.from({ length: SLOTS }, (_, k) => {
      const s = START + k / 2;
      const open = s >= o && s + 0.5 <= c;
      return { open, late: open && s >= dayCardEnd };
    }),
  };
});
const weekHours = week.reduce((s, w) => s + (w.c - w.o), 0);
const pct = (h: number) => ((h - START) / (24 - START)) * 100;
const ticks = [0, 3, 6, 9, 12, 15, 18, 21, 24];

// Цена дня: месяц делим на 30 дней, год на 365
const perDayRows = plans.map((p) => ({
  name: p.name, hours: p.hours,
  m: perDay(p.month, 30), y: perDay(p.year, 365),
  save: Math.round((1 - p.year / (p.month * 12)) * 100),
  month: p.month, year: p.year, id: p.id, tag: p.tag,
}));
const maxDay = 90;
const dayRate = perDay(day.month, 30);

// Матрица: что входит в каждый тариф
const matrix: [string, number, number, number][] = [
  ['Тренажёрный зал и кардиозона', 1, 1, 1],
  ['Фитнес-тестирование', 1, 1, 1],
  ['Раздевалки и душевые', 1, 1, 1],
  ['Бесплатная парковка', 1, 1, 1],
  ['Вечернее время, до закрытия клуба', 0, 1, 1],
  ['Пробная тренировка с тренером', 0, 1, 1],
  ['Групповые программы без доплат', 0, 0, 1],
  ['SPA: финская сауна, хаммам, релакс-зона', 0, 0, 1],
  ['Приоритетное обслуживание', 0, 0, 1],
];
const totals = [1, 2, 3].map((c) => matrix.reduce((s, r) => s + (r[c] as number), 0));

const areaSide = Math.sqrt(150 / 1300) * 100;
const personalLine = `${personal.pack} тренировок, ${rub(personal.price)}`;
const perSession = rub(Math.round(personal.price / personal.pack));
const hoursLine = site.hours.map((h) => `${h.days} ${h.time}`).join(', ');
---
<Layout title="Концепция 19 «Цифры»" description="Концепция дизайна сайта Urban210: клуб в цифрах, инфографика и графики по реальным данным." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={onestCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="root c19">
    <header class="top">
      <div class="w top-in">
        <a class="n-logo" href="/concepts/19/" aria-label="Urban210, на главную">URBAN<b>210</b><Icon name="chev" /></a>
        <nav class="top-nav" aria-label="Разделы">
          <a href="#chasy">Часы</a><a href="#ceny">Цены</a><a href="#klub">Клуб</a><a href="#lyudi">Тренеры</a><a href="#otzyvy">Отзывы</a>
        </nav>
        <p class="top-now mono" data-now aria-live="off"><i></i><span data-now-label>Хабаровск</span></p>
        <a class="b b-ink b-s" href="#zayavka" data-lead="Заявка с сайта" data-block="19_header">Оставить заявку<Icon name="chev" class="chev" /></a>
      </div>
    </header>

    <main>
      <!-- Первый экран -->
      <section class="n-hero w" aria-labelledby="h1-19">
        <div class="n-hero-txt">
          <p class="kick mono"><span>Urban210</span><span>Фитнес-клуб, Хабаровск</span></p>
          <h1 id="h1-19">Клуб, который можно посчитать</h1>
          <p class="sub">Площадь, часы, цена одного дня и всё, что входит в абонемент. Без громких слов, только цифры. День по дневной карте стоит от {dayRate}&nbsp;₽.</p>
          <div class="n-hero-cta">
            <a class="b b-acc" href="#tarify" data-block="19_hero">Выбрать карту<Icon name="chev" class="chev" /></a>
            <a class="ln" href="#ceny">Сколько стоит день<Icon name="chev1" /></a>
          </div>
        </div>
        <figure class="n-hero-fig">
          <div class="n-hero-ph">
            <Image src={img('/images/zal.jpg')} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 800, 1200]} sizes="(min-width: 1100px) 640px, calc(100vw - 32px)" loading="eager" fetchpriority="high" format="webp" quality={55} />
            <span class="pin" style="--x:30%;--y:72%" aria-hidden="true"></span>
            <span class="pin-lab mono" style="--x:30%;--y:72%">{site.facts.machines}</span>
            <span class="pin" style="--x:78%;--y:52%" aria-hidden="true"></span>
            <span class="pin-lab pin-lab-r mono" style="--x:78%;--y:52%">веса до 60 кг</span>
            <span class="dim" aria-hidden="true"><i></i><b class="mono">более 1300 м²</b><i></i></span>
          </div>
          <figcaption class="cap mono">Тренажёрный зал, {site.address.short}</figcaption>
        </figure>
      </section>

      <!-- Главные цифры -->
      <section class="w kpis" aria-label="Главные цифры клуба">
        <div class="kpi" data-kpi>
          <p class="kpi-k mono">Площадь клуба</p>
          <p class="kpi-n"><span class="cnt" data-count="1300">1300</span><small>м²</small></p>
          <svg class="kpi-v" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><rect class="bar-bg" width="200" height="14" /><rect class="bar-a grow" width={200 * 150 / 1300} height="14" /></svg>
          <p class="kpi-t">больше 1300 м², оранжевым: зал групповых</p>
        </div>
        <div class="kpi" data-kpi>
          <p class="kpi-k mono">Тренажёры</p>
          <p class="kpi-n"><span class="cnt" data-count="60">60</span><small>+</small></p>
          <svg class="kpi-v" viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true">{Array.from({ length: 60 }, (_, i) => <rect class="tick" x={i * 4} width="2" height="14" />)}</svg>
          <p class="kpi-t">{site.facts.brands}</p>
        </div>
        <div class="kpi" data-kpi>
          <p class="kpi-k mono">Парковка</p>
          <p class="kpi-n"><span class="cnt" data-count="50">50</span><small>мест</small></p>
          <svg class="kpi-v kpi-dots" viewBox="0 0 250 14" aria-hidden="true">{Array.from({ length: 50 }, (_, i) => <circle class="dot" cx={(i % 25) * 10 + 3} cy={Math.floor(i / 25) * 8 + 3} r="2.6" />)}</svg>
          <p class="kpi-t">бесплатно, под видеонаблюдением</p>
        </div>
        <div class="kpi" data-kpi>
          <p class="kpi-k mono">Зал групповых</p>
          <p class="kpi-n"><span class="cnt" data-count="150">150</span><small>м²</small></p>
          <svg class="kpi-v" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><rect class="bar-a grow" width="200" height="14" /></svg>
          <p class="kpi-t">{programCount} программ в {programs.length} направлениях</p>
        </div>
        <div class="kpi" data-kpi>
          <p class="kpi-k mono">Хаммам</p>
          <p class="kpi-n"><span>40–50</span><small>°C</small></p>
          <svg class="kpi-v" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><rect class="bar-bg" width="200" height="14" /><rect class="bar-a grow" x="80" width="20" height="14" /></svg>
          <p class="kpi-t">на шкале от 0 до 100 °C</p>
        </div>
        <div class="kpi" data-kpi>
          <p class="kpi-k mono">Рейтинг</p>
          <p class="kpi-n"><span>{rating}</span><small>из 5</small></p>
          <svg class="kpi-v" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><rect class="bar-bg" width="200" height="14" /><rect class="bar-ink grow" width={200 * site.rating.value / 5} height="14" /></svg>
          <p class="kpi-t">{site.rating.text} на Яндекс Картах</p>
        </div>
      </section>

      <!-- Рис. 1. Часы -->
      <section class="n-sec w" id="chasy" aria-labelledby="h-hours">
        <div class="fig-head">
          <p class="fig-n mono">Рис. 1</p>
          <h2 id="h-hours">Открыто {weekHours} часов в неделю</h2>
          <p class="fig-d">Каждая клетка: полчаса. Тёмные клетки: клуб открыт. Оранжевая линия: сейчас в Хабаровске.</p>
        </div>

        <div class="wk-wrap">
          <div class="wk-ctl" role="radiogroup" aria-label="Показать часы тарифа" data-wk-ctl>
            <button type="button" role="radio" aria-checked="true" data-v="all">Все часы работы</button>
            <button type="button" role="radio" aria-checked="false" data-v="day">Часы дневной карты</button>
          </div>

          <div class="wk" data-wk>
            <div class="wk-hours mono" aria-hidden="true">
              {ticks.map((t) => <span style={`--p:${pct(t)}%`}>{String(t).padStart(2, '0')}:00</span>)}
            </div>
            <div class="wk-days mono" aria-hidden="true">{week.map((w) => <span data-wk-day>{w.d}</span>)}</div>
            <div class="wk-grid" role="img" aria-label={`Часы работы: ${hoursLine}. Дневная карта действует до 16:00.`}>
              {week.map((w) => w.cells.map((c) => <i class:list={[{ o: c.open, l: c.late }]}></i>))}
              <span class="wk-now" data-wk-now hidden><b class="mono" data-wk-now-t></b></span>
            </div>
          </div>

          <aside class="wk-side">
            <p class="wk-status" data-status><i></i><span data-status-t>Пн–Пт 06:30–23:30</span></p>
            <p class="wk-left mono" data-status-l>Сб–Вс 07:30–22:30</p>
            <dl class="wk-dl">
              {site.hours.map((h) => <div><dt>{h.days}</dt><dd class="mono">{h.time}</dd></div>)}
              <div><dt>«{day.name}»</dt><dd class="mono">до 16:00</dd></div>
            </dl>
          </aside>
        </div>

        <div class="gantt" aria-label="Какие часы покрывает тариф, по будням">
          <p class="gantt-k mono">По будням</p>
          <div class="g-row">
            <span class="g-name">«{day.name}»</span>
            <span class="g-track"><span class="g-bar g-acc grow" style={`--a:${pct(wdO)}%;--b:${pct(dayCardEnd)}%`}><b class="mono">06:30–16:00</b></span></span>
          </div>
          <div class="g-row">
            <span class="g-name">«{full.name}», «{all.name}»</span>
            <span class="g-track"><span class="g-bar g-ink grow" style={`--a:${pct(wdO)}%;--b:${pct(wdC)}%`}><b class="mono">06:30–23:30</b></span></span>
          </div>
          <div class="g-axis mono" aria-hidden="true"><span></span><span class="g-ticks">{ticks.map((t) => <i style={`--p:${pct(t)}%`}>{t}</i>)}</span></div>
        </div>
        <p class="src mono">Источник: часы работы клуба. Дневная карта действует с 6:30 до 16:00, в выходные клуб открывается в 7:30.</p>
      </section>

      <!-- Рис. 2. Цена дня -->
      <section class="n-sec w" id="ceny" aria-labelledby="h-price">
        <div class="fig-head">
          <p class="fig-n mono">Рис. 2</p>
          <h2 id="h-price">Сколько стоит один день в клубе</h2>
          <p class="fig-d">Цена абонемента, делённая на дни: месяц на 30, год на 365. Чем длиннее срок, тем дешевле день.</p>
        </div>

        <div class="bars">
          <div class="bars-legend mono" aria-hidden="true"><span><i class="sw sw-g"></i>оплата за месяц</span><span><i class="sw sw-a"></i>оплата за год</span></div>
          <div class="bars-plot">
            <div class="bars-grid" aria-hidden="true">{[0, 20, 40, 60, 80].map((v) => <span style={`--p:${v / maxDay * 100}%`}><b class="mono">{v} ₽</b></span>)}</div>
            {perDayRows.map((r) => (
              <div class="bar-row">
                <p class="bar-name">{r.name}<small>{r.hours}</small></p>
                <div class="bar-pair">
                  <span class="bar bar-g grow" style={`--w:${r.m / maxDay * 100}%`}><b class="mono">{r.m} ₽</b></span>
                  <span class="bar bar-a grow" style={`--w:${r.y / maxDay * 100}%`}><b class="mono">{r.y} ₽</b></span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="n-plans" id="tarify">
          {perDayRows.map((r) => (
            <article class:list={['n-plan', { 'n-plan-top': r.id === 'all' }]}>
              <header>
                <h3>{r.name}</h3>
                {r.tag && <span class="tag mono">{r.tag}</span>}
              </header>
              <p class="n-plan-h">{r.hours[0].toUpperCase() + r.hours.slice(1)}</p>
              <dl class="n-plan-dl">
                <div><dt>Месяц</dt><dd class="mono">{rub(r.month)}</dd></div>
                <div><dt>Год</dt><dd class="mono">{rub(r.year)}</dd></div>
                <div><dt>Год против 12 месяцев</dt><dd class="mono acc">−{r.save}%</dd></div>
                <div><dt>День при оплате за год</dt><dd class="mono">{r.y} ₽</dd></div>
              </dl>
              <a class:list={['b', r.id === 'all' ? 'b-acc' : 'b-line']} href="#zayavka" data-lead={`Тариф «${r.name}»`} data-block={`19_plan_${r.id}`}>Выбрать<Icon name="chev" class="chev" /></a>
            </article>
          ))}
        </div>
        <p class="src mono">Источник: тарифы клуба. Экономия: цена года против двенадцати оплат по месяцу.</p>
      </section>

      <!-- Рис. 3. Матрица -->
      <section class="n-sec w" aria-labelledby="h-mx">
        <div class="fig-head">
          <p class="fig-n mono">Рис. 3</p>
          <h2 id="h-mx">Что входит в каждый тариф</h2>
          <p class="fig-d">Девять пунктов. Закрашенная клетка: входит в тариф без доплат.</p>
        </div>
        <div class="mx" role="table" aria-label="Что входит в тарифы">
          <div class="mx-r mx-h" role="row">
            <span role="columnheader" class="mx-f"><span class="sr">Что входит</span></span>
            {plans.map((p) => <span role="columnheader" class="mx-p">{p.name}</span>)}
          </div>
          {matrix.map((r) => (
            <div class="mx-r" role="row">
              <span role="rowheader" class="mx-f">{r[0]}</span>
              {[1, 2, 3].map((c) => (
                <span role="cell" class="mx-c">
                  <i class:list={['sq', { on: r[c] }]} aria-hidden="true"></i>
                  <span class="sr">{r[c] ? 'входит' : 'не входит'}</span>
                </span>
              ))}
            </div>
          ))}
          <div class="mx-r mx-t" role="row">
            <span role="rowheader" class="mx-f mono">Итого</span>
            {totals.map((t) => <span role="cell" class="mx-c mono"><b>{t}</b>/{matrix.length}</span>)}
          </div>
        </div>
      </section>

      <!-- Рис. 4. Клуб -->
      <section class="n-sec w" id="klub" aria-labelledby="h-club">
        <div class="club-head">
          <div class="fig-head">
            <p class="fig-n mono">Рис. 4</p>
            <h2 id="h-club">Четыре зоны на двух этажах</h2>
            <p class="fig-d">Слева площадь клуба и зал групповых программ в одном масштабе.</p>
          </div>
          <figure class="area">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <defs><pattern id="hatch19" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="0.8" height="3" fill="currentColor" /></pattern></defs>
              <rect class="area-big grow-sq" x="0.5" y="0.5" width="99" height="99" />
              <rect class="area-sm grow-sq" x="0.5" y={100 - areaSide - 0.5} width={areaSide} height={areaSide} />
            </svg>
            <figcaption class="mono"><span>Клуб: более 1300 м²</span><span class="acc">Зал групповых: 150 м²</span></figcaption>
          </figure>
        </div>

        <div class="n-zones">
          <article class="n-zone">
            <div class="n-zone-ph"><Image src={img('/images/machines.jpg')} alt="Силовые тренажёры в зале Urban210" widths={[400, 640]} sizes="(min-width: 900px) 300px, calc(100vw - 32px)" format="avif" quality={45} /></div>
            <div class="n-zone-txt"><h3>{zal.title}</h3><p>{zal.text}</p></div>
            <div class="n-zone-m"><p class="n-zone-n">60<small>+</small></p><p class="mono">тренажёров, гантели до 60 кг</p></div>
          </article>
          <article class="n-zone">
            <div class="n-zone-ph"><Image src={img('/images/cardio.jpg')} alt="Беговые дорожки в кардиозоне" widths={[400, 640]} sizes="(min-width: 900px) 300px, calc(100vw - 32px)" format="avif" quality={45} /></div>
            <div class="n-zone-txt"><h3>{cardio.title}</h3><p>{cardio.text} Отдельный верхний этаж.</p></div>
            <div class="n-zone-m"><p class="n-zone-n">2<small>этаж</small></p><p class="mono">Technogym Skillrun</p></div>
          </article>
          <article class="n-zone">
            <div class="n-zone-ph"><Image src={img('/images/group.jpg')} alt="Групповое занятие в зале на 150 м²" widths={[400, 640]} sizes="(min-width: 900px) 300px, calc(100vw - 32px)" format="avif" quality={45} /></div>
            <div class="n-zone-txt"><h3>{group.title}</h3><p>{group.text}</p>
              <ul class="n-chips mono">{programs.flatMap((p) => p.items).map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="n-zone-m"><p class="n-zone-n">150<small>м²</small></p><p class="mono">{programCount} программ</p></div>
          </article>
          <article class="n-zone">
            <div class="n-zone-ph n-zone-heat" aria-hidden="true">
              <svg viewBox="0 0 300 200" preserveAspectRatio="none">
                {Array.from({ length: 11 }, (_, i) => <line x1={20 + i * 26} x2={20 + i * 26} y1="150" y2={i % 5 === 0 ? 138 : 144} />)}
                <rect class="heat-band grow" x={20 + 4 * 26} y="60" width="26" height="90" />
                <text x="20" y="172">0</text><text x={20 + 5 * 26} y="172" text-anchor="middle">50</text><text x={20 + 10 * 26} y="172" text-anchor="end">100 °C</text>
              </svg>
            </div>
