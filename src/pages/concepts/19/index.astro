<style>
  .c19 {
    --p: #f4f3ef; --ink: #141414; --ink2: #5a564f; --rule: #d6d2c9; --g: #bdb8ae; --g2: #e4e1da;
    --acc: #ff5722; --acc-t: #c2380f;
    --sans: 'Onest n', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    --gut: clamp(16px, 3.4vw, 48px);
    font-family: var(--sans); font-size: 17px; line-height: 1.55; color: var(--ink);
    font-feature-settings: 'tnum' 1;
  }
  .c19 h1, .c19 h2, .c19 h3 { font-family: var(--sans); font-weight: 500; letter-spacing: -0.035em; color: var(--ink); }
  .mono { font-family: var(--mono); font-weight: 400; letter-spacing: 0; }
  .acc { color: var(--acc-t); }
  .w { width: 100%; max-width: 1360px; margin-inline: auto; padding-inline: var(--gut); }
  .sr { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Кнопки */
  .b { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; padding: 0 20px 0 22px; font-weight: 550; font-size: 1rem; text-decoration: none; border: 1px solid var(--ink); transition: background-color 0.25s ease, color 0.25s ease; white-space: nowrap; }
  .b :global(.chev) { width: 18px; height: 12px; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .b:hover :global(.chev) { transform: translateX(4px); }
  .b-acc { background: var(--acc); border-color: var(--acc); color: var(--ink); }
  .b-acc:hover { background: var(--ink); border-color: var(--ink); color: var(--p); }
  .b-ink { background: var(--ink); color: var(--p); }
  .b-ink:hover { background: var(--acc); border-color: var(--acc); color: var(--ink); }
  .b-line { background: transparent; color: var(--ink); }
  .b-line:hover { background: var(--ink); color: var(--p); }
  .b-s { min-height: 40px; padding: 0 14px 0 16px; font-size: 0.9rem; }
  .ln { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink); padding-bottom: 2px; font-weight: 500; }
  .ln :global(svg) { width: 8px; height: 12px; }

  /* Шапка */
  .top { position: sticky; top: 0; z-index: 30; background: rgb(244 243 239 / 0.94); border-bottom: 1px solid var(--ink); }
  .top-in { display: flex; align-items: center; gap: 28px; min-height: 60px; }
  .n-logo { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; letter-spacing: 0.04em; text-decoration: none; font-size: 1.05rem; }
  .n-logo b { color: var(--acc); font-weight: 700; }
  .n-logo :global(svg) { width: 15px; height: 14px; color: var(--acc); }
  .top-nav { display: none; gap: 24px; font-size: 0.92rem; }
  .top-nav a { text-decoration: none; color: var(--ink2); }
  .top-nav a:hover { color: var(--ink); }
  .top-now { margin-left: auto; display: none; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--ink2); }
  .top-now i, .wk-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--g); flex: none; }
  .c19.is-open .top-now i, .c19.is-open .wk-status i { background: var(--acc); box-shadow: 0 0 0 4px rgb(255 87 34 / 0.18); }
  .top .b { margin-left: auto; }
  @media (min-width: 760px) { .top-now { display: inline-flex; } .top .b { margin-left: 0; } }
  @media (min-width: 1100px) { .top-nav { display: flex; } }

  /* Первый экран */
  .n-hero { display: grid; gap: 32px; padding-top: clamp(32px, 5vw, 72px); padding-bottom: clamp(36px, 5vw, 64px); }
  .kick { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.78rem; color: var(--ink2); padding-bottom: 14px; border-bottom: 1px solid var(--rule); margin-bottom: 26px; }
  .kick span:first-child { color: var(--ink); }
  .n-hero h1 { font-size: clamp(2.6rem, 1.4rem + 5.2vw, 6.2rem); line-height: 0.96; letter-spacing: -0.05em; font-weight: 500; max-width: 9.5em; }
  .sub { margin-top: 24px; max-width: 34em; font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem); color: var(--ink2); line-height: 1.5; }
  .n-hero-cta { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; }
  .n-hero-fig { margin: 0; }
  .n-hero-ph { position: relative; aspect-ratio: 3 / 2; background: var(--g2); }
  .n-hero-ph :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .pin { position: absolute; left: var(--x); top: var(--y); width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 0 5px rgb(255 87 34 / 0.3); }
  .pin-lab { position: absolute; left: var(--x); top: var(--y); transform: translate(-12px, calc(-100% - 22px)); background: var(--p); color: var(--ink); font-size: 0.74rem; padding: 6px 9px; white-space: nowrap; border: 1px solid var(--ink); }
  .pin-lab::after { content: ''; position: absolute; left: 11px; top: 100%; width: 1px; height: 15px; background: var(--ink); }
  .pin-lab-r { transform: translate(calc(-100% + 12px), calc(-100% - 22px)); }
  .pin-lab-r::after { left: auto; right: 11px; }
  .dim { position: absolute; left: 4%; right: 4%; bottom: 6%; display: flex; align-items: center; gap: 10px; color: #fff; }
  .dim i { flex: 1; height: 1px; background: currentColor; position: relative; }
  .dim i:first-child::before, .dim i:last-child::after { content: ''; position: absolute; top: -6px; width: 1px; height: 13px; background: currentColor; }
  .dim i:first-child::before { left: 0; } .dim i:last-child::after { right: 0; }
  .dim b { font-weight: 500; font-size: 0.8rem; background: rgb(20 20 20 / 0.7); padding: 3px 8px; }
  .cap { margin-top: 10px; font-size: 0.74rem; color: var(--ink2); }
  @media (min-width: 1000px) {
    .n-hero { grid-template-columns: 1fr minmax(0, 1.05fr); gap: 56px; align-items: end; }
  }

  /* Главные цифры */
  .kpis { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--ink); }
  .kpi { padding: 18px 14px 22px 0; border-bottom: 1px solid var(--rule); display: grid; align-content: start; gap: 10px; min-width: 0; }
  .kpi:nth-child(2n) { padding-left: 14px; border-left: 1px solid var(--rule); }
  .kpi-k { font-size: 0.74rem; color: var(--ink2); }
  .kpi-n { font-size: clamp(2.4rem, 1.6rem + 3vw, 4.4rem); font-weight: 400; letter-spacing: -0.05em; line-height: 0.9; white-space: nowrap; }
  .kpi-n small { font-size: 0.36em; letter-spacing: 0; margin-left: 4px; color: var(--ink2); font-weight: 450; }
  .kpi-v { width: 100%; height: 14px; overflow: visible; }
  .kpi-t { font-size: 0.86rem; color: var(--ink2); line-height: 1.4; }
  .bar-bg { fill: var(--g2); }
  .bar-a { fill: var(--acc); }
  .bar-ink { fill: var(--ink); }
  .tick { fill: var(--ink); }
  .dot { fill: var(--ink); }
  @media (min-width: 1000px) {
    .kpis { grid-template-columns: repeat(6, 1fr); }
    .kpi-n { font-size: clamp(2.4rem, 0.8rem + 2.4vw, 3.5rem); }
    .kpi, .kpi:nth-child(2n) { padding: 20px 20px 26px; border-left: 1px solid var(--rule); border-bottom: 1px solid var(--ink); }
    .kpi:first-child { border-left: 0; padding-left: 0; }
  }

  /* Секции и подписи к рисункам */
  .n-sec { padding-top: clamp(72px, 9vw, 140px); }
  .fig-head { display: grid; gap: 14px; max-width: 760px; margin-bottom: clamp(28px, 4vw, 48px); }
  .fig-n { font-size: 0.78rem; color: var(--acc-t); padding-top: 12px; border-top: 3px solid var(--ink); width: max-content; min-width: 64px; }
  .fig-head h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem); line-height: 1.02; letter-spacing: -0.045em; }
  .fig-d { color: var(--ink2); max-width: 40em; }
