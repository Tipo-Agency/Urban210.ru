</Layout>

<script>
  // Сейчас в Хабаровске: статус клуба в шапке и линия на недельной сетке
  const root = document.querySelector<HTMLElement>('.c19')!;
  const hm = (x: number) => `${String(Math.floor(x / 60) % 24).padStart(2, '0')}:${String(x % 60).padStart(2, '0')}`;
  const WD = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  const paint = () => {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Vladivostok', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value || '';
    const d = WD.indexOf(get('weekday'));
    const m = Number(get('hour')) * 60 + Number(get('minute'));
    const we = d >= 5;
    const [o, c] = we ? [450, 1350] : [390, 1410];
    const open = m >= o && m < c;
    const nextWe = d === 4 || d === 5;
    const next = m < o ? `откроемся в ${hm(o)}` : `откроемся завтра в ${hm(nextWe ? 450 : 390)}`;
    const left = c - m;
    root.classList.toggle('is-open', open);
    const nowLab = root.querySelector('[data-now-label]');
    if (nowLab) nowLab.textContent = open ? `${hm(m)} · открыто до ${hm(c)}` : `${hm(m)} · ${next}`;
    const st = root.querySelector('[data-status-t]');
    if (st) st.textContent = open ? 'Сейчас открыто' : 'Сейчас закрыто';
    const sl = root.querySelector('[data-status-l]');
    if (sl) sl.textContent = open ? `${hm(m)} в Хабаровске, до закрытия ${Math.floor(left / 60)} ч ${left % 60} мин` : `${hm(m)} в Хабаровске, ${next}`;
    root.querySelectorAll<HTMLElement>('[data-wk-day]').forEach((el, i) => el.classList.toggle('is-today', i === d));
    const mark = root.querySelector<HTMLElement>('[data-wk-now]');
    if (mark) {
      const t = m / 1440;
      mark.hidden = t < 0 || t > 1;
      mark.style.setProperty('--t', String(Math.min(Math.max(t, 0), 1)));
      mark.style.setProperty('--d', String(d));
      const mt = mark.querySelector('[data-wk-now-t]');
      if (mt) mt.textContent = hm(m);
    }
  };
  paint();
  setInterval(paint, 30000);

  // Переключатель тарифа на сетке часов
  const ctl = root.querySelector<HTMLElement>('[data-wk-ctl]');
  const wk = root.querySelector<HTMLElement>('[data-wk]');
  ctl?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    ctl.querySelectorAll('button').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    wk?.classList.toggle('only-day', b.dataset.v === 'day');
  }));

  // Графики дорисовываются при прокрутке. GSAP грузим после load, при reduce ничего не двигаем.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const run = async () => {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);
    const st = (el: Element, start = 'top 85%') => ({ trigger: el, start, once: true });
    const fmt = (n: number) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');

    root.querySelectorAll<HTMLElement>('[data-kpi]').forEach((k, i) => {
      const tl = gsap.timeline({ scrollTrigger: st(k, 'top 95%'), delay: (i % 3) * 0.08 });
      tl.from(k.querySelectorAll('.tick, .dot'), { scale: 0, transformOrigin: '50% 100%', duration: 0.5, stagger: 0.012, ease: 'power2.out' }, 0)
        .from(k.querySelectorAll('.grow'), { scaleX: 0, transformOrigin: '0% 50%', duration: 1.1, ease: 'expo.out' }, 0);
      const c = k.querySelector<HTMLElement>('[data-count]');
      if (c) {
        const o = { v: 0 }, to = Number(c.dataset.count);
        tl.to(o, { v: to, duration: 1.4, ease: 'expo.out', onUpdate: () => { c.textContent = fmt(o.v); } }, 0);
      }
    });

    const grid = root.querySelector('.wk-grid');
    if (grid) {
      gsap.from(grid.querySelectorAll('i'), { opacity: 0, scale: 0.4, duration: 0.5, ease: 'power2.out', stagger: { each: 0.008, grid: [7, 48], from: 'start', axis: 'x' }, scrollTrigger: st(grid) });
      gsap.from(grid.querySelector('.wk-now'), { opacity: 0, duration: 0.6, delay: 1, scrollTrigger: st(grid) });
    }
    root.querySelectorAll('.gantt .grow').forEach((b, i) => gsap.from(b, { scaleX: 0, transformOrigin: '0% 50%', duration: 1.2, delay: i * 0.15, ease: 'expo.out', scrollTrigger: st(b) }));
    const bars = root.querySelector('.bars-plot');
    if (bars) {
      gsap.from(bars.querySelectorAll('.bar'), { scaleX: 0, transformOrigin: '0% 50%', duration: 1.2, ease: 'expo.out', stagger: 0.09, scrollTrigger: st(bars, 'top 75%') });
      gsap.from(bars.querySelectorAll('.bar b'), { opacity: 0, x: -8, duration: 0.5, stagger: 0.09, delay: 0.6, scrollTrigger: st(bars, 'top 75%') });
    }
    const mx = root.querySelector('.mx');
    if (mx) gsap.from(mx.querySelectorAll('.sq.on'), { scale: 0, duration: 0.45, ease: 'back.out(1.4)', stagger: 0.03, scrollTrigger: st(mx, 'top 75%') });
    root.querySelectorAll('.area .grow-sq').forEach((s, i) => gsap.from(s, { scale: 0, transformOrigin: '0% 100%', duration: 1.3, delay: i * 0.35, ease: 'expo.out', scrollTrigger: st(s) }));
    root.querySelectorAll('.heat-band, .rate .grow').forEach((s) => gsap.from(s, { scaleY: s.classList.contains('heat-band') ? 0 : 1, scaleX: s.classList.contains('heat-band') ? 1 : 0, transformOrigin: '0% 100%', duration: 1.2, ease: 'expo.out', scrollTrigger: st(s) }));
  };
  if (!reduce) {
    const go = () => ('requestIdleCallback' in window ? requestIdleCallback(() => run(), { timeout: 1200 }) : setTimeout(run, 300));
    if (document.readyState === 'complete') go();
    else addEventListener('load', go, { once: true });
  }
</script>

