  /* ---------- Тренеры ---------- */
  .f5-team { display: grid; gap: 12px; }
  .f5-coach { position: relative; overflow: hidden; border-radius: var(--r-l); background: #2a2830; color: #fff; transition: transform 0.5s var(--lift), box-shadow 0.4s ease; }
  .f5-coach:hover { transform: translateY(-6px) rotate(-0.6deg); box-shadow: var(--sh-up); }
