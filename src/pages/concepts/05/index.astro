  .f5-feed-rv p { font-size: 1rem; line-height: 1.5; flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 10; -webkit-box-orient: vertical; }
  .f5-feed-rv footer { display: grid; gap: 2px; }
  .f5-feed-rv footer b { font-weight: 800; font-size: 1.05rem; }
  .f5-feed-rv footer span { font-size: 0.85rem; opacity: 0.75; font-weight: 600; }
  .t-org { background: var(--org); color: #fff; }
