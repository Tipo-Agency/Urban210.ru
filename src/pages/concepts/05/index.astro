  .f5-plans { display: grid; gap: 12px; }
  .f5-plan { display: flex; flex-direction: column; gap: 14px; padding: 28px; border-radius: var(--r-l); background: var(--bg); transition: transform 0.5s var(--lift), box-shadow 0.4s ease; }
  .f5-plan:hover { transform: translateY(-6px); box-shadow: var(--sh-up); }
  .f5-plan.is-hot { background: var(--org); color: #fff; }
  .f5-plan-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .f5-plan h3 { font-size: 1.6rem; letter-spacing: -0.035em; }
  .f5-plan-tag { padding: 6px 12px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
  .f5-plan.is-hot .f5-plan-tag { background: #fff; color: var(--org); rotate: 4deg; }
  .f5-plan-hours { font-size: 0.95rem; color: var(--mut); margin-top: -6px; }
  .f5-plan.is-hot .f5-plan-hours, .f5-plan.is-hot .f5-plan-day { color: rgb(255 255 255 / 0.85); }
  .f5-plan-price b { display: block; font-size: clamp(2.6rem, 2rem + 2vw, 3.4rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .f5-plan-price small { display: block; margin-top: 6px; font-size: 0.92rem; font-weight: 600; }
  .f5-plan-day { font-size: 0.92rem; font-weight: 600; color: var(--cob); }
  .f5-plan-list { list-style: none; display: grid; gap: 10px; padding-top: 16px; margin-bottom: 8px; border-top: 1px solid rgb(23 20 42 / 0.1); font-size: 0.97rem; }
  .f5-plan.is-hot .f5-plan-list { border-color: rgb(255 255 255 / 0.3); }
  .f5-plan-list li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; }
  .f5-plan-list :global(svg) { width: 22px; height: 22px; padding: 3px; border-radius: 50%; background: var(--ink); color: #fff; margin-top: 1px; }
  .f5-plan.is-hot .f5-plan-list :global(svg) { background: #fff; color: var(--org); }
  .f5-plan-list li.no { color: var(--mut); }
  .f5-plan-list li.no :global(svg) { background: rgb(23 20 42 / 0.1); color: var(--mut); }
  .f5-plan.is-hot .f5-plan-list li.no { color: rgb(255 255 255 / 0.88); }
  .f5-plan.is-hot .f5-plan-list li.no :global(svg) { background: rgb(255 255 255 / 0.2); color: #fff; }
  .f5-plan-btn { margin-top: auto; width: 100%; }
  .f5-prices .py { display: none; }
  .f5-prices:has(#f5-y:checked) .py { display: block; }
  .f5-prices:has(#f5-y:checked) .pm { display: none; }

  .f5-promos { list-style: none; display: grid; gap: 12px; margin-top: 12px; }
  .f5-promos li { display: grid; gap: 4px; padding: 20px 24px; border-radius: var(--r-m); box-shadow: inset 0 0 0 2px var(--bg); }
  .f5-promos b { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.02em; }
  .f5-promos span { color: var(--mut); font-size: 0.95rem; }
  @media (min-width: 980px) {
    .f5-plans { grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .f5-plan { padding: 36px; }
    .f5-plan.is-hot { transform: translateY(-12px); }
    .f5-plan.is-hot:hover { transform: translateY(-18px); }
        .f5-promos { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- Люди ---------- */
  .f5-rate-big { display: flex; align-items: center; gap: 16px; padding: 14px 24px 14px 18px; border-radius: 999px; background: var(--card); color: var(--ink); box-shadow: var(--sh); width: fit-content; transition: transform 0.35s var(--lift); }
  .f5-rate-big:hover { transform: translateY(-3px); }
