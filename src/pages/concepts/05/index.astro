  .f5-coach h3 { font-size: 1.3rem; letter-spacing: -0.03em; }
  .f5-coach p { margin-top: 4px; font-size: 0.9rem; opacity: 0.8; line-height: 1.35; }
  .f5-personal { position: relative; display: grid; align-content: space-between; gap: 20px; padding: 28px; border-radius: var(--r-l); background: var(--pch); color: #3b2219; }
  .f5-personal-body { display: grid; gap: 12px; }
  .f5-personal h3 { font-size: 1.8rem; letter-spacing: -0.04em; max-width: 10ch; }
  .f5-personal-price b { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; }
  .f5-personal .f5-pill { width: fit-content; margin-top: 6px; }
  .f5-personal .f5-stk { position: relative; rotate: 10deg; width: 104px; height: 104px; box-shadow: var(--sh); }
  .f5-personal .f5-stk b { font-size: 1.5rem; }
