  .f5-feed { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gut) * -1); padding: 10px var(--gut) 24px; scroll-padding-inline: var(--gut); }
  .f5-feed::-webkit-scrollbar { display: none; }
