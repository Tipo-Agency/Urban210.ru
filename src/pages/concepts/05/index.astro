---
// Концепция 05 «Дружелюбный»: светлая страница, крупные скруглённые карточки, оранжевый и кобальт.
// Geologica жирным, стикеры и кнопки-таблетки, люди клуба на фото. Движение: веер фото в первом экране
// раскрывается при загрузке и наведении, стикеры подкручиваются при прокрутке, бегущая строка.
import '@fontsource-variable/geologica/wght.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink, nav } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs, promos } from '../../../data/content';

const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;

// Главный оффер: дневная карта помесячно, 1 300 ₽ / 30 дней = 43 ₽ в день
const dayPlan = plans[0];
const dayPrice = perDay(dayPlan.month, 30);
const lead = { goal: 'Заявка на карту', title: 'Подобрать карту', button: 'Отправить заявку' };

const fan = [
  { src: '/images/community/6.jpg', alt: 'Пара после тренировки в Urban210' },
  { src: '/images/community/3.jpg', alt: 'Девушка тренируется в зале Urban210' },
  { src: '/images/community/12.jpg', alt: 'Гостья клуба у шкафчиков раздевалки' },
];

// лента «наши люди»: фото и отзывы вперемешку
const people = ['/images/community/2.jpg', '/images/community/13.jpg', '/images/community/9.jpg', '/images/community/15.jpg', '/images/community/11.jpg'];
const feed: ({ kind: 'photo'; src: string } | { kind: 'review'; r: (typeof reviews)[number]; tone: string })[] = [];
const tones = ['org', 'cob', 'wht', 'pch'];
people.forEach((p, i) => {
  feed.push({ kind: 'photo', src: p });
  if (reviews[i]) feed.push({ kind: 'review', r: reviews[i], tone: tones[i % tones.length] });
});

const marquee = [`Безлимит от ${dayPrice} ₽ в день`, 'Парковка на 50 мест бесплатно', 'Без очередей к тренажёрам', 'С 6:30 по будням', 'Сауна и хаммам'];
const tradeIn = promos.find((p) => p.slug === 'trade-in')!;
const onePlus = promos.find((p) => p.slug === '1-plus-1')!;
const year = new Date().getFullYear();
---
<Layout title="Концепция 05 «Дружелюбный»" description="Концепция дизайна сайта Urban210: светлая и дружелюбная, крупные карточки, оранжевый и кобальт." noindex bare>
  <div class="f5">
    <header class="f5-top">
      <div class="f5-bar">
        <a class="f5-logo" href="/concepts/05/" aria-label="Urban210, на главную">URBAN<b>210</b><span class="f5-logo-chev"><Icon name="chev" /></span></a>
        <nav class="f5-nav" aria-label="Меню">
          <a href="#price">Тарифы</a><a href="#zones">Клуб</a><a href="#people">Отзывы</a><a href="#team">Тренеры</a><a href="#lead">Контакты</a>
        </nav>
        <a class="f5-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="f5-pill f5-pill-org f5-top-cta" href="#price">Выбрать карту</a>
      </div>
    </header>

    <!-- Первый экран -->
    <section class="f5-hero" aria-labelledby="f5-h">
      <div class="f5-hero-card">
        <div class="f5-hero-text">
          <p class="f5-status" data-status><i></i><span>Хабаровск, {site.district}</span></p>
          <h1 id="f5-h">Безлимит в зал <span class="f5-price-chip">от&nbsp;{dayPrice}&nbsp;₽</span> в день</h1>
          <p class="f5-hero-lead">{dayPlan.name}: {rub(dayPlan.month)} в месяц. {site.facts.machines} {site.facts.brands}, групповые программы, сауна и хаммам.</p>
          <div class="f5-cta">
            <a class="f5-go" href="#price"><span>Выбрать карту</span><i><Icon name="chev" /></i></a>
            <a class="f5-pill f5-pill-ghost" href="#lead" data-lead={lead.goal} data-block="05_hero">Оставить заявку</a>
          </div>
        </div>
        <div class="f5-fan" aria-label="Гости клуба">
          {fan.map((f, i) => (
            <figure class={`f5-fan-card n${i}`}>
              <Image src={img(f.src)} alt={f.alt} widths={[280, 420]} sizes="(min-width: 980px) 260px, 42vw" loading={i === 1 ? 'eager' : 'lazy'} fetchpriority={i === 1 ? 'high' : undefined} format="webp" quality={50} />
            </figure>
          ))}
          <span class="f5-stk f5-stk-cob" data-spin><b>{dayPrice} ₽</b>в день</span>
          <a class="f5-stk-rate" href={site.maps.yandexReviews} target="_blank" rel="noopener"><Icon name="star" /><b>4,7</b><span>{site.rating.text}</span></a>
        </div>
        <div class="f5-marquee" aria-hidden="true">
          <div class="f5-marquee-track">
            {[0, 1].map(() => marquee.map((m) => <span>{m}<Icon name="chev" /></span>))}
          </div>
        </div>
      </div>
      <ul class="f5-facts">
        <li><Icon name="clock" /><div><b>{site.hours[0].days} {site.hours[0].time}</b><span>{site.hours[1].days} {site.hours[1].time}</span></div></li>
        <li><Icon name="pin" /><div><b>{site.address.short}</b><span>{site.district}</span></div></li>
        <li><span class="f5-p">P</span><div><b>Парковка на 50 мест</b><span>бесплатно, под видеонаблюдением</span></div></li>
      </ul>
    </section>



    <!-- Тарифы -->
    <section class="f5-sec" id="price" aria-labelledby="f5-p">
      <div class="f5-prices">
        <div class="f5-head f5-head-row">
          <div>
            <h2 id="f5-p">Выберите карту</h2>
            <p>Безлимит в своё время: от {dayPrice} ₽ в день. Оставьте заявку, и администратор оформит карту.</p>
          </div>
          <fieldset class="f5-period">
            <legend class="sr">Период оплаты</legend>
            <input type="radio" name="f5-period" id="f5-m" checked /><label for="f5-m">Месяц</label>
            <input type="radio" name="f5-period" id="f5-y" /><label for="f5-y">Год <em>выгоднее</em></label>
          </fieldset>
        </div>
        <div class="f5-plans">
          {plans.map((p) => (
            <article class={`f5-plan ${p.id === 'full' ? 'is-hot' : ''}`} data-rise>
              <div class="f5-plan-top">
                <h3>{p.name}</h3>
                {p.tag && <span class="f5-plan-tag">{p.tag}</span>}
              </div>
              <p class="f5-plan-hours">{p.hours}</p>
              <p class="f5-plan-price">
                <span class="pm"><b>{rub(p.month)}</b><small>в месяц</small></span>
                <span class="py"><b>{rub(p.year)}</b><small>за 12 месяцев, {rub(Math.round(p.year / 12))} в месяц</small></span>
              </p>
              <p class="f5-plan-day"><span class="pm">≈ {perDay(p.month, 30)} ₽ в день</span><span class="py">≈ {perDay(p.year, 365)} ₽ в день</span></p>
              <ul class="f5-plan-list">
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" />{f}</li>)}
              </ul>
              <a class={`f5-pill ${p.id === 'full' ? 'f5-pill-wht' : 'f5-pill-ink'} f5-plan-btn`} href="#lead" data-lead={`Тариф «${p.name}»`} data-block="05_price">Выбрать тариф</a>
            </article>
          ))}
        </div>
        <ul class="f5-promos">
          <li><b>{tradeIn.title}</b><span>{tradeIn.short}. {tradeIn.terms[0]}.</span></li>
          <li><b>{onePlus.title}</b><span>{onePlus.short}.</span></li>
        </ul>
      </div>
    </section>

    <!-- Заявка -->
    <section class="f5-sec" id="lead" aria-labelledby="f5-l">
      <div class="f5-lead">
        <div class="f5-lead-txt">
          <h2 id="f5-l">Оставьте заявку, подберём карту</h2>
          <ol class="f5-steps">
            <li><b>Оставьте заявку</b><span>Имя и телефон, больше ничего</span></li>
            <li><b>Администратор перезвонит</b><span>В часы работы клуба, расскажет про тарифы</span></li>
            <li><b>Приходите в клуб</b><span>Оформим карту и покажем зал</span></li>
          </ol>
          <div class="f5-lead-alt">
            <a class="f5-pill f5-pill-wht" href={whatsappLink('Здравствуйте! Хочу выбрать карту в Urban210')} target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a>
            <a class="f5-pill f5-pill-wht" href={telegramLink('concept05')} target="_blank" rel="noopener"><Icon name="tg" />Telegram</a>
          </div>
        </div>
        <div class="f5-form">
          <LeadForm block="05_final" id="f5" goal={lead.goal} title={lead.title} button={lead.button} />
        </div>
      </div>
    </section>

    <!-- Зоны клуба -->
    <section class="f5-sec" id="zones" aria-labelledby="f5-z">
      <div class="f5-head">
        <h2 id="f5-z">Что внутри клуба</h2>
        <p>{site.facts.area} на двух этажах. Места хватает даже вечером.</p>
      </div>
      <div class="f5-bento">
        <a class="f5-zone f5-zone-big" href={zal.href} data-rise>
          <Image src={img(zal.image!)} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 800, 1100]} sizes="(min-width: 980px) 56vw, 92vw" format="avif" quality={50} />
          <div class="f5-zone-txt">
            <span class="f5-tag">Главный зал</span>
            <h3>{zal.title}</h3>
            <p>{zal.text}</p>
          </div>
          <span class="f5-arrow"><Icon name="chev" /></span>
        </a>
        <a class="f5-zone f5-zone-photo" href={cardio.href} data-rise>
          <Image src={img(cardio.image!)} alt="Беговые дорожки Technogym в кардиозоне" widths={[400, 700]} sizes="(min-width: 980px) 40vw, 92vw" format="avif" quality={50} />
          <div class="f5-zone-txt">
            <h3>{cardio.title}</h3>
            <p>{cardio.text}</p>
          </div>
          <span class="f5-arrow"><Icon name="chev" /></span>
        </a>
        <a class="f5-zone f5-zone-spa" href={spa.href} data-rise>
          <span class="f5-stk f5-stk-org f5-spa-stk" data-spin><b>40–50 °C</b>хаммам</span>
          <h3>{spa.title}</h3>
          <p>{spa.text}</p>
          <span class="f5-mini">В тарифе «Всё включено»</span>
          <span class="f5-arrow"><Icon name="chev" /></span>
        </a>
        <div class="f5-zone f5-zone-group" data-rise>
          <div class="f5-group-txt">
            <h3>{group.title}</h3>
            <p>{group.text}</p>
            <ul class="f5-chips">
              {programs.flatMap((p) => p.items).map((it) => <li>{it}</li>)}
            </ul>
            <a class="f5-pill f5-pill-wht" href={group.href}>Расписание и направления</a>
          </div>
          <div class="f5-group-ph">
            <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале 150 м²" widths={[400, 700]} sizes="(min-width: 980px) 34vw, 92vw" format="avif" quality={50} />
            <Image src={img('/images/group-strength.jpg')} alt="Силовая групповая тренировка с гантелями" widths={[300, 500]} sizes="(min-width: 980px) 18vw, 44vw" format="avif" quality={45} />
          </div>
        </div>
      </div>
    </section>

    <!-- Люди и отзывы -->
    <section class="f5-sec" id="people" aria-labelledby="f5-r">
      <div class="f5-head f5-head-row">
        <div>
          <h2 id="f5-r">Здесь тренируются ваши соседи</h2>
          <p>Отзывы гостей с Яндекс Карт и 2ГИС и фото из нашего Instagram.</p>
        </div>
        <a class="f5-rate-big" href={site.maps.yandexReviews} target="_blank" rel="noopener">
          <b>4,7</b>
          <span><span class="f5-stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>{site.rating.text} на Яндекс Картах</span>
        </a>
      </div>
      <div class="f5-feed" tabindex="0" aria-label="Фото гостей и отзывы, листается вбок">
        {feed.map((f) =>
          f.kind === 'photo' ? (
            <figure class="f5-feed-ph"><Image src={img(f.src)} alt="Гость клуба Urban210 на тренировке" widths={[300, 450]} sizes="(min-width: 980px) 300px, 64vw" format="avif" quality={45} /></figure>
          ) : (
            <blockquote class={`f5-feed-rv t-${f.tone}`}>
              <span class="f5-stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
              <p>{f.r.text}</p>
              <footer><b>{f.r.name}</b><span>{f.r.source}</span></footer>
            </blockquote>
          )
        )}
      </div>
    </section>

    <!-- Тренеры -->
    <section class="f5-sec" id="team" aria-labelledby="f5-t">
      <div class="f5-head">
        <h2 id="f5-t">Тренеры помогут начать</h2>
        <p>Покажут тренажёры, поставят технику и составят первую программу.</p>
      </div>
      <div class="f5-team">
        {trainers.map((t, i) => (
          <article class={`f5-coach c${i}`} data-rise>
            <Image src={img(t.photo)} alt={t.name} widths={[300, 500]} sizes="(min-width: 980px) 25vw, 80vw" format="avif" quality={50} />
            <div><h3>{t.name}</h3><p>{t.role}</p></div>
          </article>
        ))}
        <article class="f5-personal" data-rise>
          <span class="f5-stk f5-stk-wht" data-spin><b>0 ₽</b>первая</span>
          <div class="f5-personal-body">
          <h3>Персональные тренировки</h3>
          <p>{personal.firstFree}.</p>
          <p class="f5-personal-price"><b>{rub(personal.price)}</b> за {personal.pack} тренировок</p>
          <a class="f5-pill f5-pill-ink" href="#lead" data-lead="Персональные тренировки" data-block="05_personal">Подобрать тренера</a>
          </div>
        </article>
      </div>
    </section>


    <footer class="f5-foot">
      <div class="f5-foot-card">
        <div class="f5-foot-grid">
          <div>
            <a class="f5-logo f5-logo-lg" href="/concepts/05/">URBAN<b>210</b><span class="f5-logo-chev"><Icon name="chev" /></span></a>
            <p class="f5-foot-addr">{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <a class="f5-foot-tel" href={site.phone.href}>{site.phone.display}</a>
          </div>
          <div>
            <h2>Часы работы</h2>
            <ul>{site.hours.map((h) => <li><b>{h.days}</b> {h.time}</li>)}</ul>
            <p class="f5-foot-note">{site.parking}</p>
          </div>
          <div>
            <h2>Клуб</h2>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
          <div>
            <h2>На связи</h2>
            <ul>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={site.maps.twoGis} target="_blank" rel="noopener">2ГИС</a></li>
            </ul>
          </div>
        </div>
        <div class="f5-foot-bottom">
          <span>© {year} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</span>
          <span><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Договор-оферта</a> · <a href="/rules/">Правила клуба</a></span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Статус «открыто сейчас» по времени Хабаровска
  const st = document.querySelector<HTMLElement>('.f5 [data-status]');
  if (st) {
    const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Vladivostok' }));
    const d = now.getDay();
    const m = now.getHours() * 60 + now.getMinutes();
    const [o, c] = d === 0 || d === 6 ? [450, 1350] : [390, 1410];
    const open = m >= o && m < c;
    const pad = (x: number) => `${Math.floor(x / 60)}:${String(x % 60).padStart(2, '0')}`;
    st.classList.toggle('open', open);
    st.querySelector('span')!.textContent = open ? `Открыто сейчас, до ${pad(c)}` : `Сейчас закрыто, откроемся в ${pad(o)}`;
  }
  // Веер фото раскрывается после загрузки
  requestAnimationFrame(() => document.querySelector('.f5-fan')?.classList.add('is-open'));
</script>

<style is:global>
  body:has(.f5) { background: #efeeeb; color: #17142a; color-scheme: light; }
  body:has(.f5) .skip { color: #fff; }
  body:has(.f5) .mbar { background: rgb(255 255 255 / 0.9); border-top: 0; box-shadow: 0 -10px 30px rgb(23 20 42 / 0.08); }
  body:has(.f5) .mbar a.ic { border: 0; background: #efeeeb; border-radius: 999px; color: #17142a; }
  body:has(.f5) .mbar .btn, body:has(.f5) dialog.lead .btn { border-radius: 999px; color: #fff; font-family: 'Geologica Variable', sans-serif; font-weight: 700; }
  body:has(.f5) dialog.lead .form { background: #fff; color: #17142a; --ink: #17142a; --muted: #5d5a6e; --line: rgb(23 20 42 / 0.12); --card: #f4f3f0; border-radius: 28px; border: 0; }
  body:has(.f5) dialog.lead .form h3 { font-family: 'Geologica Variable', sans-serif; font-weight: 800; letter-spacing: -0.03em; }
  body:has(.f5) dialog.lead .field input { border-radius: 16px; }
  body:has(.f5) dialog.lead::backdrop { background: rgb(23 20 42 / 0.55); }
</style>

<style>
  .f5 {
    --org: #ff5722; --org-2: #ff7a4d; --cob: #2b3be0; --cob-d: #1c278f; --pch: #ffe0d2; --lil: #e3e5ff;
    --ink: #17142a; --mut: #5d5a6e; --bg: #efeeeb; --card: #fff;
    --r-xl: 40px; --r-l: 32px; --r-m: 24px;
    --lift: cubic-bezier(0.34, 1.45, 0.64, 1);
    --sh: 0 1px 2px rgb(23 20 42 / 0.04), 0 12px 32px -12px rgb(23 20 42 / 0.14);
    --sh-up: 0 2px 4px rgb(23 20 42 / 0.05), 0 28px 48px -16px rgb(23 20 42 / 0.24);
    --gut: clamp(12px, 2.4vw, 32px);
    font-family: 'Geologica Variable', system-ui, sans-serif;
    font-size: 17px; line-height: 1.55; color: var(--ink);
    max-width: 1440px; margin-inline: auto; padding-inline: var(--gut);
  }
  .f5 :global(h1), .f5 :global(h2), .f5 :global(h3) { font-family: 'Geologica Variable', sans-serif; font-weight: 800; letter-spacing: -0.035em; line-height: 1; hyphens: manual; -webkit-hyphens: manual; }
  .f5 :global(svg) { flex: none; }
  .f5 a { text-decoration: none; }

  /* ---------- Кнопки ---------- */
  .f5-pill { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 24px; border-radius: 999px; font-weight: 700; font-size: 0.98rem; line-height: 1.1; white-space: nowrap; transition: transform 0.35s var(--lift), background-color 0.25s ease, box-shadow 0.25s ease; }
  .f5-pill:hover { transform: translateY(-2px); }
  .f5-pill:active { transform: scale(0.96); }
  .f5-pill :global(svg) { width: 20px; height: 20px; }
  .f5-pill-org { background: var(--org); color: #fff; }
  .f5-pill-org:hover { background: #ff6a3a; }
  .f5-pill-ink { background: var(--ink); color: #fff; }
  .f5-pill-ink:hover { background: var(--cob); }
  .f5-pill-wht { background: #fff; color: var(--ink); }
  .f5-pill-ghost { background: rgb(255 255 255 / 0.18); color: #fff; box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.55); }
  .f5-pill-ghost:hover { background: rgb(255 255 255 / 0.3); }

  .f5-go { display: inline-flex; align-items: center; gap: 18px; min-height: 64px; padding: 6px 6px 6px 28px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 700; font-size: 1.05rem; transition: transform 0.35s var(--lift), background-color 0.25s ease; }
  .f5-go i { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; color: var(--org); transition: transform 0.45s var(--lift); }
  .f5-go :global(svg) { width: 20px; height: 18px; }
