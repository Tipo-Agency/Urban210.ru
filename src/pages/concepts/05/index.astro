  .f5-spa-stk b { font-size: 1.25rem; }
  .f5-mini { width: fit-content; padding: 6px 14px; border-radius: 999px; background: #fff; font-size: 0.85rem; font-weight: 700; }

  .f5-zone-group { display: grid; gap: 22px; padding: 28px; background: var(--cob); color: #fff; }
  .f5-group-txt { display: grid; gap: 14px; align-content: start; }
  .f5-group-txt p { color: rgb(255 255 255 / 0.85); max-width: 40ch; }
  .f5-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 10px; }
  .f5-chips li { padding: 9px 16px; border-radius: 999px; background: rgb(255 255 255 / 0.13); font-weight: 600; font-size: 0.95rem; transition: background-color 0.2s ease, color 0.2s ease, transform 0.35s var(--lift); }
  .f5-chips li:nth-child(3n + 1) { background: #fff; color: var(--cob); }
  .f5-chips li:hover { transform: translateY(-3px) rotate(-3deg); background: var(--org); color: #fff; }
  .f5-group-txt .f5-pill { width: fit-content; }
  .f5-group-ph { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; }
