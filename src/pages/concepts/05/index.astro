  @media (min-width: 1180px) { .f5-tel { display: inline; } }

  /* ---------- Первый экран ---------- */
  .f5-hero { padding-top: 22px; }
  .f5-hero-card { position: relative; overflow: hidden; display: grid; gap: 28px; padding: 32px 22px 0; border-radius: var(--r-xl); color: #fff;
    background: radial-gradient(120% 90% at 85% 10%, #ff8a5c 0%, transparent 55%), linear-gradient(160deg, #ff6630 0%, var(--org) 45%, #f2461a 100%); }
  .f5-status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px 8px 12px; border-radius: 999px; background: rgb(255 255 255 / 0.2); font-size: 0.9rem; font-weight: 600; width: fit-content; }
  .f5-status i { width: 10px; height: 10px; border-radius: 50%; background: #fff; }
  .f5-status.open i { background: #b6ffc8; box-shadow: 0 0 0 4px rgb(182 255 200 / 0.3); }
  .f5-hero h1 { margin-top: 22px; font-size: clamp(2.6rem, 1.4rem + 5vw, 5.6rem); line-height: 0.95; letter-spacing: -0.05em; max-width: 11ch; }
  .f5-price-chip { display: inline-block; padding: 0.02em 0.22em 0.08em; margin-top: 0.06em; border-radius: 0.3em; background: #fff; color: var(--org); transform: rotate(-3deg); }
  .f5-hero-lead { margin-top: 22px; font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem); line-height: 1.5; max-width: 40ch; color: rgb(255 255 255 / 0.94); }
  .f5-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 30px; }
  .f5-cta .f5-pill-ghost { min-height: 64px; }

  .f5-fan { position: relative; height: 380px; margin-inline: -22px; }
  .f5-fan-card { position: absolute; left: 50%; bottom: -36px; width: min(46vw, 230px); aspect-ratio: 3 / 4.6; margin: 0; border-radius: var(--r-m); overflow: hidden; box-shadow: 0 30px 50px -20px rgb(80 20 0 / 0.55); border: 5px solid #fff; transform-origin: 50% 110%;
    transform: translateX(-50%) rotate(0deg); transition: transform 0.9s var(--lift); }
  .f5-fan-card :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .f5-fan-card.n1 { z-index: 2; }
  .f5-fan.is-open .n0 { transform: translateX(-108%) rotate(-11deg); }
  .f5-fan.is-open .n1 { transform: translateX(-50%) translateY(-18px) rotate(1deg); }
  .f5-fan.is-open .n2 { transform: translateX(8%) rotate(11deg); }
  .f5-fan.is-open:hover .n0 { transform: translateX(-118%) rotate(-15deg); }
  .f5-fan.is-open:hover .n1 { transform: translateX(-50%) translateY(-34px) rotate(-1deg); }
  .f5-fan.is-open:hover .n2 { transform: translateX(18%) rotate(15deg); }
  .f5-fan-card.n0 { transition-delay: 0.15s; }
  .f5-fan-card.n2 { transition-delay: 0.25s; }
  .f5-fan.is-open:hover .f5-fan-card { transition-delay: 0s; }

  .f5-stk { position: absolute; z-index: 4; display: grid; place-content: center; text-align: center; width: 116px; height: 116px; border-radius: 50%; font-size: 0.72rem; font-weight: 600; line-height: 1.15; padding: 12px; }
  .f5-stk b { display: block; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; margin-bottom: 4px; }
  .f5-stk-cob { background: var(--cob); color: #fff; top: 0; right: 6%; rotate: 12deg; box-shadow: 0 14px 30px -10px rgb(28 39 143 / 0.6); }
  .f5-stk-org { background: var(--org); color: #fff; }
  .f5-stk-wht { background: #fff; color: var(--ink); }
  .f5-stk-rate { position: absolute; z-index: 4; left: 4%; top: 44px; display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 6px; padding: 12px 16px; border-radius: 20px; background: #fff; color: var(--ink); rotate: -7deg; box-shadow: var(--sh); transition: rotate 0.4s var(--lift); }
  .f5-stk-rate:hover { rotate: -2deg; }
  .f5-stk-rate :global(svg) { width: 20px; height: 20px; color: #ffb400; }
  .f5-stk-rate b { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.03em; }
  .f5-stk-rate span { grid-column: 1 / -1; font-size: 0.75rem; font-weight: 600; color: var(--mut); }

  .f5-marquee { position: relative; z-index: 5; margin-inline: -22px; background: var(--ink); color: #fff; overflow: hidden; padding: 16px 0; }
  .f5-marquee-track { display: flex; width: max-content; animation: f5-run 36s linear infinite; }
  .f5-marquee span { display: inline-flex; align-items: center; gap: 22px; padding-right: 22px; font-weight: 700; font-size: 1rem; white-space: nowrap; }
  .f5-marquee :global(svg) { width: 16px; height: 14px; color: var(--org); }
  @keyframes f5-run { to { transform: translateX(-50%); } }

  .f5-facts { list-style: none; display: grid; gap: 10px; margin-top: 10px; }
  .f5-facts li { display: flex; align-items: center; gap: 16px; padding: 18px 22px; background: var(--card); border-radius: var(--r-m); }
  .f5-facts li > :global(svg), .f5-p { width: 44px; height: 44px; padding: 10px; border-radius: 50%; background: var(--lil); color: var(--cob); }
  .f5-p { display: grid; place-items: center; padding: 0; font-weight: 800; font-size: 1.2rem; }
  .f5-facts b { display: block; font-weight: 700; }
  .f5-facts span:not(.f5-p) { font-size: 0.92rem; color: var(--mut); }

  @media (min-width: 980px) {
    .f5-hero-card { grid-template-columns: 1.05fr 0.95fr; padding: 64px 0 0 64px; min-height: 640px; }
    .f5-hero-text { padding-bottom: 56px; align-self: center; }
    .f5-fan { height: auto; margin: 0; }
    .f5-fan-card { width: 250px; bottom: -40px; }
    .f5-stk { width: 132px; height: 132px; font-size: 0.8rem; }
    .f5-stk b { font-size: 1.85rem; }
    .f5-stk-cob { top: 40px; right: 8%; }
    .f5-stk-rate { left: 2%; top: 120px; }
    .f5-marquee { grid-column: 1 / -1; margin: 0 0 0 -64px; }
    .f5-facts { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1300px) { .f5-fan-card { width: 280px; } }

  /* ---------- Секции ---------- */
  .f5-sec { padding-top: clamp(72px, 9vw, 128px); scroll-margin-top: 90px; }
  .f5-head { display: grid; gap: 14px; margin-bottom: clamp(28px, 4vw, 48px); padding-inline: 6px; }
  .f5-head h2 { font-size: clamp(2.1rem, 1.3rem + 3.4vw, 4.2rem); line-height: 0.98; letter-spacing: -0.045em; max-width: 16ch; }
  .f5-head p { font-size: 1.08rem; color: var(--mut); max-width: 46ch; }
  .f5-head-row { align-items: end; }
  .f5-head-row > div { display: grid; gap: 14px; }
  @media (min-width: 980px) { .f5-head-row { grid-template-columns: 1fr auto; } }

  /* ---------- Зоны ---------- */
  .f5-bento { display: grid; gap: 12px; }
  .f5-zone { position: relative; display: block; overflow: hidden; border-radius: var(--r-l); background: var(--card); color: var(--ink); box-shadow: var(--sh); transition: transform 0.5s var(--lift), box-shadow 0.4s ease; }
  a.f5-zone:hover { transform: translateY(-6px) rotate(-0.4deg); box-shadow: var(--sh-up); }
  .f5-zone :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
  a.f5-zone:hover :global(img) { transform: scale(1.04); }
  .f5-zone-big, .f5-zone-photo { min-height: 420px; color: #fff; }
  .f5-zone-big :global(img), .f5-zone-photo :global(img) { position: absolute; inset: 0; }
  .f5-zone-big::after, .f5-zone-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(23 20 42 / 0) 35%, rgb(23 20 42 / 0.78) 100%); }
  .f5-zone-txt { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; padding: 26px; display: grid; gap: 10px; }
