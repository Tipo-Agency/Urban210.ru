  .f5-tag { width: fit-content; padding: 6px 14px; border-radius: 999px; background: var(--org); color: #fff; font-size: 0.82rem; font-weight: 700; }
  .f5-arrow { position: absolute; z-index: 3; top: 18px; right: 18px; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; color: var(--ink); transition: transform 0.45s var(--lift), background-color 0.25s ease, color 0.25s ease; }
  .f5-arrow :global(svg) { width: 18px; height: 16px; }
