  .f5-coach > div { position: absolute; left: 12px; right: 12px; bottom: 12px; padding: 16px 20px; border-radius: var(--r-m); background: #fff; color: var(--ink); }
  .f5-coach.c1 > div { background: var(--org); color: #fff; }
