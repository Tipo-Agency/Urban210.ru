    .f5-zone-photo { grid-column: span 5; min-height: 0; }
    .f5-zone-spa { grid-column: span 5; min-height: 0; }
    .f5-zone-group { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; padding: 48px; gap: 48px; align-items: center; }
    .f5-zone-group h3 { font-size: 3rem; }
    .f5-zone-txt { padding: 36px; }
  }

  /* ---------- Тарифы ---------- */
  .f5-prices { padding: clamp(28px, 4vw, 56px) clamp(16px, 3.4vw, 48px); background: var(--card); border-radius: var(--r-xl); }
  .f5-prices .f5-head { padding-inline: 0; }
  .f5-period { display: inline-flex; padding: 5px; margin: 0; border: 0; border-radius: 999px; background: var(--bg); width: fit-content; }
  .f5-period input { position: absolute; opacity: 0; pointer-events: none; }
  .f5-period label { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 22px; border-radius: 999px; font-weight: 700; cursor: pointer; transition: background-color 0.25s ease, color 0.25s ease; }
  .f5-period em { font-style: normal; font-size: 0.75rem; padding: 3px 8px; border-radius: 999px; background: var(--org); color: #fff; }
