---
// Концепция 18 «Блоки»: необрутализм. Толстые чёрные рамки, плоские яркие плашки
// (оранжевый бренда, кислотный жёлтый, сирень, мята), жёсткие тени без размытия,
// кнопки, которые вдавливаются при нажатии, повёрнутые наклейки и бегущие ленты.
// Всё стоит на жёсткой сетке из 12 колонок. Движение: блоки падают на место, кнопки сплющиваются.
import { Image } from 'astro:assets';
import geoCyr from '@fontsource-variable/geologica/files/geologica-cyrillic-shrp-normal.woff2?url';
import geoLat from '@fontsource-variable/geologica/files/geologica-latin-shrp-normal.woff2?url';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos } from '../../../data/content';

const CYR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const LAT = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+20BD,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = [
  `@font-face{font-family:'Geologica b';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geoCyr}) format('woff2');unicode-range:${CYR}}`,
  `@font-face{font-family:'Geologica b';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geoLat}) format('woff2');unicode-range:${LAT}}`,
  `@font-face{font-family:'Geologica fb';src:local('Arial Black'),local('Arial');size-adjust:98%;ascent-override:92%;descent-override:24%;line-gap-override:0%}`,
].join('');

const rating = site.rating.value.toString().replace('.', ',');
const [day, full, all] = plans;
const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const num = (n: number) => rub(n).replace(/\s₽$/, '');
const personalLine = `${personal.pack} тренировок, ${rub(personal.price)}`;
const planCol = { day: 'c-white', full: 'c-yel', all: 'c-lil' } as const;
const trainerCol = ['c-mint', 'c-lil', 'c-yel'];
const reviewCol = ['c-white', 'c-lil', 'c-mint', 'c-yel'];
const tape = ['Пробный день за 1 ₽', 'Без вступительного взноса', 'Парковка на 50 мест', 'Сауна и хаммам', `${rating} на Яндекс Картах`, 'Пн–Пт 06:30–23:30'];
const year = new Date().getFullYear();
---
<Layout title="Концепция 18 «Блоки»" description="Концепция дизайна сайта Urban210: необрутализм, яркие плашки, толстые рамки и жёсткие тени." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={geoCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="bk">
    <header class="bk-head">
      <div class="bk-w bk-head-in">
        <a class="bk-logo" href="/concepts/18/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="bk-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#ceny">Цены</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zapis">Контакты</a>
        </nav>
        <a class="bk-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="bk-btn bk-btn-s c-yel" href="#zapis" data-lead={trial.title} data-block="18_header"><span>1 ₽ пробный</span><Icon name="chev" /></a>
      </div>
    </header>

    <main>
      <!-- Первый экран -->
      <section class="bk-w bk-hero" aria-labelledby="bk-h1">
        <div class="bk-grid">
          <div class="bk-box c-white bk-hero-main" data-rise style="--d:0ms">
            <p class="bk-pill c-mint">Фитнес-клуб · Хабаровск</p>
            <h1 id="bk-h1" class="bk-h1">
              <span class="sr">Urban210: </span>
              <span class="bk-h1-l">Тренируйся.</span>
              <span class="bk-h1-l bk-h1-b c-lil">Парься.</span>
              <span class="bk-h1-l bk-h1-b c-or">Повторяй.</span>
            </h1>
            <p class="bk-hero-p">{site.facts.area[0].toUpperCase() + site.facts.area.slice(1)}, {site.facts.machines} {site.facts.brands}, групповые программы и SPA с сауной и хаммамом. Первый день стоит 1 ₽.</p>
            <div class="bk-hero-cta">
              <a class="bk-btn c-or" href="#zapis" data-lead={trial.title} data-block="18_hero"><span>Записаться за 1 ₽</span><Icon name="chev" /></a>
              <a class="bk-btn c-white" href="#ceny"><span>Цены от {num(day.month)} ₽</span></a>
            </div>
          </div>

          <figure class="bk-box bk-hero-ph" data-rise style="--d:120ms">
            <Image src={img('/images/community/12.jpg')} alt="Гостья клуба у ярких шкафчиков в раздевалке Urban210" widths={[400, 600]} sizes="(min-width: 1100px) 420px, calc(100vw - 32px)" loading="eager" fetchpriority="high" format="webp" quality={60} />
            <span class="bk-stk bk-stk-round" aria-hidden="true">
              <svg viewBox="0 0 120 120"><path d="M60 2l9.6 13.4 15.6-5.4 1.5 16.4 16.3 2.6-5.1 15.7 13.5 9.3-12.1 11.2 7.4 14.7-16 3.9-.4 16.5-15.5-5.9L65.6 118 60 102.6 54.4 118l-9.2-13.6-15.5 5.9-.4-16.5-16-3.9 7.4-14.7L8.6 64l13.5-9.3L17 39l16.3-2.6 1.5-16.4 15.6 5.4z" /></svg>
              <b>1 ₽</b><small>первый<br />день</small>
            </span>
          </figure>

          <a class="bk-box bk-stat c-yel" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-rise style="--d:200ms">
            <b>{rating}</b><span>{site.rating.text} на Яндекс Картах</span>
            <i class="bk-stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</i>
          </a>
          <div class="bk-box bk-stat c-lil" data-rise style="--d:260ms"><b>06:30</b><span>открываемся по будням, закрываемся в 23:30</span></div>
          <div class="bk-box bk-stat c-mint" data-rise style="--d:320ms"><b>50</b><span>мест на бесплатной парковке</span></div>
          <div class="bk-box bk-stat c-white" data-rise style="--d:380ms"><b>0 ₽</b><span>вступительный взнос</span></div>
        </div>
      </section>

      <!-- Ленты -->
      <div class="bk-tapes" aria-hidden="true">
        <div class="bk-tape bk-tape-a"><div class="bk-tape-in">{[0, 1].map(() => tape.map((t) => <span>{t}<Icon name="chev" /></span>))}</div></div>
        <div class="bk-tape bk-tape-b c-yel"><div class="bk-tape-in">{[0, 1].map(() => tape.slice().reverse().map((t) => <span>{t}<Icon name="chev" /></span>))}</div></div>
      </div>

      <!-- Зоны -->
      <section class="bk-w bk-sec" id="zony" aria-labelledby="bk-z-h">
        <div class="bk-sec-head">
          <h2 id="bk-z-h" class="bk-h2" data-rise>Что внутри</h2>
          <p class="bk-stk bk-stk-tag c-or" data-rise aria-hidden="true">4 зоны в одном клубе</p>
        </div>
        <div class="bk-grid">
          {[
            { z: zal, c: 'c-yel', cls: 'bk-z1', alt: 'Тренажёрный зал Urban210 с панорамными окнами', tag: 'Железо' },
            { z: cardio, c: 'c-lil', cls: 'bk-z2', alt: 'Беговые дорожки в кардиозоне', tag: 'Кардио' },
            { z: group, c: 'c-mint', cls: 'bk-z3', alt: 'Групповая тренировка в зале 150 м²', tag: 'Вместе' },
          ].map(({ z, c, cls, alt, tag }, i) => (
            <a class={`bk-box bk-zone ${cls}`} href={z.href} data-rise style={`--d:${i * 90}ms`}>
              <div class={`bk-zone-ph ${c}`}>
                <Image src={img(z.image!)} alt={alt} widths={[400, 700, 1000]} sizes="(min-width: 1100px) 760px, calc(100vw - 32px)" format="avif" quality={45} loading="lazy" />
                <span class="bk-zone-tag c-white">{tag}</span>
              </div>
              <div class="bk-zone-txt">
                <h3>{z.title}</h3>
                <p>{z.text}</p>
                <span class="bk-arrow" aria-hidden="true"><Icon name="chev" /></span>
              </div>
            </a>
          ))}
          <a class="bk-box bk-zone bk-z4 c-or" href={spa.href} data-rise style="--d:270ms">
            <p class="bk-z4-t" aria-hidden="true">40–50<small>°C</small></p>
            <h3>{spa.title}</h3>
            <p>{spa.text}</p>
            <ul class="bk-chips" aria-hidden="true"><li class="c-white">Сауна</li><li class="c-yel">Хаммам</li><li class="c-lil">Релакс</li></ul>
            <span class="bk-arrow" aria-hidden="true"><Icon name="chev" /></span>
          </a>
        </div>
      </section>

      <!-- Цены -->
      <section class="bk-w bk-sec" id="ceny" aria-labelledby="bk-p-h">
        <div class="bk-sec-head">
          <h2 id="bk-p-h" class="bk-h2" data-rise>Цены без звёздочек</h2>
          <div class="bk-switch" role="group" aria-label="Период оплаты" data-switch data-rise>
            <button type="button" aria-pressed="true" data-period="m">Месяц</button>
            <button type="button" aria-pressed="false" data-period="y">Год</button>
          </div>
        </div>
        <div class="bk-grid">
          {plans.map((p, i) => (
            <article class={`bk-box bk-plan ${planCol[p.id]}`} data-rise style={`--d:${i * 100}ms`}>
              {p.tag && <span class={`bk-stk bk-stk-tag ${p.id === 'full' ? 'c-or' : 'c-mint'}`}>{p.tag}</span>}
              <h3>{p.name}</h3>
              <p class="bk-plan-h">{p.hours[0].toUpperCase() + p.hours.slice(1)}</p>
              <p class="bk-plan-price"><b data-m={num(p.month)} data-y={num(p.year)}>{num(p.month)}</b><span>₽<br /><i data-unit>в месяц</i></span></p>
              <p class="bk-plan-sub" data-sub-m={`${num(p.year)} ₽ за год`} data-sub-y={`около ${perDay(p.year, 365)} ₽ в день`}>{num(p.year)} ₽ за год</p>
              <ul>
                {p.features.map((f) => <li><span class="bk-ck"><Icon name="check" /></span>{f}</li>)}
                {p.excluded?.map((f) => <li class="is-no"><span class="bk-ck"><Icon name="minus" /></span>{f}</li>)}
              </ul>
              <a class={`bk-btn bk-btn-w ${p.id === 'full' ? 'c-or' : 'c-white'}`} href="#zapis" data-lead={`Абонемент «${p.name}»`} data-block={`18_plan_${p.id}`}><span>Хочу этот</span><Icon name="chev" /></a>
            </article>
          ))}

          <div class="bk-box bk-trial c-or" data-rise>
            <p class="bk-trial-n" aria-hidden="true">1&nbsp;₽</p>
            <div class="bk-trial-txt">
              <h3>{trial.title}</h3>
              <p>{trial.text}</p>
              <a class="bk-btn c-white" href="#zapis" data-lead={trial.title} data-block="18_trial"><span>Забрать день</span><Icon name="chev" /></a>
            </div>
            <span class="bk-stk bk-stk-tag c-yel bk-trial-stk" aria-hidden="true">Нужен только паспорт</span>
          </div>

          {[{ p: tradein, c: 'c-mint', big: '999 ₽' }, { p: friend, c: 'c-lil', big: '1+1' }].map(({ p, c, big }, i) => (
            <article class={`bk-box bk-ticket ${c}`} data-rise style={`--d:${i * 100}ms`}>
              <p class="bk-ticket-big" aria-hidden="true">{big}</p>
              <div class="bk-ticket-txt">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                <a class="bk-link" href="#zapis" data-lead={p.goal} data-block={`18_promo_${p.slug}`}>{p.cta}<Icon name="chev" /></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Тренеры -->
      <section class="bk-w bk-sec" id="trenery" aria-labelledby="bk-t-h">
        <div class="bk-sec-head">
          <h2 id="bk-t-h" class="bk-h2" data-rise>Кто рядом в зале</h2>
        </div>
        <div class="bk-grid">
          {trainers.map((t, i) => (
            <figure class="bk-box bk-tr" data-rise style={`--d:${i * 100}ms`}>
              <Image src={img(t.photo)} alt={t.name} widths={[360, 600]} sizes="(min-width: 1100px) 330px, (min-width: 700px) 45vw, calc(100vw - 32px)" format="avif" quality={50} loading="lazy" />
              <figcaption class={`bk-tr-cap ${trainerCol[i]}`} style={`--r:${[-2, 1.5, -1][i]}deg`}><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
          <div class="bk-box bk-pt c-ink" data-rise style="--d:300ms">
            <p class="bk-pill c-yel">Персонально</p>
            <p class="bk-pt-big">{personalLine}</p>
            <p>{personal.firstFree}.</p>
            <a class="bk-btn c-yel" href="#zapis" data-lead="Персональная тренировка" data-block="18_personal"><span>Подобрать тренера</span><Icon name="chev" /></a>
          </div>
        </div>
      </section>

      <!-- Отзывы -->
      <section class="bk-w bk-sec" id="otzyvy" aria-labelledby="bk-r-h">
        <div class="bk-sec-head">
          <h2 id="bk-r-h" class="bk-h2" data-rise>Говорят гости</h2>
          <a class="bk-btn bk-btn-s c-white" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-rise><span>Все отзывы</span><Icon name="chev" /></a>
        </div>
        <div class="bk-grid">
          <a class="bk-box bk-rate c-yel" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-rise>
            <b>{rating}</b>
            <i class="bk-stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</i>
            <span>{site.rating.text} на Яндекс Картах</span>
          </a>
          {reviews.map((r, i) => (
            <blockquote class={`bk-box bk-rv ${reviewCol[i]}`} data-rise style={`--d:${(i + 1) * 80}ms`}>
              <p>{r.text}</p>
              <footer><span class="bk-ava" aria-hidden="true">{r.name[0]}</span><b>{r.name}</b><span class="bk-src">{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </section>

      <!-- Заявка -->
      <section class="bk-w bk-sec bk-cta" id="zapis" aria-labelledby="bk-c-h">
        <div class="bk-grid">
          <div class="bk-box bk-cta-main c-lil" data-rise>
            <h2 id="bk-c-h" class="bk-h2">Приходи на&nbsp;пробный день</h2>
            <p class="bk-cta-p">Оставь имя и телефон. Администратор перезвонит в часы работы клуба и подберёт время.</p>
            <div class="bk-info">
              <div class="c-white"><span>Адрес</span><b>{site.address.short}</b><a href={site.maps.yandex} target="_blank" rel="noopener">На карте<Icon name="chev" /></a></div>
              <div class="c-white"><span>Часы</span>{site.hours.map((h) => <b>{`${h.days} ${h.time}`}</b>)}</div>
              <div class="c-white"><span>Телефон</span><b><a href={site.phone.href}>{site.phone.display}</a></b><span class="bk-info-l"><a href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener">WhatsApp</a><a href={telegramLink('concept18')} target="_blank" rel="noopener">Telegram</a></span></div>
              <div class="c-white"><span>Парковка</span><b>50 мест бесплатно</b><span class="bk-info-s">под видеонаблюдением</span></div>
            </div>
          </div>
          <div class="bk-box bk-cta-form c-white" data-rise style="--d:120ms">
            <LeadForm id="bk-form" block="18_final" title="Записаться за 1 ₽" />
          </div>
        </div>
      </section>
    </main>

    <footer class="bk-foot">
      <div class="bk-w">
        <p class="bk-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="bk-foot-grid">
          <div><span>Адрес</span><p>{site.address.postalCode}, {site.address.locality}, {site.address.street}<br />{site.district}</p></div>
          <div><span>Часы</span><p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p></div>
          <div><span>Связь</span><p><a href={site.phone.href}>{site.phone.display}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p></div>
          <div><span>Документы</span><p><a href="/policy/">Политика конфиденциальности</a><br /><a href="/oferta/">Договор-оферта</a><br /><a href="/rules/">Правила клуба</a></p></div>
        </div>
        <p class="bk-foot-legal">© {year} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Переключатель месяц / год у тарифов
  const sw = document.querySelector<HTMLElement>('[data-switch]');
  if (sw) {
    const btns = [...sw.querySelectorAll<HTMLButtonElement>('button')];
    btns.forEach((b) => b.addEventListener('click', () => {
      const y = b.dataset.period === 'y';
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => {
        el.textContent = (y ? el.dataset.y : el.dataset.m) || '';
        el.classList.remove('bk-pop'); void el.offsetWidth; el.classList.add('bk-pop');
      });
      document.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => (el.textContent = y ? 'за год' : 'в месяц'));
      document.querySelectorAll<HTMLElement>('[data-sub-m]').forEach((el) => (el.textContent = (y ? el.dataset.subY : el.dataset.subM) || ''));
    }));
  }
</script>

<style is:global>
  body:has(.bk) { background: #fff4e2; color: #16120f; }
  body:has(.bk) ::selection { background: #ffdd33; color: #16120f; }
  body:has(.bk) :focus-visible { outline: 3px solid #16120f; outline-offset: 3px; border-radius: 0; }
  body:has(.bk) .mbar { background: #fff4e2; border-top: 3px solid #16120f; backdrop-filter: none; color: #16120f; }
  body:has(.bk) .mbar a.ic { border: 3px solid #16120f; border-radius: 0; background: #fffdf7; box-shadow: 3px 3px 0 #16120f; }
  body:has(.bk) .mbar .btn, body:has(.bk) dialog.lead .btn { --b: #ff5722; --c: #16120f; border: 3px solid #16120f; border-radius: 0; box-shadow: 4px 4px 0 #16120f; font-family: 'Geologica b', 'Geologica fb', sans-serif; font-weight: 800; transition: transform 0.12s ease, box-shadow 0.12s ease; }
  body:has(.bk) .mbar .btn:active, body:has(.bk) dialog.lead .btn:active { transform: translate(4px, 4px) scale(1.02, 0.94); box-shadow: 0 0 0 #16120f; }
  body:has(.bk) dialog.lead::backdrop { background: rgb(22 18 15 / 0.6); backdrop-filter: none; }
  body:has(.bk) dialog.lead .form { background: #fffdf7; color: #16120f; --ink: #16120f; --muted: #4d443d; --line: #16120f; --card: #fff; border: 3px solid #16120f; border-radius: 0; box-shadow: 8px 8px 0 #16120f; font-family: 'Geologica b', 'Geologica fb', sans-serif; color-scheme: light; }
  body:has(.bk) dialog.lead .x { color: #16120f; }
  body:has(.bk) .form h3 { font-family: 'Geologica b', 'Geologica fb', sans-serif; font-weight: 850; letter-spacing: -0.03em; font-size: 1.7rem; }
  body:has(.bk) .form .field { color: #16120f; font-weight: 700; }
  body:has(.bk) .form .field input { border: 3px solid #16120f; border-radius: 0; background: #fff; color: #16120f; transition: box-shadow 0.15s ease, transform 0.15s ease; }
  body:has(.bk) .form .field input:focus { border-color: #16120f; box-shadow: 4px 4px 0 #ffdd33, 4px 4px 0 3px #16120f; transform: translate(-2px, -2px); }
  body:has(.bk) .form .consent input { accent-color: #16120f; }
  body:has(.bk) .form-done .ok { background: #6fe3b4; color: #16120f; border: 3px solid #16120f; }
</style>

<style>
  .bk {
    --ink: #16120f; --cream: #fff4e2; --white: #fffdf7;
    --or: #ff5722; --yel: #ffdd33; --lil: #b9a5ff; --mint: #6fe3b4;
    --b: 3px solid var(--ink);
    --sh: 5px; --gap: 14px;
    --gut: clamp(16px, 3vw, 40px);
    --drop: cubic-bezier(0.34, 1.45, 0.6, 1);
    --font: 'Geologica b', 'Geologica fb', system-ui, sans-serif;
    color-scheme: light;
    font-family: var(--font); font-size: 17px; line-height: 1.5; color: var(--ink);
    background-color: var(--cream);
    background-image: radial-gradient(rgb(22 18 15 / 0.14) 1.2px, transparent 1.4px);
    background-size: 24px 24px;
    overflow-x: clip;
  }
  @media (min-width: 900px) { .bk { --sh: 7px; --gap: 20px; font-size: 17.5px; } }
  .bk :global(h1), .bk :global(h2), .bk :global(h3) { font-family: var(--font); font-weight: 850; letter-spacing: -0.04em; line-height: 0.98; font-variation-settings: 'SHRP' 100; hyphens: manual; -webkit-hyphens: manual; }
  .bk a { text-decoration: none; }
  .bk :global(svg) { flex: none; }
  .bk-w { width: 100%; max-width: 1360px; margin-inline: auto; padding-inline: var(--gut); }
  .c-white { background: var(--white); }
  .c-yel { background: var(--yel); }
  .c-lil { background: var(--lil); }
  .c-mint { background: var(--mint); }
  .c-or { background: var(--or); }
  .c-ink { background: var(--ink); color: var(--cream); }

  .bk-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); }
  .bk-grid > * { grid-column: 1 / -1; }
  .bk-box { position: relative; border: var(--b); box-shadow: var(--sh) var(--sh) 0 var(--ink); }

  /* Падение блоков: сверху с лёгким наклоном и перелётом, по одному */
  :global(.js) .bk [data-rise] { opacity: 0; transform: translateY(-46px) rotate(-1.6deg); transition: opacity 0.35s ease, transform 0.75s var(--drop); transition-delay: var(--d, 0ms); }
  :global(.js) .bk [data-rise].in { opacity: 1; transform: none; }

  /* Кнопки: жёсткая тень, при наведении приподнимаются, при нажатии вдавливаются и сплющиваются */
  .bk-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 58px; padding: 0 22px; border: var(--b); box-shadow: 5px 5px 0 var(--ink); color: var(--ink); font-weight: 800; font-size: 1.02rem; letter-spacing: -0.01em; white-space: nowrap; cursor: pointer; transition: translate 0.14s ease, scale 0.14s ease, box-shadow 0.14s ease; }
  .bk-btn :global(svg) { width: 17px; height: 15px; }
  .bk-btn:hover { translate: -2px -2px; box-shadow: 7px 7px 0 var(--ink); }
  .bk-btn:active { translate: 5px 5px; scale: 1.03 0.92; box-shadow: 0 0 0 var(--ink); transition-duration: 0.06s; }
  .bk-btn-s { min-height: 46px; padding: 0 16px; font-size: 0.92rem; box-shadow: 4px 4px 0 var(--ink); }
  .bk-btn-w { width: 100%; }
  .bk-link { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; border-bottom: var(--b); padding-bottom: 2px; width: fit-content; }
  .bk-link :global(svg) { width: 14px; height: 12px; transition: transform 0.2s ease; }
  .bk-link:hover :global(svg) { transform: translateX(4px); }
  .bk-pill { display: inline-block; width: fit-content; padding: 6px 12px; border: var(--b); border-radius: 999px; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.01em; }

  /* Наклейки */
  .bk-stk { z-index: 3; color: var(--ink); }
  .bk-stk-tag { display: inline-block; padding: 8px 14px; border: var(--b); box-shadow: 3px 3px 0 var(--ink); font-weight: 850; font-size: 0.9rem; rotate: var(--r, -4deg); transition: rotate 0.3s var(--drop), scale 0.3s var(--drop); }
  .bk-stk-tag:hover { rotate: calc(var(--r, -4deg) * -1); scale: 1.05; }

  /* ---------- Шапка ---------- */
  .bk-head { position: sticky; top: 0; z-index: 30; background: var(--cream); border-bottom: var(--b); }
  .bk-head-in { display: flex; align-items: center; gap: 18px; height: 70px; }
  .bk-logo { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; background: var(--ink); color: var(--cream); font-weight: 900; font-size: 1.15rem; letter-spacing: -0.03em; line-height: 1; font-variation-settings: 'SHRP' 100; }
  .bk-logo :global(svg) { width: 15px; height: 14px; color: var(--or); }
  .bk-nav { display: none; gap: 6px; margin-left: auto; }
  .bk-nav a { padding: 8px 12px; font-weight: 700; font-size: 0.95rem; border: 3px solid transparent; transition: background-color 0.15s, border-color 0.15s, transform 0.15s; }
  .bk-nav a:hover { background: var(--yel); border-color: var(--ink); transform: rotate(-2deg); }
  .bk-tel { display: none; font-weight: 800; font-variant-numeric: tabular-nums; }
  .bk-head .bk-btn { margin-left: auto; }
  @media (min-width: 1100px) {
    .bk-nav { display: flex; }
    .bk-tel { display: inline; }
    .bk-head .bk-btn { margin-left: 0; }
  }

  /* ---------- Первый экран ---------- */
  .bk-hero { padding-block: 22px 40px; }
  .bk-hero-main { display: grid; gap: 22px; align-content: start; padding: 22px 18px 26px; }
  .bk-h1 { display: grid; justify-items: start; gap: 6px; font-size: clamp(2.6rem, 12.4vw, 7.4rem); line-height: 0.95; letter-spacing: -0.055em; }
  .bk-h1-l { display: block; }
  .bk-h1-b { padding: 0.02em 0.14em 0.08em; border: var(--b); box-shadow: 4px 4px 0 var(--ink); }
  .bk-h1-b.c-lil { transform: rotate(-2deg); margin-left: 0.1em; }
  .bk-h1-b.c-or { transform: rotate(1.4deg); margin-left: 0.5em; }
  .bk-hero-p { max-width: 46ch; font-size: 1.05rem; font-weight: 450; }
  .bk-hero-cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .bk-hero-ph { margin: 0; aspect-ratio: 4 / 5; background: var(--yel); }
  .bk-hero-ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .bk-stk-round { position: absolute; left: -12px; bottom: -20px; width: 128px; height: 128px; display: grid; place-content: center; text-align: center; }
  .bk-stk-round svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--yel); stroke: var(--ink); stroke-width: 3px; paint-order: stroke; filter: drop-shadow(3px 3px 0 var(--ink)); animation: bk-spin 24s linear infinite; }
  .bk-stk-round b, .bk-stk-round small { position: relative; display: block; transform: rotate(-10deg); }
  .bk-stk-round b { font-size: 2rem; font-weight: 900; line-height: 1; letter-spacing: -0.04em; }
  .bk-stk-round small { font-size: 0.72rem; font-weight: 800; line-height: 1.1; margin-top: 2px; }
  @keyframes bk-spin { to { transform: rotate(360deg); } }
  .bk-stat { display: grid; align-content: space-between; gap: 10px; min-height: 140px; padding: 16px; grid-column: span 6 !important; }
  .bk-stat b { font-size: clamp(2.4rem, 1.6rem + 3vw, 4.4rem); font-weight: 900; line-height: 0.9; letter-spacing: -0.05em; font-variation-settings: 'SHRP' 100; font-variant-numeric: tabular-nums; }
  .bk-stat span { font-size: 0.9rem; font-weight: 600; line-height: 1.3; }
  a.bk-stat { transition: translate 0.15s ease, box-shadow 0.15s ease; }
  a.bk-stat:hover { translate: -2px -2px; box-shadow: calc(var(--sh) + 3px) calc(var(--sh) + 3px) 0 var(--ink); }
  .bk-stars { display: flex; gap: 2px; }
  .bk-stars :global(svg) { width: 18px; height: 18px; }
  .bk-stat .bk-stars :global(svg) { width: 14px; height: 14px; }
  @media (min-width: 1100px) { .bk-stat .bk-stars { position: absolute; top: 18px; right: 16px; } .bk-stat .bk-stars :global(svg) { width: 18px; height: 18px; } }
  @media (min-width: 1100px) {
    .bk-hero { padding-block: 32px 64px; }
    .bk-hero-main { grid-column: 1 / 9 !important; padding: 36px 40px 40px; gap: 28px; }
    .bk-h1 { font-size: min(7.6vw, 7.4rem); }
    .bk-hero-ph { grid-column: 9 / 13 !important; aspect-ratio: auto; }
    .bk-stk-round { left: -46px; bottom: 26px; width: 150px; height: 150px; }
    .bk-stat { grid-column: span 3 !important; min-height: 180px; padding: 20px; }
  }

  /* ---------- Ленты ---------- */
  .bk-tapes { position: relative; height: 150px; margin-block: 0 10px; }
  .bk-tape { position: absolute; left: -5%; right: -5%; top: 50%; border-block: var(--b); overflow: hidden; }
  .bk-tape-a { background: var(--ink); color: var(--cream); transform: translateY(-50%) rotate(-3deg); z-index: 2; }
  .bk-tape-b { transform: translateY(-50%) rotate(2.4deg); }
  .bk-tape-in { display: flex; width: max-content; animation: bk-run 38s linear infinite; }
  .bk-tape-b .bk-tape-in { animation-direction: reverse; animation-duration: 46s; }
  .bk-tape span { display: inline-flex; align-items: center; gap: 22px; padding: 14px 0 14px 22px; font-weight: 850; font-size: clamp(1.05rem, 0.8rem + 1vw, 1.6rem); letter-spacing: -0.02em; white-space: nowrap; text-transform: uppercase; }
  .bk-tape span :global(svg) { width: 22px; height: 20px; color: var(--or); }
  .bk-tape-b span :global(svg) { color: var(--ink); }
  @keyframes bk-run { to { transform: translateX(-50%); } }

  /* ---------- Секции ---------- */
  .bk-sec { padding-block: clamp(48px, 7vw, 96px); }
  .bk-sec-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-bottom: clamp(24px, 3vw, 40px); }
  .bk-h2 { font-size: clamp(2.5rem, 1.3rem + 5vw, 5.6rem); letter-spacing: -0.055em; line-height: 0.92; }
  .bk-sec-head .bk-stk-tag { --r: 4deg; font-size: 1rem; }

  /* Зоны */
  .bk-zone { display: grid; grid-template-rows: auto 1fr; overflow: hidden; background: var(--white); transition: translate 0.18s ease, box-shadow 0.18s ease; }
  .bk-zone:hover { translate: -3px -3px; box-shadow: calc(var(--sh) + 4px) calc(var(--sh) + 4px) 0 var(--ink); }
  .bk-zone-ph { position: relative; aspect-ratio: 16 / 10; border-bottom: var(--b); overflow: hidden; }
  .bk-zone-ph :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.25) brightness(1.08); mix-blend-mode: multiply; transition: filter 0.3s ease, transform 0.5s ease; }
  .bk-zone:hover .bk-zone-ph :global(img) { transform: scale(1.04); }
  .bk-zone-tag { position: absolute; top: 14px; left: 14px; padding: 6px 12px; border: var(--b); font-weight: 850; font-size: 0.9rem; transform: rotate(-3deg); box-shadow: 3px 3px 0 var(--ink); }
  .bk-zone-txt { position: relative; display: grid; gap: 10px; align-content: start; padding: 18px 18px 22px; padding-right: 76px; }
  .bk-zone h3 { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); }
  .bk-zone p { font-weight: 450; }
  .bk-arrow { position: absolute; right: 16px; bottom: 18px; display: grid; place-items: center; width: 46px; height: 46px; border: var(--b); background: var(--yel); transition: transform 0.2s ease; }
  .bk-arrow :global(svg) { width: 18px; height: 16px; }
  .bk-zone:hover .bk-arrow { transform: rotate(-12deg) scale(1.08); }
  .bk-z4 { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 20px 18px 22px; }
  .bk-zone .bk-z4-t { order: 9; margin-top: auto; font-size: clamp(4.6rem, 2.6rem + 9vw, 12rem); font-weight: 900; line-height: 0.82; letter-spacing: -0.07em; font-variation-settings: 'SHRP' 100; }
  .bk-z4-t small { font-size: 0.36em; letter-spacing: -0.02em; margin-left: 0.08em; vertical-align: top; }
  .bk-z4 p:not(.bk-z4-t) { max-width: 40ch; font-weight: 500; }
  .bk-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .bk-chips li { padding: 6px 14px; border: var(--b); border-radius: 999px; font-weight: 800; font-size: 0.92rem; }
  .bk-chips li:nth-child(1) { transform: rotate(-3deg); }
  .bk-chips li:nth-child(2) { transform: rotate(2deg); }
  .bk-z4 .bk-arrow { background: var(--white); top: 18px; bottom: auto; }
  .bk-z4 h3 { padding-right: 60px; }
  @media (min-width: 900px) {
    .bk-z1 { grid-column: 1 / 8 !important; }
    .bk-z2 { grid-column: 8 / 13 !important; }
    .bk-z3 { grid-column: 1 / 6 !important; }
    .bk-z4 { grid-column: 6 / 13 !important; padding: 28px 30px 30px; }
    .bk-z2 .bk-zone-ph, .bk-z3 .bk-zone-ph { aspect-ratio: auto; height: 100%; min-height: 0; }
    .bk-z2, .bk-z3 { grid-template-rows: minmax(0, 1fr) auto; }
    .bk-z1 .bk-zone-ph { aspect-ratio: 16 / 9.4; }
    .bk-zone-txt { padding: 22px 26px 26px; padding-right: 90px; }
    .bk-arrow { right: 22px; bottom: 22px; }
  }

  /* Цены */
  .bk-switch { display: inline-flex; border: var(--b); box-shadow: 4px 4px 0 var(--ink); background: var(--white); }
  .bk-switch button { min-height: 48px; padding: 0 20px; border: 0; background: transparent; font-weight: 800; font-size: 0.98rem; cursor: pointer; transition: background-color 0.15s ease; }
  .bk-switch button + button { border-left: var(--b); }
  .bk-switch button[aria-pressed='true'] { background: var(--ink); color: var(--yel); }
  .bk-switch button:active { scale: 0.96; }
  .bk-plan { display: grid; grid-template-rows: auto auto auto auto 1fr auto; gap: 12px; padding: 24px 20px 22px; }
  .bk-plan > .bk-stk-tag { position: absolute; top: -18px; right: 16px; --r: 5deg; }
  .bk-plan h3 { font-size: clamp(1.8rem, 1.3rem + 1.4vw, 2.5rem); }
  .bk-plan-h { font-weight: 600; font-size: 0.95rem; }
  .bk-plan-price { display: flex; align-items: flex-start; gap: 10px; margin-top: 8px; padding: 14px 0 12px; border-top: var(--b); }
  .bk-plan-price b { font-size: clamp(3.8rem, 2.8rem + 3.6vw, 6rem); font-weight: 900; line-height: 0.84; letter-spacing: -0.06em; font-variation-settings: 'SHRP' 100; font-variant-numeric: tabular-nums; display: inline-block; }
  .bk-plan-price span { font-weight: 850; font-size: 1.5rem; line-height: 1; }
  .bk-plan-price i { font-style: normal; font-size: 0.82rem; font-weight: 700; }
  .bk-pop { animation: bk-squash 0.4s var(--drop); }
  @keyframes bk-squash { 0% { transform: scale(1, 1); } 35% { transform: scale(1.08, 0.86); } 100% { transform: none; } }
  .bk-plan-sub { margin-top: -8px; font-weight: 700; font-size: 0.92rem; }
  .bk-plan ul { list-style: none; display: grid; gap: 9px; align-content: start; padding-top: 14px; border-top: var(--b); }
  .bk-plan li { display: grid; grid-template-columns: 26px 1fr; gap: 10px; align-items: start; font-weight: 550; font-size: 0.98rem; line-height: 1.35; }
  .bk-ck { display: grid; place-items: center; width: 24px; height: 24px; background: var(--ink); color: var(--white); }
  .bk-ck :global(svg) { width: 16px; height: 16px; }
  .bk-plan li.is-no { opacity: 0.55; text-decoration: line-through; text-decoration-thickness: 2px; }
  .bk-plan li.is-no .bk-ck { background: transparent; color: var(--ink); border: 2px solid var(--ink); }
  .bk-plan .bk-btn { margin-top: 10px; }
  .bk-trial { display: grid; gap: 16px; padding: 22px 20px 26px; margin-top: 18px; overflow: visible; }
  .bk-trial-n { font-size: clamp(7rem, 4rem + 18vw, 15rem); font-weight: 900; line-height: 0.78; letter-spacing: -0.08em; font-variation-settings: 'SHRP' 100; color: var(--ink); padding-top: 0.04em; }
  .bk-trial-txt { display: grid; gap: 14px; align-content: center; }
  .bk-trial-txt h3 { font-size: clamp(2rem, 1.4rem + 2vw, 3.2rem); }
  .bk-trial-txt p { font-weight: 550; max-width: 40ch; }
  .bk-trial-txt .bk-btn { justify-self: start; }
  .bk-trial-stk { position: absolute; top: -20px; right: 14px; --r: -5deg; }
  .bk-ticket { display: grid; grid-template-columns: auto 1fr; gap: 0; overflow: hidden; }
  .bk-ticket-big { display: grid; place-items: center; padding: 16px 14px; border-right: 3px dashed var(--ink); font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem); font-weight: 900; letter-spacing: -0.05em; line-height: 0.9; writing-mode: vertical-rl; transform: rotate(180deg); }
  .bk-ticket-txt { display: grid; gap: 10px; padding: 18px 18px 20px; align-content: start; }
  .bk-ticket h3 { font-size: 1.5rem; }
  .bk-ticket-txt p { font-size: 0.96rem; font-weight: 500; }
  @media (min-width: 900px) {
    .bk-plan { grid-column: span 4 !important; padding: 30px 26px 26px; }
    .bk-trial { grid-column: 1 / -1 !important; grid-template-columns: auto 1fr; gap: clamp(28px, 4vw, 64px); padding: 30px 40px; align-items: center; margin-top: 26px; }
    .bk-trial-stk { right: 40px; }
    .bk-ticket { grid-column: span 6 !important; }
    .bk-ticket-big { writing-mode: horizontal-tb; transform: none; min-width: 170px; padding: 20px; font-size: clamp(2.4rem, 1.4rem + 2vw, 3.4rem); }
    .bk-ticket-txt { padding: 24px 26px 26px; }
  }

  /* Тренеры */
  .bk-tr { margin: 0; background: var(--white); display: grid; grid-template-rows: auto 1fr; }
  .bk-tr :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-bottom: var(--b); }
  .bk-tr-cap { position: relative; display: grid; gap: 4px; margin: -34px 14px 16px; padding: 12px 14px; border: var(--b); box-shadow: 4px 4px 0 var(--ink); transform: rotate(var(--r)); }
  .bk-tr-cap b { font-size: 1.3rem; font-weight: 850; letter-spacing: -0.03em; line-height: 1.05; font-variation-settings: 'SHRP' 100; }
  .bk-tr-cap span { font-size: 0.9rem; font-weight: 550; line-height: 1.3; }
  .bk-pt { display: grid; gap: 14px; align-content: start; padding: 22px 20px 24px; }
  .bk-pt .bk-pill { border-color: var(--yel); color: var(--ink); }
  .bk-pt-big { font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.5rem); font-weight: 900; line-height: 1; letter-spacing: -0.04em; font-variation-settings: 'SHRP' 100; color: var(--yel); }
  .bk-pt .bk-btn { justify-self: start; margin-top: 6px; border-color: var(--cream); box-shadow: 5px 5px 0 var(--cream); }
  .bk-pt .bk-btn:hover { box-shadow: 7px 7px 0 var(--cream); }
  .bk-pt.bk-box { box-shadow: var(--sh) var(--sh) 0 var(--or); }
  @media (min-width: 700px) { .bk-tr { grid-column: span 6 !important; } .bk-pt { grid-column: 1 / -1 !important; } }
  @media (min-width: 1100px) { .bk-tr { grid-column: span 3 !important; } .bk-pt { grid-column: span 3 !important; } }

  /* Отзывы */
  .bk-rate { display: grid; gap: 10px; grid-template-rows: 1fr auto auto; align-content: stretch; justify-items: start; padding: 22px 20px; transition: translate 0.15s ease, box-shadow 0.15s ease; }
  .bk-rate:hover { translate: -2px -2px; box-shadow: calc(var(--sh) + 3px) calc(var(--sh) + 3px) 0 var(--ink); }
  .bk-rate b { align-self: start; font-size: clamp(5rem, 3rem + 9vw, 13rem); font-weight: 900; line-height: 0.8; letter-spacing: -0.07em; font-variation-settings: 'SHRP' 100; }
  .bk-rate .bk-stars :global(svg) { width: 26px; height: 26px; }
  .bk-rate span { font-weight: 700; }
  .bk-rv { margin: 0; display: grid; gap: 16px; align-content: space-between; padding: 20px; }
  .bk-rv p { font-weight: 500; font-size: 1rem; line-height: 1.5; }
  .bk-rv footer { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .bk-ava { display: grid; place-items: center; width: 40px; height: 40px; border: var(--b); background: var(--ink); color: var(--yel); font-weight: 900; }
  .bk-rv b { font-weight: 850; }
  .bk-src { padding: 2px 8px; border: 2px solid var(--ink); font-size: 0.78rem; font-weight: 700; background: var(--white); }
  @media (min-width: 900px) {
    .bk-rate { grid-column: 1 / 5 !important; grid-row: span 2; }
    .bk-rv { grid-column: span 4 !important; }
    .bk-rv:nth-of-type(odd) { rotate: 0.6deg; }
    .bk-rv:nth-of-type(even) { rotate: -0.6deg; }
  }
  @media (min-width: 900px) and (max-width: 1099px) {
    .bk-rate { grid-column: 1 / -1 !important; grid-row: auto; }
    .bk-rv { grid-column: span 6 !important; }
  }
  @media (min-width: 1100px) {
    .bk-rv:nth-of-type(1) { grid-column: 5 / 9 !important; }
    .bk-rv:nth-of-type(2) { grid-column: 9 / 13 !important; }
    .bk-rv:nth-of-type(3) { grid-column: 5 / 9 !important; }
    .bk-rv:nth-of-type(4) { grid-column: 9 / 13 !important; }
  }

  /* Заявка */
  .bk-cta { padding-bottom: clamp(64px, 8vw, 110px); }
  .bk-cta-main { display: grid; gap: 20px; align-content: start; padding: 24px 20px; }
  .bk-cta-p { max-width: 44ch; font-weight: 550; }
  .bk-info { display: grid; gap: 12px; margin-top: 6px; }
  .bk-info > div { display: grid; gap: 3px; align-content: start; padding: 14px 16px; border: var(--b); }
  .bk-info span { font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
  .bk-info b { font-weight: 800; font-size: 1.05rem; line-height: 1.3; }
  .bk-info a { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; width: fit-content; }
