    .rl-hero-mark { grid-column: 1 / 7; }
    .rl-hero-ph { grid-column: 1 / 7; grid-row: 3; margin-top: 32px; aspect-ratio: 4 / 3; }
    .rl-h1 { grid-column: 1 / 7; grid-row: 2; margin-top: 40px; font-size: 76px; letter-spacing: -0.065em; }
    .rl-hero-tx { grid-column: 1 / 7; grid-row: 4; margin-top: 40px; font-size: 1.125rem; }
