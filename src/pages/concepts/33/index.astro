<style>
  .rl {
    --bg: #0c0c0c; --ink: #f2f2f0; --soft: #c4c4c0; --mute: #8e8e8a; --dim: #5c5c59; --hair: #262624;
    --red: #ff5722;
    --f: 'Onest r', 'Onest fb', system-ui, sans-serif;
    --m: 'Plex r', ui-monospace, 'SFMono-Regular', monospace;
    /* поля: слева широкое, в нём идёт линия (--rg от линии до текста) */
    --pl: 128px; --pr: 80px; --rg: 64px; --gap: 32px;
    --sec: 160px;
    position: relative; font-family: var(--f); color: var(--ink); font-size: 1.0625rem; line-height: 1.55;
    -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; overflow-x: clip;
  }
  @media (max-width: 1279px) { .rl { --pl: 96px; --pr: 48px; --rg: 48px; --sec: 128px; } }
  @media (max-width: 699px) { .rl { --pl: 32px; --pr: 24px; --rg: 20px; --gap: 16px; --sec: 96px; font-size: 1rem; } }

  .rl-w { width: 100%; max-width: 1440px; margin: 0 auto; padding-left: var(--pl); padding-right: var(--pr); }
  .rl :global(h1), .rl :global(h2), .rl :global(h3) { font-family: var(--f); text-transform: none; }
  :global(:where(.rl p)) { margin: 0; text-wrap: pretty; }
  :global(:where(.rl ul, .rl ol, .rl dl, .rl dd)) { margin: 0; padding: 0; list-style: none; }
  :global(:where(.rl figure, .rl blockquote)) { margin: 0; }
  :global(:where(.rl a)) { text-decoration: none; }

  /* ---------- Линия ---------- */
  .rl-line { position: absolute; top: 0; left: 0; z-index: 3; pointer-events: none; overflow: visible; }
  .rl-line :global(path) { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-linejoin: miter; stroke-linecap: butt; }
  .rl-line :global(circle) { fill: var(--red); }

  /* ---------- Типографика ---------- */
  .rl-mark { display: flex; flex-wrap: wrap; gap: 0 24px; font-family: var(--m); font-size: 0.75rem; line-height: 16px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .rl-mark span { color: var(--soft); }
  .rl-h1 { display: flex; flex-direction: column; font-size: 168px; line-height: 0.86; font-weight: 600; letter-spacing: -0.06em; margin: 0; padding-bottom: 0.17em; }
  .rl-h1 span { display: block; white-space: nowrap; height: 0.86em; }
  .rl-h2 { font-size: 56px; line-height: 1.04; font-weight: 600; letter-spacing: -0.045em; text-wrap: balance; max-width: 12em; }
  .rl-h2-xl { font-size: 88px; line-height: 0.96; letter-spacing: -0.055em; }
  .rl-p { color: var(--soft); font-size: 1.125rem; line-height: 1.55; max-width: 32em; }
  .rl-quiet { display: inline-flex; align-items: center; min-height: 48px; color: var(--ink); font-weight: 500; text-decoration: underline !important; text-decoration-color: var(--dim) !important; text-decoration-thickness: 1px !important; text-underline-offset: 6px; transition: text-decoration-color 0.3s; }
  .rl-quiet:hover { text-decoration-color: var(--ink) !important; }

  /* ---------- Кнопки ---------- */
  .rl-btn { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 56px; padding: 0 24px; background: var(--ink); color: var(--bg); font-weight: 600; font-size: 1rem; line-height: 1; border: 1px solid var(--ink); transition: background-color 0.3s, color 0.3s, border-color 0.3s; white-space: nowrap; }
  .rl-btn :global(svg) { width: 17px; height: 12px; flex: none; transition: transform 0.4s cubic-bezier(0.6, 0, 0.25, 1); }
  .rl-btn:hover :global(svg) { transform: translateX(4px); }
  .rl-btn:hover { background: #fff; }
  .rl-btn-line { background: transparent; color: var(--ink); border-color: #3a3a38; }
  .rl-btn-line:hover { background: transparent; border-color: var(--ink); }
  .rl-btn-s { min-height: 40px; padding: 0 16px; font-size: 0.875rem; justify-content: center; gap: 0; }
  .rl-btn-wide { width: 100%; }

  /* ---------- Шапка ---------- */
  .rl-top-in { display: flex; align-items: center; gap: 40px; height: 88px; }
  .rl-logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; color: var(--ink); }
  .rl-logo :global(svg) { width: 17px; height: 14px; color: var(--red); }
  .rl-nav { display: flex; gap: 32px; margin-left: auto; font-size: 0.9375rem; color: var(--soft); }
  .rl-nav a { transition: color 0.3s; }
  .rl-nav a:hover, .rl-tel:hover { color: var(--ink); }
  .rl-tel { font-family: var(--m); font-size: 0.875rem; color: var(--soft); transition: color 0.3s; }

  /* ---------- Первый экран ---------- */
  .rl-hero { padding-top: 40px; }
  .rl-hero-in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); grid-template-rows: auto 1fr auto auto; }
  .rl-hero-mark { grid-column: 1 / 8; grid-row: 1; }
  .rl-h1 { grid-column: 1 / 9; grid-row: 2; align-self: end; position: relative; z-index: 1; }
  .rl-hero-ph { grid-column: 9 / 13; grid-row: 1 / 3; aspect-ratio: 4 / 5; overflow: hidden; background: #161616; align-self: end; }
  .rl-hero-ph :global(img), .rl-zone-ph :global(img), .rl-team-ph :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.06) brightness(0.88); }
  .rl-hero-tx { grid-column: 1 / 6; grid-row: 3; margin-top: 64px; font-size: 1.25rem; line-height: 1.5; color: var(--soft); max-width: 26em; }
  .rl-hero-act { grid-column: 9 / 13; grid-row: 3; margin-top: 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; align-self: start; }
  .rl-hero-facts { grid-column: 1 / 13; grid-row: 4; margin-top: 64px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap); border-top: 1px solid var(--hair); padding-top: 24px; }
  .rl-hero-facts div { display: flex; flex-direction: column; gap: 8px; }
  .rl-hero-facts dt, .rl-facts dt { font-family: var(--m); font-size: 0.75rem; line-height: 16px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .rl-hero-facts dd { font-size: 1.125rem; color: var(--ink); }
  .rl-hero-facts a:hover { color: var(--soft); }

  /* ---------- Секции ---------- */
  .rl-sec { padding-top: var(--sec); }
  .rl-head { display: grid; gap: 24px; margin-bottom: 80px; }
  .rl-head-rev { grid-template-columns: 1fr auto; align-items: end; }
  .rl-head-rev > div { display: grid; gap: 24px; }

  /* строки зон и отзывов: тонкая линия сверху, оранжевая ветка входит в её начало */
  .rl-rows > li { border-top: 1px solid var(--hair); }
  .rl-zone { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); padding: 32px 0; align-items: start; }
  .rl-idx { grid-column: 1 / 2; font-family: var(--m); font-size: 0.75rem; line-height: 40px; letter-spacing: 0.1em; color: var(--mute); }
  .rl-zone h3 { grid-column: 2 / 6; font-size: 32px; line-height: 40px; font-weight: 500; letter-spacing: -0.03em; }
  .rl-zone h3 a { color: var(--ink); transition: color 0.3s; }
  .rl-zone h3 a:hover { color: var(--soft); }
  .rl-zone p { grid-column: 6 / 10; color: var(--soft); padding-top: 8px; }
  .rl-zone-ph { grid-column: 10 / 13; aspect-ratio: 3 / 2; overflow: hidden; background: #161616; }
  .rl-zone-note { grid-column: 10 / 13; aspect-ratio: 3 / 2; display: flex; align-items: flex-end; padding: 16px; border: 1px solid var(--hair); font-family: var(--m); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }

  /* ---------- Тарифы ---------- */
  .rl-plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap); }
  .rl-plan { display: flex; flex-direction: column; border-top: 1px solid var(--hair); padding-top: 32px; }
  .rl-plan header { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .rl-plan h3 { font-size: 24px; line-height: 32px; font-weight: 500; letter-spacing: -0.02em; }
  .rl-tag { font-family: var(--m); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .is-hot .rl-tag { color: var(--ink); }
  .rl-plan-h { margin-top: 8px !important; font-family: var(--m); font-size: 0.75rem; line-height: 16px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); }
  .rl-price { display: flex; align-items: baseline; gap: 12px; margin-top: 48px !important; }
  .rl-price b { font-size: 96px; line-height: 0.9; font-weight: 600; letter-spacing: -0.06em; }
  .rl-price span { color: var(--mute); font-size: 0.9375rem; }
  .rl-year { margin-top: 24px !important; color: var(--soft); font-size: 0.9375rem; }
  .rl-plan ul { margin: 32px 0 40px; flex: 1; }
  .rl-plan li { padding: 12px 0; border-top: 1px solid var(--hair); font-size: 0.9375rem; color: var(--soft); }
  .rl-plan li.no { color: var(--dim); text-decoration: line-through; text-decoration-color: #3a3a38; }

  /* ---------- Цена дня ---------- */
  .rl-offer { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: start; }
  .rl-one { grid-column: 1 / 6; display: flex; align-items: flex-start; justify-content: center; gap: 8px; padding: 48px 0 56px; font-weight: 600; letter-spacing: -0.07em; }
  .rl-one b { font-size: 240px; line-height: 0.74; }
  .rl-one span { font-size: 96px; line-height: 0.8; color: var(--soft); letter-spacing: 0; }
  .rl-offer-tx { grid-column: 7 / 13; display: grid; gap: 24px; justify-items: start; }
  .rl-terms { display: grid; gap: 8px; font-family: var(--m); font-size: 0.8125rem; color: var(--mute); margin-bottom: 16px !important; }
  .rl-terms li::before { content: '+ '; color: var(--dim); }
  .rl-side { grid-column: 1 / 13; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); margin-top: 96px; }
  .rl-side li:first-child { grid-column: 1 / 6; }
  .rl-side li:last-child { grid-column: 7 / 13; }
  .rl-side li { border-top: 1px solid var(--hair); padding-top: 24px; display: grid; gap: 12px; align-content: start; }
  .rl-side h3 { font-size: 20px; line-height: 28px; font-weight: 500; letter-spacing: -0.02em; }
  .rl-side p { color: var(--mute); font-size: 0.9375rem; }
  .rl-side .rl-quiet { justify-self: start; }

  /* ---------- Тренеры ---------- */
  .rl-team { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap); }
  .rl-team li { display: grid; gap: 8px; align-content: start; }
  .rl-team-ph { aspect-ratio: 4 / 5; overflow: hidden; background: #161616; margin-bottom: 24px; }
  .rl-team b { font-size: 20px; line-height: 28px; font-weight: 500; letter-spacing: -0.02em; }
  .rl-team li > span:last-child { color: var(--mute); font-size: 0.9375rem; }
  .rl-personal { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 16px; margin-top: 96px; padding-top: 32px; border-top: 1px solid var(--hair); align-items: start; }
  .rl-personal h3 { grid-column: 1 / 5; font-size: 24px; line-height: 32px; font-weight: 500; letter-spacing: -0.02em; }
  .rl-personal > p:nth-of-type(1) { grid-column: 5 / 9; color: var(--soft); }
