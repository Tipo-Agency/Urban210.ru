    .rl-hero-ph { grid-column: 8 / 13; }
    .rl-hero-tx { grid-column: 1 / 8; }
    .rl-hero-act { grid-column: 8 / 13; }
    .rl-plans, .rl-team { grid-template-columns: 1fr; row-gap: 64px; }
    .rl-one, .rl-offer-tx, .rl-side { grid-column: 1 / 13; }
