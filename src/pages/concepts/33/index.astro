  .rl-score { display: flex; align-items: flex-end; gap: 16px; color: var(--ink); }
  .rl-score b { font-size: 96px; line-height: 0.8; font-weight: 600; letter-spacing: -0.06em; }
  .rl-score span { font-family: var(--m); font-size: 0.75rem; line-height: 18px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); }
  .rl-rev { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); padding: 32px 0 40px; }
  .rl-rev-who { grid-column: 1 / 5; display: grid; gap: 4px; align-content: start; }
  .rl-rev-who b { font-weight: 500; font-size: 1.125rem; }
  .rl-rev-who span { font-family: var(--m); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .rl-rev blockquote { grid-column: 5 / 12; }
  .rl-rev blockquote p { font-size: 1.25rem; line-height: 1.55; color: var(--soft); }

  /* ---------- Заявка ---------- */
  .rl-final { padding-bottom: var(--sec); }
  .rl-final-in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: start; }
  .rl-final-tx { grid-column: 1 / 7; display: grid; gap: 24px; }
  .rl-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 32px var(--gap); margin-top: 40px; }
  .rl-facts div { display: grid; gap: 8px; align-content: start; }
  .rl-facts dd { color: var(--soft); font-size: 0.9375rem; }
  .rl-facts a { color: var(--ink); }
  .rl-form { grid-column: 8 / 13; padding-top: 40px; }

  /* ---------- Подвал ---------- */
  .rl-foot { border-top: 1px solid var(--hair); padding: 64px 0 112px; font-size: 0.9375rem; color: var(--mute); }
  .rl-foot-cols { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 32px; }
  .rl-foot-cols > div { grid-column: 1 / 6; display: grid; gap: 16px; align-content: start; }
  .rl-foot-cols > ul { grid-column: span 2; display: grid; gap: 8px; align-content: start; }
  .rl-foot-cols > ul:nth-of-type(3) { grid-column: span 3; }
  .rl-foot a { color: var(--soft); transition: color 0.3s; }
  .rl-foot a:hover { color: var(--ink); }
  .rl-foot .rl-logo { color: var(--ink); }
  .rl-legal { margin-top: 64px !important; font-family: var(--m); font-size: 0.75rem; letter-spacing: 0.04em; color: var(--dim); }

  /* ---------- Средняя ширина ---------- */
  @media (max-width: 1279px) {
    .rl-h1 { font-size: 136px; }
