---
// Концепция 33 «Красная линия»: почти чёрная страница и одна тонкая оранжевая линия.
// Линия идёт по левому полю и рисуется по мере прокрутки. На своём пути она подчёркивает заголовок,
// обводит фото, ведёт к популярному тарифу, обводит цену дня и заканчивается на кнопке заявки.
// Геометрию считает маленький скрипт по реальным блокам страницы, поэтому линия совпадает с вёрсткой на любой ширине.
import onCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import pmCyr from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-cyrillic-400-normal.woff2?url';
import pmLat from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, personalText } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = `
@font-face{font-family:'Onest r';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Onest r';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onLat}) format('woff2');unicode-range:${UL}}
@font-face{font-family:'Plex r';font-style:normal;font-display:swap;font-weight:400;src:url(${pmCyr}) format('woff2');unicode-range:${UR}}
@font-face{font-family:'Plex r';font-style:normal;font-display:swap;font-weight:400;src:url(${pmLat}) format('woff2');unicode-range:${UL}}
@font-face{font-family:'Onest fb';src:local('Arial');size-adjust:103%;ascent-override:95%;descent-override:25%;line-gap-override:0%}`;

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const rating = site.rating.value.toString().replace('.', ',');
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const zoneList = [
  { ...z.zal, text: cap(z.zal.text), photo: '/images/zal.jpg', alt: 'Тренажёрный зал Urban210 с панорамными окнами' },
  { ...z.cardio, photo: '/images/cardio.jpg', alt: 'Ряд беговых дорожек в кардиозоне' },
  { ...z.group, text: cap(z.group.text), photo: '/images/group.jpg', alt: 'Групповая тренировка в большом зале' },
  { ...z.spa, photo: null, alt: '' },
];
const dayPrice = perDay(plans[0].month, 30);
const side = promos.filter((p) => p.slug !== '1-rubl');
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
---
<Layout title="Концепция 33 «Красная линия»" description="Концепция дизайна сайта Urban210: почти чёрная страница и одна оранжевая линия, которая рисуется при прокрутке и ведёт к заявке." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={onCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="rl" data-rl>
    <svg class="rl-line" data-rl-svg aria-hidden="true" focusable="false"></svg>

    <header class="rl-top">
      <div class="rl-w rl-top-in">
        <a class="rl-logo" href="/concepts/33/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="rl-nav" aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a>
        </nav>
        <a class="rl-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="rl-btn rl-btn-line rl-btn-s" href="#tarify" data-block="33_header">Выбрать карту</a>
      </div>
    </header>

    <!-- Первый экран: линия подчёркивает заголовок и становится рамкой фото -->
    <section class="rl-hero" data-l="hero" aria-labelledby="rl-h1">
      <div class="rl-w rl-hero-in" data-l="wrap">
        <p class="rl-mark rl-hero-mark">Фитнес-клуб<span>{site.city}</span><span class="rl-hide-s">{site.address.short}</span></p>
        <h1 id="rl-h1" class="rl-h1" data-l="h1"><span>Прямо</span><span>к&nbsp;цели.</span></h1>
        <figure class="rl-hero-ph" data-l="photo">
          <Image src={img('/images/community/2.jpg')} alt="Гость клуба тренируется с гантелью" widths={[480, 600]} sizes="(min-width: 1000px) 390px, 220px" loading="eager" fetchpriority="high" format="webp" quality={60} />
        </figure>
        <p class="rl-hero-tx">{cap(site.facts.area)} в&nbsp;Железнодорожном районе: {site.facts.machines} {site.facts.brands}, групповые программы и&nbsp;SPA. Безлимит от&nbsp;{dayPrice}&nbsp;₽ в день.</p>
        <div class="rl-hero-act">
          <a class="rl-btn" href="#tarify" data-block="33_hero">Выбрать карту<Icon name="chev" /></a>
          <a class="rl-quiet" href="#zayavka" data-lead="Заявка с сайта" data-block="33_hero">Оставить заявку</a>
        </div>
        <dl class="rl-hero-facts">
          {site.hours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
          <div><dt>Яндекс Карты</dt><dd><a href={site.maps.yandexReviews} target="_blank" rel="noopener">{rating} · {site.rating.text}</a></dd></div>
        </dl>
      </div>
    </section>

    <!-- Зоны: линия заходит в каждую строку -->
    <section class="rl-sec" id="zony" aria-labelledby="rl-zones-h">
      <div class="rl-w">
        <div class="rl-head">
          <p class="rl-mark">01<span>Пространство</span></p>
          <h2 id="rl-zones-h" class="rl-h2">Четыре зоны в&nbsp;одном абонементе</h2>
        </div>
        <ol class="rl-rows">
          {zoneList.map((zn, i) => (
            <li class="rl-zone" data-l="tick">
              <span class="rl-idx">{String(i + 1).padStart(2, '0')}</span>
              <h3><a href={zn.href}>{zn.title}</a></h3>
              <p>{zn.text}</p>
              {zn.photo
                ? <span class="rl-zone-ph"><Image src={img(zn.photo)} alt={zn.alt} widths={[360, 560, 720]} sizes="(min-width: 1000px) 300px, 100vw" loading="lazy" format="avif" quality={45} /></span>
                : <span class="rl-zone-note">В тарифе «{plans[2].name}»</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Тарифы: линия приводит к популярному -->
    <section class="rl-sec" id="tarify" aria-labelledby="rl-price-h">
      <div class="rl-w">
        <div class="rl-head">
          <p class="rl-mark">02<span>Тарифы</span></p>
          <h2 id="rl-price-h" class="rl-h2">Платите за&nbsp;тренировки, а&nbsp;не&nbsp;за&nbsp;вход</h2>
        </div>
        <div class="rl-plans" data-l="plans">
          {plans.map((p, i) => (
            <article class={`rl-plan ${i === 1 ? 'is-hot' : ''}`} data-l={i === 1 ? 'midplan' : undefined}>
              <header>
                <h3>{p.name}</h3>
                {p.tag && <span class="rl-tag">{p.tag}</span>}
              </header>
              <p class="rl-plan-h">{cap(p.hours)}</p>
              <p class="rl-price"><b data-l={i === 1 ? 'midprice' : undefined}>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="rl-year">За год {rub(p.year)}</p>
              <ul>
                {p.features.map((f) => <li>{f}</li>)}
                {p.excluded?.map((f) => <li class="no">{f}</li>)}
              </ul>
              <a class={`rl-btn rl-btn-wide ${i === 1 ? '' : 'rl-btn-line'}`} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`33_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Цена дня: линия обводит цену -->
    <section class="rl-sec" aria-labelledby="rl-offer-h">
      <div class="rl-w rl-offer">
        <p class="rl-one" data-l="one" aria-hidden="true"><b>{dayPrice}</b><span>₽</span></p>
        <div class="rl-offer-tx">
          <p class="rl-mark">03<span>Цена дня</span></p>
          <h2 id="rl-offer-h" class="rl-h2">Безлимит от&nbsp;{dayPrice}&nbsp;₽ в день</h2>
          <p class="rl-p">{plans[0].name}: {rub(plans[0].month)} в месяц, {plans[0].hours}. Безлимит в зал и кардиозону.</p>
          <ul class="rl-terms">{plans[0].features.slice(1).map((t) => <li>{t}</li>)}</ul>
          <a class="rl-btn" href="#zayavka" data-lead="Заявка с сайта" data-block="33_offer">Оставить заявку<Icon name="chev" /></a>
        </div>
        <ul class="rl-side">
          {side.map((pr) => (
            <li>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
              <a class="rl-quiet" href="#zayavka" data-lead={pr.goal} data-block={`33_promo_${pr.slug}`}>{pr.cta}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Тренеры: линия проходит под фото, как полка -->
    <section class="rl-sec" id="trenery" aria-labelledby="rl-team-h">
      <div class="rl-w">
        <div class="rl-head">
          <p class="rl-mark">04<span>Команда</span></p>
          <h2 id="rl-team-h" class="rl-h2">Тренеры, которые поставят технику</h2>
        </div>
        <ul class="rl-team" data-l="shelf">
          {trainers.map((t) => (
            <li>
              <span class="rl-team-ph" data-l="shelfph"><Image src={img(t.photo)} alt={t.name} widths={[360, 520, 760]} sizes="(min-width: 1000px) 400px, 100vw" loading="lazy" format="avif" quality={45} /></span>
              <b>{t.name}</b>
              <span>{t.role}</span>
            </li>
          ))}
        </ul>
        <div class="rl-personal">
          <h3>Персональные тренировки</h3>
          <p>{personalText.lead}</p>
          <p class="rl-personal-p"><b>{personalLine}</b><span>{personal.firstFree}</span></p>
          <a class="rl-quiet" href="#zayavka" data-lead="Персональные тренировки" data-block="33_personal">Записаться к тренеру</a>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="rl-sec" id="otzyvy" aria-labelledby="rl-rev-h">
      <div class="rl-w">
        <div class="rl-head rl-head-rev">
          <div>
            <p class="rl-mark">05<span>Отзывы</span></p>
            <h2 id="rl-rev-h" class="rl-h2">Что пишут гости</h2>
          </div>
          <a class="rl-score" href={site.maps.yandexReviews} target="_blank" rel="noopener"><b>{rating}</b><span>из 5 на Яндекс Картах<br />{site.rating.text}</span></a>
        </div>
        <ul class="rl-rows">
          {reviews.map((r) => (
            <li class="rl-rev" data-l="tick">
              <p class="rl-rev-who"><b>{r.name}</b><span>{r.source}</span></p>
              <blockquote><p>{r.text}</p></blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Заявка: линия заканчивается на кнопке -->
    <section class="rl-sec rl-final" id="zayavka" aria-labelledby="rl-final-h">
      <div class="rl-w rl-final-in">
        <div class="rl-final-tx">
          <p class="rl-mark">06<span>Запись</span></p>
          <h2 id="rl-final-h" class="rl-h2 rl-h2-xl">Начните с&nbsp;одного дня</h2>
          <dl class="rl-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h, i) => <>{i > 0 && <br />}{`${h.days} ${h.time}`}</>)}</dd></div>
            <div><dt>Парковка</dt><dd>{site.parking}</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="rl-form" data-l="form">
          <LeadForm id="rl" block="33_final" />
        </div>
      </div>
    </section>

    <footer class="rl-foot">
      <div class="rl-w">
        <div class="rl-foot-cols">
          <div>
            <a class="rl-logo" href="/concepts/33/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
            <p>{site.address.locality}, {site.address.street}</p>
          </div>
          <ul>
            <li><a href={site.phone.href}>{site.phone.display}</a></li>
            <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
            <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
            <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
          </ul>
          <ul>
            <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li>
          </ul>
          <ul>
            <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li>
          </ul>
        </div>
        <p class="rl-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Линия: основной путь идёт по левому полю и рисуется прокруткой.
  // От него отходят ветки (подчёркивание, рамки, указатель на тариф). Ветка выстреливает сама,
  // когда основной путь доходит до её начала. Нарисованное не стирается при прокрутке вверх.
  type P = [number, number];
  type Branch = { pts: P[]; at: number; delay: number; el?: SVGPathElement; len?: number };
  const root = document.querySelector<HTMLElement>('[data-rl]');
  const svg = root?.querySelector<SVGSVGElement>('[data-rl-svg]');
  if (root && svg) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NS = 'http://www.w3.org/2000/svg';
    const q = (s: string) => root.querySelector<HTMLElement>(`[data-l="${s}"]`)!;
    const R = (el: Element) => {
      const a = el.getBoundingClientRect(), b = root.getBoundingClientRect();
      return { l: a.left - b.left, t: a.top - b.top, r: a.right - b.left, b: a.bottom - b.top, w: a.width, h: a.height };
    };
    const segLen = (pts: P[]) => pts.slice(1).reduce((s, p, i) => s + Math.abs(p[0] - pts[i][0]) + Math.abs(p[1] - pts[i][1]), 0);
    const d = (pts: P[]) => 'M' + pts.map((p) => `${Math.round(p[0]) + 0.25} ${Math.round(p[1]) + 0.25}`).join('L');

    let main: P[] = [];
    let mainLen = 0;
    let branches: Branch[] = [];
    let mainEl: SVGPathElement | null = null;
    let cur = reduce ? Infinity : 0;
    let target = 0;
    let raf = 0;
    const fired = new Set<number>();
    const btn = q('form').querySelector<HTMLElement>('button[type=submit]');

    // длина основного пути до точки, где он впервые достигает высоты y
    const lenAtY = (y: number) => {
      let s = 0;
      for (let i = 1; i < main.length; i++) {
        const [ax, ay] = main[i - 1], [bx, by] = main[i];
        if (ay === by) { if (ay > y) return s; s += Math.abs(bx - ax); continue; }
        if (by <= y) { s += by - ay; continue; }
        return s + Math.max(0, y - ay);
      }
      return s;
    };

    const build = () => {
      const wrap = q('wrap');
      const cs = getComputedStyle(wrap);
      const mob = innerWidth < 700;
      const rail = R(wrap).l + parseFloat(cs.paddingLeft) - parseFloat(getComputedStyle(root).getPropertyValue('--rg'));
      const pad = mob ? 12 : 16;
      const hero = R(q('hero'));
      const y0 = hero.t + (mob ? 24 : 40);
      branches = [];
      const add = (pts: P[], at: number, delay = 0) => { const b = { pts, at, delay }; branches.push(b); return segLen(pts); };

      // 1. Заголовок и фото: линия под заголовком переходит в нижнюю сторону рамки,
      // в углу рамка расходится в две стороны и сходится наверху справа
      const ph = R(q('photo'));
      const f = { l: ph.l - pad, t: ph.t - pad, r: ph.r + pad, b: ph.b + pad };
      const atU = f.b - y0;
      const uLen = add([[rail, f.b], [f.l, f.b]], atU);
      const du = Math.min(900, uLen / 1.6);
      add([[f.l, f.b], [f.l, f.t], [f.r, f.t]], atU, du);
      add([[f.l, f.b], [f.r, f.b], [f.r, f.t]], atU, du);

      // 2. Строки зон и отзывов: короткая ветка к началу каждой строки
      root.querySelectorAll<HTMLElement>('[data-l="tick"]').forEach((el) => {
        const r = R(el);
        add([[rail, r.t], [r.l, r.t]], r.t - y0);
      });

      // 3. Тарифы: по зазору над колонками и между ними к цене популярного тарифа
      const plansR = R(q('plans'));
      const mid = R(q('midplan'));
      if (mob) {
        // на телефоне тарифы друг под другом: верхняя линия популярного становится оранжевой
        add([[rail, mid.t], [mid.r, mid.t]], mid.t - y0);
      } else {
        // над колонками к середине популярного тарифа, вниз, и по его верхней линии в обе стороны
        const ya = plansR.t - 56, xc = Math.round(mid.l + mid.w / 2);
        const sLen = add([[rail, ya], [xc, ya], [xc, mid.t]], ya - y0);
        const ds = Math.min(900, sLen / 1.6);
        add([[xc, mid.t], [mid.l, mid.t]], ya - y0, ds);
        add([[xc, mid.t], [mid.r, mid.t]], ya - y0, ds);
      }

      // 4. Цена дня: рамка вокруг «43 ₽», вход по нижней стороне
      const one = R(q('one'));
      const o = { l: one.l, t: one.t, r: one.r, b: one.b };
      const oLen = add([[rail, o.b], [o.l, o.b]], o.b - y0);
      const dOne = Math.max(200, oLen / 1.6);
      add([[o.l, o.b], [o.l, o.t], [o.r, o.t]], o.b - y0, dOne);
      add([[o.l, o.b], [o.r, o.b], [o.r, o.t]], o.b - y0, dOne);

      // 5. Тренеры: линия под фото
      const sh = R(q('shelf'));
      const sp = R(q('shelfph'));
      const ys = sp.b + (mob ? 12 : 16);
      if (!mob) add([[rail, ys], [sh.r, ys]], ys - y0);
      else root.querySelectorAll<HTMLElement>('[data-l="shelfph"]').forEach((el) => { const r = R(el); add([[rail, r.b + 12], [r.r, r.b + 12]], r.b + 12 - y0); });

      // 6. Финал: основной путь сворачивает к кнопке формы
      const form = R(q('form'));
      const b = btn ? R(btn) : form;
      const yb = b.t + b.h / 2;
      if (mob) main = [[rail, y0], [rail, yb], [b.l, yb]];
      else {
        const ya = form.t - 40, xf = form.l - 48;
        main = [[rail, y0], [rail, ya], [xf, ya], [xf, yb], [b.l, yb]];
      }
      mainLen = segLen(main);

      // отрисовка
      svg.setAttribute('width', String(root.offsetWidth));
      svg.setAttribute('height', String(root.offsetHeight));
      svg.replaceChildren();
      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('cx', String(Math.round(rail) + 0.25)); dot.setAttribute('cy', String(y0)); dot.setAttribute('r', '3.5');
      svg.append(dot);
      mainEl = document.createElementNS(NS, 'path');
      mainEl.setAttribute('d', d(main));
      mainEl.style.strokeDasharray = `${mainLen} ${mainLen + 10}`;
      svg.append(mainEl);
      branches.forEach((br, i) => {
        const el = document.createElementNS(NS, 'path');
        const len = segLen(br.pts);
        el.setAttribute('d', d(br.pts));
        el.style.strokeDasharray = `${len} ${len + 10}`;
        el.style.strokeDashoffset = fired.has(i) || reduce ? '0' : String(len);
        br.el = el; br.len = len;
        svg.append(el);
      });
      paint();
    };

    const paint = () => {
      if (!mainEl) return;
      const shown = Math.min(cur, mainLen);
      mainEl.style.strokeDashoffset = String(mainLen - shown);
      branches.forEach((br, i) => {
        if (fired.has(i) || shown < br.at || !br.el || !br.len) return;
        fired.add(i);
        const dur = Math.max(260, Math.min(900, br.len / 1.6));
        br.el.style.transition = reduce ? 'none' : `stroke-dashoffset ${dur}ms cubic-bezier(.6,0,.25,1) ${br.delay}ms`;
        br.el.style.strokeDashoffset = '0';
      });
      btn?.classList.toggle('is-lit', shown >= mainLen - 1);
    };

    const tick = () => {
      raf = 0;
      const diff = target - cur;
      cur = Math.abs(diff) < 0.5 ? target : cur + diff * 0.12;
      paint();
      if (cur !== target) raf = requestAnimationFrame(tick);
    };

    const onScroll = () => {
      const bottom = scrollY + innerHeight >= document.documentElement.scrollHeight - 4;
      const t = bottom ? mainLen : lenAtY(scrollY + innerHeight * 0.8);
      if (t > target) target = t;
      if (reduce) { cur = Infinity; paint(); return; }
      if (!raf && cur !== target) raf = requestAnimationFrame(tick);
    };

    let pend = 0;
    const rebuild = () => { cancelAnimationFrame(pend); pend = requestAnimationFrame(() => { build(); onScroll(); }); };
    build();
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', rebuild);
    new ResizeObserver(rebuild).observe(root);
    document.fonts?.ready.then(rebuild);
    root.classList.add('is-drawn');
  }
</script>

