    .rl-hero-facts div:last-child { grid-column: 1 / 3; }
    .rl-hero-facts dd { font-size: 1rem; }

    .rl-h2 { font-size: 40px; line-height: 1.05; }
    .rl-h2-xl { font-size: 52px; }
    .rl-head { margin-bottom: 48px; gap: 16px; }
    .rl-head-rev { grid-template-columns: 1fr; gap: 32px; }
    .rl-score b { font-size: 72px; }

    .rl-zone { grid-template-columns: 40px 1fr; padding: 24px 0 32px; row-gap: 12px; column-gap: 0; }
    .rl-idx { grid-column: 1; line-height: 32px; }
    .rl-zone h3 { grid-column: 2; font-size: 26px; line-height: 32px; }
