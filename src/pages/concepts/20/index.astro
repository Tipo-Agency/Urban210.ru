---
// Концепция 20 «Первый день»: кино-история первого дня в клубе.
// На компьютере сцены закреплены и сменяют друг друга при прокрутке (GSAP ScrollTrigger, scrub),
// часы в углу идут от 06:30 до вечера. На телефоне и при reduced-motion: простая вертикальная история.
// Шрифты: Sofia Sans Extra Condensed для времени и заголовков, Jost для текста. Один акцент #ff5722.
import { Image } from 'astro:assets';
import sofCyr from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-cyrillic-wght-normal.woff2?url';
import sofLat from '@fontsource-variable/sofia-sans-extra-condensed/files/sofia-sans-extra-condensed-latin-wght-normal.woff2?url';
import jostCyr from '@fontsource-variable/jost/files/jost-cyrillic-wght-normal.woff2?url';
import jostLat from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs } from '../../../data/content';

const cyr = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const lat = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (name: string, url: string, range: string) => `@font-face{font-family:'${name}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = [ff('Sofia f', sofCyr, cyr), ff('Sofia f', sofLat, lat), ff('Jost f', jostCyr, cyr), ff('Jost f', jostLat, lat)].join('');

const num = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const dayRate = perDay(plans[0].month, 30);
const rating = site.rating.value.toString().replace('.', ',');
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;
const parfenova = trainers.find((t) => t.photo.includes('parfenova'))!;
const personalLine = `${personal.pack} тренировок за ${rub(personal.price)}`;
const hoursLine = site.hours.map((h) => `${h.days} ${h.time}`).join(', ');

type Scene = { id: string; t: string; place: string; title: string[]; lines: string[]; image?: string; alt?: string; pos?: string; note?: string };
const scenes: Scene[] = [
  {
    id: 'vhod', t: '06:30', place: 'У входа',
    title: ['Первый', 'день'],
    lines: ['Клуб открывается в 6:30.', 'У входа бесплатная парковка на 50 мест под видеонаблюдением.'],
    image: '/images/hero.jpg', alt: 'Тренажёрный зал Urban210 ранним утром', pos: '50% 60%',
  },
  {
    id: 'resepshen', t: '06:35', place: 'Ресепшен',
    title: ['Пара минут,', 'и браслет на руке'],
    lines: ['Паспорт, анкета, ключ от шкафчика.', 'Администратор поможет выбрать карту.'],
    image: '/images/reception.jpg', alt: 'Стойка ресепшена Urban210', pos: '50% 55%',
  },
  {
    id: 'zal', t: '06:45', place: 'Тренажёрный зал',
    title: ['Инструктор покажет', 'технику'],
    lines: [`Больше 1300 м², ${site.facts.machines} ${site.facts.brands}.`, 'Свободные веса до 60 кг. Фитнес-тестирование входит в любой тариф.'],
    image: '/images/zal.jpg', alt: 'Тренажёрный зал с панорамными окнами', pos: '50% 50%',
  },
  {
    id: 'kardio', t: '07:40', place: 'Кардио, второй этаж',
    title: ['Наверх,', 'к дорожкам'],
    lines: [cardio.text, 'Гости пишут, что свободная дорожка находится почти всегда.'],
    image: '/images/cardio.jpg', alt: 'Ряд беговых дорожек в кардиозоне', pos: '50% 50%',
  },
  {
    id: 'gruppa', t: '19:00', place: 'Групповое занятие',
    title: ['Вечером', 'в группе'],
    lines: [`Зал групповых программ 150 м²: ${programs.flatMap((p) => p.items).slice(0, 5).join(', ')} и другие.`, 'Запись в приложении клуба. Без доплат в тарифе «Всё включено».'],
    image: '/images/group.jpg', alt: 'Групповое занятие в большом зале', pos: '50% 45%',
    note: 'Время занятий смотрите в расписании клуба',
  },
  {
    id: 'spa', t: '20:15', place: 'Сауна и хаммам',
    title: ['Тепло', 'после нагрузки'],
    lines: ['Финская сауна, хаммам 40–50 °C', 'и релакс-зона с массажными креслами.'],
  },
];
const minutes = scenes.map((s) => { const [h, m] = s.t.split(':').map(Number); return h * 60 + m; });
---
<Layout title="Концепция 20 «Первый день»" description="Концепция дизайна сайта Urban210: история первого дня в клубе, сцена за сценой." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={sofCyr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="root c20">
    <header class="hd">
      <a class="hd-logo" href="/concepts/20/" aria-label="Urban210, на главную">URBAN<b>210</b><Icon name="chev" /></a>
      <nav class="hd-nav" aria-label="Разделы">
        <a href="#den">Первый день</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#otzyvy">Отзывы</a>
      </nav>
      <a class="hd-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="bt bt-acc bt-s" href="#zayavka" data-lead="Заявка с сайта" data-block="20_header">Оставить заявку<Icon name="chev" class="chev" /></a>
    </header>

    <main>
      <!-- Фильм: сцены первого дня -->
      <section class="film" id="den" aria-label="Первый день в Urban210" data-film data-min={minutes.join(',')}>
        {scenes.map((s, i) => (
          <article class:list={['sc', `sc-${s.id}`, { 'sc-first': i === 0 }]} style={`--i:${i}`} aria-labelledby={`sc-h-${i}`}>
            <div class="sc-bg">
              {s.image ? (
                <Image src={img(s.image)} alt={s.alt!} widths={i === 0 ? [640, 1024, 1600, 2400] : [640, 1024, 1600]} sizes="100vw"
                  loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined}
                  format={i === 0 ? 'webp' : 'avif'} quality={i === 0 ? 60 : 50} style={`object-position:${s.pos}`} />
              ) : (
                <div class="steam" aria-hidden="true"><i></i><i></i><i></i><span>40–50<small>°C</small></span></div>
              )}
              {s.id === 'zal' && <video data-hero-video data-src="/video/hero-bw.mp4" poster="/video/hero-bw-poster.jpg" muted loop playsinline preload="none" aria-hidden="true"></video>}
            </div>
            <div class="sc-shade" aria-hidden="true"></div>
            <div class="sc-dim" aria-hidden="true"></div>

            <p class="sc-time" aria-hidden="true">{s.t}</p>
            <div class="sc-copy" data-rise={i > 0 ? "" : undefined}>
              <p class="sc-place rv"><span><i></i><b>{s.t}</b>{s.place}</span></p>
              {i === 0
                ? <h1 id={`sc-h-${i}`} class="sc-h sc-h1">{s.title.map((l) => <span class="rv"><span>{l}</span></span>)}</h1>
                : <h2 id={`sc-h-${i}`} class="sc-h">{s.title.map((l) => <span class="rv"><span>{l}</span></span>)}</h2>}
              <div class="sc-lines">{s.lines.map((l) => <p class="rv"><span>{l}</span></p>)}</div>
              {i === 0 && (
                <div class="sc-cta rv"><span>
                  <a class="bt bt-acc" href="#tarify" data-block="20_hero">Выбрать карту<Icon name="chev" class="chev" /></a>
                  <span class="scroll-hint">Листайте, покажем весь день</span>
                </span></div>
              )}
              {s.note && <p class="sc-note rv"><span>{s.note}</span></p>}
            </div>
            {s.id === 'zal' && (
              <figure class="sc-coach rv"><span>
                <Image src={img(parfenova.photo)} alt={parfenova.name} widths={[200, 400]} sizes="160px" format="avif" quality={50} />
                <figcaption><b>{parfenova.name}</b>{parfenova.role}</figcaption>
              </span></figure>
            )}
          </article>
        ))}

        <div class="hud" aria-hidden="true">
          <p class="hud-clock" data-clock>06:30</p>
          <ol class="hud-rail">
            {scenes.map((s, i) => <li data-tick style={`--i:${i}`}><b>{s.t}</b><span>{s.place}</span></li>)}
          </ol>
          <span class="hud-bar"><i data-bar></i></span>
        </div>
      </section>

      <!-- Финальная сцена: цена дня и форма -->
      <section class="end" id="zayavka" aria-labelledby="end-h">
        <div class="end-bg" aria-hidden="true">
          <Image src={img('/images/brand/promo-bg-1.webp')} alt="" widths={[800, 1400]} sizes="100vw" format="avif" quality={45} />
        </div>
        <div class="wr end-in">
          <div class="end-txt">
            <p class="end-t"><i></i>23:30 · клуб закрывается</p>
            <h2 id="end-h">Завтра в 6:30 может начаться ваш первый день</h2>
            <p class="end-p">{plans[0].name}: {rub(plans[0].month)} в месяц, {plans[0].hours}. Это {dayRate}&nbsp;₽ в&nbsp;день. Оставьте номер, администратор перезвонит и поможет выбрать карту.</p>
            <p class="end-price">{dayRate}<small>₽</small></p>
          </div>
          <LeadForm id="f20a" block="20_end" />
        </div>
      </section>

      <!-- Тарифы -->
      <section class="sct wr" id="tarify" aria-labelledby="pr-h">
        <div class="sct-head">
          <h2 id="pr-h">После первого дня</h2>
          <p>Три тарифа от {rub(plans[0].month)} в месяц, это от {dayRate} ₽ в день.</p>
        </div>
        <div class="per" role="radiogroup" aria-label="Период оплаты" data-per>
          <button type="button" role="radio" aria-checked="true" data-v="m">Месяц</button>
          <button type="button" role="radio" aria-checked="false" data-v="y">Год</button>
        </div>
        <div class="pl-grid">
          {plans.map((p) => (
            <article class:list={['pl', { 'pl-max': p.id === 'all' }]}>
              <header class="pl-top">
                <h3>{p.name}</h3>
                {p.tag && <span class="pl-tag">{p.tag}</span>}
              </header>
              <p class="pl-hours"><Icon name="clock" />{p.hours[0].toUpperCase() + p.hours.slice(1)}</p>
              <p class="pl-price"><b data-m={num(p.month)} data-y={num(p.year)}>{num(p.month)}</b><span>₽</span><small data-unit>в месяц</small></p>
              <p class="pl-day" data-m={`${perDay(p.month, 30)} ₽ в день`} data-y={`${perDay(p.year, 365)} ₽ в день, за год ${num(p.year)} ₽`}>{perDay(p.month, 30)} ₽ в день</p>
              <ul class="pl-list">
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="off"><Icon name="minus" />{f}</li>)}
              </ul>
              <a class:list={['bt', p.id === 'all' ? 'bt-acc' : 'bt-line']} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`20_plan_${p.id}`}>Выбрать<Icon name="chev" class="chev" /></a>
            </article>
          ))}
        </div>
        <p class="pl-foot">Персональные тренировки: {personalLine}. {personal.firstFree}.</p>
      </section>

      <!-- Тренеры -->
      <section class="sct wr" id="trenery" aria-labelledby="tr-h">
        <div class="sct-head">
          <h2 id="tr-h">В ролях</h2>
          <p>Люди, которые встретят вас в первый день и покажут зал.</p>
        </div>
        <div class="cast">
          {trainers.map((t) => (
            <figure class="cast-i">
              <div class="cast-ph"><Image src={img(t.photo)} alt={t.name} widths={[360, 600]} sizes="(min-width: 900px) 30vw, 80vw" format="avif" quality={45} /></div>
              <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- Отзывы -->
      <section class="sct wr" id="otzyvy" aria-labelledby="rv-h">
        <div class="sct-head rv-head">
          <h2 id="rv-h">Рецензии гостей</h2>
          <a class="rate" href={site.maps.yandexReviews} target="_blank" rel="noopener">
            <b>{rating}</b>
            <span><span class="stars" aria-label={`${rating} из 5`}>{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>{site.rating.text} на Яндекс Картах</span>
          </a>
        </div>
        <div class="revs">
          {reviews.map((r) => (
            <blockquote class="rvw">
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </section>

      <!-- Заявка -->
      <section class="sct wr ask" aria-labelledby="ask-h">
        <div class="ask-txt">
          <h2 id="ask-h">Остались вопросы? Перезвоним</h2>
          <p>Расскажем про тарифы, расписание групповых и SPA. Или напишите в <a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener">WhatsApp</a> и <a href={telegramLink('site_20')} target="_blank" rel="noopener">Telegram</a>.</p>
          <p class="ask-tel"><a href={site.phone.href}>{site.phone.display}</a></p>
        </div>
        <LeadForm id="f20b" block="20_final" />
      </section>
    </main>

    <footer class="ft">
      <div class="wr">
        <p class="ft-big" aria-hidden="true">URBAN<b>210</b><Icon name="chev" /></p>
        <div class="ft-g">
          <div><h3>Адрес</h3><p>{site.address.locality}, {site.address.street}<br />{site.district}<br />Парковка на 50 мест</p></div>
          <div><h3>Часы</h3>{site.hours.map((h) => <p>{h.days} {h.time}</p>)}</div>
          <div><h3>Связь</h3><p><a href={site.phone.href}>{site.phone.display}</a></p><p><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a> · <a href={telegramLink('site_20_footer')} target="_blank" rel="noopener">Telegram</a> · <a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p></div>
          <div><h3>Документы</h3><p><a href="/rules/">Правила клуба</a></p><p><a href="/oferta/">Договор-оферта</a></p><p><a href="/policy/">Политика конфиденциальности</a></p></div>
        </div>
        <p class="ft-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}. {hoursLine}.</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Период оплаты: месяц или год
  const per = document.querySelector<HTMLElement>('.c20 [data-per]');
  per?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    per.querySelectorAll('button').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    const v = b.dataset.v as 'm' | 'y';
    document.querySelectorAll<HTMLElement>('.c20 .pl [data-m]').forEach((el) => { el.textContent = el.dataset[v]!; });
    document.querySelectorAll<HTMLElement>('.c20 .pl [data-unit]').forEach((el) => { el.textContent = v === 'm' ? 'в месяц' : 'за год'; });
  }));

  // Шапка темнеет после первого экрана
  const hd = document.querySelector<HTMLElement>('.c20 .hd');
  const onScroll = () => hd?.classList.toggle('is-solid', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Фильм: только на широком экране, без reduced-motion. GSAP грузится отдельным чанком.
  const film = document.querySelector<HTMLElement>('[data-film]');
  const wide = matchMedia('(min-width: 1024px) and (min-height: 600px)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (film && wide.matches && !reduce) {
    Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      const scenes = [...film.querySelectorAll<HTMLElement>('.sc')];
      const N = scenes.length;
      const mins = (film.dataset.min || '').split(',').map(Number);
      const clock = film.querySelector<HTMLElement>('[data-clock]')!;
      const bar = film.querySelector<HTMLElement>('[data-bar]')!;
      const ticks = [...film.querySelectorAll<HTMLElement>('[data-tick]')];
      const hm = (x: number) => `${String(Math.floor(x / 60)).padStart(2, '0')}:${String(Math.floor(x % 60)).padStart(2, '0')}`;
      const inner = (s: HTMLElement) => s.querySelectorAll<HTMLElement>('.rv > span, .rv > *:not(span)');

      film.classList.add('is-film');
      const L = 1.4; // длина одного перехода на таймлайне
      const START = 0.5; // первая сцена чуть держится
      scenes.forEach((s, i) => {
        if (!i) return;
        gsap.set(s, { clipPath: 'inset(100% 0% 0% 0%)' });
        gsap.set(inner(s), { yPercent: 115, opacity: 0 });
      });

      const tl = gsap.timeline({ defaults: { ease: 'none' } });
      tl.to({}, { duration: START });
      gsap.set(scenes[0].querySelector('.sc-bg'), { scale: 1.06 });
      for (let i = 0; i < N - 1; i++) {
        const a = scenes[i], b = scenes[i + 1], t = START + i * L;
        tl.to(inner(a), { yPercent: -60, opacity: 0, duration: 0.35, stagger: 0.03, ease: 'power2.in' }, t)
          .to(a.querySelector('.sc-dim'), { opacity: 1, duration: 0.7, ease: 'power1.in' }, t + 0.1)
          .to(a.querySelector('.sc-bg'), { scale: 1, yPercent: -4, duration: 0.8 }, t)
          .to(b, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.7, ease: 'power3.inOut' }, t + 0.15)
          .fromTo(b.querySelector('.sc-bg'), { scale: 1.22, yPercent: 6 }, { scale: 1.06, yPercent: 0, duration: 1.1, ease: 'power2.out' }, t + 0.15)
          .to(inner(b), { yPercent: 0, opacity: 1, duration: 0.45, stagger: 0.05, ease: 'power3.out' }, t + 0.6);
      }
      tl.to({}, { duration: 0.35 });
      const total = tl.duration();

      // Часы: время между сценами «бежит», пока идёт переход
      const paint = () => {
        const tt = tl.time() - START;
        const k = Math.max(0, Math.min(N - 1, Math.floor(tt / L)));
        const f = k >= N - 1 ? 0 : gsap.utils.clamp(0, 1, (tt - k * L - 0.15) / 0.85);
        const e = f * f * (3 - 2 * f);
        const m = k >= N - 1 ? mins[N - 1] : mins[k] + (mins[k + 1] - mins[k]) * e;
        clock.textContent = hm(m);
        const cur = f > 0.5 ? k + 1 : k;
        ticks.forEach((el, j) => { el.classList.toggle('on', j === cur); el.classList.toggle('past', j < cur); });
        bar.style.transform = `scaleX(${tl.progress()})`;
      };

      ScrollTrigger.create({
        trigger: film,
        start: 'top top',
        end: () => `+=${innerHeight * 0.9 * (N - 1)}`,
        pin: true,
        scrub: 0.5,
        animation: tl,
        invalidateOnRefresh: true,
        onUpdate: paint,
      });
      paint();
      void total;
      // Вступление первой сцены: после создания ScrollTrigger, чтобы он запомнил конечные позиции строк
      if (scrollY < 20) gsap.from(inner(scenes[0]), { yPercent: 105, duration: 1.1, stagger: 0.06, ease: "power3.out" });

      // Если экран сузился, сцены возвращаются в обычный поток
      wide.addEventListener('change', () => location.reload(), { once: true });
    });
  }
</script>

<style is:global>
  body:has(.c20) { background: #0b0a09; color: #f3eee8; }
  body:has(.c20) .form { background: #f3eee8; color: #14110f; --muted: #5d554e; --card: #fff; --line: rgb(20 17 15 / 0.16); border-radius: 2px; font-family: 'Jost f', system-ui, sans-serif; font-size: 16px; }
  body:has(.c20) .form h3 { font-family: 'Sofia f', 'Arial Narrow', sans-serif; font-weight: 700; font-size: 2.1rem; line-height: 1; letter-spacing: 0; text-transform: uppercase; color: #14110f; }
  body:has(.c20) .form .field { color: #5d554e; }
  body:has(.c20) .form .field input { border-radius: 2px; background: #fff; color: #14110f; }
  body:has(.c20) .form .field input:focus { border-color: #ff5722; }
  body:has(.c20) .form .field .err, body:has(.c20) .form .consent.bad { color: #c2380f; }
  body:has(.c20) .form .consent { color: #5d554e; }
