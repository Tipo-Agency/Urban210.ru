---
// Концепция 04 «Спринт»: спортивный плакат на белом. Sofia Sans Extra Condensed 800–900 капсом,
// оранжевый бренда и глубокий синий плашками, цифры столбиком. Мотив таймера и интервалов:
// живой отсчёт до закрытия клуба по времени Хабаровска, шкала дня делениями, полоски «₽ в день»
// заполняются при прокрутке, шкала прогресса страницы в шапке разбита на интервалы.
import '@fontsource-variable/sofia-sans-extra-condensed/wght.css';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs } from '../../../data/content';
import heroImg from '../../../assets/images/group-strength.jpg';

const rating = site.rating.value.toString().replace('.', ',');
const wd = site.hours[0];
const we = site.hours[1];
const hoursData = JSON.stringify(site.hours.map((h) => ({ days: h.schema.days, open: h.schema.opens, close: h.schema.closes })));
const classes = programs.flatMap((p) => p.items);
const zoneList = zones.map((z) => ({ ...z, img: z.image ? img(z.image) : null }));
const maxDay = Math.max(...plans.map((p) => perDay(p.month, 30)));
const quotes = reviews.slice(0, 3).map((r) => ({ ...r, short: r.text.split('. ').slice(0, 2).join('. ').replace(/\.?$/, '.') }));
const team = trainers.map((t) => ({ ...t, img: img(t.photo.replace('.jpg', '-glow.webp')) }));
const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, '\u00a0');
const stats = [
  { n: '1300', u: 'м²', l: 'площадь клуба' },
  { n: '60+', u: '', l: `тренажёров ${site.facts.brands}` },
  { n: '150', u: 'м²', l: 'зал групповых программ' },
  { n: '0', u: '₽', l: 'вступительный взнос' },
];
---
<Layout title="Концепция 04 «Спринт»" description="Концепция дизайна сайта Urban210: спортивный плакат с таймером и интервалами." noindex bare>
  <div class="s4">
    <header class="s4-top">
      <a class="s4-logo" href="/concepts/04/" aria-label="Urban210, на главную">URBAN<b>210</b><Icon name="chev" /></a>
      <nav class="s4-nav" aria-label="Меню">
        <a href="#zones">Зоны</a><a href="#price">Тарифы</a><a href="#team">Тренеры</a><a href="#reviews">Отзывы</a><a href="#go">Контакты</a>
      </nav>
      <a class="s4-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="s4-btn s4-btn-sm" href="#go" data-lead={trial.title} data-block="s4_header">1 ₽ первый день</a>
      <span class="s4-progress" aria-hidden="true"></span>
    </header>

    <!-- Первый экран -->
    <section class="s4-hero" aria-labelledby="s4-h">
      <div class="s4-hero-txt">
        <p class="s4-kick"><span class="s4-dot"></span>Фитнес-клуб в Хабаровске</p>
        <h1 id="s4-h"><span>Первый</span><span>день</span><span>за <mark>1 ₽</mark></span></h1>
        <p class="s4-lead">Полный доступ в зал на один день. {site.facts.machines}, свободные веса до 60 кг, групповые и SPA. Без вступительного взноса.</p>
        <div class="s4-cta">
          <a class="s4-btn" href="#go" data-lead={trial.title} data-block="s4_hero">Записаться<Icon name="chev" /></a>
          <a class="s4-link" href="#price">Тарифы от {rub(plans[0].month)}</a>
        </div>
      </div>

      <div class="s4-hero-side">
        <figure class="s4-hero-ph">
          <Image src={heroImg} alt="Силовая тренировка с гантелями в зале Urban210" widths={[480, 800, 1200]} sizes="(min-width: 980px) 44vw, 100vw" loading="eager" fetchpriority="high" format="webp" quality={50} />
        </figure>
        <div class="s4-timer" data-timer data-hours={hoursData} aria-live="off">
          <p class="s4-timer-k"><span class="s4-live"></span><span data-t-label>Режим работы</span></p>
          <p class="s4-timer-n" data-t-clock>{wd.time.replace('–', '·')}</p>
          <p class="s4-timer-s" data-t-sub>{wd.days} {wd.time} · {we.days} {we.time}</p>
          <ol class="s4-segs" data-t-segs aria-hidden="true">
            {Array.from({ length: 17 }).map(() => <li></li>)}
          </ol>
          <p class="s4-timer-scale" aria-hidden="true"><span data-t-a>06:30</span><span data-t-b>23:30</span></p>
        </div>
      </div>
    </section>

    <!-- Бегущая строка программ -->
    <div class="s4-run" aria-label="Групповые программы">
      <div class="s4-run-in">
        {[0, 1].map((k) => (
          <p aria-hidden={k === 1 ? 'true' : undefined}>
            {classes.map((c) => <><span>{c}</span><Icon name="chev" /></>)}
          </p>
        ))}
      </div>
    </div>

    <!-- Цифры -->
    <section class="s4-sec s4-stats-sec" aria-labelledby="s4-n">
      <div class="s4-wrap">
        <h2 id="s4-n" class="s4-h2">Клуб <span>в цифрах</span></h2>
        <ul class="s4-stats">
          {stats.map((s) => (
            <li>
              <b>{s.n}<small>{s.u}</small></b>
              <span>{s.l}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Зоны -->
    <section class="s4-sec s4-zones-sec" id="zones" aria-labelledby="s4-z">
      <div class="s4-wrap">
        <div class="s4-head">
          <h2 id="s4-z" class="s4-h2">Четыре <span>станции</span></h2>
          <p>Круг по клубу: железо, кардио, группа и восстановление. Всё в одном здании, без переездов.</p>
        </div>
        <ol class="s4-zones">
          {zoneList.map((z, i) => (
            <li class:list={['s4-zone', !z.img && 'is-spa']}>
              <a href={z.href}>
                <span class="s4-zone-top">
                  <span>Станция {i + 1}/{zoneList.length}</span>
                  <span class="s4-zone-bar" style={`--p:${(i + 1) / zoneList.length}`}></span>
                </span>
                {z.img ? (
                  <span class="s4-zone-ph"><Image src={z.img} alt="" widths={[480, 800]} sizes="(min-width: 900px) 45vw, 100vw" format="avif" quality={45} /></span>
                ) : (
                  <span class="s4-zone-spa" aria-hidden="true"><b>40–50</b><small>°C в хаммаме</small></span>
                )}
                <span class="s4-zone-t">{z.title}<Icon name="chev" /></span>
                <span class="s4-zone-d">{z.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Тарифы -->
    <section class="s4-sec" id="price" aria-labelledby="s4-p">
      <div class="s4-wrap">
        <div class="s4-head">
          <h2 id="s4-p" class="s4-h2">Тарифы <span>без взноса</span></h2>
          <p>Безлимит в своё время. Платите только за тариф. Полоска показывает цену одного дня.</p>
        </div>
        <div class="s4-plans">
          {plans.map((p) => (
            <article class:list={['s4-plan', `p-${p.id}`]}>
              <header>
                <h3>{p.name}</h3>
                {p.tag && <span class="s4-tag">{p.tag}</span>}
              </header>
              <p class="s4-plan-h">{p.hours}</p>
              <p class="s4-price"><b>{fmt(p.month)}</b><span><i>₽</i>в месяц</span></p>
              <div class="s4-day" data-rise>
                <span class="s4-day-bar" style={`--w:${(perDay(p.month, 30) / maxDay).toFixed(3)}`}></span>
                <span class="s4-day-v"><b>{perDay(p.month, 30)} ₽</b> в день · {rub(p.year)} за год</span>
              </div>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="off"><Icon name="minus" />{f}</li>)}
              </ul>
              <a class="s4-btn" href="#go" data-lead={p.name} data-block={`s4_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <div class="s4-trial">
          <p class="s4-trial-n" aria-hidden="true">1<span>₽</span></p>
          <div class="s4-trial-txt">
            <h3>{trial.title}</h3>
            <p>{trial.text}</p>
          </div>
          <a class="s4-btn s4-btn-light" href="#go" data-lead={trial.title} data-block="s4_trial">Записаться<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Тренеры -->
    <section class="s4-sec s4-team-sec" id="team" aria-labelledby="s4-t">
      <div class="s4-wrap">
        <div class="s4-head">
          <h2 id="s4-t" class="s4-h2">Тренеры <span>в зале</span></h2>
          <p>{personal.pack} персональных тренировок за {rub(personal.price)}. {personal.firstFree}.</p>
        </div>
        <ul class="s4-team">
          {team.map((t) => (
            <li>
              <span class="s4-team-ph"><Image src={t.img} alt={t.name} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 90vw" format="avif" quality={50} /></span>
              <h3>{t.name}</h3>
              <p>{t.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="s4-sec" id="reviews" aria-labelledby="s4-r">
      <div class="s4-wrap s4-rev">
        <div class="s4-score">
          <p class="s4-score-n" aria-hidden="true">{rating}</p>
          <h2 id="s4-r">Рейтинг {rating} из 5</h2>
          <p>{site.rating.text} на Яндекс Картах и в 2ГИС.</p>
          <a class="s4-link" href={site.maps.yandexReviews} target="_blank" rel="noopener">Все отзывы</a>
        </div>
        <div class="s4-quotes">
          {quotes.map((q) => (
            <figure>
              <blockquote>{q.short}</blockquote>
              <figcaption><b>{q.name}</b>{q.source}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="s4-go" id="go" aria-labelledby="s4-g">
      <div class="s4-wrap s4-go-in">
        <div class="s4-go-txt">
          <h2 id="s4-g"><span>На старт</span><span>за 1 ₽</span></h2>
          <p>Оставьте телефон. Администратор перезвонит в часы работы клуба и подберёт время для пробного дня.</p>
          <dl class="s4-info">
            <div><dt>Адрес</dt><dd>{site.address.short}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{wd.days} {wd.time}<br />{we.days} {we.time}</dd></div>
            <div><dt>Парковка</dt><dd>{site.parking}</dd></div>
            <div><dt>Связь</dt><dd><a href={site.phone.href}>{site.phone.display}</a><br /><a href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener">WhatsApp</a> · <a href={telegramLink('s4_go')} target="_blank" rel="noopener">Telegram</a></dd></div>
          </dl>
        </div>
        <div class="s4-form"><LeadForm id="s4" block="s4_final" /></div>
      </div>
    </section>

    <footer class="s4-foot">
      <div class="s4-wrap">
        <p class="s4-big" aria-hidden="true">URBAN<b>210</b><Icon name="chev" /></p>
        <div class="s4-foot-row">
          <p>{site.address.locality}, {site.address.street}</p>
          <nav aria-label="Разделы"><a href="/price/">Тарифы</a><a href="/zal/">Зал</a><a href="/group/">Групповые</a><a href="/spa/">SPA</a><a href="/trainers/">Тренеры</a><a href="/promo/">Акции</a><a href="/contacts/">Контакты</a></nav>
          <p><a href={site.instagram} target="_blank" rel="noopener">Instagram</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <p class="s4-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn} · <a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Договор-оферта</a></p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Таймер первого экрана: сколько осталось до закрытия (или до открытия) по времени Хабаровска, UTC+10
  const el = document.querySelector<HTMLElement>('[data-timer]');
  if (el) {
    type H = { days: string[]; open: string; close: string };
    const hours: H[] = JSON.parse(el.dataset.hours || '[]');
    const names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const min = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
    const forDay = (d: number) => hours.find((h) => h.days.includes(names[d]));
    const label = el.querySelector<HTMLElement>('[data-t-label]')!;
    const clock = el.querySelector<HTMLElement>('[data-t-clock]')!;
    const sub = el.querySelector<HTMLElement>('[data-t-sub]')!;
    const a = el.querySelector<HTMLElement>('[data-t-a]')!;
    const b = el.querySelector<HTMLElement>('[data-t-b]')!;
    const segs = [...el.querySelectorAll<HTMLElement>('[data-t-segs] li')];
    const pad = (n: number) => String(n).padStart(2, '0');
    const hms = (s: number) => `${pad(Math.floor(s / 3600))}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}`;
    const tick = () => {
      const now = new Date(Date.now() + 10 * 3600e3);
      const day = now.getUTCDay();
      const sec = now.getUTCHours() * 3600 + now.getUTCMinutes() * 60 + now.getUTCSeconds();
      const today = forDay(day);
      if (!today) return;
      const o = min(today.open) * 60, c = min(today.close) * 60;
      a.textContent = today.open; b.textContent = today.close;
      let p = 0;
      if (sec >= o && sec < c) {
        el.classList.add('is-open');
        label.textContent = 'Открыто · до закрытия';
        clock.textContent = hms(c - sec);
        sub.textContent = `Сегодня до ${today.close}`;
        p = (sec - o) / (c - o);
      } else {
        el.classList.remove('is-open');
        const next = sec < o ? today : forDay((day + 1) % 7)!;
        const left = sec < o ? o - sec : 86400 - sec + min(next.open) * 60;
        label.textContent = 'Закрыто · откроемся через';
        clock.textContent = hms(left);
        sub.textContent = `${sec < o ? 'Сегодня' : 'Завтра'} с ${next.open}`;
        p = sec >= c ? 1 : 0;
      }
      const n = Math.floor(p * segs.length);
      segs.forEach((s, i) => { s.classList.toggle('on', i < n); s.classList.toggle('now', i === n && p > 0 && p < 1); });
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style is:global>
  body:has(.s4) {
    --bg: #ffffff; --card: #f1f1ee; --ink: #0b1233; --muted: #565d78; --line: rgb(11 18 51 / 0.16);
    --accent: #ff5722; --accent-ink: #0b1233;
    background: #fff; color: #0b1233; color-scheme: light;
  }
  html:has(.s4) { background: #101b63; }
  body:has(.s4) ::selection { background: #ff5722; color: #fff; }
  body:has(.s4) :focus-visible { outline-color: #1b2fd1; }
  body:has(.s4) .mbar { background: rgb(255 255 255 / 0.94); border-top-color: rgb(11 18 51 / 0.12); color: #0b1233; }
  body:has(.s4) .mbar .btn, body:has(.s4) dialog.lead .btn { background: #ff5722; color: #fff; font-family: 'Sofia Sans Extra Condensed Variable', sans-serif; font-weight: 800; font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.02em; }
  body:has(.s4) dialog.lead::backdrop { background: rgb(11 18 51 / 0.7); }
  body:has(.s4) dialog.lead .form { background: #fff; color: #0b1233; border: 0; border-top: 8px solid #ff5722; border-radius: 6px; }
  body:has(.s4) dialog.lead h3 { font-family: 'Sofia Sans Extra Condensed Variable', sans-serif; font-weight: 900; text-transform: uppercase; font-size: 2.4rem; letter-spacing: 0; line-height: 0.95; padding-right: 40px; }
  body:has(.s4) dialog.lead .field input { background: #f1f1ee; border-color: transparent; }
</style>

<style>
  .s4 {
    --o: #ff5722;
    --n: #101b63;
    --ink: #0b1233;
    --mut: #565d78;
    --gray: #f1f1ee;
    --line: rgb(11 18 51 / 0.14);
    --cond: 'Sofia Sans Extra Condensed Variable', 'Arial Narrow', sans-serif;
    --w: 1360px;
    --g: clamp(16px, 4vw, 48px);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    color: var(--ink);
    font-size: 16px;
    overflow-x: clip;
  }
  .s4 :global(h1), .s4 :global(h2), .s4 :global(h3) { font-family: var(--cond); font-weight: 900; text-transform: uppercase; letter-spacing: -0.005em; line-height: 0.86; hyphens: manual; }
  .s4-wrap { max-width: var(--w); margin-inline: auto; padding-inline: var(--g); }
  .s4-sec { padding-block: clamp(72px, 9vw, 136px); }
  .s4-h2 { font-size: clamp(3.6rem, 2rem + 7vw, 9rem); }
  .s4-h2 span { display: block; color: var(--o); }
  .s4-head { display: grid; gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }
  .s4-head p { max-width: 44ch; color: var(--mut); font-size: 1.02rem; }
  @media (min-width: 980px) { .s4-head { grid-template-columns: 1fr minmax(0, 400px); align-items: end; } }

  /* ---------- Кнопки ---------- */
  .s4-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    min-height: 56px; padding: 0 22px 0 26px; border-radius: 6px;
    background: var(--o); color: #fff; text-decoration: none; white-space: nowrap;
    font: 800 1.4rem/1 var(--cond); text-transform: uppercase; letter-spacing: 0.02em;
    transition: background-color 0.2s, transform 0.2s var(--ease);
  }
  .s4-btn :global(svg) { width: 18px; height: 14px; transition: transform 0.25s var(--ease); }
  .s4-btn:hover { background: #e8440f; }
  .s4-btn:hover :global(svg) { transform: translateX(4px); }
  .s4-btn:active { transform: scale(0.96); }
  .s4-btn-sm { min-height: 44px; padding: 0 18px; font-size: 1.15rem; }
  .s4-btn-light { background: #fff; color: var(--n); }
  .s4-btn-light:hover { background: var(--gray); }
  .s4-link { font: 800 1.3rem/1 var(--cond); text-transform: uppercase; letter-spacing: 0.02em; color: var(--ink); text-decoration: none; padding-block: 10px; box-shadow: inset 0 -3px 0 var(--o); transition: box-shadow 0.25s var(--ease); }
  .s4-link:hover { box-shadow: inset 0 -12px 0 rgb(255 87 34 / 0.35); }

  /* ---------- Шапка ---------- */
  .s4-top { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 28px; height: 68px; padding-inline: var(--g); background: #fff; box-shadow: 0 1px 0 var(--line); }
  .s4-logo { display: inline-flex; align-items: center; font: 900 1.9rem/1 var(--cond); letter-spacing: 0.01em; color: var(--n); text-decoration: none; }
  .s4-logo b { color: var(--o); font-weight: 900; }
  .s4-logo :global(svg) { width: 16px; height: 15px; margin-left: 5px; color: var(--o); }
  .s4-nav { display: none; gap: 26px; margin-left: auto; }
  .s4-nav a, .s4-tel { font: 800 1.2rem/1 var(--cond); text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; color: var(--ink); }
  .s4-nav a:hover, .s4-tel:hover { color: var(--o); }
  .s4-tel { display: none; letter-spacing: 0.02em; }
  .s4-top .s4-btn { margin-left: auto; }
  .s4-progress { position: absolute; left: 0; right: 0; bottom: -4px; height: 4px; pointer-events: none; display: none; }
  @supports (animation-timeline: scroll()) {
    .s4-progress {
      display: block; transform-origin: left; transform: scaleX(0);
      background: var(--o);
      -webkit-mask: repeating-linear-gradient(90deg, #000 0 calc(12.5% - 3px), transparent calc(12.5% - 3px) 12.5%);
      mask: repeating-linear-gradient(90deg, #000 0 calc(12.5% - 3px), transparent calc(12.5% - 3px) 12.5%);
      animation: s4-prog linear both; animation-timeline: scroll(root);
    }
    @keyframes s4-prog { to { transform: scaleX(1); } }
  }
  @media (min-width: 1100px) { .s4-nav, .s4-tel { display: flex; } .s4-top .s4-btn { margin-left: 0; } }

  /* ---------- Первый экран ---------- */
  .s4-hero { max-width: var(--w); margin-inline: auto; padding: clamp(28px, 4vw, 56px) var(--g) clamp(40px, 5vw, 72px); display: grid; gap: 32px; }
  .s4-kick { display: inline-flex; align-items: center; gap: 10px; font: 800 1.2rem/1 var(--cond); text-transform: uppercase; letter-spacing: 0.06em; color: var(--n); }
  .s4-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--o); }
