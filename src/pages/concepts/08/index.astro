---
// Концепция 08 «Бенто»: страница из плиток разного размера, как продуктовая страница Apple и виджеты iOS.
// Системный шрифт, мягкие тени, плитка с видео, статус «открыто сейчас» по времени Хабаровска,
// переключатели тарифов, плитки всплывают по очереди и приподнимаются под курсором.
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, programs, promos } from '../../../data/content';
import hall from '../../../assets/images/zal.jpg';
import cutout from '../../../assets/images/trainers/lazko-cutout.webp';

const num = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const [day, full, all] = plans;
const rating = site.rating.value.toString().replace('.', ',');
const spa = zones.find((z) => z.id === 'spa')!;
const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const lazko = trainers.find((t) => t.photo.includes('lazko'))!;
const others = trainers.filter((t) => t !== lazko);
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const planInfo = plans.map((p) => ({
  id: p.id, name: p.name, m: num(p.month), y: num(p.year), h: p.hours,
}));
const allFeatures = [
  ['Тренажёрный зал и кардиозона', 1, 1, 1],
  ['Фитнес-тестирование', 1, 1, 1],
  ['Раздевалки, душевые, парковка', 1, 1, 1],
  ['Вечернее время', 0, 1, 1],
  ['Пробная тренировка с тренером', 0, 1, 1],
  ['Групповые программы', 0, 0, 1],
  ['SPA: сауна, хаммам, релакс-зона', 0, 0, 1],
  ['Приоритетное обслуживание', 0, 0, 1],
] as const;
---
<Layout title="Концепция 08 «Бенто»" description="Концепция дизайна сайта Urban210: страница из плиток, как виджеты iOS." noindex bare>
  <div class="bn">
    <header class="bn-nav">
      <div class="bn-w bn-nav-in">
        <a class="bn-logo" href="/concepts/08/" aria-label="Urban210, на главную">URBAN<b>210</b><Icon name="chev" /></a>
        <nav aria-label="Разделы">
          <a href="#zony">Зоны</a><a href="#tarify">Тарифы</a><a href="#trenery">Тренеры</a><a href="#zayavka">Контакты</a>
        </nav>
        <a class="bn-pill bn-pill-s" href="#zayavka" data-lead={trial.title} data-block="08_header">День за 1 ₽</a>
      </div>
    </header>

    <main>
      <!-- Первый экран -->
      <section class="bn-hero bn-w" aria-labelledby="bn-h1">
        <p class="bn-eyebrow">Фитнес-клуб в Хабаровске</p>
        <h1 id="bn-h1">Зал. Кардио. Групповые. SPA.</h1>
        <p class="bn-sub">Всё в одном клубе на {site.address.short}. Первый день за 1&nbsp;₽, дальше от {num(day.month)}&nbsp;₽ в&nbsp;месяц.</p>
        <div class="bn-hero-cta">
          <a class="bn-pill" href="#zayavka" data-lead={trial.title} data-block="08_hero">Записаться за 1 ₽</a>
          <a class="bn-more" href="#tarify">Смотреть тарифы<Icon name="chev1" /></a>
        </div>
      </section>

      <!-- Главное -->
      <section class="bn-w" aria-label="Коротко о клубе">
        <div class="bn-grid bn-g1">
          <article class="t t-video" data-in style="--d:0ms">
            <Image src={hall} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 800, 1200]} sizes="(min-width: 1100px) 790px, calc(100vw - 32px)" loading="eager" fetchpriority="high" format="webp" quality={50} />
            <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
            <div class="t-video-shade" aria-hidden="true"></div>
            <span class="bn-chip bn-chip-dark"><i class="bn-rec"></i>Зал Urban210</span>
            <div class="t-video-txt">
              <p class="bn-big">Больше 1300 м²</p>
              <p>60+ тренажёров {site.facts.brands}, свободные веса до 60 кг.</p>
            </div>
          </article>

          <article class="t t-open" data-in style="--d:80ms" data-status>
            <p class="t-k"><Icon name="clock" />Сейчас в Хабаровске <span data-clock></span></p>
            <p class="t-open-s"><i></i><span data-open-label>Пн–Пт до 23:30</span></p>
            <p class="t-open-left" data-open-left>Сб–Вс до 22:30</p>
            <ul class="t-hours">
              {site.hours.map((h, i) => <li data-hours={i === 0 ? 'wd' : 'we'}><span>{h.days}</span><b>{h.time}</b></li>)}
            </ul>
          </article>

          <a class="t t-rate" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-in style="--d:160ms">
            <p class="t-k">Рейтинг</p>
            <p class="t-rate-n">{rating}</p>
            <p class="bn-stars" aria-label={`${rating} из 5`}>
              {[0, 1, 2, 3, 4].map((i) => <span style={i === 4 ? '--f:70%' : '--f:100%'}><Icon name="star" /><Icon name="star" /></span>)}
            </p>
            <p class="t-foot">{site.rating.text} на Яндекс Картах<Icon name="chev1" /></p>
          </a>

          <article class="t t-trial" data-in style="--d:0ms">
            <p class="t-k">Пробный день</p>
            <p class="t-trial-n">1<span>₽</span></p>
            <p class="t-trial-p">{trial.text.split('.')[0]}. Без обязательств.</p>
            <a class="bn-pill bn-pill-w" href="#zayavka" data-lead={trial.title} data-block="08_trial_tile">Записаться</a>
          </article>

          <article class="t t-price" data-in style="--d:80ms" data-price>
            <p class="t-k">Абонемент</p>
            <div class="bn-seg" role="radiogroup" aria-label="Тариф" data-seg style="--n:3">
              <span class="bn-seg-th" aria-hidden="true"></span>
              {planInfo.map((p, i) => <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-m={p.m} data-y={p.y} data-h={p.h} data-name={p.name}>{p.id === 'day' ? 'Дневная' : p.id === 'full' ? 'Полный' : 'Всё'}</button>)}
            </div>
            <p class="t-price-n"><b data-pm>{num(day.month)}</b> ₽<small>/мес</small></p>
            <p class="t-price-s"><span data-pn>{day.name}</span>, <span data-ph>{day.hours}</span>. За год <span data-py>{num(day.year)}</span> ₽.</p>
          </article>

          <a class="t t-map" href={site.maps.yandex} target="_blank" rel="noopener" data-in style="--d:160ms">
            <svg class="t-map-bg" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <rect width="400" height="300" fill="#e9ebe6" />
              <path d="M-20 60 L420 20 M-20 160 L420 120 M-20 260 L420 230 M60 -20 L110 320 M190 -20 L230 320 M320 -20 L350 320" stroke="#fff" stroke-width="10" fill="none" stroke-linecap="round" />
              <path d="M-20 215 C120 175 240 205 420 70" stroke="#fff" stroke-width="22" fill="none" stroke-linecap="round" />
              <path d="M-20 215 C120 175 240 205 420 70" stroke="#ffd9c8" stroke-width="4" fill="none" stroke-linecap="round" />
              <rect x="248" y="40" width="54" height="46" rx="6" fill="#dfe6d9" /><rect x="120" y="70" width="48" height="58" rx="6" fill="#dfe2dc" /><rect x="38" y="232" width="70" height="40" rx="6" fill="#dfe6d9" />
            </svg>
            <span class="t-pin" aria-hidden="true"><Icon name="chev" /></span>
            <div class="t-map-card">
              <p class="t-k">Как добраться</p>
              <p class="t-map-a">{site.address.short}</p>
              <p class="t-map-s">Парковка на 50 мест<span>Маршрут<Icon name="chev1" /></span></p>
            </div>
          </a>
        </div>
      </section>

      <!-- Зоны -->
      <section class="bn-sec bn-w" id="zony" aria-labelledby="bn-z">
        <div class="bn-head">
          <h2 id="bn-z">Четыре зоны.<br /><span>Один абонемент «{all.name}».</span></h2>
        </div>
        <div class="bn-grid bn-g2">
          <a class="t t-photo t-zal" href={zal.href} data-in>
            <Image src={img('/images/free-weights.jpg')} alt="Стойка с гантелями в тренажёрном зале" widths={[480, 760, 1000]} sizes="(min-width: 1100px) 590px, calc(100vw - 32px)" format="avif" quality={45} />
            <div class="t-photo-txt">
              <h3>{zal.title}</h3>
              <p>Больше 1300 м², {site.facts.machines}, свободные веса до 60 кг.</p>
            </div>
            <span class="t-plus" aria-hidden="true">+</span>
          </a>
          <a class="t t-photo t-cardio" href={cardio.href} data-in style="--d:80ms">
            <Image src={img('/images/cardio.jpg')} alt="Беговые дорожки Technogym в кардиозоне" widths={[480, 760]} sizes="(min-width: 1100px) 590px, calc(100vw - 32px)" format="avif" quality={45} />
            <div class="t-photo-txt">
              <h3>{cardio.title}</h3>
              <p>{cardio.text}</p>
            </div>
            <span class="t-plus" aria-hidden="true">+</span>
          </a>
          <a class="t t-photo t-group" href={group.href} data-in style="--d:0ms">
            <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале групповых программ" widths={[480, 760]} sizes="(min-width: 1100px) 390px, calc(100vw - 32px)" format="avif" quality={45} />
            <div class="t-photo-txt">
              <h3>{group.title}</h3>
              <p class="bn-tags">{programs.flatMap((p) => p.items).map((i) => <span>{i}</span>)}</p>
            </div>
          </a>
          <article class="t t-stat" data-in style="--d:80ms">
            <p class="t-k">Зал групповых</p>
            <p class="t-stat-n">150<small>м²</small></p>
            <p class="t-foot">Запись в приложении клуба</p>
          </article>
          <a class="t t-spa" href={spa.href} data-in style="--d:0ms">
            <div>
              <p class="t-k">{spa.title}</p>
              <h3>Сауна, хаммам и&nbsp;релакс-зона</h3>
              <ul class="t-spa-l">
                <li>Финская сауна</li><li>Хаммам 40–50 °C</li><li>Массажные кресла</li>
              </ul>
              <p class="t-foot">В тарифе «{all.name}»<Icon name="chev1" /></p>
            </div>
            <p class="t-spa-n" aria-hidden="true">40–50<small>°C</small></p>
          </a>
          <article class="t t-dark" data-in style="--d:80ms">
            <p class="t-k">Тренажёры</p>
            <p class="t-stat-n">60+</p>
            <p class="t-foot">{site.facts.brands}. Без очередей даже вечером.</p>
          </article>
        </div>
      </section>

      <!-- Тарифы -->
      <section class="bn-sec bn-w" id="tarify" aria-labelledby="bn-p">
        <div class="bn-head">
          <h2 id="bn-p">Выберите абонемент.<br /><span>Вступительного взноса нет.</span></h2>
          <div class="bn-seg bn-seg-l" role="radiogroup" aria-label="Период оплаты" data-period style="--n:2">
            <span class="bn-seg-th" aria-hidden="true"></span>
            <button type="button" role="radio" aria-checked="true" data-v="m">Месяц</button>
            <button type="button" role="radio" aria-checked="false" data-v="y">Год</button>
          </div>
        </div>
        <div class="bn-plans">
          {plans.map((p, i) => (
            <article class:list={['t t-plan', p.id === 'full' && 'is-hot']} data-in style={`--d:${i * 80}ms`}>
              <header>
                <h3>{p.name}</h3>
                {p.tag && <span class="bn-tag">{p.tag}</span>}
              </header>
              <p class="t-plan-h">{p.hours}</p>
              <p class="t-plan-n"><b data-m={num(p.month)} data-y={num(p.year)}>{num(p.month)}</b> ₽<small data-unit>в месяц</small></p>
              <p class="t-plan-d" data-m={`или ${num(p.year)} ₽ за год`} data-y={`≈ ${perDay(p.year, 365)} ₽ в день`}>или {num(p.year)} ₽ за год</p>
              <ul class="t-plan-f">
                {allFeatures.map((f) => (
                  <li class={f[i + 1] ? 'y' : 'n'}>
                    {f[i + 1] ? <Icon name="check" /> : <Icon name="minus" />}
                    <span>{f[0]}</span><span class="sr">{f[i + 1] ? ', входит' : ', не входит'}</span>
                  </li>
                ))}
              </ul>
              <a class:list={['bn-pill', p.id !== 'full' && 'bn-pill-g']} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`08_${p.id}`}>Выбрать</a>
            </article>
          ))}
        </div>
        <div class="bn-grid bn-g3">
          <article class="t t-wide" data-in>
            <span class="t-wide-n" aria-hidden="true">1 ₽</span>
            <div>
              <h3>Не уверены? Начните с пробного дня.</h3>
              <p>{trial.text}</p>
            </div>
            <a class="bn-pill" href="#zayavka" data-lead={trial.title} data-block="08_trial_wide">Записаться за 1 ₽</a>
          </article>
          <article class="t t-mini" data-in style="--d:80ms">
            <p class="t-k">Trade-in</p>
            <p class="t-mini-n">999 ₽</p>
            <p class="t-foot">{tradein.short}: месяц безлимита.</p>
          </article>
        </div>
      </section>

      <!-- Тренеры и отзывы -->
      <section class="bn-sec bn-w" id="trenery" aria-labelledby="bn-t">
        <div class="bn-head">
          <h2 id="bn-t">Тренеры рядом.<br /><span>Отзывы на картах.</span></h2>
        </div>
        <div class="bn-grid bn-g4">
          <article class="t t-coach" data-in>
            <div class="t-coach-glow" aria-hidden="true"></div>
            <Image src={cutout} alt={lazko.name} widths={[360, 560]} sizes="(min-width: 1100px) 390px, 80vw" format="avif" quality={55} />
            <div class="t-coach-txt">
              <h3>{lazko.name}</h3>
              <p>{lazko.role}</p>
              <a class="bn-pill bn-pill-w" href="#zayavka" data-lead="Персональная тренировка" data-block="08_coach">Записаться к тренеру</a>
            </div>
          </article>
          {others.map((t, i) => (
            <article class="t t-card" data-in style={`--d:${(i + 1) * 80}ms`}>
              <Image src={img(t.photo)} alt={t.name} widths={[160, 240]} sizes="96px" format="avif" quality={55} />
              <div>
                <h3>{t.name}</h3>
                <p>{t.role}</p>
              </div>
            </article>
          ))}
          <article class="t t-gift" data-in style="--d:160ms">
            <p class="t-k">Персональные</p>
            <h3>{personal.firstFree}.</h3>
          </article>
          <article class="t t-photo t-friend" data-in style="--d:240ms">
            <Image src={img('/images/community/3.jpg')} alt="Пара тренируется вместе в Urban210" widths={[360, 600]} sizes="(min-width: 1100px) 390px, calc(100vw - 32px)" format="avif" quality={45} />
            <div class="t-photo-txt">
              <p class="t-k">Акция</p>
              <h3>{friend.title}</h3>
              <p>{friend.short}.</p>
            </div>
          </article>
          {reviews.slice(0, 2).map((r, i) => (
            <figure class="t t-review" data-in style={`--d:${i * 80}ms`}>
              <p class="bn-stars" aria-label="5 из 5">{[0, 1, 2, 3, 4].map(() => <span style="--f:100%"><Icon name="star" /><Icon name="star" /></span>)}</p>
              <blockquote>{r.text}</blockquote>
              <figcaption><b>{r.name}</b><span>{r.source}</span></figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- Заявка -->
      <section class="bn-sec bn-w" id="zayavka" aria-labelledby="bn-l">
        <div class="t t-lead" data-in>
          <div class="t-lead-l">
            <p class="bn-eyebrow">Пробный день за 1 ₽</p>
            <h2 id="bn-l">Приходите посмотреть клуб.</h2>
            <ol class="t-steps">
              <li><b>1</b>Оставьте имя и телефон</li>
              <li><b>2</b>Администратор перезвонит в часы работы клуба</li>
              <li><b>3</b>Приходите с паспортом и сменной обувью</li>
            </ol>
            <ul class="bn-list">
              <li><a href={site.phone.href}><span class="bn-ic bn-ic-o"><Icon name="phone" /></span><span>Позвонить<small>{site.phone.display}</small></span><Icon name="chev1" /></a></li>
              <li><a href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener"><span class="bn-ic bn-ic-g"><Icon name="wa" /></span><span>WhatsApp<small>Ответим в часы работы</small></span><Icon name="chev1" /></a></li>
              <li><a href={telegramLink('concept_08')} target="_blank" rel="noopener"><span class="bn-ic bn-ic-b"><Icon name="tg" /></span><span>Telegram-бот<small>@{site.telegramBot}</small></span><Icon name="chev1" /></a></li>
            </ul>
          </div>
          <div class="t-lead-r">
            <LeadForm block="08_final" id="bn" title="Записаться на пробный день" />
          </div>
        </div>
      </section>
    </main>

    <footer class="bn-foot">
      <div class="bn-w">
        <div class="bn-foot-g">
          <div><h2>Клуб</h2><p>{site.address.locality}, {site.address.street}</p><p>{site.district}</p><p>{site.parking}</p></div>
          <div><h2>Часы работы</h2>{site.hours.map((h) => <p>{h.days}: {h.time}</p>)}</div>
          <div><h2>Связь</h2><p><a href={site.phone.href}>{site.phone.display}</a></p><p><a href={`mailto:${site.email}`}>{site.email}</a></p><p><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p></div>
          <div><h2>Документы</h2><p><a href="/rules/">Правила клуба</a></p><p><a href="/oferta/">Договор-оферта</a></p><p><a href="/policy/">Политика конфиденциальности</a></p></div>
        </div>
        <p class="bn-legal">© {new Date().getFullYear()} {site.legal.name}. ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}. Фитнес-клуб Urban210, Хабаровск.</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Статус «открыто сейчас» и часы по времени Хабаровска (Asia/Vladivostok)
  const box = document.querySelector<HTMLElement>('.bn [data-status]');
  const hm = (x: number) => `${String(Math.floor(x / 60) % 24).padStart(2, '0')}:${String(x % 60).padStart(2, '0')}`;
  const paint = () => {
    if (!box) return;
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Vladivostok', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value || '';
    const wd = get('weekday');
    const m = Number(get('hour')) * 60 + Number(get('minute'));
    const weekend = wd === 'Sat' || wd === 'Sun';
    const [o, c] = weekend ? [450, 1350] : [390, 1410];
    const open = m >= o && m < c;
    const tomorrowWeekend = wd === 'Fri' || wd === 'Sat';
    box.classList.toggle('is-open', open);
    box.classList.toggle('is-closed', !open);
    box.querySelector('[data-clock]')!.textContent = hm(m);
    box.querySelector('[data-open-label]')!.textContent = open ? 'Открыто' : 'Закрыто';
    const left = c - m;
    box.querySelector('[data-open-left]')!.textContent = open
      ? `до ${hm(c)}, ещё ${Math.floor(left / 60)} ч ${left % 60} мин`
      : m < o ? `откроемся сегодня в ${hm(o)}` : `откроемся завтра в ${hm(tomorrowWeekend ? 450 : 390)}`;
    box.querySelectorAll<HTMLElement>('[data-hours]').forEach((li) => li.classList.toggle('is-today', (li.dataset.hours === 'we') === weekend));
  };
  paint();
  setInterval(paint, 30000);

  // Переключатели: бегунок едет к выбранному варианту
  const setSeg = (seg: HTMLElement, i: number) => {
    seg.style.setProperty('--i', String(i));
    seg.querySelectorAll<HTMLButtonElement>('button').forEach((b, j) => b.setAttribute('aria-checked', String(j === i)));
  };
  const priceTile = document.querySelector<HTMLElement>('[data-price]');
  const seg = document.querySelector<HTMLElement>('[data-seg]');
  seg?.querySelectorAll<HTMLButtonElement>('button').forEach((b, i) => b.addEventListener('click', () => {
    setSeg(seg, i);
    if (!priceTile) return;
    priceTile.querySelector('[data-pm]')!.textContent = b.dataset.m!;
    priceTile.querySelector('[data-py]')!.textContent = b.dataset.y!;
    priceTile.querySelector('[data-ph]')!.textContent = b.dataset.h!;
    priceTile.querySelector('[data-pn]')!.textContent = b.dataset.name!;
  }));
  const period = document.querySelector<HTMLElement>('[data-period]');
  period?.querySelectorAll<HTMLButtonElement>('button').forEach((b, i) => b.addEventListener('click', () => {
    setSeg(period, i);
    const v = b.dataset.v as 'm' | 'y';
    document.querySelectorAll<HTMLElement>('.t-plan [data-m]').forEach((el) => { el.textContent = el.dataset[v]!; });
    document.querySelectorAll<HTMLElement>('.t-plan [data-unit]').forEach((el) => { el.textContent = v === 'm' ? 'в месяц' : 'за год'; });
  }));

  // Плитки всплывают один раз, когда попадают в экран
  const tiles = document.querySelectorAll<HTMLElement>('.bn [data-in]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) tiles.forEach((t) => t.classList.add('is-in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-in');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -6% 0px' });
    tiles.forEach((t) => io.observe(t));
  }
</script>

