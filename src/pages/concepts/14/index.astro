<script>
  const root = document.querySelector<HTMLElement>('[data-ef]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Часы и статус по времени Хабаровска (Asia/Vladivostok, UTC+10)
  const hm = (x: number) => `${String(Math.floor(x / 60) % 24).padStart(2, '0')}:${String(x % 60).padStart(2, '0')}`;
  const paint = () => {
    if (!root) return;
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Vladivostok', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value || '';
    const wd = get('weekday');
    const m = Number(get('hour')) * 60 + Number(get('minute'));
    const weekend = wd === 'Sat' || wd === 'Sun';
    const [o, c] = weekend ? [450, 1350] : [390, 1410];
    const open = m >= o && m < c;
    const nextWeekend = wd === 'Fri' || wd === 'Sat';
    root.classList.toggle('is-open', open);
    root.classList.toggle('is-closed', !open);
    root.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => { el.textContent = hm(m); });
    root.querySelectorAll<HTMLElement>('[data-open-label]').forEach((el) => { el.textContent = open ? 'Открыто' : 'Закрыто'; });
    const word = root.querySelector<HTMLElement>('[data-status-word]');
    if (word) word.textContent = open ? 'Открыто' : 'Закрыто';
    const today = root.querySelector<HTMLElement>('[data-today]');
    if (today) today.textContent = `${hm(o)}–${hm(c)}`;
    const left = root.querySelector<HTMLElement>('[data-open-left]');
    if (left) {
      const l = c - m;
      left.textContent = open
        ? `Открыто до ${hm(c)}, ещё ${Math.floor(l / 60)} ч ${l % 60} мин`
        : m < o ? `Откроемся сегодня в ${hm(o)}` : `Откроемся завтра в ${hm(nextWeekend ? 450 : 390)}`;
    }
    root.querySelectorAll<HTMLElement>('[data-hours]').forEach((li) => li.classList.toggle('is-today', (li.dataset.hours === 'we') === weekend));
  };
  paint();
  setInterval(paint, 20000);

  // Шторки: плашки въезжают, когда попадают в кадр
  const wipes = root?.querySelectorAll<HTMLElement>('[data-wipe]') || [];
  if (reduce || !('IntersectionObserver' in window)) wipes.forEach((w) => w.classList.add('in'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    }), { rootMargin: '0px 0px -10% 0px' });
    wipes.forEach((w) => io.observe(w));
  }

  // Мультикамера: переключение со шторкой
  const mc = root?.querySelector<HTMLElement>('[data-mc]');
  if (mc) {
    const shots = [...mc.querySelectorAll<HTMLElement>('[data-shot]')];
    const tabs = [...mc.querySelectorAll<HTMLButtonElement>('[data-cam]')];
    const sting = mc.querySelector<HTMLElement>('[data-sting]')!;
    let cur = 0;
    const go = (i: number, focus = false) => {
      if (i === cur) return;
      shots[cur].classList.remove('on');
      shots[cur].classList.add('out');
      const prev = shots[cur];
      setTimeout(() => prev.classList.remove('out'), 700);
      shots[i].classList.add('on');
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      if (focus) tabs[i].focus();
      if (!reduce) {
        sting.classList.remove('run');
        void sting.offsetWidth;
        sting.classList.add('run');
      }
      cur = i;
    };
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => go(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go((cur + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go((cur - 1 + tabs.length) % tabs.length, true); }
      });
    });
  }

  if (!reduce) root?.classList.add('is-run');
</script>

