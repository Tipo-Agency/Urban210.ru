---
// Концепция 14 «Эфир»: клуб как спортивная трансляция. Шапка-табло с живыми часами Хабаровска
// и статусом «открыто», плашки нижней трети, бегущая строка фактов, мультикамера по зонам со шторкой,
// тарифы как табло статистики, тренеры как карточки игроков, логотип канала в углу.
// Только реальные факты из src/data. Без GSAP: шторки на CSS clip-path и IntersectionObserver.
// Шрифты только кириллица и латиница: полные пакеты раздували HTML до 140 КБ
import exoCyrI from '@fontsource-variable/exo-2/files/exo-2-cyrillic-wght-italic.woff2?url';
import exoLatI from '@fontsource-variable/exo-2/files/exo-2-latin-wght-italic.woff2?url';
import exoCyr from '@fontsource-variable/exo-2/files/exo-2-cyrillic-wght-normal.woff2?url';
import exoLat from '@fontsource-variable/exo-2/files/exo-2-latin-wght-normal.woff2?url';
import tekCyr from '@fontsource-variable/tektur/files/tektur-cyrillic-wght-normal.woff2?url';
import tekLat from '@fontsource-variable/tektur/files/tektur-latin-wght-normal.woff2?url';
import { Image, getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, programs } from '../../../data/content';
import hero from '../../../assets/images/hero.jpg';
import hall from '../../../assets/images/zal.jpg';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (fam: string, style: string, url: string, range: string) => `@font-face{font-family:'${fam}';font-style:${style};font-display:swap;font-weight:100 900;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fonts = [
  ff('Exo 2 Variable', 'italic', exoCyrI, UR), ff('Exo 2 Variable', 'italic', exoLatI, UL),
  ff('Exo 2 Variable', 'normal', exoCyr, UR), ff('Exo 2 Variable', 'normal', exoLat, UL),
  ff('Tektur Variable', 'normal', tekCyr, UR), ff('Tektur Variable', 'normal', tekLat, UL),
].join('');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const z = (id: string) => zones.find((x) => x.id === id)!;
const cams = [
  { key: 'zal', title: z('zal').title, text: z('zal').text, image: '/images/zal.jpg', alt: 'Тренажёрный зал Urban210 с панорамными окнами', href: z('zal').href },
  { key: 'weights', title: 'Свободные веса', text: `Гантели, грифы и блины, ${site.facts.freeWeights}.`, image: '/images/free-weights.jpg', alt: 'Ряд гантелей в зоне свободных весов', href: '/zal/' },
  { key: 'cardio', title: z('cardio').title, text: z('cardio').text, image: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне', href: z('cardio').href },
  { key: 'group', title: z('group').title, text: z('group').text, image: '/images/group.jpg', alt: 'Групповая тренировка в зале групповых программ', href: z('group').href, tags: programs.flatMap((p) => p.items) },
  { key: 'spa', title: z('spa').title, text: z('spa').text, image: null, alt: '', href: z('spa').href },
];
const [day, full, all] = plans;
const dayRate = perDay(day.month, 30);
const rows: [string, string, string, string][] = [
  ['Время', 'с 6:30 до 16:00', 'Всё время работы', 'Всё время работы'],
];
const marks: [string, number, number, number][] = [
  ['Тренажёрный зал и кардиозона', 1, 1, 1],
  ['Фитнес-тестирование', 1, 1, 1],
  ['Раздевалки, душевые, парковка', 1, 1, 1],
  ['Пробная тренировка с тренером', 0, 1, 1],
  ['Групповые программы', 0, 0, 1],
  ['SPA: сауна, хаммам, релакс-зона', 0, 0, 1],
  ['Приоритетное обслуживание', 0, 0, 1],
];
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const ticker = [
  `${day.name} от ${dayRate} ₽ в день`,
  ...site.hours.map((h) => `${h.days} ${h.time}`),
  site.parking,
  `${rating} на Яндекс Картах, ${site.rating.text}`,
  `${tradein.title} по карте другого клуба`,
  `${friend.title} при покупке годовой подписки`,
  `${site.facts.machines} ${site.facts.brands}`,
  `SPA: финская сауна и хаммам в тарифе «${all.name}»`,
  personal.firstFree,
];
const position = (role: string) => (/групп/i.test(role) ? 'Групповые' : 'Тренажёрный зал');
const year = new Date().getFullYear();
// На телефоне вертикальный кадр светлого зала, на десктопе тёмный общий план под видео
const heroM = await getImage({ src: hall, widths: [480, 780, 1100], sizes: '100vw', format: 'webp', quality: 50 });
---
<Layout title="Концепция 14 «Эфир»" description="Концепция дизайна сайта Urban210: клуб как спортивная трансляция, табло, плашки и бегущая строка." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={exoCyrI} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>
  <div class="ef" data-ef>
    <!-- Табло -->
    <header class="sb">
      <a class="sb-logo" href="/concepts/14/" aria-label="Urban210, на главную"><span>URBAN<b>210</b></span><Icon name="chev" /></a>
      <p class="sb-live"><i class="dot" aria-hidden="true"></i><span class="sb-live-l">Прямой эфир</span><span class="sb-live-s">Эфир</span></p>
      <p class="sb-hours" data-today>{site.hours[0].time}</p>
      <p class="sb-clock" data-status><span class="sb-k">Хабаровск</span><b data-clock>--:--</b><span class="sb-st" data-open-label>Клуб</span></p>
      <nav class="sb-nav" aria-label="Разделы">
        <a href="#obzor">Обзор</a><a href="#tablo">Тарифы</a><a href="#sostav">Состав</a><a href="#intervyu">Отзывы</a>
      </nav>
      <a class="sb-tel" href={site.phone.href}>{site.phone.display}</a>
      <a class="btn-p btn-p-s" href="#zayavka" data-lead="Заявка с сайта" data-block="14_header"><span class="cta-l">Оставить заявку</span><span class="cta-s">Заявка</span><Icon name="chev" /></a>
    </header>

    <!-- Логотип канала в углу -->
    <div class="bug" aria-hidden="true"><span>U<b>210</b></span><Icon name="chev" /><i>Эфир</i></div>

    <main>
      <!-- Первый экран -->
      <section class="eh" aria-labelledby="ef-h1">
        <div class="eh-media" aria-hidden="true">
          <picture>
            <source media="(max-width: 759px)" srcset={heroM.srcSet.attribute} sizes="100vw" type="image/webp" />
            <Image src={hero} alt="" widths={[640, 1000, 1500, 2200]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={55} />
          </picture>
          <video data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none"></video>
        </div>
        <div class="eh-shade" aria-hidden="true"></div>
        <p class="eh-cam" aria-hidden="true"><span class="rec"></span>Камера 1 · Зал Urban210</p>

        <div class="eh-in">
          <div class="lt3">
            <p class="tags"><span class="tag tag-o">Эксклюзив</span><span class="tag tag-d">{site.city}</span></p>
            <h1 id="ef-h1">
              <span class="pl pl-w"><span>Ваш выход</span></span>
              <span class="pl pl-o"><span>От {dayRate} ₽ в день</span></span>
            </h1>
            <p class="pl pl-d eh-sub"><span>Фитнес-клуб Urban210, {site.address.short}. {day.name} за {rub(day.month)} в&nbsp;месяц: зал и кардиозона {day.hours}.</span></p>
            <div class="eh-cta">
              <a class="btn-p" href="#tablo" data-block="14_hero">Выбрать карту<Icon name="chev" /></a>
              <a class="btn-g" href="#zayavka" data-lead="Заявка с сайта" data-block="14_hero">Оставить заявку</a>
            </div>
          </div>

          <aside class="today" aria-label="Сегодня в клубе" data-status-card>
            <p class="today-h"><span>Сегодня в эфире</span><b data-status-word>Клуб</b></p>
            <ul>
              {site.hours.map((h, i) => <li data-hours={i === 0 ? 'wd' : 'we'}><span>{h.days}</span><b>{h.time}</b></li>)}
            </ul>
            <p class="today-left" data-open-left>Часы работы клуба</p>
            <a class="today-rate" href={site.maps.yandexReviews} target="_blank" rel="noopener"><b>{rating}</b><span><Icon name="star" />Яндекс Карты<br />{site.rating.text}</span></a>
          </aside>
        </div>

        <div class="etk" aria-label="Коротко о клубе">
          <p class="etk-k"><span class="tk-l">Новости клуба</span><span class="tk-s">Новости</span></p>
          <div class="etk-vp">
            <ul class="etk-row">
              {ticker.map((t) => <li><Icon name="chev" />{t}</li>)}
            </ul>
            <ul class="etk-row" aria-hidden="true">
              {ticker.map((t) => <li><Icon name="chev" />{t}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- Цифры перед трансляцией -->
      <section class="facts" aria-label="Клуб в цифрах">
        <div class="w facts-in">
          {[
            ['1300+', 'м²', 'площадь клуба'],
            ['60+', '', `тренажёров ${site.facts.brands}`],
            ['60', 'кг', 'свободные веса до'],
            ['50', '', 'мест бесплатной парковки'],
            [String(dayRate), '₽', 'в день по дневной карте'],
          ].map(([v, u, l], i) => (
            <div class="fact" data-wipe style={`--d:${i * 70}ms`}><b>{v}<small>{u}</small></b><span>{l}</span></div>
          ))}
        </div>
      </section>

      <!-- Мультикамера -->
      <section class="es" id="obzor" aria-labelledby="ef-obzor">
        <div class="w">
          <div class="sh" data-wipe>
            <span class="tag tag-o">Повтор</span>
            <h2 class="pl pl-w" id="ef-obzor"><span>Обзор клуба</span></h2>
            <p class="pl pl-d"><span>Пять камер. Переключайте зоны</span></p>
          </div>

          <div class="mc" data-mc>
            <div class="mc-screen">
              {cams.map((c, i) => (
                <figure class:list={['mc-shot', { on: i === 0 }]} data-shot={i} id={`cam-${c.key}`} role="tabpanel" aria-label={`Камера ${i + 1}: ${c.title}`}>
                  {c.image ? (
                    <Image src={img(c.image)} alt={c.alt} widths={[640, 1000, 1400]} sizes="(min-width: 1200px) 1100px, 100vw" format="avif" quality={50} loading="lazy" />
                  ) : (
                    <div class="nosig" aria-hidden="true"><span>Нет сигнала</span><small>В SPA камер нет</small></div>
                  )}
                  <figcaption class="mc-lt">
                    <span class="tag tag-o">Камера {i + 1}</span>
                    <span class="pl pl-w mc-title"><span>{c.title}</span></span>
                    <span class="pl pl-d mc-text"><span>{c.text}</span></span>
                    {c.tags && <span class="mc-tags">{c.tags.map((t) => <i>{t}</i>)}</span>}
                    <a class="mc-more" href={c.href}>Подробнее<Icon name="chev1" /></a>
                  </figcaption>
                </figure>
              ))}
              <span class="mc-replay" aria-hidden="true"><Icon name="chev" />Повтор</span>
              <span class="mc-sting" aria-hidden="true" data-sting><i></i><i></i></span>
            </div>
            <div class="mc-thumbs" role="tablist" aria-label="Камеры">
              {cams.map((c, i) => (
                <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`cam-${c.key}`} data-cam={i}>
                  {c.image ? <Image src={img(c.image)} alt="" widths={[240, 360]} sizes="220px" format="avif" quality={40} loading="lazy" /> : <span class="nosig nosig-s" aria-hidden="true"><span>Нет сигнала</span></span>}
                  <span class="mc-th-l"><b>Кам {i + 1}</b>{c.title}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Табло тарифов -->
      <section class="es es-board" id="tablo" aria-labelledby="ef-tablo">
        <div class="w">
          <div class="sh" data-wipe>
            <span class="tag tag-o">Табло</span>
            <h2 class="pl pl-w" id="ef-tablo"><span>Тарифы</span></h2>
            <p class="pl pl-d"><span>Три карты, дневная от {dayRate} ₽ в день</span></p>
          </div>

          <div class="excl" data-wipe>
            <span class="tag tag-w">В день</span>
            <p class="excl-n"><b>{dayRate}</b><span>₽</span></p>
            <div class="excl-t">
              <h3>{day.name}: {dayRate} ₽ в день</h3>
              <p>{rub(day.month)} в месяц. Тренажёрный зал и кардиозона {day.hours}.</p>
            </div>
            <a class="btn-p btn-p-dark" href="#zayavka" data-lead="Заявка с сайта" data-block="14_day">Оставить заявку<Icon name="chev" /></a>
          </div>

          <div class="board" role="table" data-wipe aria-label="Сравнение тарифов">
            <div class="b-row b-head" role="row">
              <span class="b-l" role="columnheader"><span class="sr">Показатель</span></span>
              {plans.map((p) => (
                <span class:list={['b-team', { hot: p.id === 'full' }]} role="columnheader">
                  {p.tag ? <i>{p.tag}</i> : <i class="ghost">Базовый</i>}
                  <b>{p.name}</b>
                </span>
              ))}
            </div>
            <div class="b-row b-big" role="row">
              <span class="b-l" role="rowheader">В месяц</span>
              {plans.map((p) => (
                <span class="b-v" role="cell"><b class="dig">{num(p.month)}<small>₽</small></b><i class="bar" style={`--v:${(p.month / all.month).toFixed(3)}`}></i></span>
              ))}
            </div>
            <div class="b-row" role="row">
              <span class="b-l" role="rowheader">За год</span>
              {plans.map((p) => <span class="b-v" role="cell"><b class="dig dig-s">{rub(p.year)}</b></span>)}
            </div>
            <div class="b-row" role="row">
              <span class="b-l" role="rowheader">В день при оплате за год</span>
              {plans.map((p) => <span class="b-v" role="cell"><b class="dig dig-s">{perDay(p.year, 365)} ₽</b></span>)}
            </div>
            {rows.map(([l, a, b, c]) => (
              <div class="b-row" role="row">
                <span class="b-l" role="rowheader">{l}</span>
                {[a, b, c].map((v) => <span class="b-v b-txt" role="cell">{v}</span>)}
              </div>
            ))}
            {marks.map(([l, a, b, c]) => (
              <div class="b-row" role="row">
                <span class="b-l" role="rowheader">{l}</span>
                {[a, b, c].map((v) => (
                  <span class:list={['b-v', 'b-m', { yes: v }]} role="cell">{v ? <Icon name="check" /> : <Icon name="minus" />}<span class="sr">{v ? 'есть' : 'нет'}</span></span>
                ))}
              </div>
            ))}
            <div class="b-row b-cta" role="row">
              <span class="b-l" role="cell"></span>
              {plans.map((p) => (
                <span class="b-v" role="cell"><a class:list={[p.id === 'full' ? 'btn-p' : 'btn-g', 'btn-sm']} href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block="14_board">Выбрать<Icon name="chev" /></a></span>
              ))}
            </div>
          </div>

          <div class="epromos">
            {[tradein, friend].map((p) => (
              <a class="promo-c" href={`/promo/${p.slug}/`} data-wipe>
                <span class="tag tag-o">Анонс</span>
                <b>{p.title}</b>
                <span>{p.short}</span>
                <Icon name="chev" />
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Состав -->
      <section class="es" id="sostav" aria-labelledby="ef-sostav">
        <div class="w">
          <div class="sh" data-wipe>
            <span class="tag tag-o">Состав</span>
            <h2 class="pl pl-w" id="ef-sostav"><span>Тренеры</span></h2>
            <p class="pl pl-d"><span>Поставят технику и составят программу</span></p>
          </div>
          <div class="cards">
            {trainers.map((t, i) => {
              const [first, ...rest] = t.name.split(' ');
              return (
                <article class="card" data-wipe style={`--d:${i * 90}ms`}>
                  <Image src={img(t.photo)} alt={`${t.name}, ${t.role.toLowerCase()}`} widths={[400, 600, 900]} sizes="(min-width: 1000px) 400px, (min-width: 700px) 45vw, 100vw" format="avif" quality={50} loading="lazy" />
                  <span class="card-team" aria-hidden="true"><span>URBAN<b>210</b></span><Icon name="chev" /></span>
                  <span class="card-pos">{position(t.role)}</span>
                  <div class="card-lt">
                    <span class="card-first">{first}</span>
                    <h3 class="card-last">{rest.join(' ')}</h3>
                    <p class="card-role">{t.role}</p>
                  </div>
                </article>
              );
            })}
          </div>
          <div class="pers" data-wipe>
            <span class="tag tag-o">Персонально</span>
            <p class="pers-t"><b>{personal.pack} тренировок за {rub(personal.price)}</b><span>{personal.firstFree}.</span></p>
            <a class="btn-g" href="#zayavka" data-lead="Персональная тренировка" data-block="14_personal">Записаться к тренеру<Icon name="chev" /></a>
          </div>
        </div>
      </section>

      <!-- Отзывы -->
      <section class="es" id="intervyu" aria-labelledby="ef-int">
        <div class="w">
          <div class="sh" data-wipe>
            <span class="tag tag-o">Интервью</span>
            <h2 class="pl pl-w" id="ef-int"><span>Говорят гости</span></h2>
            <p class="pl pl-d"><span>Отзывы с Яндекс Карт и 2ГИС</span></p>
          </div>
          <div class="int">
            <a class="score" href={site.maps.yandexReviews} target="_blank" rel="noopener" data-wipe>
              <span class="score-k">Рейтинг</span>
              <b class="score-v">{rating}</b>
              <span class="score-s">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
              <span class="score-l">Яндекс Карты · {site.rating.text}</span>
              <span class="score-a">Читать отзывы<Icon name="chev1" /></span>
            </a>
            {reviews.map((r, i) => (
              <figure class="iv" data-wipe style={`--d:${(i % 2) * 80}ms`}>
                <span class="iv-k">Гость клуба</span>
                <blockquote>{r.text}</blockquote>
                <figcaption><span class="pl pl-w"><span>{r.name}</span></span><span class="tag tag-o">{r.source}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- Программа передач и заявка -->
      <section class="es es-cta" id="zayavka" aria-labelledby="ef-cta">
        <div class="w cta">
          <div class="guide">
            <div class="sh" data-wipe>
              <span class="tag tag-o">Программа</span>
              <h2 class="pl pl-w" id="ef-cta"><span>Выйти в эфир</span></h2>
              <p class="pl pl-d"><span>Перезвоним и поможем выбрать карту</span></p>
            </div>
            <ol class="tv">
              <li><span class="tv-t">06:30</span><span><b>Начало эфира</b>По будням клуб открывается в 06:30, в выходные в 07:30</span></li>
              <li><span class="tv-t">16:00</span><span><b>Конец дневной карты</b>«{day.name}» действует {day.hours}</span></li>
              <li><span class="tv-t">22:30</span><span><b>Финал выходных</b>{site.hours[1].days} клуб работает до 22:30</span></li>
              <li><span class="tv-t">23:30</span><span><b>Конец эфира</b>{site.hours[0].days} последние тренировки до 23:30</span></li>
            </ol>
            <ul class="links">
              <li><a href={site.phone.href}><Icon name="phone" />{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Хочу записаться в Urban210')} target="_blank" rel="noopener"><Icon name="wa" />WhatsApp</a></li>
              <li><a href={telegramLink('concept14')} target="_blank" rel="noopener"><Icon name="tg" />Telegram</a></li>
            </ul>
          </div>
          <div class="cta-form" data-wipe>
            <span class="cta-bar" aria-hidden="true"><i class="dot"></i>В эфир</span>
            <LeadForm id="ef" block="14_final" />
          </div>
        </div>
      </section>
    </main>

    <footer class="ft">
