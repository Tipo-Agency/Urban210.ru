---
// Концепция 27 «Аэробика»: видеокассета с аэробикой из восьмидесятых.
// Неоновые розовый, бирюзовый и оранжевый полосами, экран кинескопа с надписями видеомагнитофона
// (PLAY, счётчик времени, едва заметные полосы трекинга), фото с цветокоррекцией под VHS, аудиокассета для пробного дня.
// Rubik Mono One в заголовках, IBM Plex Mono для экранных надписей. Хром не используем (он был в 11).
// Движение: катушки кассеты крутятся, счётчик идёт, полоса трекинга проползает по экрану. При reduced motion всё стоит.
import rmCyr from '@fontsource/rubik-mono-one/files/rubik-mono-one-cyrillic-400-normal.woff2?url';
import rmLat from '@fontsource/rubik-mono-one/files/rubik-mono-one-latin-400-normal.woff2?url';
import pmCyr from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-cyrillic-500-normal.woff2?url';
import pmLat from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import rubUrl from '@fontsource-variable/golos-text/files/golos-text-latin-ext-wght-normal.woff2?url';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import { img } from '../../../data/images';
import { site, whatsappLink, telegramLink } from '../../../data/site';
import { plans, perDay, rub, trial, personal } from '../../../data/pricing';
import { reviews, trainers, zones, promos, programs } from '../../../data/content';

const UR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const UL = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ff = (fam: string, url: string, range: string) => `@font-face{font-family:'${fam}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2');unicode-range:${range}}`;
// в Rubik Mono One и Plex Mono нет знака рубля в этих наборах: берём его из Golos, этот файл уже грузит основной текст
const fonts = [
  ff('Rubik 27', rmCyr, UR), ff('Rubik 27', rmLat, UL), ff('Rubik 27', rubUrl, 'U+20BD'),
  ff('Plex 27', pmCyr, UR), ff('Plex 27', pmLat, UL), ff('Plex 27', rubUrl, 'U+20BD'),
].join('');

const num = (n: number) => n.toLocaleString('ru-RU').replace(/\s/g, ' ');
const rating = site.rating.value.toString().replace('.', ',');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const z = Object.fromEntries(zones.map((x) => [x.id, x]));
const tradein = promos.find((p) => p.slug === 'trade-in')!;
const friend = promos.find((p) => p.slug === '1-plus-1')!;
const trialPromo = promos.find((p) => p.slug === '1-rubl')!;
const personalLine = `${personal.pack} тренировок: ${rub(personal.price)}`;
const run = ['Вступительного взноса нет', `Пробный день ${trial.price} ₽`, 'Парковка на 50 мест', `${site.hours[0].days} ${site.hours[0].time}`, `${site.hours[1].days} ${site.hours[1].time}`, `${rating} на Яндекс Картах`, site.facts.machines];
const channels = [
  { ch: '01', zone: z.zal, photo: '/images/free-weights.jpg', alt: 'Свободные веса в зале Urban210' },
  { ch: '02', zone: z.cardio, photo: '/images/cardio.jpg', alt: 'Беговые дорожки в кардиозоне' },
  { ch: '03', zone: z.group, photo: '/images/group-strength.jpg', alt: 'Силовая групповая тренировка' },
];
const progSkin = ['p', 'o', 'c', 'y'];
const tapeSkin = ['c', 'p', 'o'];
---
<Layout title="Концепция 27 «Аэробика»" description="Концепция дизайна сайта Urban210: видеокассета с аэробикой восьмидесятых, неоновые полосы, экран кинескопа и аудиокассета пробного дня." noindex bare>
  <Fragment slot="head">
    <link rel="preload" href={rmCyr} as="font" type="font/woff2" crossorigin />
    <style set:html={fonts} />
  </Fragment>

  <div class="vh">
    <header class="vh-top">
      <div class="vh-w vh-top-in">
        <a class="vh-logo" href="/concepts/27/" aria-label="Urban210, на главную">URBAN210<Icon name="chev" /></a>
        <nav class="vh-nav" aria-label="Разделы">
          <a href="#kanaly">Зоны</a><a href="#tarify">Тарифы</a><a href="#vedushchie">Тренеры</a><a href="#otzyvy">Отзывы</a><a href="#zayavka">Адрес</a>
        </nav>
        <a class="vh-tel" href={site.phone.href}>{site.phone.display}</a>
        <a class="vh-btn vh-btn-s" href="#zayavka" data-lead={trial.title} data-block="27_header"><i class="vh-rec" aria-hidden="true"></i>Пробный 1 ₽</a>
      </div>
    </header>

    <!-- Первый экран: кинескоп -->
    <section class="vh-hero" aria-labelledby="vh-h1">
      <span class="vh-rays" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <div class="vh-w vh-hero-in">
        <div class="vh-hero-tx">
          <p class="vh-osd-line">Канал 210 · Фитнес-клуб · Хабаровск</p>
          <h1 id="vh-h1" class="vh-h1">
            <span class="l1">Раз<i>,</i></span>
            <span class="l1">два<i>,</i></span>
            <span class="l2">в зал!</span>
            <span class="l3">Первый день в Urban210 за 1 ₽</span>
          </h1>
          <p class="vh-lead">Тренажёрный зал, кардио, групповые программы и SPA в Железнодорожном районе. Включайтесь с 6:30 утра, вступительного взноса нет.</p>
          <div class="vh-cta">
            <a class="vh-btn" href="#zayavka" data-lead={trial.title} data-block="27_hero">Записаться за 1 ₽<Icon name="chev" /></a>
            <a class="vh-link" href="#tarify">Тарифы от {num(plans[0].month)} ₽</a>
          </div>
        </div>

        <div class="vh-tv">
          <div class="vh-screen">
            <Image class="vh-shot" src={img('/images/group.jpg')} alt="Групповая тренировка в зале Urban210" widths={[480, 640, 800, 960]} sizes="(min-width: 1100px) 46vw, 92vw" loading="eager" fetchpriority="high" format="webp" quality={55} />
            <video class="vh-vid" data-hero-video data-src="/video/hero-bw.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
            <span class="vh-tint" aria-hidden="true"></span>
            <span class="vh-scan" aria-hidden="true"></span>
            <span class="vh-track" aria-hidden="true"></span>
            <span class="vh-osd vh-osd-tl" aria-hidden="true">PLAY ▶</span>
            <span class="vh-osd vh-osd-tr" aria-hidden="true">SP <b data-tc>0:00:00</b></span>
            <span class="vh-osd vh-osd-bl" aria-hidden="true">CH 210</span>
            <span class="vh-osd vh-osd-br" aria-hidden="true">{site.hours[0].time}</span>
          </div>
          <div class="vh-panel" aria-hidden="true">
            <span class="kn"></span><span class="kn"></span>
            <span class="grill"></span>
            <span class="pw"></span>
          </div>
        </div>
      </div>

      <div class="vh-w">
        <ul class="vh-stats">
          <li><b>{rating}</b><span>Яндекс Карты, {site.rating.text}</span></li>
          <li><b>06:30</b><span>открываемся по будням</span></li>
          <li><b>50</b><span>мест бесплатной парковки</span></li>
          <li><b>0 ₽</b><span>вступительный взнос</span></li>
        </ul>
      </div>
    </section>

    <!-- Полосы с бегущей строкой -->
    <div class="vh-band" aria-hidden="true">
      <div class="vh-run">{[0, 1].map(() => <span>{run.map((t) => <>{t}<Icon name="chev" /></>)}</span>)}</div>
    </div>

    <!-- Зоны: каналы -->
    <section class="vh-sec vh-light" id="kanaly" aria-labelledby="vh-ch-h">
      <div class="vh-w">
        <div class="vh-head">
          <p class="vh-kick">Переключайте каналы</p>
          <h2 id="vh-ch-h" class="vh-h2">Четыре зоны <span>одного клуба</span></h2>
          <p class="vh-head-t">{cap(site.facts.area)} на двух этажах. Всё, что нужно для тренировки, под одной крышей.</p>
        </div>
        <div class="vh-chans">
          {channels.map((c, i) => (
            <a class={`ch ch-${i}`} href={c.zone.href} data-rise>
              <div class="ch-scr">
                <Image src={img(c.photo)} alt={c.alt} widths={[400, 640, 900]} sizes={i === 0 ? '(min-width: 1100px) 56vw, 92vw' : '(min-width: 1100px) 40vw, 92vw'} loading="lazy" format="avif" quality={45} />
                <span class="vh-tint" aria-hidden="true"></span>
                <span class="vh-scan" aria-hidden="true"></span>
                <span class="vh-osd vh-osd-tl" aria-hidden="true">CH {c.ch}</span>
              </div>
              <h3>{c.zone.title}</h3>
              <p>{cap(c.zone.text)}</p>
            </a>
          ))}
          <a class="ch ch-3" href={z.spa.href} data-rise>
            <div class="ch-scr ch-bars" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
              <span class="ch-bars-t">SPA</span>
              <span class="vh-osd vh-osd-tl">CH 04</span>
            </div>
            <h3>{z.spa.title}</h3>
            <p>{z.spa.text} В тарифе «{plans[2].name}».</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Групповые: разминка -->
    <section class="vh-sec vh-prog" aria-labelledby="vh-pr-h">
      <div class="vh-w">
        <div class="vh-head">
          <p class="vh-kick">Зал групповых программ, 150 м²</p>
          <h2 id="vh-pr-h" class="vh-h2">Всё, как <span>на кассете</span></h2>
          <p class="vh-head-t">Только вживую и с тренером рядом. Запись на групповые в приложении клуба.</p>
        </div>
        <ol class="vh-progs">
          {programs.map((g, i) => (
            <li class={`pg pg-${progSkin[i]}`} data-rise>
              <span class="pg-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{g.group}</h3>
              <p class="pg-items">{g.items.join(' · ')}</p>
              <p>{g.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Тарифы: видеокассеты -->
    <section class="vh-sec vh-light" id="tarify" aria-labelledby="vh-p-h">
      <div class="vh-w">
        <div class="vh-head">
          <p class="vh-kick">Абонементы без взноса за вход</p>
          <h2 id="vh-p-h" class="vh-h2">Выберите <span>кассету</span></h2>
          <p class="vh-head-t">Помесячно или сразу на год. Годовая карта выходит дешевле, цену дня посчитали.</p>
        </div>
        <div class="vh-tapes">
          {plans.map((p, i) => (
            <article class={`tp tp-${tapeSkin[i]}`} data-rise>
              <div class="tp-label">
                <span class="tp-len">VHS · кассета {i + 1}</span>
                <h3>{p.name}</h3>
                {p.tag && <span class="tp-tag">{p.tag}</span>}
              </div>
              <p class="tp-h">{cap(p.hours)}</p>
              <p class="tp-price"><b>{num(p.month)}</b><span>₽ в месяц</span></p>
              <p class="tp-year">За год {rub(p.year)}, это {perDay(p.year, 365)} ₽ в день</p>
              <ul>
                {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
                {p.excluded?.map((f) => <li class="no"><Icon name="minus" /><s>{f}</s></li>)}
              </ul>
              <a class="vh-btn vh-btn-w" href="#zayavka" data-lead={`Тариф «${p.name}»`} data-block={`27_plan_${p.id}`}>Выбрать<Icon name="chev" /></a>
            </article>
          ))}
        </div>

        <!-- Пробный день: аудиокассета -->
        <div class="vh-trial">
          <div class="cs" aria-hidden="true">
            <span class="cs-scr s1"></span><span class="cs-scr s2"></span><span class="cs-scr s3"></span><span class="cs-scr s4"></span>
            <div class="cs-label">
              <span class="cs-side">A</span>
              <span class="cs-title">Пробный день</span>
              <span class="cs-price">1 ₽</span>
              <span class="cs-lines"></span>
            </div>
            <div class="cs-win">
              <span class="cs-reel r1"><i></i></span>
              <span class="cs-tape"></span>
              <span class="cs-reel r2"><i></i></span>
            </div>
            <span class="cs-foot"></span>
          </div>
          <div class="vh-trial-tx">
            <p class="vh-kick">Сторона А</p>
            <h3>{trial.title}</h3>
            <p>{trial.text}</p>
            <ul>{trialPromo.terms.map((t) => <li>{t}</li>)}</ul>
            <a class="vh-btn" href="#zayavka" data-lead={trial.title} data-block="27_trial">{trialPromo.cta}<Icon name="chev" /></a>
          </div>
        </div>

        <div class="vh-stickers">
          {[tradein, friend].map((pr, i) => (
            <article class={`st st-${i}`} data-rise>
              <h3>{pr.title}</h3>
              <p>{pr.text}</p>
              <a class="vh-link" href="#zayavka" data-lead={pr.goal} data-block={`27_promo_${pr.slug}`}>{pr.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Тренеры: обложки кассет -->
    <section class="vh-sec" id="vedushchie" aria-labelledby="vh-t-h">
      <div class="vh-w">
        <div class="vh-head">
          <p class="vh-kick">В главных ролях</p>
          <h2 id="vh-t-h" class="vh-h2">Тренеры <span>клуба</span></h2>
          <p class="vh-head-t">Покажут тренажёры, поставят технику и соберут программу под вашу цель.</p>
        </div>
        <div class="vh-covers">
          {trainers.map((t, i) => (
            <figure class={`cv cv-${tapeSkin[i]}`} data-rise>
              <div class="cv-ph">
                <Image src={img(t.photo)} alt={t.name} widths={[320, 480, 640]} sizes="(min-width: 1100px) 28vw, 88vw" loading="lazy" format="avif" quality={50} />
                <span class="vh-tint" aria-hidden="true"></span>
                <span class="cv-stripes" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="cv-hifi" aria-hidden="true">HI-FI · STEREO</span>
              </div>
              <figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="vh-pt" data-rise>
          <div>
            <p class="vh-kick">Персональные тренировки</p>
            <p class="vh-pt-big">{personalLine}</p>
            <p class="vh-pt-t">{personal.firstFree}.</p>
          </div>
          <a class="vh-btn" href="#zayavka" data-lead="Персональные тренировки" data-block="27_personal">Записаться к тренеру<Icon name="chev" /></a>
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="vh-sec vh-light" id="otzyvy" aria-labelledby="vh-r-h">
      <div class="vh-w">
        <div class="vh-head vh-head-rev">
          <div>
            <p class="vh-kick">Отзывы зрителей</p>
            <h2 id="vh-r-h" class="vh-h2">Смотрели <span>и пришли</span></h2>
          </div>
          <a class="vh-score" href={site.maps.yandexReviews} target="_blank" rel="noopener">
            <b>{rating}</b><span>из 5 на Яндекс Картах<br />{site.rating.text}</span>
          </a>
        </div>
        <div class="vh-revs">
          {reviews.map((r, i) => (
            <blockquote class={`rv rv-${i % 3}`} data-rise>
              <p>{r.text}</p>
              <footer><b>{r.name}</b><span>{r.source}</span></footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section class="vh-final" id="zayavka" aria-labelledby="vh-f-h">
      <span class="vh-rays vh-rays-f" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <div class="vh-w fi-in">
        <div class="fi-tx">
          <p class="fi-rec"><i class="vh-rec" aria-hidden="true"></i>REC</p>
          <h2 id="vh-f-h" class="vh-h2 fi-h">Запишите себя <span>на пробный день</span></h2>
          <dl class="fi-facts">
            <div><dt>Адрес</dt><dd>{site.address.locality}, {site.address.street}<br />{site.district}</dd></div>
            <div><dt>Часы</dt><dd>{site.hours.map((h) => <>{`${h.days} ${h.time}`}<br /></>)}</dd></div>
            <div><dt>Парковка</dt><dd>Бесплатная, 50 мест под видеонаблюдением</dd></div>
            <div><dt>Телефон</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
          </dl>
        </div>
        <div class="fi-form">
          <LeadForm id="vh" block="27_final" />
        </div>
      </div>
    </section>

    <footer class="vh-foot">
      <div class="vh-w">
        <p class="vh-foot-big" aria-hidden="true">URBAN210<Icon name="chev" /></p>
        <div class="vh-foot-cols">
          <div>
            <h2>Клуб</h2>
            <p>{site.address.locality}, {site.address.street}<br />{site.district}</p>
            <p>{site.hours.map((h) => <>{`${h.days}: ${h.time}`}<br /></>)}</p>
          </div>
          <div>
            <h2>Связь</h2>
            <ul>
              <li><a href={site.phone.href}>{site.phone.display}</a></li>
              <li><a href={whatsappLink('Здравствуйте! Вопрос по клубу Urban210')} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={telegramLink('site_footer')} target="_blank" rel="noopener">Telegram-бот</a></li>
              <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <h2>Клуб и цены</h2>
            <ul>
              <li><a href="/price/">Тарифы</a></li><li><a href="/zal/">Тренажёрный зал</a></li><li><a href="/group/">Групповые</a></li><li><a href="/spa/">SPA</a></li><li><a href="/trainers/">Тренеры</a></li><li><a href="/promo/">Акции</a></li>
            </ul>
          </div>
          <div>
            <h2>Документы</h2>
            <ul>
              <li><a href="/rules/">Правила клуба</a></li><li><a href="/oferta/">Договор-оферта</a></li><li><a href="/policy/">Политика конфиденциальности</a></li><li><a href={site.maps.yandexReviews} target="_blank" rel="noopener">Отзывы на Яндекс Картах</a></li>
            </ul>
          </div>
        </div>
        <p class="vh-legal">© {new Date().getFullYear()} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Счётчик видеомагнитофона: сколько секунд страница открыта. При reduced motion стоит на месте.
  const tc = document.querySelector<HTMLElement>('.vh [data-tc]');
  if (tc && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const t0 = Date.now();
    const pad = (n: number) => String(n).padStart(2, '0');
    setInterval(() => {
      const s = Math.floor((Date.now() - t0) / 1000);
      tc.textContent = `${Math.floor(s / 3600)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
    }, 1000);
  }
</script>

<style is:global>
  body:has(.vh) { background: #1c0e2c; color: #fff3e6; overflow-x: clip; }
  body:has(.vh) ::selection { background: #ff3d8b; color: #1c0e2c; }
  body:has(.vh) :focus-visible { outline: 3px solid #19d3e6; outline-offset: 3px; }
  body:has(.vh) .form { background: #fff3e6; color: #1c0e2c; --ink: #1c0e2c; --muted: #5e4c6b; --card: #fff; --line: #1c0e2c; border-radius: 18px; border: 3px solid #1c0e2c; box-shadow: 8px 8px 0 #ff3d8b, 16px 16px 0 #19d3e6; gap: 14px; }
  body:has(.vh) .form h3 { font-family: 'Rubik 27', 'Arial Black', sans-serif; font-weight: 800; font-size: 1.3rem; line-height: 1.15; letter-spacing: 0; word-spacing: -0.42em; text-transform: uppercase; }
  body:has(.vh) .form .muted, body:has(.vh) .form .consent, body:has(.vh) .form .form-note, body:has(.vh) .form .form-note a { color: #5e4c6b; }
  body:has(.vh) .form .field { color: #1c0e2c; font-weight: 600; font-size: 0.9rem; }
  body:has(.vh) .form .field input { border-radius: 10px; border: 2px solid #1c0e2c; background: #fff; color: #1c0e2c; }
  body:has(.vh) .form .field input::placeholder { color: #8d7d97; }
