---
// Главная (дизайн 05 «Дружелюбный», тёмный, выбран 30.10.2026): оффер от 43 ₽ в день, сразу выбор карты и заявка,
// дальше зоны, отзывы, тренеры, акции и свежие статьи со ссылками на внутренние страницы.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Plans from '../components/Plans.astro';
import Final from '../components/Final.astro';
import Reviews from '../components/Reviews.astro';
import Trainers from '../components/Trainers.astro';
import Promos from '../components/Promos.astro';
import PostCard from '../components/PostCard.astro';
import Faq from '../components/Faq.astro';
import AppBlock from '../components/AppBlock.astro';
import MapBlock from '../components/MapBlock.astro';
import { img } from '../data/images';
import { site } from '../data/site';
import { plans, perDay, rub } from '../data/pricing';
import { zones, programs, faqGeneral } from '../data/content';

const dayPlan = plans[0];
const dayPrice = perDay(dayPlan.month, 30);
const zal = zones.find((z) => z.id === 'zal')!;
const cardio = zones.find((z) => z.id === 'cardio')!;
const group = zones.find((z) => z.id === 'group')!;
const spa = zones.find((z) => z.id === 'spa')!;

// Веер на первом экране: гости целиком, без обрезанных голов
const fan = [
  { src: '/images/community/11.jpg', alt: 'Гостья клуба в тренажёрном зале Urban210' },
  { src: '/images/community/13.jpg', alt: 'Гостья клуба у силовой рамы' },
  { src: '/images/community/9.jpg', alt: 'Гость клуба после тренировки' },
];
const marquee = [`Безлимит от ${dayPrice} ₽ в день`, 'Парковка на 50 мест бесплатно', 'Без очередей к тренажёрам', 'С 6:30 по будням', 'Сауна и хаммам'];
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Layout
  image="/og/home.jpg"
  title="Фитнес-клуб Urban210 в Хабаровске: тренажёрный зал от 43 ₽ в день"
  description={`Фитнес-клуб в Железнодорожном районе Хабаровска: ${site.facts.area}, ${site.facts.machines}, групповые программы, сауна и хаммам. Безлимит от ${dayPrice} ₽ в день, карта от ${rub(dayPlan.month)} в месяц.`}
>
  <section class="f5-hero" aria-labelledby="f5-h">
    <div class="f5-hero-card">
      <div class="f5-hero-text">
        <p class="f5-status" data-status><i></i><span>Хабаровск, {site.district}</span></p>
        <h1 id="f5-h">Безлимит в зал <span class="f5-price-chip">от&nbsp;{dayPrice}&nbsp;₽</span> в день</h1>
        <p class="f5-hero-lead">{dayPlan.name}: {rub(dayPlan.month)} в месяц. {site.facts.machines} {site.facts.brands}, групповые программы, сауна и хаммам.</p>
        <div class="f5-cta">
          <a class="f5-go" href="#cards"><span>Выбрать карту</span><i><Icon name="chev" /></i></a>
          <a class="f5-pill f5-pill-ghost" href="#zayavka" data-lead="Заявка на карту" data-block="home_hero">Оставить заявку</a>
        </div>
      </div>
      <div class="f5-fan" aria-label="Гости клуба">
        {fan.map((f, i) => (
          <figure class={`f5-fan-card n${i}`}>
            <Image src={img(f.src)} alt={f.alt} widths={[280, 420, 600]} sizes="(min-width: 980px) 280px, 46vw" loading={i === 1 ? 'eager' : 'lazy'} fetchpriority={i === 1 ? 'high' : undefined} format="webp" quality={60} style="object-position:50% 12%" />
          </figure>
        ))}
        <span class="f5-stk f5-stk-cob" data-spin><b>{dayPrice} ₽</b>в день</span>
        <a class="f5-stk-rate" href="#otzyvy"><Icon name="star" /><b>{site.rating.value.toString().replace('.', ',')}</b><span>{site.rating.text}</span></a>
      </div>
      <div class="f5-marquee" aria-hidden="true">
        <div class="f5-marquee-track">
          {[0, 1].map(() => marquee.map((m) => <span>{m}<Icon name="chev" /></span>))}
        </div>
      </div>
    </div>
    <ul class="f5-facts">
      <li><Icon name="clock" /><div><b>{site.hours[0].days} {site.hours[0].time}</b><span>{site.hours[1].days} {site.hours[1].time}</span></div></li>
      <li><Icon name="pin" /><div><b>{site.address.short}</b><span>{site.district}</span></div></li>
      <li><span class="f5-p">P</span><div><b>Парковка на 50 мест</b><span>бесплатно, под видеонаблюдением</span></div></li>
    </ul>
  </section>

  <Plans block="home" />

  <Final block="home_final" />

  <section class="f5-sec" id="zones" aria-labelledby="f5-z">
    <div class="f5-head f5-head-row">
      <div>
        <h2 id="f5-z">Что внутри клуба</h2>
        <p>{site.facts.area} на двух этажах. Места хватает даже вечером.</p>
      </div>
      <a class="f5-pill f5-pill-wht" href="/zones/">Все зоны клуба</a>
    </div>
    <div class="f5-bento">
      <a class="f5-zone f5-zone-big" href="/zal/" data-rise>
        <Image src={img(zal.image!)} alt="Тренажёрный зал Urban210 с панорамными окнами" widths={[480, 800, 1100]} sizes="(min-width: 980px) 56vw, 92vw" format="avif" quality={50} />
        <div class="f5-zone-txt">
          <span class="f5-tag">Главный зал</span>
          <h3>{zal.title}</h3>
          <p>{zal.text}</p>
        </div>
        <span class="f5-arrow"><Icon name="chev" /></span>
      </a>
      <a class="f5-zone f5-zone-photo" href="/zones/cardio/" data-rise>
        <Image src={img(cardio.image!)} alt="Беговые дорожки Technogym в кардиозоне" widths={[400, 700]} sizes="(min-width: 980px) 40vw, 92vw" format="avif" quality={50} />
        <div class="f5-zone-txt">
          <h3>{cardio.title}</h3>
          <p>{cardio.text}</p>
        </div>
        <span class="f5-arrow"><Icon name="chev" /></span>
      </a>
      <a class="f5-zone f5-zone-spa" href="/spa/" data-rise>
        <span class="f5-stk f5-stk-org f5-spa-stk" data-spin><b>40–50 °C</b>хаммам</span>
        <h3>{spa.title}</h3>
        <p>{spa.text}</p>
        <span class="f5-mini">В тарифе «Всё включено»</span>
        <span class="f5-arrow"><Icon name="chev" /></span>
      </a>
      <div class="f5-zone f5-zone-group" data-rise>
        <div class="f5-group-txt">
          <h3>{group.title}</h3>
          <p>{group.text}</p>
          <ul class="f5-chips">
            {programs.flatMap((p) => p.items).map((it) => <li>{it}</li>)}
          </ul>
          <a class="f5-pill f5-pill-wht" href="/group/">Направления и запись</a>
        </div>
        <div class="f5-group-ph">
          <Image src={img('/images/group.jpg')} alt="Групповая тренировка в зале 150 м²" widths={[400, 700]} sizes="(min-width: 980px) 34vw, 92vw" format="avif" quality={50} />
          <Image src={img('/images/group-strength.jpg')} alt="Силовая групповая тренировка с гантелями" widths={[300, 500]} sizes="(min-width: 980px) 18vw, 44vw" format="avif" quality={45} />
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <AppBlock />

  <section class="f5-sec" id="team" aria-labelledby="f5-t">
    <div class="f5-head f5-head-row">
      <div>
        <h2 id="f5-t">Тренеры помогут начать</h2>
        <p>Покажут тренажёры, поставят технику и составят первую программу.</p>
      </div>
      <a class="f5-pill f5-pill-wht" href="/personal/">Персональные тренировки</a>
    </div>
    <Trainers />
  </section>

  <section class="f5-sec" aria-labelledby="f5-promo">
    <div class="f5-head f5-head-row">
      <div><h2 id="f5-promo">Акции</h2></div>
      <a class="f5-pill f5-pill-wht" href="/promo/">Все акции</a>
    </div>
    <Promos />
  </section>

  <section class="f5-sec" aria-labelledby="f5-blog">
    <div class="f5-head f5-head-row">
      <div>
        <h2 id="f5-blog">Блог о тренировках</h2>
        <p>Как начать, худеть и набирать без вреда, что выбрать в Хабаровске.</p>
      </div>
      <a class="f5-pill f5-pill-wht" href="/blog/">Все статьи</a>
    </div>
    <ul class="f5-posts">{posts.map((p) => <li><PostCard post={p} /></li>)}</ul>
  </section>

  <MapBlock />

  <Faq items={faqGeneral} />
</Layout>

<script>
  // Статус «открыто сейчас» по времени Хабаровска
  const st = document.querySelector<HTMLElement>('[data-status]');
  if (st) {
    const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Vladivostok' }));
    const d = now.getDay();
    const m = now.getHours() * 60 + now.getMinutes();
    const [o, c] = d === 0 || d === 6 ? [450, 1350] : [390, 1410];
    const open = m >= o && m < c;
    const pad = (x: number) => `${Math.floor(x / 60)}:${String(x % 60).padStart(2, '0')}`;
    st.classList.toggle('open', open);
    st.querySelector('span')!.textContent = open ? `Открыто сейчас, до ${pad(c)}` : `Сейчас закрыто, откроемся в ${pad(o)}`;
  }
  // Веер фото раскрывается после загрузки
  requestAnimationFrame(() => document.querySelector('.f5-fan')?.classList.add('is-open'));
</script>
