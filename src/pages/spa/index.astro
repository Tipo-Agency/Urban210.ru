---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Final from '../../components/Final.astro';
import Cta from '../../components/Cta.astro';
import { plans, rub } from '../../data/pricing';

const items = [
  { title: 'Финская сауна', text: 'Сухой жар расслабляет мышцы после силовой и помогает восстановиться к следующей тренировке.' },
  { title: 'Хаммам', text: 'Влажный пар 40–50 °C. Мягче сауны, полезен для дыхания и кожи. Хорошо чередовать с прохладным душем.' },
  { title: 'Релакс-зона', text: 'Массажные кресла и тишина. Десять минут после тренировки, чтобы пульс пришёл в норму.' },
];
const steps = [
  ['Остыньте', 'Подождите 10–15 минут после тренировки, пока пульс и дыхание успокоятся.'],
  ['Прогрейтесь', 'Тёплый душ, затем сауна или хаммам на 8–12 минут.'],
  ['Остудитесь', 'Прохладный душ и отдых 10 минут, выпейте воды.'],
  ['Повторите', '2–3 захода и финал в релакс-зоне.'],
];
const faq = [
  { q: 'Сколько стоит SPA-зона?', a: `SPA входит в тариф «Всё включено»: ${rub(plans[2].month)} в месяц или ${rub(plans[2].year)} за год. Отдельно за сауну платить не нужно.` },
  { q: 'Можно ли в сауну сразу после тренировки?', a: 'Лучше подождать 10–15 минут, пока пульс и дыхание восстановятся. Заходите на 8–12 минут, между заходами отдыхайте и пейте воду.' },
  { q: 'Кому нельзя в сауну и хаммам?', a: 'При повышенной температуре, острых воспалениях, гипертонии, болезнях сердца и сосудов, во время беременности. Если сомневаетесь, посоветуйтесь с врачом.' },
  { q: 'Что взять с собой?', a: 'Полотенце, сланцы и шапочку для сауны. Душевые с гелем и шампунем есть в раздевалках.' },
];
---
<Layout title="Сауна и хаммам в фитнес-клубе, Хабаровск" description={`SPA-зона фитнес-клуба Urban210: финская сауна, хаммам 40–50 °C и релакс-зона с массажными креслами. Входит в тариф «Всё включено» за ${rub(plans[2].month)} в месяц.`}>
  <PageHero title="SPA-зона: сауна и хаммам" lead="Восстановление после тренировки без отдельной оплаты: финская сауна, хаммам и релакс-зона входят в тариф «Всё включено»." crumbs={[{ href: '/spa/', label: 'SPA-зона' }]}>
    <Cta goal="Всё включено" block="spa_hero">Хочу «Всё включено»</Cta>
  </PageHero>
  <section class="sec" style="padding-top:0" data-block="spa_items" aria-labelledby="spa-t">
    <div class="wrap">
      <h2 id="spa-t" class="sr">Что есть в SPA-зоне</h2>
      <div class="grid-3">
        {items.map((it, i) => (
          <article class:list={['tile', i === 0 && 'zone-spa']} style="min-height:280px;justify-content:flex-end" data-rise>
            <h3>{it.title}</h3>
            <p style={i === 0 ? 'color:rgb(245 240 234 / .85)' : ''}>{it.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="sec" style="padding-top:0" data-block="spa_how" aria-labelledby="how-t">
    <div class="wrap">
      <div class="head"><h2 id="how-t">Как правильно восстанавливаться</h2></div>
      <ol class="steps">{steps.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>
  <Faq items={faq} title="Вопросы о SPA" />
  <Final title="SPA в тарифе «Всё включено»" block="final_spa" goal="Всё включено" text="Оставьте номер: администратор расскажет про тариф «Всё включено» и покажет SPA-зону, когда придёте в клуб." />
</Layout>
