---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
---
<Layout title="Страница не найдена" description="Такой страницы нет на сайте фитнес-клуба Urban210." noindex>
  <section class="page-hero" style="min-height:70svh;display:grid;align-items:center">
    <div class="wrap">
      <p class="num accent" style="font-size:clamp(6rem,20vw,14rem)">404</p>
      <h1 style="margin-top:16px">Такой страницы нет</h1>
      <p class="lead" style="margin-top:20px">Возможно, ссылка устарела. Начните с главной или загляните в тарифы.</p>
      <div class="actions"><a class="btn btn-light" href="/">На главную</a><a class="link" href="/price/">Тарифы</a><Cta block="404">Пробный день за 1 ₽</Cta></div>
    </div>
  </section>
</Layout>
