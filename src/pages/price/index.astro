---
import AppBlock from '../../components/AppBlock.astro';
// Цены: выбор карты, сравнение тарифов, сколько стоит день, персональные тренировки и вопросы об оплате.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Plans from '../../components/Plans.astro';
import Faq from '../../components/Faq.astro';
import Final from '../../components/Final.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { plans, perDay, rub, personal } from '../../data/pricing';
import { faqGeneral } from '../../data/content';

const [day, full, all] = plans;
const dayPrice = perDay(day.month, 30);

// Что входит в каждую карту: true — входит, false — нет, строка — значение
const rows: [string, (boolean | string)[]][] = [
  ['Время посещения', [day.hours, 'всё время работы', 'всё время работы']],
  ['Тренажёрный зал и кардиозона', [true, true, true]],
  ['Фитнес-тестирование', [true, true, true]],
  ['Раздевалки и душевые', [true, true, true]],
  ['Бесплатная парковка', [true, true, true]],
  ['Пробная тренировка с тренером', [false, true, true]],
  ['Групповые программы', [false, false, true]],
  ['SPA: финская сауна, хаммам, релакс-зона', [false, false, true]],
  ['Приоритетное обслуживание', [false, false, true]],
  ['Цена за месяц', plans.map((p) => rub(p.month))],
  ['Цена за 12 месяцев', plans.map((p) => rub(p.year))],
];

const faq = [
  ...faqGeneral.slice(0, 3),
  { q: 'Можно ли заморозить карту?', a: 'Да, один раз в год на 30 дней бесплатно. Заморозку оформляет администратор по звонку. Если заболели, карту можно продлить по справке.' },
  { q: 'Можно ли оплатить частями?', a: `Если годовая карта сразу выходит дорого, можно платить помесячно: от ${rub(day.month)} в месяц. Можно ли разбить на части оплату годовой карты, подскажет администратор при оформлении.` },
  { q: 'Чем дневная карта отличается от «Полного дня»?', a: `Дневная карта действует ${day.hours}. Это самый дешёвый вариант, если вы тренируетесь утром или днём. «Полный день» открывает клуб на всё время работы и включает пробную тренировку с тренером.` },
];
---
<Layout
  image="/og/price.jpg"
  title="Цены на абонементы в фитнес-клуб в Хабаровске"
  description={`Абонементы в фитнес-клуб Urban210 в Хабаровске: от ${rub(day.month)} в месяц или от ${dayPrice} ₽ в день. Сравнение трёх карт, цены за год, персональный тренер.`}
>
  <PageHero
    title="Цены на абонементы в фитнес-клуб"
    lead={`Три карты с безлимитом в выбранное время. Самая доступная выходит от ${dayPrice} ₽ в день, при оплате за год ещё дешевле.`}
    crumbs={[{ href: '/price/', label: 'Цены' }]}
    image="/images/reception.jpg"
    alt="Ресепшен фитнес-клуба Urban210"
    position="50% 50%"
  >
    <a class="f5-go" href="#cards"><span>Выбрать карту</span><i><Icon name="chev" /></i></a>
    <Cta block="price_hero">Оставить заявку</Cta>
  </PageHero>

  <Plans title="Выберите карту" block="price_page" />

  <section class="f5-sec" id="compare" aria-labelledby="cmp-t">
    <div class="f5-head">
      <h2 id="cmp-t">Что входит в каждую карту</h2>
      <p>Каждая следующая карта включает всё из предыдущей и добавляет своё.</p>
    </div>
    <div class="cmp-wrap">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col"><span class="sr">Что входит</span></th>
            {plans.map((p) => <th scope="col" class:list={[p.id === 'full' && 'hot']}>{p.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map(([label, vals]) => (
            <tr>
              <th scope="row">{label}</th>
              {vals.map((v, i) => (
                <td class:list={[i === 1 && 'hot']}>
                  {v === true ? <span class="yes"><Icon name="check" /><span class="sr">входит</span></span>
                    : v === false ? <span class="no"><Icon name="minus" /><span class="sr">не входит</span></span>
                    : v}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="f5-sec" aria-labelledby="day-t">
    <div class="f5-head">
      <h2 id="day-t">Сколько стоит день тренировок</h2>
      <p>Делим цену карты на 30 дней месяца или на 365 дней года. Чем чаще вы ходите, тем дешевле выходит одно посещение.</p>
    </div>
    <div class="f5-grid f5-grid-3">
      {plans.map((p, i) => (
        <article class:list={['f5-card', i === 1 && 'is-org']}>
          <h3>{p.name}</h3>
          <p class="perday"><b>{perDay(p.month, 30)} ₽</b> в день при оплате за месяц</p>
          <p>{rub(p.month)} в месяц, {p.hours}.</p>
          <p class="perday sm"><b>{perDay(p.year, 365)} ₽</b> в день при оплате за год</p>
          <p>{rub(p.year)} за 12 месяцев, это {rub(Math.round(p.year / 12))} в месяц.</p>
        </article>
      ))}
    </div>
  </section>

  <section class="f5-sec" aria-labelledby="pt-t">
    <div class="f5-card is-cob pt">
      <div>
        <h2 id="pt-t">Персональные тренировки</h2>
        <p>Тренер составит программу под вашу цель, поставит технику и будет следить за прогрессом.</p>
      </div>
      <div class="pt-price">
        <b>{rub(personal.price)}</b>
        <span>{personal.pack} тренировок, {rub(Math.round(personal.price / personal.pack))} за одну</span>
      </div>
      <div class="pt-btns">
        <Cta variant="wht" goal="Персональные тренировки" block="price_personal">Записаться к тренеру</Cta>
        <a class="f5-pill f5-pill-ghost" href="/personal/">Как проходят занятия</a>
      </div>
    </div>
  </section>

  <section class="f5-sec" aria-label="Приложение клуба"><AppBlock compact /></section>

  <Faq items={faq} title="Вопросы о ценах" />
  <Final block="price_final" />
</Layout>

<style>
  .cmp-wrap { position: relative; overflow-x: auto; border-radius: var(--r-l); background: var(--card); }
  .cmp { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 0.98rem; }
  .cmp th, .cmp td { padding: 16px 18px; text-align: center; border-bottom: 1px solid rgb(244 242 238 / 0.08); vertical-align: middle; }
  .cmp tbody th { text-align: left; font-weight: 600; color: var(--ink); }
  .cmp thead th { font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; padding-top: 24px; }
  .cmp tr:last-child th, .cmp tr:last-child td { border-bottom: 0; }
  .cmp td.hot, .cmp th.hot { background: rgb(255 87 34 / 0.1); }
  .cmp thead th.hot { color: var(--org); }
  .cmp .yes, .cmp .no { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; }
  .cmp .yes { background: var(--org); color: #fff; }
  .cmp .no { background: rgb(244 242 238 / 0.08); color: var(--mut); }
  .cmp :global(svg) { width: 18px; height: 18px; }
  .cmp tbody tr:nth-last-child(-n + 2) td { font-weight: 800; white-space: nowrap; }
  @media (max-width: 640px) {
    .cmp { min-width: 0; table-layout: fixed; }
    .cmp th, .cmp td { padding: 12px 4px; font-size: 0.8rem; line-height: 1.3; }
    .cmp tbody th { padding-left: 14px; width: 36%; }
    .cmp thead th { font-size: 0.82rem; padding-top: 18px; }
    .cmp .yes, .cmp .no { width: 24px; height: 24px; }
    .cmp tbody tr:nth-last-child(-n + 2) td { font-size: 0.74rem; }
  }
  .perday { color: var(--ink) !important; font-weight: 600; }
  .perday b { display: block; font-size: clamp(2.4rem, 2rem + 1.6vw, 3.2rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .perday.sm { margin-top: 10px; padding-top: 16px; border-top: 1px solid rgb(244 242 238 / 0.12); }
  .perday.sm b { font-size: 1.8rem; }
  .f5-card.is-org .perday { color: #fff !important; }
  .f5-card.is-org .perday.sm { border-color: rgb(255 255 255 / 0.3); }
  .pt { display: grid; gap: 24px; padding: clamp(28px, 4vw, 56px); }
  .pt h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); letter-spacing: -0.045em; line-height: 1; }
  .pt p { margin-top: 12px; max-width: 44ch; }
  .pt-price b { display: block; font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .pt-price span { display: block; margin-top: 8px; color: rgb(255 255 255 / 0.88); font-weight: 600; }
  .pt-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 980px) { .pt { grid-template-columns: 1.3fr 1fr; align-items: center; } .pt-btns { grid-column: 1 / -1; } }
</style>
