---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Final from '../../components/Final.astro';
import { img } from '../../data/images';
const TOUR = 'https://my.matterport.com/show/?m=RX7Vmh4E33h&play=1&lang=ru';
const photos = [
  ['/images/zal.jpg', 'Тренажёрный зал'],
  ['/images/cardio.jpg', 'Кардиозона'],
  ['/images/free-weights.jpg', 'Свободные веса'],
  ['/images/machines.jpg', 'Силовые тренажёры'],
  ['/images/group.jpg', 'Групповая тренировка'],
  ['/images/reception.jpg', 'Ресепшен и зона отдыха'],
];
---
<Layout title="3D-тур по фитнес-клубу в Хабаровске" description="Виртуальный 3D-тур по фитнес-клубу Urban210 в Хабаровске: тренажёрный зал, кардиозона, студия групповых программ, раздевалки и SPA.">
  <PageHero title="3D-тур по клубу" lead="Пройдитесь по залам, раздевалкам и SPA-зоне, не выходя из дома. А потом приходите на пробный день за 1 ₽." crumbs={[{ href: '/virtual-tour/', label: '3D-тур' }]} />
  <section class="wrap" data-block="tour">
    <div class="tour">
      <button class="map-btn" type="button" data-frame={TOUR} data-title="3D-тур по клубу Urban210">
        <span class="num accent" style="font-size:2.4rem">Начать тур</span>
        <span class="muted">Загрузится 3D-модель клуба, около 10 МБ</span>
      </button>
    </div>
  </section>
  <section class="sec" aria-label="Фотографии клуба">
    <div class="wrap">
      <ul class="gallery">
        {photos.map(([src, alt]) => <li><Image src={img(src)} alt={alt} widths={[480, 800]} sizes="(min-width: 900px) 33vw, 50vw" format="avif" quality={50} /></li>)}
      </ul>
    </div>
  </section>
  <Final />
</Layout>
