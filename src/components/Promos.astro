---
// Акции клуба карточками со ссылкой на страницу акции.
import Icon from './Icon.astro';
import { promos } from '../data/content';
const list = promos.filter((p) => p.slug !== '1-rubl');
---
<div class="f5-grid f5-grid-2">
  {list.map((p, i) => (
    <a class:list={['f5-card', i === 0 ? 'is-org' : 'is-cob']} href={`/promo/${p.slug}/`}>
      <h3>{p.title}</h3>
      <p>{p.short}. {p.text}</p>
      <span class="f5-card-more">Подробнее<Icon name="chev" /></span>
    </a>
  ))}
</div>
