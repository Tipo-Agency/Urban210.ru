---
// Тренеры карточками. Ссылки ведут на страницы тренеров /trainers/<slug>/.
import { Image } from 'astro:assets';
import { img } from '../data/images';
import { trainers } from '../data/content';
interface Props { link?: boolean }
const { link = true } = Astro.props;
const slug = (photo: string) => photo.split('/').pop()!.replace(/\.[a-z]+$/, '');
const tones = ['', 'c1', 'c2'];
---
<div class="f5-team">
  {trainers.map((t, i) => {
    const Tag = link ? 'a' : 'div';
    return (
      <Tag class={`f5-coach ${tones[i % 3]}`} href={link ? `/trainers/${slug(t.photo)}/` : undefined}>
        <Image src={img(t.photo)} alt={t.name} widths={[360, 560]} sizes="(min-width: 1100px) 25vw, (min-width: 700px) 45vw, 76vw" format="avif" quality={55} />
        <div><h3>{t.name}</h3><p>{t.role}</p></div>
      </Tag>
    );
  })}
</div>
