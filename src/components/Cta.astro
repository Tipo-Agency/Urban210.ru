---
// Кнопка заявки: открывает форму в окне с нужной целью. Без JS ведёт к блоку заявки.
interface Props { goal?: string; block?: string; variant?: 'org' | 'ink' | 'wht' | 'ghost'; class?: string }
const { goal = 'Заявка с сайта', block = '', variant = 'org', class: cls } = Astro.props;
---
<a class:list={['f5-pill', `f5-pill-${variant}`, cls]} href="#zayavka" data-lead={goal} data-block={block}><slot /></a>
