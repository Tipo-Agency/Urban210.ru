---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { img } from '../data/images';
interface Props { post: CollectionEntry<'blog'>; level?: 'h2' | 'h3' }
const { post, level = 'h3' } = Astro.props;
const H = level;
---
<a class="post-card" href={`/blog/${post.id}/`}>
  <div class="ph"><Image src={img(post.data.image)} alt="" widths={[400, 640]} sizes="(min-width: 1100px) 30vw, (min-width: 760px) 45vw, 100vw" format="avif" quality={45} /></div>
  <div class="b">
    <p class="post-meta"><span class="cat">{post.data.category}</span></p>
    <H>{post.data.title}</H>
    <p>{post.data.description}</p>
  </div>
</a>
