---
// Финальный блок с формой. Якорь #zayavka: сюда ведут кнопки, если JS не загрузился.
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { site, whatsappLink, telegramLink } from '../data/site';
interface Props { title?: string; text?: string; goal?: string; block?: string; button?: string; formTitle?: string }
const {
  title = 'Первый день за 1 ₽',
  text = 'Приходите, потренируйтесь, загляните в раздевалки и SPA. Понравится — оформите абонемент без вступительного взноса.',
  goal, block = 'final', button, formTitle,
} = Astro.props;
---
<section class="final sec on-accent" id="zayavka" data-block={block} aria-labelledby={`${block}-t`}>
  <Icon name="chev" class="bigchev" />
  <div class="wrap final-grid">
    <div>
      <h2 id={`${block}-t`}>{title}</h2>
      <p class="lead" style="margin-top:22px;max-width:40ch">{text}</p>
      <div class="alt-contacts">
        <a class="link" href={site.phone.href}>{site.phone.display}</a>
        <a class="link" href={whatsappLink('Здравствуйте! Хочу на пробный день в Urban210')} target="_blank" rel="noopener">WhatsApp</a>
        <a class="link" href={telegramLink('site_final')} target="_blank" rel="noopener">Telegram</a>
      </div>
    </div>
    <LeadForm goal={goal} block={block} id={block} button={button} title={formTitle} />
  </div>
</section>
