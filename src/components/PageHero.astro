---
import { Image } from 'astro:assets';
import { img } from '../data/images';
interface Props { title: string; lead?: string; crumbs?: { href: string; label: string }[]; image?: string; alt?: string }
const { title, lead, crumbs = [], image, alt = '' } = Astro.props;
---
<header class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav aria-label="Хлебные крошки">
        <ol class="crumbs">
          <li><a href="/">Главная</a></li>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>)}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {Astro.slots.has('default') && <div class="actions"><slot /></div>}
    {image && (
      <div class="page-hero-media">
        <Image src={img(image)} alt={alt} widths={[480, 828, 1280, 1600]} sizes="(min-width: 1360px) 1312px, 100vw" loading="eager" fetchpriority="high" format="webp" quality={60} />
      </div>
    )}
  </div>
</header>
