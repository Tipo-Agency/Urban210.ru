---
// Вопросы и ответы с разметкой FAQPage.
import type { Faq as Item } from '../data/content';
interface Props { items: Item[]; title?: string; text?: string; id?: string }
const { items, title = 'Частые вопросы', text, id = 'faq' } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section class="f5-sec" id={id} aria-labelledby={`${id}-t`}>
  <div class="f5-head">
    <h2 id={`${id}-t`}>{title}</h2>
    {text && <p>{text}</p>}
  </div>
  <div class="f5-faq">
    {items.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}<i aria-hidden="true"></i></summary>
        <p class="a">{f.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
