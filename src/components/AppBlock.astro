---
// Блок о мобильном приложении клуба. Кнопки магазинов показываем, только когда в site.app есть ссылки.
// Телефон нарисован вёрсткой (чёткий на любом экране); на экране только то, что умеет приложение: пропуск, абонемент, запись.
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';
import { plans } from '../data/pricing';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const stores = [
  { label: 'App Store', href: site.app.appStore },
  { label: 'Google Play', href: site.app.googlePlay },
  { label: 'RuStore', href: site.app.ruStore },
].filter((s) => s.href);
const plan = plans[plans.length - 1].name;
// Пример расписания на экране телефона: направления из content.ts, время условное
const today = [
  { time: '18:00', name: 'Пилатес', room: 'Зал 150 м²', state: 'done' },
  { time: '19:00', name: 'Body Pump', room: 'Зал 150 м²', state: 'open' },
  { time: '20:00', name: 'TRX', room: 'Октагон', state: 'open' },
];
const icons = ['qr', 'cal', 'card'];
---
{compact ? (
  <div class="f5-card app-mini">
    <h3>Мобильное приложение</h3>
    <p>{site.app.features.map((f) => f.title).join(', ')}. Всё в приложении клуба.</p>
    {stores.length > 0 && <p class="app-stores">{stores.map((s) => <a class="f5-pill f5-pill-ink" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>}
  </div>
) : (
  <section class="f5-sec" id="app" aria-labelledby="f5-app">
    <div class="app">
      <div class="app-txt">
        <span class="f5-tag">Приложение клуба</span>
        <h2 id="f5-app">Клуб в&nbsp;телефоне</h2>
        <p class="app-lead">Пропуск, абонемент и запись на групповые в одном приложении. Пластиковая карта не нужна.</p>
        <ul class="app-list">
          {site.app.features.map((f, i) => (
            <li>
              <span class="app-ic" aria-hidden="true">
                {icons[i] === 'qr' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M14 14h3v3h-3zM20 14v.01M20 20h-3v-3M14 20v.01" /></svg>}
                {icons[i] === 'cal' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4M8 15l2.5 2.5L16 13" /></svg>}
                {icons[i] === 'card' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2.5" y="5" width="19" height="14" rx="3" /><path d="M2.5 10h19M7 15h4" /></svg>}
              </span>
              <div><b>{f.title}</b><span>{f.text}</span></div>
            </li>
          ))}
        </ul>
        {stores.length > 0
          ? <p class="app-stores">{stores.map((s) => <a class="f5-pill f5-pill-ink" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>
          : <p class="app-note">Как подключить приложение, подскажет администратор: <a href={site.phone.href}>{site.phone.display}</a></p>}
      </div>

      <div class="ph-wrap" aria-hidden="true">
        <div class="ph">
          <span class="ph-btn ph-btn-a"></span><span class="ph-btn ph-btn-b"></span><span class="ph-btn ph-btn-c"></span>
          <div class="ph-screen">
            <div class="ph-status"><b>9:41</b><span class="ph-island"></span><i class="ph-bat"></i></div>

            <div class="ph-head">
              <LogoMark size={34} />
              <div><small>Добрый вечер</small><b>Анна</b></div>
              <span class="ph-ava">А</span>
            </div>

            <div class="ph-card">
              <div class="ph-card-top"><span>URBAN<b>210</b></span><em>Активна</em></div>
              <p class="ph-plan">{plan}</p>
              <p class="ph-left"><b>23</b> дня до конца карты</p>
              <span class="ph-bar"><i></i></span>
            </div>

            <div class="ph-pass">
              <span class="ph-qr">
                <svg viewBox="0 0 21 21" shape-rendering="crispEdges"><path fill="#000" d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zm1 1v5h5V1zm1 1h3v3h-3zM0 14h7v7H0zm1 1v5h5v-5zm1 1h3v3H2zM8 0h2v2H8zm3 1h2v3h-2zM8 3h2v2H8zm0 3h3v2H8zm4 2h2v3h-2zM0 8h2v2H0zm3 0h3v2H3zm5 3h3v2H8zm7-3h2v2h-2zm3 0h3v3h-3zM8 14h2v3H8zm3 1h3v2h-3zm4-1h2v2h-2zm3 2h3v2h-3zm-4 3h3v2h-3zm5 1h2v1h-2zm-10 0h2v1H8z" /></svg>
              </span>
              <span><b>Пропуск</b><small>Покажите код на входе</small></span>
            </div>

            <div class="ph-sec"><b>Сегодня</b><small>Запись на групповые</small></div>
            <ul class="ph-list">
              {today.map((c) => (
                <li>
                  <time>{c.time}</time>
                  <span><b>{c.name}</b><small>{c.room}</small></span>
                  {c.state === 'done' ? <em class="is-done">Вы записаны</em> : <em>Записаться</em>}
                </li>
              ))}
            </ul>

            <nav class="ph-tabs">
              <span class="on"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11l8-7 8 7v9a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" /></svg>Главная</span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>Расписание</span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M14 14h3v3h-3zM20 20h-3v-3" /></svg>Пропуск</span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>Профиль</span>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .app { display: grid; gap: 40px; padding: clamp(28px, 4vw, 64px); border-radius: var(--r-xl); background: var(--card); overflow: hidden; }
  .app-txt { display: grid; gap: 22px; align-content: center; }
  .app h2 { font-size: clamp(2.3rem, 1.3rem + 3.8vw, 4.6rem); line-height: 0.96; letter-spacing: -0.05em; }
  .app-lead { color: var(--mut); font-size: 1.12rem; max-width: 38ch; }
  .app-list { list-style: none; display: grid; gap: 18px; }
  .app-list li { display: grid; grid-template-columns: 48px 1fr; gap: 14px; align-items: center; }
  .app-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 16px; background: var(--org); color: #000; }
  .app-ic svg { width: 24px; height: 24px; }
  .app-list b { display: block; font-size: 1.1rem; letter-spacing: -0.01em; }
  .app-list span:not(.app-ic) { color: var(--mut); font-size: 0.96rem; }
  .app-note { color: var(--mut); }
  .app-note a { color: var(--ink); font-weight: 700; }
  .app-stores { display: flex; flex-wrap: wrap; gap: 10px; }

  /* Телефон */
  .ph-wrap { display: grid; place-items: center; padding: 8px 0; }
  .ph { position: relative; width: 300px; height: 620px; padding: 11px; border-radius: 54px; background: #1c1c1c; box-shadow: inset 0 0 0 1.5px #3a3a3a, inset 0 0 0 5px #0d0d0d, 0 50px 90px -40px rgb(255 87 34 / 0.35), 0 30px 60px -30px #000; }
  .ph-btn { position: absolute; width: 3px; border-radius: 2px; background: #2a2a2a; }
  .ph-btn-a { left: -3px; top: 120px; height: 30px; }
  .ph-btn-b { left: -3px; top: 170px; height: 54px; }
  .ph-btn-c { right: -3px; top: 190px; height: 80px; }
  .ph-screen > * { flex-shrink: 0; }
  .ph-screen { position: relative; height: 100%; display: flex; flex-direction: column; gap: 12px; padding: 14px 16px 0; border-radius: 44px; background: #000; overflow: hidden; color: #f4f2ee; font-size: 13px; line-height: 1.25; }
  .ph-status { display: flex; align-items: center; justify-content: space-between; height: 22px; padding: 0 12px; font-size: 13px; }
  .ph-island { width: 92px; height: 26px; border-radius: 20px; background: #0d0d0d; box-shadow: inset 0 0 0 1px #1a1a1a; }
  .ph-bat { width: 24px; height: 11px; border-radius: 3px; border: 1.5px solid #f4f2ee; position: relative; }
  .ph-bat::after { content: ''; position: absolute; inset: 1.5px 5px 1.5px 1.5px; border-radius: 1px; background: #f4f2ee; }
  .ph-head { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
  .ph-head small { display: block; color: #8d8a9b; font-size: 11px; }
  .ph-head b { font-size: 17px; letter-spacing: -0.02em; }
  .ph-ava { margin-left: auto; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #1a1a1a; font-weight: 800; }
  .ph-card { position: relative; padding: 14px 14px 16px; border-radius: 22px; background: var(--org); color: #000; overflow: hidden; }
  .ph-card::after { content: ''; position: absolute; right: -36px; top: -36px; width: 120px; height: 120px; border-radius: 50%; border: 18px solid rgb(0 0 0 / 0.08); }
  .ph-card-top { display: flex; justify-content: space-between; align-items: center; font-weight: 800; letter-spacing: -0.03em; }
  .ph-card-top b { color: #fff; }
  .ph-card-top em { font-style: normal; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: #000; color: #fff; }
  .ph-plan { margin-top: 18px; font-size: 21px; font-weight: 800; letter-spacing: -0.04em; }
  .ph-left { margin-top: 2px; font-size: 12px; font-weight: 600; }
  .ph-left b { font-size: 12px; }
  .ph-bar { display: block; height: 6px; margin-top: 10px; border-radius: 3px; background: rgb(0 0 0 / 0.18); }
  .ph-bar i { display: block; width: 74%; height: 100%; border-radius: 3px; background: #000; }
  .ph-pass { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 20px; background: #f4f2ee; color: #000; }
  .ph-qr { flex: none; display: grid; place-items: center; width: 52px; height: 52px; padding: 6px; border-radius: 12px; background: #fff; }
  .ph-qr svg { width: 100%; height: 100%; }
  .ph-pass b { display: block; font-size: 15px; letter-spacing: -0.02em; }
  .ph-pass small { color: #555; font-size: 11px; }
  .ph-sec { display: flex; align-items: baseline; justify-content: space-between; margin-top: 2px; }
  .ph-sec b { font-size: 15px; letter-spacing: -0.02em; }
  .ph-sec small { color: #8d8a9b; font-size: 10.5px; }
  .ph-list { list-style: none; display: grid; gap: 6px; }
  .ph-list li { display: grid; grid-template-columns: 38px 1fr auto; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 16px; background: #111; }
  .ph-list time { font-weight: 800; font-size: 12px; color: var(--org); }
  .ph-list b { display: block; font-size: 12.5px; }
  .ph-list small { display: block; color: #8d8a9b; font-size: 10px; white-space: nowrap; }
  .ph-list em { font-style: normal; font-size: 10px; font-weight: 700; padding: 6px 9px; border-radius: 999px; background: var(--org); color: #000; }
  .ph-list em.is-done { background: #1f1f1f; color: #f4f2ee; }
  .ph-tabs { display: grid; grid-template-columns: repeat(4, 1fr); margin: auto -16px 0; padding: 10px 8px 22px; background: #0b0b0b; border-top: 1px solid #1a1a1a; font-size: 9.5px; color: #77748a; text-align: center; }
  .ph-tabs span { display: grid; justify-items: center; gap: 4px; }
  .ph-tabs svg { width: 20px; height: 20px; }
  .ph-tabs .on { color: var(--org); }

  .app-mini h3 { font-size: 1.4rem; margin-bottom: 8px; }
  .app-mini p { color: var(--mut); }
  .app-mini .app-stores { margin-top: 14px; }
  @media (min-width: 900px) { .app { grid-template-columns: 1.15fr 1fr; align-items: center; } }
  @media (max-width: 360px) { .ph { transform: scale(0.9); margin: -30px 0; } }
  @media (min-width: 1100px) { .ph { transform: scale(1.14); } .ph-wrap { padding: 48px 0; } }
</style>
