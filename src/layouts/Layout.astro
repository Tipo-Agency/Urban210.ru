---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import LeadDialog from '../components/LeadDialog.astro';
import { site, nav, SITE_URL, messengerLinks } from '../data/site';
import { plans } from '../data/pricing';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  type?: 'website' | 'article';
  // bare: страница рисует свою шапку и подвал (концепции дизайна)
  bare?: boolean;
}
const { title, description, image = '/og/default.jpg', noindex = false, jsonld = [], type = 'website', bare = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = SITE_URL + path;
// Суффикс бренда только если заголовок остаётся в пределах 60 знаков (иначе поисковик обрежет)
const fullTitle = path === '/' || `${title} | Urban210`.length > 60 ? title : `${title} | Urban210`;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const messengers = messengerLinks();
const year = new Date().getFullYear();

const YM_ID = import.meta.env.PUBLIC_YM_ID || '108422317';
const CT_ID = import.meta.env.PUBLIC_CALLTOUCH_ID || '';
const CT_SITE = import.meta.env.PUBLIC_CALLTOUCH_SITE_ID || '';

// schema.org: клуб как HealthClub и SportsActivityLocation. Только факты из src/data/site.ts.
const gym = {
  '@context': 'https://schema.org',
  '@type': ['HealthClub', 'SportsActivityLocation'],
  '@id': SITE_URL + '/#club',
  name: site.fullName,
  url: SITE_URL + '/',
  image: SITE_URL + '/og.jpg',
  telephone: site.phone.href.replace('tel:', ''),
  email: site.email,
  priceRange: `${plans[0].month}–${plans[2].month} ₽ в месяц`,
  currenciesAccepted: 'RUB',
  areaServed: `${site.city}, ${site.district}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: 'RU',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.lat, longitude: site.address.lng },
  openingHoursSpecification: site.hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schema.days, opens: h.schema.opens, closes: h.schema.closes })),
  ...(messengers.length ? { sameAs: messengers.map((m) => m.href) } : {}),
  parentOrganization: { '@type': 'Organization', name: site.legal.name, taxID: site.legal.inn },
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Urban210" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {!bare && <link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin />}
    <script type="application/ld+json" set:html={JSON.stringify(gym)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduce');
    </script>
    <slot name="head" />
  </head>
  <body data-ym={YM_ID} data-ct-site={CT_SITE}>
    <a class="skip" href="#main">К содержанию</a>

    {bare ? (
      <main id="main"><slot /></main>
    ) : (
      <div class="f5">
        <header class="f5-top" data-header>
          <div class="f5-bar">
            <Logo />
            <nav class="f5-nav" aria-label="Основное меню">
              {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
            </nav>
            <a class="f5-tel" href={site.phone.href}>{site.phone.display}</a>
            <a class="f5-pill f5-pill-org f5-top-cta" href="/price/#cards">Выбрать карту</a>
            <button class="f5-burger" type="button" aria-label="Меню" aria-expanded="false" aria-controls="menu" data-burger><i></i><i></i></button>
          </div>
        </header>

        <div class="f5-menu" id="menu" data-menu>
          <nav aria-label="Меню">
            {[{ href: '/', label: 'Главная' }, ...nav].map((n) => (
              <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}
          </nav>
          <div class="f5-menu-foot">
            <a class="f5-foot-tel" href={site.phone.href}>{site.phone.display}</a>
            <p>{site.address.short} · {site.hours.map((h) => `${h.days} ${h.time}`).join(', ')}</p>
            <a class="f5-pill f5-pill-org" href="#zayavka" data-lead="Заявка с сайта" data-block="menu">Оставить заявку</a>
          </div>
        </div>

        <main id="main">
          <slot />
        </main>

        <footer class="f5-foot">
          <div class="f5-foot-card">
            <div class="f5-foot-grid">
              <div>
                <Logo size="lg" />
                <p class="f5-foot-addr">{site.address.locality}, {site.address.street}<br />{site.district}</p>
                <a class="f5-foot-tel" href={site.phone.href}>{site.phone.display}</a>
              </div>
              <div>
                <h2>Часы работы</h2>
                <ul>{site.hours.map((h) => <li><b>{h.days}</b> {h.time}</li>)}</ul>
                <p class="f5-foot-note">{site.parking}</p>
              </div>
              <div>
                <h2>Клуб</h2>
                <ul>
                  {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
                  <li><a href="/personal/">Персональные тренировки</a></li>
                  <li><a href="/virtual-tour/">3D-тур</a></li>
                </ul>
              </div>
              <div>
                <h2>На связи</h2>
                <ul>
                  <li><a href={site.phone.href}>{site.phone.display}</a></li>
                  {messengers.map((m) => <li><a href={m.href} target="_blank" rel="noopener">{m.label}</a></li>)}
                  <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
                  <li><a href="/contacts/">Как добраться</a></li>
                </ul>
              </div>
            </div>
            <div class="f5-foot-bottom">
              <span>© {year} {site.legal.name}, ИНН {site.legal.inn}, ОГРН {site.legal.ogrn}</span>
              <span><a href="/policy/">Политика конфиденциальности</a> · <a href="/oferta/">Публичная оферта</a> · <a href="/rules/">Правила посещения</a></span>
            </div>
          </div>
        </footer>
      </div>
    )}

    <div class="mbar" data-mbar>
      <a class="ic" href={site.phone.href} aria-label="Позвонить"><Icon name="phone" /></a>
      {messengers.slice(0, 1).map((m) => <a class="ic" href={m.href} target="_blank" rel="noopener" aria-label={m.label}><Icon name={m.id === 'telegram' ? 'tg' : 'chev'} /></a>)}
      <a class="btn" href="#zayavka" data-lead="Заявка с сайта" data-block="mobile_bar">Оставить заявку</a>
    </div>

    <LeadDialog />

    <script>
      import { boot } from '../scripts/site';
      boot();
    </script>

    {YM_ID && (
      <script is:inline define:vars={{ YM_ID, CT_ID }}>
        // Метрика и Calltouch грузятся после load, чтобы не мешать первому экрану
        // на localhost и тестовых адресах счётчики не включаем, чтобы не портить статистику
        if (/(^|\.)urban210\.ru$/.test(location.hostname)) addEventListener('load', function () {
          setTimeout(function () {
            (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
            ym(Number(YM_ID), 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
            if (CT_ID) {
              (function(w,d,n,c){w.CalltouchDataObject=n;w[n]=function(){w[n]['callbacks'].push(arguments)};if(!w[n]['callbacks']){w[n]['callbacks']=[]}w[n]['loaded']=false;if(typeof c!=='object'){c=[c]}w[n]['counters']=c;for(var i=0;i<c.length;i+=1){p(c[i])}function p(cId){var a=d.getElementsByTagName('script')[0],s=d.createElement('script'),i=function(){a.parentNode.insertBefore(s,a)},m=typeof Array.prototype.find==='function',n=m?'init-min.js':'init.js';s.async=true;s.src='https://mod.calltouch.ru/'+n+'?id='+cId;i()}})(window,document,'ct',CT_ID);
            }
          }, 1500);
        });
      </script>
    )}
  </body>
</html>
